---
import BaseLayout from '../layouts/BaseLayout.astro';
import { recursos, latestRecursoISO } from '../lib/recursos';
import { NEW_POST_DAYS } from '../lib/blog';

// Regla editorial (octubre de 2026): aqui solo va lo que tiene un archivo
// descargable. Las guias paso a paso y los articulos informativos estan en /blog/.
// El listado sale de src/lib/recursos.ts: paginas en src/pages/recursos/ y
// articulos de Sanity con bloque de descarga.
const title = "Plantillas de instrucciones de trabajo y PRL | REELEVO";
const description = "Plantillas gratis en Excel y Word para pyme industrial: matriz de polivalencia, gestión documental de PRL, instrucciones de trabajo y SOP.";
const canonical = "https://www.gmvsolutions.es/recursos/";

// Candidatos a "Novedades": lo publicado en los NEW_POST_DAYS dias previos al
// ultimo recurso. Cual se ve de verdad lo decide el script de Header.astro.
const limiteNovedades = new Date(Date.parse(latestRecursoISO) - NEW_POST_DAYS * 864e5).toISOString().slice(0, 10);
const novedades = recursos.filter((r) => r.publicado > limiteNovedades);

const MESES = ['ene.', 'feb.', 'mar.', 'abr.', 'may.', 'jun.', 'jul.', 'ago.', 'sept.', 'oct.', 'nov.', 'dic.'];
const fecha = (iso: string) => {
  const [a, m, d] = iso.split('-');
  return `${parseInt(d, 10)} ${MESES[parseInt(m, 10) - 1]} ${a}`;
};

const schema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "headline": "Plantillas descargables de REELEVO",
  "description": description,
  "url": canonical,
  "about": ["Instrucciones de trabajo", "Gestión documental industrial", "Prevención de riesgos laborales", "Procedimientos operativos estándar"],
  "mainEntity": {
    "@type": "ItemList",
    "itemListElement": recursos.map((r, i) => ({
      "@type": "ListItem",
      "position": i + 1,
      "url": `https://www.gmvsolutions.es${r.url}`,
      "name": r.titulo,
    })),
  },
  "author": { "@type": "Organization", "name": "GMV Solutions" }
};
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  schema={schema}
  activeNav="recursos"
  pageType="recurso_hub"
>
  <section class="page-hero">
    <div class="eyebrow fade-up">Recursos</div>
    <h1 class="fade-up delay-1">Plantillas gratuitas <br><em>para tu planta</em></h1>
    <p class="fade-up delay-2">Archivos listos para descargar y rellenar: matriz de polivalencia, gestión documental de PRL, instrucciones de trabajo y SOP de producción. Las guías y los artículos están en el <a href="/blog/">blog</a>.</p>
  </section>

  <!-- NOVEDADES: oculta salvo que el script de Header.astro marque la seccion con .is-new -->
  <section class="section blog-news" id="novedades" data-published={latestRecursoISO}>
    <div class="section-inner">
      <div class="eyebrow blog-news__eyebrow">Publicado en los últimos {NEW_POST_DAYS} días</div>
      <h2 class="section-title">Novedades</h2>
      <div class="articles-grid">
        {novedades.map((r) => (
          <a href={r.url} class="article-card" data-published={r.publicado}>
            <div class="article-card-category">Plantilla {r.formato}<span class="new-badge">Nuevo</span></div>
            <h3 class="article-card-title">{r.titulo}</h3>
            <p class="article-card-desc">{r.desc}</p>
            <div class="article-card-meta"><span>{fecha(r.publicado)}</span></div>
            <div class="article-card-link">Ver y descargar →</div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <div class="divider"></div>

  <section class="section" id="plantillas">
    <div class="section-inner">
      <div class="fade-up">
        <div class="eyebrow">Descargables</div>
        <h2 class="section-title">Todas las plantillas</h2>
        <p class="section-sub">Gratis. Te pedimos nombre, empresa y correo de trabajo, y la descarga empieza al momento.</p>
      </div>
      <div class="articles-grid fade-up delay-1">
        {recursos.map((r) => (
          <a href={r.url} class="article-card" data-published={r.publicado}>
            <div class="article-card-category">Plantilla {r.formato}<span class="new-badge">Nuevo</span></div>
            <h3 class="article-card-title">{r.titulo}</h3>
            <p class="article-card-desc">{r.desc}</p>
            <div class="article-card-meta"><span>{fecha(r.publicado)}</span></div>
            <div class="article-card-link">Ver y descargar →</div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <div class="divider"></div>

  <section class="cta-section">
    <div class="cta-eyebrow fade-up">Cuando la plantilla se queda corta</div>
    <h3 class="cta-title fade-up delay-1">
      La misma lógica, <em>sin mantenerla a mano</em>
    </h3>
    <p class="cta-sub fade-up delay-2">
      En REELEVO las instrucciones de trabajo y la gestión documental viven en el puesto:
      una sola versión vigente, pendientes que se calculan solos y acuse de cada trabajador.
    </p>
    <div class="cta-actions fade-up delay-3">
      <a href="https://app.gmvsolutions.es/registro" class="btn-primary"
         data-cta data-cta-intent="registro" data-cta-location="footer" data-cta-label="Probar gratis">Probar gratis</a>
      <a href="/blog/" class="btn-ghost">Leer el blog →</a>
    </div>
  </section>
</BaseLayout>

<style>
  /* Mismas tarjetas y mismo aviso de novedades que /blog/ */
  .blog-news:not(.is-new),
  .blog-news .article-card:not(.is-new) { display: none; }
  .blog-news__eyebrow { color: var(--gold); }
  .articles-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; margin-top: 40px; }
  .article-card {
    display: flex; flex-direction: column;
    background: var(--surface); border: 1px solid var(--border); border-radius: 6px;
    padding: 32px 28px; text-decoration: none; color: inherit; transition: border-color .25s;
  }
  .article-card:hover { border-color: var(--border-hover); }
  .article-card.is-new { border-color: var(--gold-border); box-shadow: 0 0 24px var(--gold-glow); }
  .article-card-category {
    display: flex; align-items: center; justify-content: space-between; gap: 8px;
    font-family: 'DM Mono', monospace; font-size: .6rem; letter-spacing: .14em;
    text-transform: uppercase; color: var(--orange-ink); margin-bottom: 12px;
  }
  .article-card-title {
    font-family: 'Oswald', sans-serif; font-size: 1.05rem; font-weight: 600;
    text-transform: uppercase; letter-spacing: .02em; margin-bottom: 12px; line-height: 1.2;
  }
  .article-card-desc { font-size: .88rem; color: var(--gray); line-height: 1.65; margin-bottom: 20px; flex: 1; }
  .article-card-meta { display: flex; align-items: center; gap: 6px; font-size: .75rem; color: var(--gray2); margin-bottom: 20px; }
  .article-card-link { font-family: 'DM Mono', monospace; font-size: .7rem; letter-spacing: .08em; color: var(--orange-ink); text-transform: uppercase; }
  .page-hero p a { color: var(--orange-ink); }
  @media (max-width: 900px) { .articles-grid { grid-template-columns: 1fr; } }
</style>
