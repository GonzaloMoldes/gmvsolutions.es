---
import Ilustracion from '../components/Ilustracion.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import FaqSection from '../components/FaqSection.astro';
import { softwareApplicationSchema, faqPageSchema, type FaqItem } from '../lib/seo';
import { getPagina, conNegritas, sinMarcas } from '../lib/contenido';

// Textos editables desde Sanity (Páginas de funcionalidad). Respaldo: src/data/paginas/obras-trazabilidad.json.
const pagina = await getPagina('obras-trazabilidad');

const title = pagina.seo.title;
const description = pagina.seo.description;
const canonical = "https://www.gmvsolutions.es/obras-trazabilidad/";

// Una sola lista alimenta el bloque visible y el FAQPage del head (auditoria P6).
//
// La quinta pregunta recoge el limite honesto que antes era seccion propia
// ("Trazabilidad operativa, no un sistema MES completo"). La plantilla admite
// prueba O limite: se queda la prueba, y el limite pasa aqui (tarea C1 de
// PLAN_SIMPLIFICACION_EDITORIAL_WEB_2026-08.md).
const faqs: FaqItem[] = pagina.faq.items.map(({ q, a }) => ({ q, a: sinMarcas(a) }));

const pageSchema = softwareApplicationSchema();

const schema = [pageSchema, faqPageSchema(faqs)];
---

<BaseLayout title={title} description={description} canonical={canonical} schema={schema} activeNav="" pageType="capacidad">

  <!-- HERO + PROBLEMA -->
  <section class="page-hero">
    <div class="eyebrow fade-up">{pagina.hero.antetitulo}</div>
    <h1 class="fade-up delay-1">{pagina.hero.titulo}{pagina.hero.tituloDestacado && <> <br> <em>{pagina.hero.tituloDestacado}</em></>}</h1>
    <p class="fade-up delay-2" set:html={conNegritas(pagina.hero.texto)} />
    <div class="hero-cta fade-up delay-3">
      {pagina.hero.botones[0] && (
<a href={pagina.hero.botones[0].url} class="btn-primary"
         data-cta data-cta-intent="registro" data-cta-location="hero" data-cta-label="Registrarse gratis">{pagina.hero.botones[0].texto}</a>
)}
    </div>
    <Ilustracion escena="trazabilidad" />
  </section>

  <div class="divider"></div>

  <!-- CÓMO FUNCIONA — bloque dominante -->
  <section class="section">
    <div class="section-inner">
      <div class="fade-up">
        <div class="eyebrow">Cómo funciona en REELEVO</div>
        <h2 class="section-title">Del pedido a la entrega — con historial completo de cada pieza</h2>
        <p class="section-sub">Cada obra es un contenedor trazable. Sabes qué se planificó, qué se produjo, quién lo hizo y cuándo — pieza a pieza.</p>
      </div>

      <div class="kaizen-flow fade-up delay-1">
        <div class="flow-step">
          <div class="flow-num">1</div>
          <div class="flow-content">
            <h3>Creas la obra y defines lo que hay que producir</h3>
            <p>Abres el proyecto, le asocias los productos a fabricar y las unidades planificadas de cada uno. Desde ese momento toda la producción queda colgando de esa obra.</p>
          </div>
        </div>

        <div class="flow-arrow">↓</div>

        <div class="flow-step">
          <div class="flow-num">2</div>
          <div class="flow-content">
            <h3>Los operarios producen vinculados a la obra</h3>
            <p>El operario escanea el QR de su puesto, elige la obra activa y sigue el proceso SOP correspondiente. Cada ejecución se registra sola con su operario, su máquina, su turno y su hora.</p>
          </div>
        </div>

        <div class="flow-arrow">↓</div>

        <div class="flow-step">
          <div class="flow-num">3</div>
          <div class="flow-content">
            <h3>Se genera un QR individual por pieza terminada</h3>
            <p>Al dar una pieza por terminada, REELEVO crea el código QR de esa unidad concreta. El operario imprime la etiqueta y la pega en la pieza física antes de almacenarla o enviarla: la trazabilidad viaja con ella.</p>
          </div>
        </div>

        <div class="flow-arrow">↓</div>

        <div class="flow-step">
          <div class="flow-num">4</div>
          <div class="flow-content">
            <h3>Ese QR es la trazabilidad de la pieza para siempre</h3>
            <p>Quien lo escanee —en planta, en almacén o en casa del cliente— accede al historial completo: quién la hizo, cuándo, con qué proceso, en qué máquina, en qué turno y dentro de qué obra. No caduca ni depende de que alguien recuerde nada, y se exporta tal cual para una auditoría o para responder a una reclamación.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <div class="divider"></div>

  <!-- QUÉ INCLUYE -->
  <section class="section">
    <div class="section-inner">
      <div class="fade-up">
        <div class="eyebrow">Qué incluye</div>
        <h2 class="section-title">Gestión de obras y trazabilidad por pieza</h2>
      </div>

      <div class="solution-grid fade-up delay-1">
        <div class="solution-cell">
          <h3>Gestión de obras y proyectos</h3>
          <p>Proyectos con productos y unidades planificadas, y cuáles van activas, completadas o en riesgo de plazo.</p>
        </div>

        <div class="solution-cell">
          <h3>Avance en tiempo real</h3>
          <p>Cuántas unidades llevas frente a las planificadas, sin preguntar ni esperar al cierre de semana.</p>
        </div>

        <div class="solution-cell">
          <h3>Ficha trazable por pieza</h3>
          <p>QR único por unidad, etiqueta imprimible e historial cronológico de la obra.</p>
        </div>
      </div>

      <p class="roles-line fade-up delay-2">Para talleres de mecanizado, calderería y carpintería metálica, contratas de montaje y donde <strong>ISO 9001</strong> exige evidencia de quién hizo qué. Ver <a href="/sectores/mecanizado-cnc/">mecanizado CNC</a> o <a href="/calidad-y-conformidad/">calidad y conformidad</a>.</p>
    </div>
  </section>

  <div class="divider"></div>

  <!-- PRUEBA -->
  <section class="section">
    <div class="section-inner">
      <div class="fade-up">
        <div class="eyebrow">Cuando el cliente reclama</div>
        <h2 class="section-title">De la reclamación a la causa raíz, sin investigar</h2>
      </div>

      <ol class="timeline fade-up delay-1">
        <li><strong>La llamada</strong> — Taller CNC, 200 piezas semanales para 4 clientes. Uno avisa: una pieza viene fuera de tolerancia.</li>
        <li><strong>10 segundos</strong> — Se escanea su QR: unidad nº 174 de la obra, con operario, máquina, turno y proceso.</li>
        <li><strong>2 minutos</strong> — El historial del SOP muestra un cambio de herramienta sin registrar ese día. Ahí está la causa raíz.</li>
        <li><strong>La respuesta</strong> — Informe con datos reales y plan de acción, en la misma llamada en vez de en dos días.</li>
      </ol>

      <p class="timeline-note fade-up delay-2">Escenario ilustrativo del recorrido de una reclamación dentro de la herramienta, no un caso medido en un cliente.</p>
    </div>
  </section>

  <div class="divider"></div>

  <FaqSection items={faqs} />

  <div class="divider"></div>

  <!-- SIGUIENTE PASO -->
  <section class="cta-section">
    <div class="cta-eyebrow fade-up">{pagina.ctaFinal.antetitulo}</div>
    <h3 class="cta-title fade-up delay-1">{pagina.ctaFinal.titulo}{pagina.ctaFinal.tituloDestacado && <> <br> <em>{pagina.ctaFinal.tituloDestacado}</em></>}</h3>
    <p class="cta-sub fade-up delay-2" set:html={conNegritas(pagina.ctaFinal.texto)} />
    <div class="cta-actions fade-up delay-3">
      {pagina.ctaFinal.botones[0] && (
<a href={pagina.ctaFinal.botones[0].url} class="btn-primary"
         data-cta data-cta-intent="registro" data-cta-location="footer" data-cta-label="Registrarme en REELEVO">{pagina.ctaFinal.botones[0].texto}</a>
)}
      {pagina.ctaFinal.botones[1] && (
<a href={pagina.ctaFinal.botones[1].url} class="btn-ghost">{pagina.ctaFinal.botones[1].texto}</a>
)}
    </div>
    <div class="cta-trust fade-up delay-4">{pagina.ctaFinal.nota}</div>
  </section>

</BaseLayout>

<style>
  /* FLUJO — bloque dominante */
  .kaizen-flow {
    display: flex;
    flex-direction: column;
    gap: 0;
    margin-top: 48px;
    max-width: 720px;
  }

  .flow-step {
    display: flex;
    gap: 24px;
    align-items: flex-start;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 28px;
  }

  .flow-num {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    min-width: 44px;
    background: var(--orange);
    color: var(--steel, #141618);
    border-radius: 50%;
    font-family: 'Oswald', sans-serif;
    font-size: 1.2rem;
    font-weight: 600;
  }

  .flow-content h3 {
    font-family: 'Oswald', sans-serif;
    font-size: 1.05rem;
    margin-bottom: 8px;
    color: var(--white);
  }

  .flow-content p {
    color: var(--gray);
    font-size: .95rem;
    line-height: 1.65;
    margin: 0;
  }

  .flow-arrow {
    text-align: center;
    font-size: 1.6rem;
    color: var(--orange-ink);
    padding: 6px 0;
    margin-left: 22px;
  }

  /* QUE INCLUYE */
  .solution-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    margin-top: 40px;
  }

  @media (max-width: 860px) {
    .solution-grid { grid-template-columns: 1fr; }
  }

  .solution-cell {
    background: var(--surface);
    border: 1px solid var(--border);
    border-top: 2px solid var(--orange);
    border-radius: 6px;
    padding: 24px;
  }

  .solution-cell h3 {
    font-family: 'Oswald', sans-serif;
    font-size: 1rem;
    margin-bottom: 10px;
    color: var(--white);
  }

  .solution-cell p {
    font-size: .95rem;
    color: var(--gray);
    line-height: 1.65;
    margin: 0;
  }

  /* Sustituye a la seccion "Para quien es esto" (4 tarjetas de perfil,
     165 palabras). Conserva los sectores y el enlazado interno. */
  .roles-line {
    margin-top: 28px;
    font-size: .95rem;
    color: var(--gray);
    max-width: 68ch;
  }

  .roles-line strong {
    color: var(--white);
    font-weight: 500;
  }

  .roles-line a {
    color: var(--orange-ink);
    text-decoration: none;
    border-bottom: 1px solid rgba(244, 82, 30, .35);
  }

  .roles-line a:hover {
    border-bottom-color: var(--orange);
  }

  /* PRUEBA — sustituye al bloque "Caso real" de 201 palabras */
  .timeline {
    margin: 40px 0 0;
    padding: 0;
    list-style: none;
    max-width: 720px;
    border-left: 2px solid var(--border);
  }

  .timeline li {
    position: relative;
    padding: 0 0 20px 26px;
    font-size: .95rem;
    line-height: 1.65;
    color: var(--gray);
  }

  .timeline li:last-child {
    padding-bottom: 0;
  }

  .timeline li::before {
    content: '';
    position: absolute;
    left: -5px;
    top: .6em;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--orange);
  }

  .timeline li strong {
    color: var(--white);
    font-weight: 500;
  }

  .timeline-note {
    margin-top: 24px;
    font-size: .82rem;
    color: var(--gray2);
    max-width: 720px;
  }

  .cta-trust {
    margin-top: 16px;
    font-size: 0.82rem;
    color: rgba(20,22,24, 0.45);
    letter-spacing: .04em;
  }
</style>
