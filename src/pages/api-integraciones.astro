---
import BaseLayout from '../layouts/BaseLayout.astro';
import FaqSection from '../components/FaqSection.astro';
import { softwareApplicationSchema, faqPageSchema, type FaqItem } from '../lib/seo';
import Ilustracion from '../components/Ilustracion.astro';
import { getPagina, conNegritas, sinMarcas } from '../lib/contenido';

// Textos editables desde Sanity (Páginas de funcionalidad). Respaldo: src/data/paginas/api-integraciones.json.
const pagina = await getPagina('api-integraciones');

const title = pagina.seo.title;
const description = pagina.seo.description;
const canonical = "https://www.gmvsolutions.es/api-integraciones/";

// Una sola lista alimenta el bloque visible y el FAQPage del head (auditoria P6).
//
// La quinta pregunta recoge la tabla "Disponibilidad por plan" que era una
// seccion propia; el detalle vive en /precios/, que es su sitio (tarea C1 de
// PLAN_SIMPLIFICACION_EDITORIAL_WEB_2026-08.md).
const faqs: FaqItem[] = pagina.faq.items.map(({ q, a }) => ({ q, a: sinMarcas(a) }));

const pageSchema = softwareApplicationSchema();

const schema = [pageSchema, faqPageSchema(faqs)];
---

<BaseLayout title={title} description={description} canonical={canonical} schema={schema} activeNav="" pageType="capacidad">

  <!-- HERO + PROBLEMA -->
  <section class="page-hero">
    <div class="eyebrow fade-up">{pagina.hero.antetitulo}</div>
    <h1 class="fade-up delay-1">{pagina.hero.titulo}{pagina.hero.tituloDestacado && <> <br> <em>{pagina.hero.tituloDestacado}</em></>}</h1>
    <p class="fade-up delay-2" set:html={conNegritas(pagina.hero.texto)} />
    <div class="hero-cta fade-up delay-3">
      {pagina.hero.botones[0] && (
<a href={pagina.hero.botones[0].url} class="btn-primary"
         data-cta data-cta-intent="registro" data-cta-location="hero" data-cta-label="Registrarse gratis">{pagina.hero.botones[0].texto}</a>
)}
    </div>
    <Ilustracion escena="api-integraciones" />
  </section>

  <div class="divider"></div>

  <!-- TRES CAPAS — bloque dominante -->
  <section class="section">
    <div class="section-inner">
      <div class="fade-up">
        <div class="eyebrow">Tres capas de integración</div>
        <h2 class="section-title">Desde el aviso automático hasta el dashboard en Power BI</h2>
        <p class="section-sub">Elige el nivel que necesitas: recibir un aviso cuando pasa algo, leer y escribir por API, o explotar los datos en la herramienta de BI que ya usa la dirección.</p>
      </div>

      <div class="integration-layers fade-up delay-1">
        <div class="layer-card layer-1">
          <div class="layer-badge">Capa 1</div>
          <h3>Webhooks — 21 eventos de planta</h3>
          <p>REELEVO avisa a tus sistemas cuando ocurre algo relevante. Tú no consultas nada: el aviso llega solo, y puede acabar publicado en un canal de Teams sin que nadie tenga que revisar el sistema.</p>
          <div class="layer-events">
            <div class="event-tag">Proceso completado</div>
            <div class="event-tag">Riesgo de cobertura de turno</div>
            <div class="event-tag">Competencia degradada</div>
            <div class="event-tag">Incidencia de calidad detectada</div>
            <div class="event-tag">Certificación por caducar</div>
            <div class="event-tag">Pieza generada</div>
          </div>
          <p class="layer-detail">Entrega cada 5 minutos, con reintento automático si tu sistema no responde y registro de todas las entregas. Cada payload va firmado con HMAC-SHA256 para que puedas verificar la autenticidad.</p>
        </div>

        <div class="layer-card layer-2">
          <div class="layer-badge">Capa 2</div>
          <h3>API REST — lectura y escritura programática</h3>
          <p>Acceso completo a los datos de REELEVO desde cualquier sistema externo, con contrato OpenAPI documentado. Es la vía para sincronizar órdenes de fabricación con el ERP y evitar la doble entrada de datos.</p>
          <div class="api-endpoints">
            <div class="endpoint-group">
              <div class="endpoint-label">Lectura</div>
              <div class="endpoint-list">procesos · operarios · completions · skill matrix · certificaciones · producción · Kaizen · reportes</div>
            </div>
            <div class="endpoint-group">
              <div class="endpoint-label">Escritura</div>
              <div class="endpoint-list">sesiones QR · registros de producción · propuestas Kaizen · actualizaciones de competencias</div>
            </div>
          </div>
          <p class="layer-detail">Autenticación por API key con permisos de lectura y escritura configurables por clave. Analytics de uso incluidos en el panel.</p>
        </div>

        <div class="layer-card layer-3">
          <div class="layer-badge">Capa 3</div>
          <h3>Microsoft 365 — kit de integración nativo</h3>
          <p>Para quien ya vive en el ecosistema Microsoft, sin desarrollo a medida: <strong>Power BI</strong> con queries listas y cuatro vistas preconfiguradas —operaciones, calidad, formación y Skill Matrix— con medidas DAX; <strong>Power Automate</strong> con conector importable y plantillas de alertas y reportes de calidad; <strong>Teams</strong> para publicar los avisos donde ya está el equipo.</p>
          <p class="layer-detail">Es la capa que más se usa: el dashboard de producción se actualiza solo.</p>
        </div>
      </div>
    </div>
  </section>

  <div class="divider"></div>

  <!-- CONECTORES -->
  <!-- Verificado en reelevo-app: app/empresa/configuracion/integraciones/
       contiene factorial, holded, machinemetrics, microsoft-365, mtconnect y
       whatsapp. SAP se configura por sus propias rutas
       (app/api/empresa/integraciones/sap-hr y sap-production) con crons
       sap-hr-sync (diario) y sap-production-sync. -->
  <section class="section">
    <div class="section-inner">
      <div class="fade-up">
        <div class="eyebrow">Conectores</div>
        <h2 class="section-title">Con qué se conecta, sin escribir código</h2>
      </div>

      <div class="connectors-grid fade-up delay-1">
        <div class="conn-group">
          <div class="conn-group-title">ERP y producción</div>
          <div class="conn-item">
            <div class="conn-name">SAP HR</div>
            <div class="conn-desc">Sincronización diaria de empleados</div>
          </div>
          <div class="conn-item">
            <div class="conn-name">SAP Production</div>
            <div class="conn-desc">Órdenes de fabricación sincronizadas</div>
          </div>
          <div class="conn-item">
            <div class="conn-name">Holded</div>
            <div class="conn-desc">Productos y órdenes bajo demanda</div>
          </div>
        </div>

        <div class="conn-group">
          <div class="conn-group-title">RRHH</div>
          <div class="conn-item">
            <div class="conn-name">Factorial</div>
            <div class="conn-desc">Personal sincronizado, sin dar de alta a nadie dos veces</div>
          </div>
        </div>

        <div class="conn-group">
          <div class="conn-group-title">IoT industrial</div>
          <div class="conn-item">
            <div class="conn-name">MachineMetrics</div>
            <div class="conn-desc">Telemetría de máquina por webhook entrante</div>
          </div>
          <div class="conn-item">
            <div class="conn-name">MTConnect</div>
            <div class="conn-desc">Estándar de telemetría para máquina conectada</div>
          </div>
        </div>

        <div class="conn-group">
          <div class="conn-group-title">Ofimática y mensajería</div>
          <div class="conn-item">
            <div class="conn-name">Microsoft 365</div>
            <div class="conn-desc">SSO, Power BI, Power Automate y entregas a Teams</div>
          </div>
          <div class="conn-item">
            <div class="conn-name">WhatsApp</div>
            <div class="conn-desc">Avisos a operarios y responsables donde ya leen</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <div class="divider"></div>

  <!-- LÍMITE -->
  <section class="section">
    <div class="section-inner">
      <div class="fade-up">
        <div class="eyebrow">Transparencia técnica</div>
        <h2 class="section-title">Casi nadie necesita integrar el primer día</h2>
      </div>

      <div class="honest-note fade-up delay-1">
        <p>Las integraciones rinden cuando ya hay uso consolidado en planta: primero digitalizas la operación, luego conectas. Si aún no tienes Power BI ni un ERP activo, el panel de REELEVO ya te da la visibilidad que necesitas. Y cada conector exige que la configuración de tu lado esté completa —credenciales, permisos y, en IoT, que la máquina publique de verdad—: confírmalo antes de darlo por hecho.</p>
      </div>

      <p class="roles-line fade-up delay-2">Siguiente paso natural: <a href="/integracion-m365/">kit de Microsoft 365</a> · <a href="/precios/">qué incluye cada plan</a>.</p>
    </div>
  </section>

  <div class="divider"></div>

  <FaqSection items={faqs} />

  <div class="divider"></div>

  <!-- SIGUIENTE PASO -->
  <section class="cta-section">
    <div class="cta-eyebrow fade-up">{pagina.ctaFinal.antetitulo}</div>
    <h3 class="cta-title fade-up delay-1">{pagina.ctaFinal.titulo}{pagina.ctaFinal.tituloDestacado && <> <br> <em>{pagina.ctaFinal.tituloDestacado}</em></>}</h3>
    <p class="cta-sub fade-up delay-2" set:html={conNegritas(pagina.ctaFinal.texto)} />
    <div class="cta-actions fade-up delay-3">
      {pagina.ctaFinal.botones[0] && (
<a href={pagina.ctaFinal.botones[0].url} class="btn-primary"
         data-cta data-cta-intent="registro" data-cta-location="footer" data-cta-label="Registrarme en REELEVO">{pagina.ctaFinal.botones[0].texto}</a>
)}
      {pagina.ctaFinal.botones[1] && (
<a href={pagina.ctaFinal.botones[1].url} class="btn-ghost">{pagina.ctaFinal.botones[1].texto}</a>
)}
    </div>
    <div class="cta-trust fade-up delay-4">{pagina.ctaFinal.nota}</div>
  </section>

</BaseLayout>

<style>
  /* CAPAS DE INTEGRACION — bloque dominante */
  .integration-layers {
    display: flex;
    flex-direction: column;
    gap: 24px;
    margin-top: 48px;
  }

  .layer-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 32px;
  }

  .layer-card.layer-3 {
    border-color: rgba(255, 100, 0, 0.35);
  }

  .layer-badge {
    display: inline-block;
    font-family: 'Oswald', sans-serif;
    font-size: 0.75rem;
    letter-spacing: .08em;
    text-transform: uppercase;
    color: var(--orange-ink);
    background: rgba(255, 100, 0, 0.1);
    padding: 4px 10px;
    border-radius: 3px;
    margin-bottom: 14px;
  }

  .layer-card h3 {
    font-family: 'Oswald', sans-serif;
    font-size: 1.2rem;
    margin-bottom: 10px;
    color: var(--white);
  }

  .layer-card > p {
    color: var(--gray);
    font-size: .95rem;
    line-height: 1.65;
    margin: 0 0 16px;
  }

  .layer-card > p strong {
    color: var(--white);
    font-weight: 500;
  }

  .layer-events {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 16px;
  }

  .event-tag {
    font-size: 0.8rem;
    padding: 4px 10px;
    background: rgba(20,22,24, 0.06);
    border: 1px solid var(--border);
    border-radius: 3px;
    color: var(--gray);
  }

  .layer-detail {
    color: var(--gray) !important;
    font-size: .88rem !important;
    line-height: 1.6 !important;
    margin: 0 !important;
    border-top: 1px solid var(--border);
    padding-top: 16px;
    margin-top: 4px !important;
  }

  .api-endpoints {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-bottom: 16px;
  }

  .endpoint-group {
    display: flex;
    gap: 12px;
    align-items: flex-start;
  }

  .endpoint-label {
    font-family: 'Oswald', sans-serif;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: .06em;
    color: var(--orange-ink);
    min-width: 60px;
    margin-top: 2px;
  }

  .endpoint-list {
    color: var(--gray);
    font-size: 0.88rem;
    line-height: 1.5;
  }

  /* CONECTORES */
  .connectors-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 20px;
    margin-top: 40px;
    align-items: start;
  }

  .conn-group {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 22px 20px;
  }

  .conn-group-title {
    font-family: 'DM Mono', monospace;
    font-size: .7rem;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--orange-ink);
    margin-bottom: 16px;
  }

  .conn-item + .conn-item {
    margin-top: 16px;
    padding-top: 16px;
    border-top: 1px solid var(--border);
  }

  .conn-name {
    font-family: 'Oswald', sans-serif;
    font-size: .95rem;
    font-weight: 600;
    margin-bottom: 5px;
  }

  .conn-desc {
    font-size: .95rem;
    color: var(--gray);
    line-height: 1.6;
  }

  @media (max-width: 1100px) {
    .connectors-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 640px) {
    .connectors-grid { grid-template-columns: 1fr; }
  }

  /* LIMITE */
  .honest-note {
    padding: 20px 24px;
    border-left: 3px solid var(--orange);
    background: var(--surface);
    border-radius: 0 6px 6px 0;
    max-width: 760px;
    margin-top: 32px;
  }

  .honest-note p {
    color: var(--gray);
    font-size: .95rem;
    line-height: 1.65;
    margin: 0;
  }

  .roles-line {
    margin-top: 28px;
    font-size: .95rem;
    color: var(--gray);
  }

  .roles-line a {
    color: var(--orange-ink);
    text-decoration: none;
    border-bottom: 1px solid rgba(244, 82, 30, .35);
  }

  .roles-line a:hover {
    border-bottom-color: var(--orange);
  }

  .cta-trust {
    margin-top: 16px;
    font-size: 0.82rem;
    color: rgba(20,22,24, 0.45);
    letter-spacing: .04em;
  }
</style>
