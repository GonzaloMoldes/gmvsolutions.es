---
import BaseLayout from '../layouts/BaseLayout.astro';
import FaqSection from '../components/FaqSection.astro';
import { softwareApplicationSchema, faqPageSchema, type FaqItem } from '../lib/seo';

// Contenido verificado contra reelevo-app:
//   lib/oee.ts               → formulas de disponibilidad, rendimiento y calidad
//   app/api/cron/oee-snapshot → snapshot diario
//   lib/lean/waste-types.ts  → los 8 desperdicios TIMWOODS con sus etiquetas
//   lib/lean/value-stream.ts → clases VA / NNVA / NVA y %VA
//   lib/lean/takt.ts         → takt = tiempo disponible / unidades objetivo, semaforo
//   lib/tier-config.ts       → leanWaste, leanVsm y leanTakt son Pro+
// Regla: PLAN_CORRECCIONES_WEB_VS_APP_2026-08.md, tarea D1.

const title = "Software de OEE para pyme industrial | REELEVO";
const description = "Calcula el OEE de cada máquina con los datos que ya registra el operario en planta: disponibilidad, rendimiento y calidad, con snapshot diario automático.";
const canonical = "https://www.gmvsolutions.es/oee/";

const faqs: FaqItem[] = [
  {
    q: '¿Qué es el OEE y cómo se calcula?',
    a: 'El OEE (Overall Equipment Effectiveness) mide qué parte del tiempo productivo de una máquina se aprovecha de verdad. Se calcula multiplicando tres factores: disponibilidad (tiempo planificado menos paradas), rendimiento (ciclo real frente al ciclo ideal) y calidad (unidades buenas sobre unidades producidas). Un 100% significaría producir siempre, al ritmo previsto y sin ningún rechazo.',
  },
  {
    q: '¿De dónde salen los datos del OEE en REELEVO?',
    a: 'De la ejecución real en planta, no de un parte rellenado después. Cuando el operario escanea el QR y ejecuta el proceso queda registrado el tiempo, las unidades producidas, las rechazadas y las paradas con su motivo. El OEE se calcula con eso, así que no hay doble captura ni una hoja aparte que alguien tenga que mantener.',
  },
  {
    q: '¿Qué hace falta configurar para que el OEE sea fiable?',
    a: 'Tres cosas: el tiempo planificado del turno, el tiempo de ciclo ideal de cada proceso y que el operario registre los rechazos. Sin tiempo planificado no hay disponibilidad, sin ciclo ideal no hay rendimiento, y sin rechazos registrados la calidad se asume al 100%. REELEVO marca cuándo la calidad es una estimación en vez de un dato medido.',
  },
  {
    q: '¿Necesito conectar sensores a las máquinas?',
    a: 'No para empezar. El OEE se calcula con lo que registra el operario en el flujo del proceso, que es lo que permite tener OEE en máquinas antiguas sin electrónica. Si tienes máquinas conectadas, REELEVO admite telemetría por MTConnect y MachineMetrics para afinar los tiempos de parada.',
  },
  {
    q: '¿Qué es el análisis TIMWOODS?',
    a: 'Es la clasificación de los ocho desperdicios Lean: transporte, inventario, movimiento, espera, sobreproducción, sobreprocesamiento, defectos y talento desaprovechado. REELEVO reparte por esas categorías lo que aparece en planta, de forma que la conversación deja de ser "vamos mal" y pasa a ser "el 40% de lo que perdemos es espera".',
  },
];

const pageSchema = softwareApplicationSchema();
const schema = [pageSchema, faqPageSchema(faqs)];
---

<BaseLayout title={title} description={description} canonical={canonical} schema={schema} activeNav="" pageType="capacidad">

  <!-- PAGE HERO -->
  <section class="page-hero">
    <div class="eyebrow fade-up">OEE · Lean · Datos de ejecución</div>
    <h1 class="fade-up delay-1">El OEE de tu planta,<br><em>calculado solo</em></h1>
    <p class="fade-up delay-2">
      Disponibilidad, rendimiento y calidad de cada máquina, con los datos que el operario ya registra
      al ejecutar el proceso. Sin hojas de cálculo, sin partes que alguien consolida el lunes y sin
      pedirte que instales un sensor en una máquina de 1998.
    </p>
    <div class="hero-cta fade-up delay-3" style="display:flex;gap:14px;justify-content:center;flex-wrap:wrap;">
      <a href="https://app.gmvsolutions.es/registro" class="btn-primary"
         data-cta data-cta-intent="registro" data-cta-location="hero" data-cta-label="Registrarme en REELEVO">Registrarme en REELEVO</a>
      <a href="/precios/" class="btn-ghost">Ver planes</a>
    </div>
  </section>

  <div class="divider"></div>

  <!-- EL PROBLEMA -->
  <section class="section">
    <div class="section-inner">
      <div class="fade-up">
        <div class="eyebrow">El problema</div>
        <h2 class="section-title">Casi nadie tiene OEE. Quien lo tiene, no se lo cree</h2>
      </div>

      <div class="challenge-content fade-up delay-1">
        <div class="challenge-list">
          <div class="challenge-item">
            <span class="icon">❌</span>
            <span>El OEE se calcula en un Excel, con datos que alguien apunta en un papel y teclea el lunes siguiente</span>
          </div>
          <div class="challenge-item">
            <span class="icon">❌</span>
            <span>Las paradas se registran «a ojo» al final del turno, así que la disponibilidad no cuadra con lo que pasó</span>
          </div>
          <div class="challenge-item">
            <span class="icon">❌</span>
            <span>El dato llega tarde: cuando el informe está listo, el turno que lo generó ya no se puede corregir</span>
          </div>
          <div class="challenge-item">
            <span class="icon">❌</span>
            <span>Los proyectos de OEE se plantean con sensores en cada máquina, y ahí es donde se quedan parados por presupuesto</span>
          </div>
        </div>
      </div>

      <div class="risk-box fade-up delay-2">
        <h3>Un OEE que nadie se cree no sirve para decidir</h3>
        <p>Si el número sale de una reconstrucción manual, la reunión se va en discutir el dato en vez de en discutir qué hacer con él. La única forma de que el OEE se use es que salga solo del trabajo que ya se hace.</p>
      </div>
    </div>
  </section>

  <div class="divider"></div>

  <!-- CÓMO SE CALCULA -->
  <section class="section">
    <div class="section-inner">
      <div class="fade-up">
        <div class="eyebrow">Cómo se calcula</div>
        <h2 class="section-title">Tres factores, un número</h2>
        <p class="section-sub">
          REELEVO calcula el OEE por máquina y por planta, y guarda un snapshot cada día
          para que puedas ver la evolución y no solo la foto de hoy.
        </p>
      </div>

      <div class="oee-formula fade-up delay-1">
        <div class="oee-factor">
          <div class="oee-factor-label">Disponibilidad</div>
          <div class="oee-factor-calc">tiempo planificado − paradas<hr />tiempo planificado</div>
          <p class="oee-factor-desc">
            Sale de las paradas que el operario registra <strong>con su motivo</strong> durante la ejecución,
            no de una estimación al cierre del turno.
          </p>
        </div>

        <div class="oee-op">×</div>

        <div class="oee-factor">
          <div class="oee-factor-label">Rendimiento</div>
          <div class="oee-factor-calc">ciclo ideal × unidades<hr />tiempo en marcha</div>
          <p class="oee-factor-desc">
            Compara el ritmo real con el tiempo de ciclo ideal que has definido en el proceso.
            Es donde aparecen las microparadas que nadie apunta.
          </p>
        </div>

        <div class="oee-op">×</div>

        <div class="oee-factor">
          <div class="oee-factor-label">Calidad</div>
          <div class="oee-factor-calc">unidades − rechazos<hr />unidades producidas</div>
          <p class="oee-factor-desc">
            Con los rechazos que se registran en el propio proceso, junto al análisis Pareto
            para ver qué defecto concentra el problema.
          </p>
        </div>

        <div class="oee-op">=</div>

        <div class="oee-factor oee-result">
          <div class="oee-factor-label">OEE</div>
          <div class="oee-factor-value">D × R × C</div>
          <p class="oee-factor-desc">
            Por máquina, por planta y por día. Con snapshot diario automático,
            sin que nadie tenga que lanzar nada.
          </p>
        </div>
      </div>
    </div>
  </section>

  <div class="divider"></div>

  <!-- HONESTIDAD DEL DATO -->
  <section class="section">
    <div class="section-inner">
      <div class="fade-up">
        <div class="eyebrow">La letra pequeña, por delante</div>
        <h2 class="section-title">REELEVO te dice cuándo el número<br><em>es una suposición</em></h2>
        <p class="section-sub">
          Es la diferencia entre un OEE que sirve para decidir y uno que sirve para un informe.
          Estas son las condiciones reales para que cada factor sea un dato medido.
        </p>
      </div>

      <div class="honesty-grid fade-up delay-1">
        <div class="honesty-row">
          <div class="honesty-factor">Disponibilidad</div>
          <div class="honesty-need">Necesita tiempo planificado de turno configurado</div>
          <div class="honesty-else">Sin eso, no se calcula — no se inventa</div>
        </div>
        <div class="honesty-row">
          <div class="honesty-factor">Rendimiento</div>
          <div class="honesty-need">Necesita tiempo de ciclo ideal en el proceso</div>
          <div class="honesty-else">Sin eso, no se calcula — no se inventa</div>
        </div>
        <div class="honesty-row">
          <div class="honesty-factor">Calidad</div>
          <div class="honesty-need">Necesita que se registren los rechazos</div>
          <div class="honesty-else">Sin ningún rechazo, se marca como <strong>estimada</strong>, no como medida</div>
        </div>
      </div>

      <div class="honesty-note fade-up delay-2">
        La mayoría de herramientas te dan un 100% de calidad cuando en realidad nadie ha registrado un
        solo rechazo, y ese número acaba en un comité de dirección como si fuera real. REELEVO marca
        explícitamente esos casos como estimación. Preferimos que veas un dato incompleto y sepas que
        lo es, a que tomes una decisión sobre un número que no significa lo que parece.
      </div>
    </div>
  </section>

  <div class="divider"></div>

  <!-- LEAN -->
  <section class="section">
    <div class="section-inner">
      <div class="fade-up">
        <div class="eyebrow">Lean sobre datos reales</div>
        <h2 class="section-title">Del «vamos mal» al «esto es lo que nos cuesta»</h2>
        <p class="section-sub">
          El análisis Lean deja de ser un taller de dos días con post-its y pasa a alimentarse
          de lo que ocurre en cada ejecución. Disponible en el plan Pro.
        </p>
      </div>

      <div class="lean-grid fade-up delay-1">
        <article class="lean-card">
          <div class="lean-tag">TIMWOODS</div>
          <h3 class="lean-title">Los ocho desperdicios, repartidos</h3>
          <p class="lean-desc">
            Lo que se pierde en planta se clasifica en las ocho categorías Lean —transporte, inventario,
            movimiento, espera, sobreproducción, sobreprocesamiento, defectos y talento desaprovechado—
            para que la conversación sea sobre cuál pesa más, no sobre si vamos bien o mal.
          </p>
        </article>

        <article class="lean-card">
          <div class="lean-tag">VSM · %VA</div>
          <h3 class="lean-title">Cuánto de tu proceso añade valor</h3>
          <p class="lean-desc">
            Cada paso se clasifica en tres clases: <strong>valor añadido</strong> (el cliente lo paga),
            <strong>necesario sin valor</strong> (controles y traslados obligados) y <strong>sin valor</strong>
            (desperdicio eliminable). De ahí sale el %VA del proceso, que es la conversación incómoda y útil.
          </p>
        </article>

        <article class="lean-card">
          <div class="lean-tag">Takt time</div>
          <h3 class="lean-title">El ritmo que exige la demanda</h3>
          <p class="lean-desc">
            El takt es el tiempo disponible dividido entre las unidades objetivo. REELEVO lo compara con
            el ciclo real y lo señaliza: holgado, ajustado al límite, o por encima del takt — que es
            decir que no vas a llegar y que ahí está el cuello de botella.
          </p>
        </article>

        <article class="lean-card">
          <div class="lean-tag">ROI</div>
          <h3 class="lean-title">Tiempo ahorrado, medido</h3>
          <p class="lean-desc">
            Un panel de retorno con el tiempo ahorrado sobre datos de ejecución, y un resumen semanal
            por email al responsable los lunes. Solo se envía si ha habido actividad real la semana
            anterior: si no se usó, no te llega un informe vacío.
          </p>
        </article>
      </div>
    </div>
  </section>

  <div class="divider"></div>

  <!-- DISPONIBILIDAD POR PLAN -->
  <section class="section">
    <div class="section-inner">
      <div class="fade-up">
        <div class="eyebrow">Disponibilidad por plan</div>
        <h2 class="section-title">Qué necesitas para tener esto</h2>
      </div>

      <div class="oee-plans fade-up delay-1">
        <div class="oee-plan-row oee-plan-head">
          <div>Capacidad</div>
          <div>Starter</div>
          <div>Pro</div>
        </div>
        <div class="oee-plan-row">
          <div>Registro de paradas, unidades y rechazos</div>
          <div class="yes">✓</div>
          <div class="yes">✓</div>
        </div>
        <div class="oee-plan-row">
          <div>Productividad y monitoreo en vivo</div>
          <div class="yes">✓</div>
          <div class="yes">✓</div>
        </div>
        <div class="oee-plan-row">
          <div>Analítica avanzada e informes personalizados</div>
          <div class="no">—</div>
          <div class="yes">✓</div>
        </div>
        <div class="oee-plan-row">
          <div>Lean: TIMWOODS, VSM y takt time</div>
          <div class="no">—</div>
          <div class="yes">✓</div>
        </div>
        <div class="oee-plan-row">
          <div>Reportes PDF programados por email</div>
          <div class="no">—</div>
          <div class="yes">✓</div>
        </div>
      </div>
      <p class="oee-plans-note fade-up delay-2">
        <a href="/precios/">Ver planes y precios →</a>
      </p>
    </div>
  </section>

  <div class="divider"></div>

  <!-- CROSS-LINKS -->
  <section class="section section-center">
    <div class="section-inner">
      <div class="fade-up">
        <div class="eyebrow">Sigue explorando</div>
        <h2 class="section-title">De dónde salen los datos que alimentan el OEE</h2>
      </div>

      <div class="cross-grid fade-up delay-1">
        <a class="cross-card" href="/control-produccion/">
          <h3>Control de producción</h3>
          <p>El registro de unidades, paradas y tiempos que alimenta cada factor del OEE.</p>
        </a>
        <a class="cross-card" href="/documentacion-procesos/">
          <h3>Documentación de procesos</h3>
          <p>Donde se define el tiempo de ciclo ideal contra el que se mide el rendimiento.</p>
        </a>
        <a class="cross-card" href="/kaizen/">
          <h3>Kaizen y mejora continua</h3>
          <p>Lo que el análisis Lean detecta acaba siendo una mejora con impacto medido.</p>
        </a>
      </div>
    </div>
  </section>

  <div class="divider"></div>

  <FaqSection items={faqs} />

  <div class="divider"></div>

  <!-- CTA -->
  <section class="cta-section">
    <div class="cta-eyebrow fade-up">Empieza por una máquina</div>
    <h2 class="cta-title fade-up delay-1">
      No necesitas sensores.<br><em>Necesitas que quede registrado</em>
    </h2>
    <p class="cta-sub fade-up delay-2">
      Empieza por la máquina que más te tensiona, con el proceso que ya ejecutan tus operarios.
      El OEE aparece solo en cuanto hay ejecuciones registradas.
    </p>
    <div class="cta-actions fade-up delay-3">
      <a href="https://app.gmvsolutions.es/registro" class="btn-primary"
         data-cta data-cta-intent="registro" data-cta-location="footer" data-cta-label="Registrarme en REELEVO">
        Registrarme en REELEVO
      </a>
    </div>
    <div class="cta-note fade-up delay-4">Plan gratuito para empezar · Sin tarjeta</div>
  </section>

</BaseLayout>

<style>
  .challenge-content { max-width: 760px; margin-top: 40px; }

  .challenge-list {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .challenge-item {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    font-size: .9rem;
    line-height: 1.65;
    color: var(--gray);
  }

  .challenge-item .icon { flex-shrink: 0; }

  .risk-box {
    max-width: 760px;
    margin-top: 32px;
    padding: 24px 26px;
    background: rgba(255, 255, 255, .03);
    border-left: 2px solid var(--orange);
    border-radius: 0 4px 4px 0;
  }

  .risk-box h3 {
    font-family: 'Oswald', sans-serif;
    font-size: 1rem;
    font-weight: 600;
    margin-bottom: 10px;
  }

  .risk-box p {
    font-size: .88rem;
    line-height: 1.7;
    color: var(--gray);
  }

  /* FÓRMULA OEE — los tres factores en fila, con el operador entre ellos.
     En movil el operador se rota para que la lectura siga siendo vertical. */
  .oee-formula {
    display: grid;
    grid-template-columns: 1fr auto 1fr auto 1fr auto 1fr;
    align-items: stretch;
    gap: 12px;
    margin-top: 44px;
  }

  .oee-factor {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 22px 20px;
    display: flex;
    flex-direction: column;
  }

  .oee-factor.oee-result {
    border-color: var(--orange);
    background: rgba(255, 150, 0, .05);
  }

  .oee-factor-label {
    font-family: 'DM Mono', monospace;
    font-size: .62rem;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--orange);
    margin-bottom: 14px;
  }

  .oee-factor-calc {
    font-family: 'DM Mono', monospace;
    font-size: .72rem;
    line-height: 1.5;
    color: var(--white);
    text-align: center;
    margin-bottom: 14px;
  }

  .oee-factor-calc hr {
    border: none;
    border-top: 1px solid var(--orange);
    margin: 5px 0;
  }

  .oee-factor-value {
    font-family: 'Oswald', sans-serif;
    font-size: 1.5rem;
    font-weight: 700;
    text-align: center;
    margin-bottom: 14px;
    color: var(--white);
  }

  .oee-factor-desc {
    font-size: .8rem;
    line-height: 1.6;
    color: var(--gray);
    margin-top: auto;
  }

  .oee-factor-desc strong { color: var(--white); font-weight: 500; }

  .oee-op {
    display: flex;
    align-items: center;
    font-family: 'Oswald', sans-serif;
    font-size: 1.4rem;
    color: var(--orange);
  }

  /* HONESTIDAD DEL DATO */
  .honesty-grid {
    margin-top: 40px;
    border: 1px solid var(--border);
    border-radius: 8px;
    overflow: hidden;
    max-width: 900px;
  }

  .honesty-row {
    display: grid;
    grid-template-columns: 180px 1fr 1fr;
    gap: 16px;
    padding: 16px 20px;
    font-size: .86rem;
    line-height: 1.6;
    color: var(--gray);
  }

  .honesty-row + .honesty-row { border-top: 1px solid var(--border); }

  .honesty-factor {
    font-family: 'Oswald', sans-serif;
    font-weight: 600;
    color: var(--white);
  }

  .honesty-else strong { color: var(--orange); font-weight: 500; }

  .honesty-note {
    max-width: 900px;
    margin-top: 24px;
    padding: 20px 24px;
    background: rgba(255, 255, 255, .03);
    border-left: 2px solid var(--orange);
    border-radius: 0 4px 4px 0;
    font-size: .88rem;
    line-height: 1.75;
    color: var(--gray);
  }

  /* LEAN */
  .lean-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
    margin-top: 40px;
  }

  .lean-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 26px 24px;
  }

  .lean-tag {
    font-family: 'DM Mono', monospace;
    font-size: .62rem;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--orange);
    margin-bottom: 12px;
  }

  .lean-title {
    font-family: 'Oswald', sans-serif;
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: .02em;
    margin-bottom: 10px;
  }

  .lean-desc {
    font-size: .87rem;
    color: var(--gray);
    line-height: 1.7;
  }

  .lean-desc strong { color: var(--white); font-weight: 500; }

  /* PLANES */
  .oee-plans {
    margin-top: 40px;
    border: 1px solid var(--border);
    border-radius: 8px;
    overflow: hidden;
    max-width: 760px;
  }

  .oee-plan-row {
    display: grid;
    grid-template-columns: 1fr 120px 120px;
    padding: 13px 20px;
    font-size: .87rem;
    color: var(--gray);
  }

  .oee-plan-row + .oee-plan-row { border-top: 1px solid var(--border); }

  .oee-plan-head {
    font-family: 'Oswald', sans-serif;
    font-size: .8rem;
    text-transform: uppercase;
    letter-spacing: .06em;
    color: var(--white);
    background: rgba(255, 255, 255, .03);
  }

  .oee-plan-row .yes,
  .oee-plan-row .no { text-align: center; }
  .oee-plan-row .yes { color: var(--green); font-weight: 600; }
  .oee-plan-row .no { color: var(--gray2); }

  .oee-plans-note {
    max-width: 760px;
    margin-top: 16px;
    font-size: .87rem;
  }

  .oee-plans-note a {
    color: var(--orange);
    text-decoration: none;
  }

  .oee-plans-note a:hover { text-decoration: underline; }

  /* CROSS-LINKS */
  .cross-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
    margin-top: 40px;
    text-align: left;
  }

  .cross-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 24px 22px;
    text-decoration: none;
    display: block;
    transition: border-color .2s;
  }

  .cross-card:hover { border-color: var(--orange); }

  .cross-card h3 {
    font-family: 'Oswald', sans-serif;
    font-size: 1rem;
    font-weight: 600;
    margin-bottom: 10px;
    color: var(--white);
  }

  .cross-card p {
    font-size: .85rem;
    color: var(--gray);
