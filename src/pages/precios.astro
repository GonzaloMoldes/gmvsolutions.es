---
import Ilustracion from '../components/Ilustracion.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import FaqSection from '../components/FaqSection.astro';
import { faqPageSchema, type FaqItem } from '../lib/seo';
import { getPrecios, conNegritas, sinMarcas, etiquetaCta } from '../lib/contenido';

// Textos y planes editables desde Sanity (Precios). Respaldo: src/data/precios.default.json.
const precios = await getPrecios();

const title = precios.seo.title;
const description = precios.seo.description;
const canonical = "https://www.gmvsolutions.es/precios/";
const primaryCtaHref = "https://app.gmvsolutions.es/registro";
const primaryCtaLabel = "Registrarme en REELEVO";

// Una sola lista alimenta el bloque visible y el FAQPage del head (auditoria P6).
const faqs: FaqItem[] = precios.faq.items.map(({ q, a }) => ({ q, a: sinMarcas(a) }));

// Solo los planes con precio numerico van como Offer al schema.
const importe = (precio: string) => precio.replace(/[^\d,.]/g, '').replace(',', '.');
const pageSchema = {
  "@context": "https://schema.org",
  "@type": "Product",
  "name": "REELEVO",
  "description": "Software SOP industrial para reducir improvisación, ordenar incorporaciones y ganar visibilidad operativa en planta",
  "offers": precios.planes
    .filter((pl) => importe(pl.precio) !== '')
    .map((pl) => ({
      "@type": "Offer",
      "name": pl.nombre,
      "price": importe(pl.precio),
      "priceCurrency": "EUR",
      "url": pl.cta.url.startsWith('http') ? pl.cta.url : primaryCtaHref,
    })),
};

const schema = [pageSchema, faqPageSchema(faqs)];
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  schema={schema}
  activeNav="precios"
  pageType="core"
>
  <!-- PAGE HERO -->
  <section class="page-hero">
    <div class="eyebrow fade-up">{precios.hero.antetitulo}</div>
    <h1 class="fade-up delay-1">{precios.hero.titulo}{precios.hero.tituloDestacado && <> <br><em>{precios.hero.tituloDestacado}</em></>}</h1>
    <p class="fade-up delay-2" set:html={conNegritas(precios.hero.texto)} />
    <div class="hero-actions fade-up delay-3" style="justify-content:center; margin-top:24px;">
      <a href={precios.hero.ctaPrincipal.url} class="btn-primary"
         data-cta data-cta-intent="registro" data-cta-location="hero" data-cta-label={etiquetaCta(precios.hero.ctaPrincipal.texto)}>{precios.hero.ctaPrincipal.texto}</a>
      <a href={precios.hero.ctaSecundario.url} class="btn-ghost">{precios.hero.ctaSecundario.texto}</a>
    </div>
    <Ilustracion escena="precios" />
  </section>

  <div class="divider"></div>

  <!-- CAPAS DE VALOR -->
  <!-- PLANES -->
  <section class="section" id="planes">
    <div class="section-inner">
      <!-- Los limites y las features de estas cuatro tarjetas salen de
           reelevo-app/lib/tier-config.ts. Si se tocan aqui sin tocarlos alli,
           la web vuelve a prometer lo que el producto no da. Ver
           PLAN_CORRECCIONES_WEB_VS_APP_2026-08.md, Anexo I. -->
      <div class="plans-grid fade-up">
        {precios.planes.map((pl) => {
          const contacto = pl.cta.url.startsWith('mailto:');
          return (
            <div class={pl.destacado ? 'plan-card featured' : 'plan-card'}>
              {pl.destacado && pl.insignia && <div class="plan-badge">{pl.insignia}</div>}
              <div class="plan-name">{pl.nombre}</div>
              <div class="plan-scope">{pl.ambito}</div>
              <div class="plan-price">{pl.precio}{pl.sufijo && <sub>{pl.sufijo}</sub>}</div>
              <div class="plan-period">{pl.periodo}</div>
              {pl.anual && <div class="plan-annual" set:html={conNegritas(pl.anual)} />}
              <div class="plan-desc" set:html={conNegritas(pl.descripcion)} />
              <div class="plan-features">
                {pl.caracteristicas.map((c) => (
                  <div class="plan-feature">
                    {c.estado === 'no' ? <span class="cross">×</span> : c.estado === 'segun' ? <span class="roadmap">○</span> : <span class="check">✓</span>}{c.texto}{c.estado === 'segun' && c.etiqueta && <> <span class="plan-badge-roadmap">{c.etiqueta}</span></>}
                  </div>
                ))}
              </div>
              <div class="plan-cta">
                {pl.destacado
                  ? <a href={pl.cta.url} class="btn-primary"
                       data-cta data-cta-intent={contacto ? 'contacto' : 'registro'} data-cta-location="pricing" data-cta-label={contacto ? `${etiquetaCta(pl.cta.texto)} - ${pl.nombre}` : `Registrarme - ${pl.nombre}`}>{pl.cta.texto}</a>
                  : <a href={pl.cta.url} class="btn-ghost" style="width:100%;text-align:center;font-size:.82rem;padding:14px 20px;display:block;"
                       data-cta data-cta-intent={contacto ? 'contacto' : 'registro'} data-cta-location="pricing" data-cta-label={contacto ? `${etiquetaCta(pl.cta.texto)} - ${pl.nombre}` : `Registrarme - ${pl.nombre}`}>{pl.cta.texto}</a>}
                <p class="plan-note">{pl.nota}</p>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <div class="divider" style="max-width:100%;"></div>

  <!-- CALCULADORA ROI -->
  <section class="roi-section" id="roi">
    <div class="roi-inner">
      <div class="eyebrow fade-up">Calculadora de ROI</div>
      <h2 class="section-title fade-up delay-1">¿Cuánto te cuesta seguir <em>operando con improvisación</em>?</h2>
      <p class="section-sub fade-up delay-2">Una estimación sencilla para poner números a algo que casi siempre se normaliza: bajas mal cubiertas, incorporaciones lentas y tiempo de tutoría que no se ve en los informes.</p>

      <div class="roi-grid fade-up delay-3">
        <div class="roi-inputs">
          <div class="roi-field">
            <label>Número de trabajadores <span id="lbl-workers">40</span></label>
            <input type="range" min="10" max="200" step="5" value="40" id="sl-workers">
          </div>
          <div class="roi-field">
            <label>Tasa de absentismo (%) <span id="lbl-abs">7</span>%</label>
            <input type="range" min="3" max="15" step="0.5" value="7" id="sl-abs">
          </div>
          <div class="roi-field">
            <label>Coste diario por trabajador (€) <span id="lbl-daily">120</span>€</label>
            <input type="range" min="60" max="300" step="10" value="120" id="sl-daily">
          </div>
          <div class="roi-field">
            <label>Días perdidos por baja sin cubrir <span id="lbl-lost">1.5</span></label>
            <input type="range" min="0.5" max="5" step="0.5" value="1.5" id="sl-lost">
          </div>
          <div style="font-size:.78rem;color:var(--gray2);line-height:1.55;">* Días efectivos de producción reducida por baja no cubierta correctamente hasta que entra el sustituto a pleno rendimiento.</div>
        </div>

        <div class="roi-result">
          <div class="roi-result-row">
            <span class="roi-result-label">Bajas anuales estimadas</span>
            <span class="roi-result-value" id="res-absences">123</span>
          </div>
          <div class="roi-result-row">
            <span class="roi-result-label">Coste directo por baja no cubierta</span>
            <span class="roi-result-value" id="res-perbaja">180€</span>
          </div>
          <div class="roi-result-row">
            <span class="roi-result-label">Impacto total anual estimado</span>
            <span class="roi-result-value" id="res-annual">22.140€</span>
          </div>
          <div class="roi-result-row prominent">
            <span class="roi-result-label">Escenario con una reducción del 25%</span>
            <span class="roi-result-value" id="res-savings">8.856€</span>
          </div>
          <div class="roi-result-summary">
            <div class="roi-result-big">
              <span class="roi-result-big-label">Relación con el coste anual</span>
              <span class="roi-result-big-value" id="res-roi">×5.0</span>
            </div>
            <div class="roi-result-payback" id="res-payback">En ese escenario, el coste se cubriría en aprox. 2.4 meses</div>
          </div>
          <!-- La calculadora se queda, pero etiquetada como lo que es: una
               hipotesis que introduce el visitante. No es un ahorro medido en
               clientes y no puede presentarse como tal. -->
          <div class="roi-result-note">* Esto no es un ahorro medido: es una simulación con los datos que tú introduces y una hipótesis de reducción del 25% del coste directo, tomando el plan Pro anualizado como referencia. REELEVO reduce parte del impacto de las bajas —menos errores, menos tiempo de parada y menos dependencia del tutor— pero no lo elimina, y el resultado real depende de tu operación.</div>
          <div style="margin-top:20px;">
            <a href={primaryCtaHref} class="btn-primary" style="font-size:.8rem;padding:12px 24px;"
               data-cta data-cta-intent="registro" data-cta-location="body" data-cta-label="Registrarme - ROI">{primaryCtaLabel} →</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <div class="divider" style="max-width:100%;"></div>


  <!-- CTA -->
  <FaqSection items={faqs} />

  <div class="divider"></div>

  <section class="cta-section">
    <div class="cta-eyebrow fade-up">{precios.ctaFinal.antetitulo}</div>
    <h2 class="cta-title fade-up delay-1">
      {precios.ctaFinal.titulo}{precios.ctaFinal.tituloDestacado && <> <br><em>{precios.ctaFinal.tituloDestacado}</em></>}
    </h2>
    <p class="cta-sub fade-up delay-2" set:html={conNegritas(precios.ctaFinal.texto)} />
    <div class="fade-up delay-3" style="display:flex;gap:16px;justify-content:center;flex-wrap:wrap;">
      <a href={precios.ctaFinal.cta.url} class="btn-primary"
         data-cta data-cta-intent="registro" data-cta-location="footer" data-cta-label={etiquetaCta(precios.ctaFinal.cta.texto)}>
        {precios.ctaFinal.cta.texto}
      </a>
    </div>
    <div class="cta-note fade-up delay-4">
      {precios.ctaFinal.nota}
    </div>
  </section>
</BaseLayout>

<style>

  .package-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    margin-top: 48px;
  }

  .package-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 28px 24px;
    text-align: left;
  }

  .package-label {
    font-family: 'DM Mono', monospace;
    font-size: .7rem;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--orange-ink);
    margin-bottom: 12px;
  }

  .package-title {
    font-family: 'Oswald', sans-serif;
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: .03em;
    margin-bottom: 12px;
  }

  .package-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .package-list li {
    font-size: .95rem;
    color: var(--gray);
    line-height: 1.65;
    padding: 10px 0;
    border-top: 1px solid var(--border);
  }

  .package-list li:first-child {
    border-top: none;
    padding-top: 0;
  }

  /* Plans */
  .plans-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 2px;
    margin-top: 48px;
  }

  .plan-card {
    background: var(--surface);
    padding: 40px 26px;
    display: flex;
    flex-direction: column;
    position: relative;
  }

  .plan-card.featured {
    border: 2px solid var(--orange);
  }

  .plan-badge {
    position: absolute;
    top: -1px;
    left: 50%;
    transform: translateX(-50%);
    background: var(--orange);
    color: var(--white);
    font-family: 'DM Mono', monospace;
    font-size: .6rem;
    letter-spacing: .12em;
    text-transform: uppercase;
    padding: 6px 16px;
    font-weight: 500;
  }

  .plan-name {
    font-family: 'Oswald', sans-serif;
    font-size: 1.2rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: .05em;
    color: var(--orange-ink);
    margin-bottom: 8px;
  }

  .plan-scope {
    font-family: 'DM Mono', monospace;
    font-size: .7rem;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--orange-ink);
    margin-bottom: 16px;
  }

  .plan-price {
    font-family: 'Oswald', sans-serif;
    font-size: 2.5rem;
    font-weight: 700;
    line-height: 1;
    margin-bottom: 4px;
  }

  .plan-price sub {
    font-size: .6rem;
    color: var(--gray);
  }

  .plan-period {
    font-size: .8rem;
    color: var(--gray2);
    margin-bottom: 20px;
  }

  /* El anual va debajo del mensual y no en un conmutador: son dos datos, no
     dos modos, y asi el precio de referencia (el mensual) no desaparece. */
  .plan-annual {
    font-size: .78rem;
    color: var(--gray);
    margin-top: -14px;
    margin-bottom: 20px;
  }

  .plan-annual strong {
    color: var(--white);
    font-weight: 500;
  }

  .plan-desc {
    font-size: .9rem;
    color: var(--gray);
    line-height: 1.65;
    margin-bottom: 28px;
  }

  .plan-features {
    flex: 1;
    margin-bottom: 32px;
  }

  .plan-feature {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: .85rem;
    line-height: 1.5;
    margin-bottom: 8px;
  }

  .plan-feature .check {
    color: var(--green);
    font-weight: 600;
    flex-shrink: 0;
  }

  .plan-feature .cross {
    color: var(--gray2);
    flex-shrink: 0;
  }

  .plan-cta {
    text-align: center;
  }

  .plan-note {
    font-size: .75rem;
    color: var(--gray2);
    margin-top: 8px;
  }

  /* ROI Calculator */
  .roi-section {
    background: var(--surface);
    padding: 80px 32px;
    text-align: center;
  }

  .roi-inner {
    max-width: 1000px;
    margin: 0 auto;
  }

  .roi-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    margin-top: 48px;
    text-align: left;
  }

  .roi-field {
    margin-bottom: 24px;
  }

  .roi-field label {
    display: block;
    font-size: .9rem;
    margin-bottom: 8px;
    color: var(--white);
  }

  .roi-field input[type="range"] {
    width: 100%;
    height: 6px;
    background: var(--border);
    outline: none;
    border-radius: 3px;
    appearance: none;
  }

  .roi-field input[type="range"]::-webkit-slider-thumb {
    width: 20px;
    height: 20px;
    background: var(--orange);
    border-radius: 50%;
    cursor: pointer;
    appearance: none;
  }

  .roi-result {
    background: var(--surface2);
    padding: 32px;
    border-radius: 4px;
  }

  .roi-result-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 12px 0;
    border-bottom: 1px solid var(--border);
  }

  .roi-result-row.prominent {
    background: rgba(244, 82, 30, 0.06);
    margin: 8px -16px;
    padding: 16px;
    border: none;
    font-weight: 500;
  }

  .roi-result-label {
    font-size: .85rem;
    color: var(--gray);
  }

  .roi-result-value {
    font-family: 'Oswald', sans-serif;
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--white);
  }

  .roi-result-summary {
    margin-top: 20px;
    text-align: center;
  }

  .roi-result-big {
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 8px;
    margin-bottom: 12px;
  }

  .roi-result-big-label {
    font-size: .8rem;
    color: var(--gray);
  }

  .roi-result-big-value {
    font-family: 'Oswald', sans-serif;
    font-size: 2rem;
    font-weight: 700;
    color: var(--orange-ink);
  }

  .roi-result-payback {
    font-size: .85rem;
    color: var(--green);
    font-weight: 500;
  }

  /* Trial Band */
  .trial-band {
    background: var(--surface2);
    padding: 64px 32px;
    text-align: center;
  }

  .trial-title {
    font-family: 'Oswald', sans-serif;
    font-size: clamp(1.6rem, 3.5vw, 2.2rem);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .02em;
    margin-bottom: 32px;
  }

  .trial-title em {
    color: var(--orange-ink);
    font-style: normal;
  }

  .trial-bullets {
    display: flex;
    justify-content: center;
    gap: 32px;
    flex-wrap: wrap;
    margin-bottom: 36px;
  }

  .trial-bullet {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: .85rem;
    color: var(--gray);
  }

  .trial-bullet span {
    color: var(--green);
    font-weight: 600;
  }

  /* Comparison Table */
  .comp-scroll {
    overflow-x: auto;
    border: 1px solid var(--border);
    border-radius: 6px;
  }

  .comp-table {
    width: 100%;
    border-collapse: collapse;
    min-width: 560px;
  }

  .comp-table thead th {
    background: var(--surface2);
    padding: 16px 20px;
    font-family: 'Oswald', sans-serif;
    font-size: .85rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: .04em;
    text-align: center;
    border-bottom: 2px solid var(--border);
  }

  .comp-table thead th.comp-highlight {
    background: rgba(244,82,30,.12);
    color: var(--orange-ink);
    border-bottom-color: var(--orange);
  }

  .comp-table thead th.comp-feature-col {
    text-align: left;
    width: 30%;
  }

  .comp-table tbody tr {
    border-bottom: 1px solid var(--border);
  }

  .comp-table tbody tr:last-child {
    border-bottom: none;
  }

  .comp-table tbody tr:hover td {
    background: rgba(20,22,24,.02);
  }

  .comp-table tbody tr:hover td.comp-highlight {
    background: rgba(244,82,30,.10);
  }

  .comp-table td {
    padding: 14px 20px;
    font-size: .85rem;
    text-align: center;
    color: var(--gray);
    background: var(--surface);
    vertical-align: middle;
  }

  .comp-table td.comp-label {
    text-align: left;
    font-weight: 500;
    color: var(--white);
  }

  .comp-table td.comp-highlight {
    background: rgba(244,82,30,.06);
    color: var(--white);
    font-weight: 500;
  }

  .comp-table .check {
    color: var(--green);
    font-weight: 600;
    margin-right: 4px;
  }

  .comp-table .cross {
    color: var(--gray2);
    margin-right: 4px;
  }

  .plan-badge-roadmap {
    font-family: 'DM Mono', monospace;
    font-size: .7rem;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: var(--gray2);
    background: var(--surface2);
    border: 1px solid var(--border);
    padding: 2px 7px;
    border-radius: 3px;
    margin-left: 4px;
    vertical-align: middle;
  }

  .plan-feature .roadmap {
    color: var(--gray2);
    flex-shrink: 0;
  }

  .roi-result-note {
    font-size: .72rem;
    color: var(--gray2);
    line-height: 1.55;
    margin-top: 16px;
    border-top: 1px solid var(--border);
    padding-top: 12px;
  }

  /* Cuatro planes no caben legibles por debajo de ~1200px: pasan a 2x2 antes
     de caer a columna unica, para no dejar tarjetas de 180px de ancho. */
  @media (max-width: 1200px) {
    .plans-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 900px) {
    .package-grid {
      grid-template-columns: 1fr;
    }

    .roi-grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }

  @media (max-width: 700px) {
    .plans-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 600px) {
    .trial-bullets {
      flex-direction: column;
      align-items: center;
      gap: 16px;
    }
  }
</style>

<script>
  function calcRoi() {
    const workers = parseInt((document.getElementById('sl-workers') as HTMLInputElement).value);
    const abs = parseFloat((document.getElementById('sl-abs') as HTMLInputElement).value);
    const daily = parseInt((document.getElementById('sl-daily') as HTMLInputElement).value);
    const lost = parseFloat((document.getElementById('sl-lost') as HTMLInputElement).value);

    document.getElementById('lbl-workers')!.textContent = workers.toString();
    document.getElementById('lbl-abs')!.textContent = abs.toString();
    document.getElementById('lbl-daily')!.textContent = daily.toString();
    document.getElementById('lbl-lost')!.textContent = lost.toString();

    const workingDays = 220;
    const absences = Math.round(workers * (abs / 100) * workingDays / 5);
    const perBaja = Math.round(lost * daily);
    const annual = absences * perBaja;
    const reductionFactor = 0.25; // Conservative assumption for partial impact reduction
    const savings = Math.round(annual * reductionFactor);
    // Precio anual del plan Pro (1.290 €), que es la referencia que declara la
    // nota bajo la calculadora. Antes estaba en 1788 = 149 x 12, del precio
    // antiguo: el calculo llevaba tiempo saliendo con un coste inflado.
    const reelevo = 1290;
    const roi = savings > 0 ? (savings / reelevo).toFixed(1) : '—';
    const paybackMonths = savings > 0 ? (reelevo / (savings / 12)).toFixed(1) : '—';

    document.getElementById('res-absences')!.textContent = absences.toString();
    document.getElementById('res-perbaja')!.textContent = perBaja.toLocaleString('es-ES') + '€';
    document.getElementById('res-annual')!.textContent = annual.toLocaleString('es-ES') + '€';
    document.getElementById('res-savings')!.textContent = savings.toLocaleString('es-ES') + '€';
    document.getElementById('res-roi')!.textContent = '×' + roi;
    document.getElementById('res-payback')!.textContent = parseFloat(paybackMonths) < 1
      ? 'En ese escenario, el coste se cubriría en menos de 1 mes'
      : `En ese escenario, el coste se cubriría en aprox. ${paybackMonths} meses`;
  }

  document.addEventListener('DOMContentLoaded', function() {
    calcRoi();

    ['sl-workers', 'sl-abs', 'sl-daily', 'sl-lost'].forEach(id => {
      document.getElementById(id)?.addEventListener('input', calcRoi);
    });
  });
</script>

