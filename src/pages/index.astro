---
import BaseLayout from '../layouts/BaseLayout.astro';
import Screenshot from '../components/Screenshot.astro';
import Ilustracion from '../components/Ilustracion.astro';
import FaqSection from '../components/FaqSection.astro';
import { faqPageSchema } from '../lib/seo';
import { getHome, conNegritas, etiquetaCta } from '../lib/contenido';

// Textos editables desde Sanity (Página de inicio). Respaldo: src/data/home.default.json.
const home = await getHome();

const title = home.seo.title;
const description = home.seo.description;
const canonical = "https://www.gmvsolutions.es/";

// La Organization se emite globalmente desde BaseLayout (src/lib/seo.ts).
// Aqui: WebSite (propio de la home) + SoftwareApplication con oferta (S2-C1).
const schema = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "REELEVO",
    "url": "https://www.gmvsolutions.es"
  },
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "@id": "https://www.gmvsolutions.es/#software",
    "name": "REELEVO",
    "applicationCategory": "BusinessApplication",
    "applicationSubCategory": "Software de instrucciones de trabajo digitales",
    "operatingSystem": "Web, Android, iOS",
    "inLanguage": "es-ES",
    "description": description,
    "url": "https://www.gmvsolutions.es/",
    "publisher": { "@id": "https://www.gmvsolutions.es/#organization" },
    "featureList": [
      "Instrucciones de trabajo digitales en el puesto, sin cuenta de operario",
      "Instrucciones paso a paso con foto y vídeo, abiertas con un QR en la máquina",
      "Registro verificable de ejecución",
      "Monitor de actividad de turno",
      "Gestión de competencias y certificaciones",
      "Trazabilidad por pieza y lote",
      "OEE y análisis Lean sobre datos de ejecución",
      "Mantenimiento preventivo",
      "Kaizen y mejora continua",
      "API REST y webhooks",
      "Resistencia a cortes de conexión en el flujo de ejecución"
    ],
    "offers": {
      "@type": "AggregateOffer",
      "priceCurrency": "EUR",
      "lowPrice": "0",
      "highPrice": "129",
      "offerCount": "3",
      "offers": [
        {
          "@type": "Offer",
          "name": "Free",
          "price": "0",
          "priceCurrency": "EUR",
          "url": "https://app.gmvsolutions.es/registro",
          "priceSpecification": {
            "@type": "UnitPriceSpecification",
            "price": "0",
            "priceCurrency": "EUR",
            "billingIncrement": "1",
            "unitText": "MES / EMPRESA"
          }
        },
        {
          "@type": "Offer",
          "name": "Starter",
          "price": "49",
          "priceCurrency": "EUR",
          "url": "https://app.gmvsolutions.es/registro",
          "priceSpecification": {
            "@type": "UnitPriceSpecification",
            "price": "49",
            "priceCurrency": "EUR",
            "billingIncrement": "1",
            "unitText": "MES / EMPRESA"
          }
        },
        {
          "@type": "Offer",
          "name": "Pro",
          "price": "129",
          "priceCurrency": "EUR",
          "url": "https://app.gmvsolutions.es/registro",
          "priceSpecification": {
            "@type": "UnitPriceSpecification",
            "price": "129",
            "priceCurrency": "EUR",
            "billingIncrement": "1",
            "unitText": "MES / EMPRESA"
          }
        }
      ]
    },
    "potentialAction": [
      {
        "@type": "RegisterAction",
        "name": "Registrarse en REELEVO",
        "target": "https://app.gmvsolutions.es/registro"
      }
    ]
  }
];

// Pictogramas del recorrido de implantacion (estilo señalética ISO 7010).
const pictos = import.meta.glob('../assets/pictogramas/*.svg', { query: '?raw', import: 'default', eager: true }) as Record<string, string>;
const picto = (n: string) => pictos[`../assets/pictogramas/${n}.svg`];

// Cifra de §02 tal como se escribe en el panel («7,2», «40», «3–5»): cada
// numero se envuelve en .h-count para que el script de abajo lo anime.
const cifraAnimada = (valor: string) =>
  valor
    .replace(/&/g, '&amp;').replace(/</g, '&lt;')
    .replace(/\d+(?:,\d+)?/g, (m) => {
      const dec = m.includes(',') ? m.split(',')[1].length : 0;
      return `<span class="h-count" data-to="${m.replace(',', '.')}" data-dec="${dec}">${m}</span>`;
    });

// Objeciones previas al alta. Mismo texto para el bloque visible y el FAQPage.
// Solo afirmaciones que el resto del sitio ya sostiene (featureList, /modo-offline,
// /precios).
const faqs = home.faq.items.map(({ q, a }) => ({ q, a }));
schema.push(faqPageSchema(faqs));
---
<BaseLayout title={title} description={description} canonical={canonical} schema={schema} activeNav="" pageType="core">

  <!-- ═══ HERO ═══ -->
  <section class="h-hero">
    <div class="h-wrap h-hero-grid">
      <div class="h-hero-copy">
        <div class="h-ref"><span class="h-ref-tag">REF. 00</span> {home.hero.referencia}</div>
        <h1 class="h-title">{home.hero.titulo}</h1>
        <p class="h-lead" set:html={conNegritas(home.hero.entradilla)} />
        <div class="h-actions">
          <a href={home.hero.ctaPrincipal.url} class="btn-primary"
             data-cta data-cta-intent="registro" data-cta-location="hero" data-cta-label={etiquetaCta(home.hero.ctaPrincipal.texto)}>{home.hero.ctaPrincipal.texto}</a>
          <a href={home.hero.ctaSecundario.url} class="btn-ghost"
             data-cta data-cta-intent="demo" data-cta-location="hero" data-cta-label={etiquetaCta(home.hero.ctaSecundario.texto)}>{home.hero.ctaSecundario.texto}</a>
        </div>
        <p class="h-note">{home.hero.nota}</p>
      </div>
      <Ilustracion escena="hero" class="h-hero-ilus" />
    </div>

    <!-- Ficha técnica. Los 60 dias salen de TRIAL_DURATION_DAYS en
         reelevo-app/lib/billing.ts: si cambia, cambiar aqui, en el CTA final,
         en la FAQ y en /precios. -->
    <div class="h-wrap">
      <dl class="h-spec">
        {home.hero.ficha.map((d) => <div><dt>{d.etiqueta}</dt><dd>{d.valor}</dd></div>)}
      </dl>
    </div>
  </section>

  <!-- ═══ §01 EL DÍA A DÍA ═══ -->
  <section class="h-sec" id="casos">
    <div class="h-wrap">
      <div class="h-head fade-up">
        <div>
          <div class="h-kicker">{home.escenas.antetitulo}</div>
          <h2 class="h-h2">{home.escenas.titulo}</h2>
        </div>
        <p class="h-head-sub" set:html={conNegritas(home.escenas.texto)} />
      </div>
      <div class="h-inc fade-up delay-1">
        {home.escenas.tarjetas.map((t) => (
          <article class="h-inc-card">
            <div class="h-inc-top"><span>{t.codigo}</span><span>{t.momento}</span></div>
            <div class="h-inc-body">
              <div class="h-inc-tag">{t.etiqueta}</div>
              <h3>{t.titulo}</h3>
              <p>{t.texto}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ §02 DATOS ═══ -->
  <section class="h-dark">
    <div class="h-wrap">
      <div class="h-kicker h-kicker--dark">{home.datos.antetitulo}</div>
      <h2 class="h-h2">{home.datos.titulo}</h2>
      <div class="h-read fade-up">
        {home.datos.cifras.map((c) => (
          <div class="h-read-item">
            <div class="h-read-label">{c.etiqueta}</div>
            <div class="h-read-num"><Fragment set:html={cifraAnimada(c.valor)} /><span class={c.unidad.trim().length > 1 || c.unidad.startsWith(' ') ? 'h-read-unit' : undefined}>{c.unidad}</span></div>
            <div class="h-bar"><i style={`--w:${c.barra ?? 0}%`}></i></div>
            <p>{c.texto}</p>
          </div>
        ))}
      </div>
      <p class="h-source">{home.datos.fuente}</p>
    </div>
  </section>

  <!-- ═══ §03 RECORRIDO DE IMPLANTACIÓN ═══ -->
  <section class="h-sec" id="producto">
    <div class="h-wrap">
      <div class="h-head fade-up">
        <div>
          <div class="h-kicker">{home.recorrido.antetitulo}</div>
          <h2 class="h-h2">{home.recorrido.titulo}</h2>
        </div>
        <p class="h-head-sub" set:html={conNegritas(home.recorrido.texto)} />
      </div>

      <div class="h-phases" aria-hidden="true">
        <span class="h-ph h-ph--2">Fase A · Arranque</span>
        <span class="h-ph h-ph--2">Fase B · Primer puesto</span>
        <span class="h-ph">Fase C · Operación</span>
        <span class="h-ph h-ph--last">Fase D · Escala</span>
      </div>
      <div class="h-lane" aria-hidden="true"><i></i><b></b></div>

      <ol class="h-route fade-up delay-1">
        {home.recorrido.pasos.map((st, i) => {
          const n = String(i + 1).padStart(2, '0');
          const svg = picto(`e${n}`);
          return (
            <li class={i === home.recorrido.pasos.length - 1 ? 'h-st h-st--last' : 'h-st'}>
              <span class="h-st-plate">E-{n}</span>
              {svg && <Fragment set:html={svg} />}
              <span class="h-st-role">{st.rol}</span>
              <h3>{st.titulo}</h3>
              <p>{st.texto}</p>
              {st.enlace?.url && <a href={st.enlace.url} class="h-st-link">→ {st.enlace.texto}</a>}
            </li>
          );
        })}
      </ol>

      <figure class="h-shot fade-up">
        <figcaption class="h-shot-bar"><span>{home.recorrido.captura}</span><span>Captura real del producto</span></figcaption>
        <Screenshot name="monitor-actividad" alt="Monitor de operarios de REELEVO con el estado en tiempo real de cada máquina y operario" layout="full" />
      </figure>
    </div>
  </section>

  <!-- ═══ §04 PARA QUIÉN ═══ -->
  <section class="h-sec h-sec--line">
    <div class="h-wrap">
      <div class="h-kicker">{home.roles.antetitulo}</div>
      <h2 class="h-h2">{home.roles.titulo}</h2>
      <div class="h-roles">
        {home.roles.items.map((r, i) => (
          <a href={r.url} class="h-role">
            <span class="h-role-n">Rol / {String(i + 1).padStart(2, '0')}</span>
            <span class="h-role-t">{r.titulo}</span>
            <span class="h-role-d">{r.texto}</span>
            <span class="h-role-go">Ver →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <FaqSection items={faqs} heading={home.faq.titulo} eyebrow={home.faq.antetitulo} />

  <!-- ═══ CTA FINAL ═══ -->
  <section class="h-cta">
    <div class="h-tape" aria-hidden="true"></div>
    <div class="h-wrap h-cta-inner">
      <div class="h-kicker h-kicker--dark">{home.ctaFinal.antetitulo}</div>
      <h2 class="h-cta-title">{home.ctaFinal.titulo}</h2>
      <p class="h-cta-sub" set:html={conNegritas(home.ctaFinal.texto)} />
      <div class="h-actions">
        <a href={home.ctaFinal.ctaPrincipal.url} class="btn-primary"
           data-cta data-cta-intent="registro" data-cta-location="footer" data-cta-label={etiquetaCta(home.ctaFinal.ctaPrincipal.texto)}>{home.ctaFinal.ctaPrincipal.texto}</a>
        <a href={home.ctaFinal.ctaSecundario.url} class="btn-ghost h-ghost-dark"
           data-cta data-cta-intent="contenido" data-cta-location="footer" data-cta-label={etiquetaCta(home.ctaFinal.ctaSecundario.texto)}>{home.ctaFinal.ctaSecundario.texto}</a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // Cifras de la banda de datos: cuentan desde 0 cuando el bloque entra en
  // pantalla. El HTML ya trae el valor final, asi que sin JS, con "reducir
  // movimiento" o para un buscador se lee el dato correcto.
  const nums = document.querySelectorAll<HTMLElement>('.h-count');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (nums.length && !reduce && 'IntersectionObserver' in window) {
    const fmt = (v: number, dec: number) => v.toFixed(dec).replace('.', ',');
    const run = (el: HTMLElement) => {
      const to = parseFloat(el.dataset.to || '0');
      const dec = parseInt(el.dataset.dec || '0', 10);
      const t0 = performance.now();
      const dur = 1400;
      const tick = (t: number) => {
        const k = Math.min(1, (t - t0) / dur);
        el.textContent = fmt(to * (1 - Math.pow(1 - k, 3)), dec);
        if (k < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    };
    nums.forEach((el) => (el.textContent = fmt(0, parseInt(el.dataset.dec || '0', 10))));
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        e.target.querySelectorAll<HTMLElement>('.h-count').forEach(run);
        io.unobserve(e.target);
      }
    }, { rootMargin: '0px 0px -12% 0px', threshold: 0.05 });
    document.querySelectorAll('.h-read').forEach((el) => io.observe(el));
  }
</script>

<script>
  // Parallax del hero: guarda la posicion del raton normalizada en --mx/--my.
  // Solo escritorio con raton, sin «reducir movimiento», y solo mientras el
  // hero esta en pantalla; un requestAnimationFrame por movimiento como maximo.
  const hero = document.querySelector('.h-hero');
  const fino = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
  const quieto = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (hero && fino && !quieto) {
    const root = document.documentElement;
    let visible = true;
    let frame = 0;
    let mx = 0;
    let my = 0;
    new IntersectionObserver(([e]) => {
      visible = e.isIntersecting;
      if (!visible) { root.style.setProperty('--mx', '0'); root.style.setProperty('--my', '0'); }
    }).observe(hero);
    window.addEventListener('pointermove', (ev) => {
      if (!visible) return;
      mx = (ev.clientX / window.innerWidth) * 2 - 1;
      my = (ev.clientY / window.innerHeight) * 2 - 1;
      if (frame) return;
      frame = requestAnimationFrame(() => {
        frame = 0;
        root.style.setProperty('--mx', mx.toFixed(3));
        root.style.setProperty('--my', my.toFixed(3));
      });
    }, { passive: true });
  }
</script>

<style>
  .h-wrap { max-width: 1280px; margin: 0 auto; padding: 0 32px; }
  .h-kicker { font-family: 'DM Mono', monospace; font-size: .78rem; letter-spacing: .06em; text-transform: uppercase; color: var(--orange-ink); margin-bottom: 14px; }
  .h-kicker--dark { color: var(--orange); }
  .h-h2 { font-family: 'Oswald', sans-serif; font-weight: 700; text-transform: uppercase; font-size: clamp(2rem, 4vw, 3.4rem); line-height: .98; margin: 0; }

  /* HERO */
  .h-hero { padding: 120px 0 0; border-bottom: 1px solid var(--border); }
  .h-hero-grid { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: 48px; align-items: center; padding-bottom: 56px; }
  .h-hero-copy { display: flex; flex-direction: column; gap: 26px; }
  .h-ref { font-family: 'DM Mono', monospace; font-size: .78rem; letter-spacing: .06em; text-transform: uppercase; color: var(--gray2); display: flex; gap: 12px; align-items: center; flex-wrap: wrap; }
  .h-ref-tag { border: 1px solid var(--steel); color: var(--steel); padding: 3px 8px; }
  .h-title { font-family: 'Oswald', sans-serif; font-weight: 700; text-transform: uppercase; font-size: clamp(2.6rem, 5vw, 4.3rem); line-height: .94; letter-spacing: -.005em; margin: 0; }
  .h-lead { font-size: 1.2rem; line-height: 1.55; color: var(--gray); max-width: 520px; margin: 0; }
  .h-actions { display: flex; gap: 12px; flex-wrap: wrap; }
  .h-note { font-family: 'DM Mono', monospace; font-size: .78rem; color: var(--gray2); margin: 0; }
  .h-spec { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); margin: 0; border-top: 1px solid var(--steel); border-left: 1px solid var(--border); background: var(--paper); }
  .h-spec > div { padding: 20px 24px; border-right: 1px solid var(--border); border-bottom: 1px solid var(--border); }
  .h-spec dt { font-family: 'DM Mono', monospace; font-size: .7rem; letter-spacing: .06em; text-transform: uppercase; color: var(--gray2); }
  .h-spec dd { margin: 6px 0 0; font-weight: 700; font-size: 1.05rem; }

  /* Parallax del hero (solo raton y con movimiento permitido). El script de
     abajo escribe --mx/--my (-1..1) en <html>; cada capa se desplaza con su
     propia profundidad. Se usa la propiedad «translate» y no «transform» para
     no pisar las animaciones de los globos y de la respiracion. */
  @media (prefers-reduced-motion: no-preference) and (hover: hover) and (pointer: fine) {
    .h-hero :global(.h-hero-ilus svg) { translate: calc(var(--mx, 0) * -10px) calc(var(--my, 0) * -6px); transition: translate .5s cubic-bezier(.22, 1, .36, 1); }
    .h-hero :global(.h-hero-ilus .ilus-breathe) { translate: calc(var(--mx, 0) * 5px) calc(var(--my, 0) * 3px); transition: translate .5s cubic-bezier(.22, 1, .36, 1); }
    .h-hero :global(.h-hero-ilus .ilus-bubble) { translate: calc(var(--mx, 0) * 14px) calc(var(--my, 0) * 9px); transition: translate .6s cubic-bezier(.22, 1, .36, 1); }
  }

  /* SECCIONES */
  .h-sec { padding: 104px 0; }
  .h-sec--line { border-top: 1px solid var(--border); }
  .h-head { display: flex; justify-content: space-between; align-items: end; gap: 40px; margin-bottom: 48px; flex-wrap: wrap; }
  .h-head > div { max-width: 720px; }
  .h-head-sub { max-width: 420px; margin: 0; font-size: 1rem; line-height: 1.6; color: var(--gray); }

  /* INCIDENCIAS */
  .h-inc { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; }
  .h-inc-card { background: var(--paper); border: 1px solid var(--border); border-top: 4px solid var(--steel); transition: transform .25s, border-color .25s, box-shadow .25s; }
  .h-inc-card:hover { transform: translateY(-4px); border-top-color: var(--orange); box-shadow: 0 18px 30px -22px rgba(20,22,24,.45); }
  .h-inc-top { display: flex; justify-content: space-between; padding: 12px 18px; border-bottom: 1px dashed var(--border); font-family: 'DM Mono', monospace; font-size: .75rem; color: var(--gray2); }
  .h-inc-body { padding: 20px 18px 24px; display: flex; flex-direction: column; gap: 10px; }
  .h-inc-tag { font-family: 'DM Mono', monospace; font-size: .72rem; font-weight: 600; text-transform: uppercase; color: var(--orange-ink); }
  .h-inc-body h3 { font-size: 1.3rem; line-height: 1.2; font-weight: 700; margin: 0; }
  .h-inc-body p { font-size: .95rem; line-height: 1.6; color: var(--gray); margin: 0; }

  /* BANDA OSCURA DE DATOS */
  .h-dark { background: var(--steel); color: #ECEAE5; padding: 104px 0; }
  .h-dark .h-h2 { color: #ECEAE5; margin-bottom: 40px; }
  .h-read { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-top: 1px solid #3A3E44; }
  .h-read-item { padding: 32px; border-right: 1px solid #3A3E44; display: flex; flex-direction: column; gap: 14px; }
  .h-read-item:first-child { padding-left: 0; }
  .h-read-item:last-child { border-right: 0; }
  .h-read-label { font-family: 'DM Mono', monospace; font-size: .75rem; text-transform: uppercase; color: #9A978F; }
  .h-read-num { font-family: 'DM Mono', monospace; font-weight: 500; font-size: clamp(3.4rem, 6vw, 5.4rem); line-height: 1; }
  .h-read-num span { color: var(--orange); }
  .h-read-unit { font-size: .4em; }
  .h-bar { height: 6px; background: #2A2E33; }
  .h-bar i { display: block; height: 6px; width: var(--w); background: var(--orange); }
  /* Las barras se llenan a la vez que cuentan las cifras (script al final). */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .h-read .h-bar i { width: 0; transition: width 1.4s cubic-bezier(.22, 1, .36, 1) .2s; }
    :global(.js) .h-read:global(.is-visible) .h-bar i { width: var(--w); }
  }
  .h-read-item p { margin: 0; font-size: .95rem; line-height: 1.6; color: #B9B6AE; }
  .h-source { margin: 0; padding-top: 20px; border-top: 1px solid #3A3E44; font-family: 'DM Mono', monospace; font-size: .72rem; line-height: 1.6; color: #9A978F; max-width: none; }

  /* RECORRIDO */
  .h-phases { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 16px; margin-bottom: 16px; }
  .h-ph { border-top: 2px solid var(--steel); padding-top: 10px; font-family: 'DM Mono', monospace; font-size: .72rem; letter-spacing: .06em; text-transform: uppercase; }
  .h-ph--2 { grid-column: span 2; }
  .h-ph--last { border-color: var(--orange); color: var(--orange-ink); }
  /* Fila propia para la cinta: antes iba detras de las tarjetas y solo asomaba en los huecos. */
  .h-lane { position: relative; height: 12px; margin: 14px 0 34px; }
  .h-lane i { position: absolute; left: 0; right: 28px; top: 0; height: 12px; background: repeating-linear-gradient(-45deg, var(--orange) 0 14px, var(--steel) 14px 28px); }
  /* La cinta avanza un periodo horizontal de la raya (28px / cos 45°): el bucle no se nota. */
  @media (prefers-reduced-motion: no-preference) { .h-lane i { animation: hLane 1.6s linear infinite; } .h-tape { animation: hTape 2s linear infinite; } }
  @keyframes hLane { to { background-position: 39.6px 0; } }
  @keyframes hTape { to { background-position: 50.91px 0; } }
  .h-lane b { position: absolute; right: 0; top: -12px; width: 32px; height: 36px; background: var(--orange); clip-path: polygon(0 0, 100% 50%, 0 100%); }
  .h-route { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 16px; }
