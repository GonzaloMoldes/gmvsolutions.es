---
import BaseLayout from '../layouts/BaseLayout.astro';
import Screenshot from '../components/Screenshot.astro';
import PlatformMap from '../components/PlatformMap.astro';

const title = "Software español para digitalizar la planta industrial | REELEVO";
const description = "Software español para digitalizar la planta industrial: control de producción, continuidad ante bajas y trazabilidad, sin la complejidad de un MES.";
const canonical = "https://www.gmvsolutions.es/";

// La Organization se emite globalmente desde BaseLayout (src/lib/seo.ts).
// Aqui: WebSite (propio de la home) + SoftwareApplication con oferta (S2-C1).
const schema = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "REELEVO",
    "url": "https://www.gmvsolutions.es"
  },
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "@id": "https://www.gmvsolutions.es/#software",
    "name": "REELEVO",
    "applicationCategory": "BusinessApplication",
    "operatingSystem": "Web, Android, iOS",
    "inLanguage": "es-ES",
    "description": description,
    "url": "https://www.gmvsolutions.es/",
    "publisher": { "@id": "https://www.gmvsolutions.es/#organization" },
    "featureList": [
      "Procedimientos en el puesto sin cuenta de operario",
      "Registro verificable de ejecución",
      "Monitor de actividad de turno",
      "Gestión de competencias y certificaciones",
      "Trazabilidad por pieza y lote",
      "OEE y análisis Lean sobre datos de ejecución",
      "Mantenimiento preventivo",
      "Kaizen y mejora continua",
      "API REST y webhooks",
      "Resistencia a cortes de conexión en el flujo de ejecución"
    ],
    "offers": {
      "@type": "AggregateOffer",
      "priceCurrency": "EUR",
      "lowPrice": "0",
      "highPrice": "129",
      "offerCount": "3",
      "offers": [
        {
          "@type": "Offer",
          "name": "Free",
          "price": "0",
          "priceCurrency": "EUR",
          "url": "https://app.gmvsolutions.es/registro",
          "priceSpecification": {
            "@type": "UnitPriceSpecification",
            "price": "0",
            "priceCurrency": "EUR",
            "billingIncrement": "1",
            "unitText": "MES / EMPRESA"
          }
        },
        {
          "@type": "Offer",
          "name": "Starter",
          "price": "49",
          "priceCurrency": "EUR",
          "url": "https://app.gmvsolutions.es/registro",
          "priceSpecification": {
            "@type": "UnitPriceSpecification",
            "price": "49",
            "priceCurrency": "EUR",
            "billingIncrement": "1",
            "unitText": "MES / EMPRESA"
          }
        },
        {
          "@type": "Offer",
          "name": "Pro",
          "price": "129",
          "priceCurrency": "EUR",
          "url": "https://app.gmvsolutions.es/registro",
          "priceSpecification": {
            "@type": "UnitPriceSpecification",
            "price": "129",
            "priceCurrency": "EUR",
            "billingIncrement": "1",
            "unitText": "MES / EMPRESA"
          }
        }
      ]
    },
    "potentialAction": [
      {
        "@type": "RegisterAction",
        "name": "Registrarse en REELEVO",
        "target": "https://app.gmvsolutions.es/registro"
      }
    ]
  }
];
---

<BaseLayout title={title} description={description} canonical={canonical} schema={schema} activeNav="" pageType="core">

  <!-- ═══ HERO ═══ -->
  <section class="hero">
    <div class="hero-eyebrow fade-up">Software español para digitalizar la planta industrial en pymes</div>
    <h1 class="hero-title fade-up delay-1">
      Controla tu planta<br>
      sin complejidad<br>
      <em>de un sistema MES</em>.
    </h1>
    <p class="hero-sub fade-up delay-2">
      Tu planta depende de dos o tres personas. Si una falta un martes a las seis, lo notas en la línea. REELEVO pone lo que saben en el puesto, para que el turno siga sin ellas.
    </p>
    <div class="hero-actions fade-up delay-3">
      <a href="https://app.gmvsolutions.es/registro" class="btn-primary"
         data-cta data-cta-intent="registro" data-cta-location="hero" data-cta-label="Probar gratis">Probar gratis</a>
      <a href="/precios/" class="btn-ghost">Ver planes</a>
    </div>
    <p class="hero-friction fade-up delay-3">Sin tarjeta · Sin compromiso · Sin llamada comercial</p>
    <div class="hero-proof fade-up delay-4">
      <div class="hero-proof-item">
        <div class="hero-proof-num">Continuidad</div>
        <div class="hero-proof-label">menos dependencia cuando falta alguien</div>
      </div>
      <div class="hero-proof-item">
        <div class="hero-proof-num">Visibilidad</div>
        <div class="hero-proof-label">seguimiento diario de la operacion</div>
      </div>
      <!-- El tercer bloque anclaba el sitio en 49 EUR antes de que el visitante
           supiera que puede probarlo sin pagar. Mismo componente, misma maqueta:
           solo cambia el ancla.
           Los 60 dias salen de TRIAL_DURATION_DAYS en reelevo-app/lib/billing.ts.
           Si ese valor cambia, hay que cambiarlo aqui, en el CTA de cierre, en
           /precios y en la FAQ. -->
      <div class="hero-proof-item">
        <div class="hero-proof-num">60 días</div>
        <div class="hero-proof-label">del plan Pro, sin tarjeta</div>
      </div>
    </div>
  </section>

    <!-- ═══ POSICIONAMIENTO ═══ -->
    <section class="section">
      <div class="section-inner">
        <p class="section-sub fade-up" style="text-align:center;max-width:780px;margin:0 auto;">
          REELEVO es el <strong>software español para digitalizar la planta industrial</strong> de las pymes:
          lleva el control de producción, la continuidad ante bajas y la trazabilidad de ejecución al puesto
          de trabajo, sin la complejidad de implantar un MES.
        </p>
      </div>
    </section>

    <div class="divider"></div>

    <!-- ═══ EL PROBLEMA ═══ -->
    <section class="section" id="casos">
      <div class="section-inner">
        <div class="casos-header fade-up">
          <div class="eyebrow">El día a día</div>
          <h2 class="section-title">Que problema resuelve REELEVO</h2>
          <p class="section-sub">
            Bajas, incorporaciones, turnos sin trazabilidad y procesos que cada uno hace a su manera.
            Ese es el foco principal.
          </p>
        </div>

        <div class="casos fade-up delay-1">
          <div class="caso">
            <div class="caso-tag">El experto no ha venido</div>
            <h3 class="caso-title">
              «Javi está de baja.<br>
              ¿Quién arranca<br>
              la llenadora?»
            </h3>
            <p class="caso-desc">
              Es martes a las 6:30. Javi lleva 15 años en esa máquina y hoy está en urgencias.
              Su sustituto no domina el proceso. La línea no arranca hasta que alguien
              encuentre la solución o hasta que Javi coja el teléfono.
            </p>
            <ul class="caso-benefits">
              <li>Horas de línea parada buscando quién sabe arrancarla</li>
              <li>Errores por improvisar sin instrucciones claras</li>
              <li>Llamadas al experto durante su baja para salir del paso</li>
            </ul>
          </div>

          <div class="caso">
            <div class="caso-tag">Incorporación nueva</div>
            <h3 class="caso-title">
              «Es su primer día.<br>
              Alguien tiene que<br>
              enseñarle.»
            </h3>
            <p class="caso-desc">
              Llega alguien nuevo — fijo, personal de ETT, lo que sea — y necesita aprender el puesto.
              Uno de tus mejores operarios deja su máquina para hacer de tutor durante días.
              Dos personas ocupadas, un solo puesto produciendo.
            </p>
            <ul class="caso-benefits">
              <li>Tu mejor operario pierde tiempo productivo enseñando</li>
              <li>El aprendizaje depende de quién enseña y cómo</li>
              <li>En campañas o picos, se multiplica con cada ETT nuevo</li>
            </ul>
          </div>

          <div class="caso">
            <div class="caso-tag">La operación diaria</div>
            <h3 class="caso-title">
              «¿Quién hizo qué<br>
              ayer en la línea 3<br>
              y con qué resultado?»
            </h3>
            <p class="caso-desc">
              La producción pasa, pero no queda registro. No sabes quién ejecutó el proceso,
              si siguió los pasos correctos, si hubo incidencias o cuántas unidades salieron realmente.
              Decides sobre estimaciones, no sobre datos.
            </p>
            <ul class="caso-benefits">
              <li>Sin trazabilidad de quién hizo qué ni cuándo</li>
              <li>Decisiones de producción basadas en intuición</li>
              <li>Dependes de reuniones y llamadas para saber el estado real</li>
            </ul>
          </div>

          <!-- Cuarta escena: abre el eje de consistencia, que hasta ahora no
               aparecia en la home (PROPUESTA_9_DISPARADORES_COMERCIAL_2026-08, M1).
               Cubre los disparadores 1 (errores), 6 (estandarizar) y 7 (que cada
               uno lo haga a su manera). -->
          <div class="caso">
            <div class="caso-tag">Tres turnos, tres criterios</div>
            <h3 class="caso-title">
              «La misma pieza sale<br>
              distinta según<br>
              quién esté.»
            </h3>
            <p class="caso-desc">
              La instrucción existe, pero cada uno la interpreta a su manera. El veterano se salta
              dos pasos porque «siempre lo ha hecho así», el de tarde ajusta distinto, el de noche
              improvisa. Nadie hace nada mal a propósito: no hay una versión única de cómo se hace.
            </p>
            <ul class="caso-benefits">
              <li>Errores que se repiten sin que nadie sepa de dónde salen</li>
              <li>Mejorar es imposible si cada turno parte de un método distinto</li>
              <li>La no conformidad aparece meses después y no hay rastro de qué se hizo</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <div class="divider"></div>

    <!-- ═══ DATOS ═══ -->
    <section class="section section-center">
      <div class="section-inner">
        <div class="fade-up">
          <div class="eyebrow">Lo que dicen los números</div>
          <h2 class="section-title">El coste que nadie mide</h2>
          <p class="section-sub">
            Datos de la Encuesta REELEVO 2025 sobre 347 pymes industriales españolas.
            La mayoría de talleres asumen esto como "normal". No lo es.
          </p>
        </div>

        <div class="dolor-grid fade-up delay-1">
          <div class="dolor-item">
            <div class="dolor-num">7,2<sup>%</sup></div>
            <div class="dolor-label">
              <strong>Tasa de absentismo</strong> media en pymes industriales.
              1 de cada 14 trabajadores falta cada día.
            </div>
          </div>
          <div class="dolor-item">
            <div class="dolor-num">3-5</div>
            <div class="dolor-label">
              <strong>Días de aprendizaje</strong> hasta que una incorporación nueva
              rinde como el operario titular.
            </div>
          </div>
          <div class="dolor-item">
            <div class="dolor-num">40<sup>%</sup></div>
            <div class="dolor-label">
              <strong>De jefes de planta</strong> llaman directamente al experto
              cuando alguien falta. Aunque esté de baja.
            </div>
          </div>
        </div>

        <p class="fade-up delay-2" style="text-align:center;margin-top:32px;font-size:.78rem;color:var(--gray2);line-height:1.6;">
          Fuente: Encuesta REELEVO 2025 sobre dependencia operativa en pymes industriales españolas (n=347, empresas de 10-200 empleados del sector manufacturero).
        </p>
      </div>
    </section>

    <div class="divider"></div>

    <!-- ═══ PRODUCTO EN ACCIÓN ═══ -->
    <section class="section section-center" id="producto">
      <div class="section-inner">
        <PlatformMap />

        <div class="visual-proof-grid fade-up delay-2">
          <article class="visual-proof-card">
            <div class="visual-proof-tag">En el puesto</div>
            <h3 class="visual-proof-title">El sustituto no arranca a ciegas</h3>
            <p class="visual-proof-desc">
              El sustituto abre el puesto y el proceso ya está ahí. No llama a nadie.
              No espera a que Javi conteste el móvil desde casa. Arranca.
            </p>
          </article>

          <article class="visual-proof-card">
            <div class="visual-proof-tag">Para producción</div>
            <h3 class="visual-proof-title">Producción decide con el turno a la vista</h3>
            <p class="visual-proof-desc">
              Producción ve el turno mientras pasa, no en la reunión del día siguiente.
              Si la línea 3 se atasca, te enteras cuando todavía puedes mover a alguien.
            </p>
          </article>

          <article class="visual-proof-card">
            <div class="visual-proof-tag">Para seguimiento</div>
            <h3 class="visual-proof-title">El trabajo deja una base útil</h3>
            <p class="visual-proof-desc">
              Cada proceso ejecutado deja rastro: quién lo hizo, cuándo y cuánto tardó.
              Cuando llega la auditoría de calidad —o se jubila el de toda la vida— no empiezas de cero.
            </p>
          </article>
        </div>

        <div class="screenshots-cta fade-up delay-3">
          <a href="https://app.gmvsolutions.es/registro" class="btn-ghost"
             data-cta data-cta-intent="registro" data-cta-location="body" data-cta-label="Registrarme en REELEVO">Registrarme en REELEVO →</a>
        </div>
      </div>
    </section>

    <div class="divider"></div>

    <!-- ═══ CTA FINAL ═══ -->
    <section class="cta-section">
      <div class="cta-eyebrow fade-up">¿Quieres verlo en tu planta?</div>
      <div class="cta-title fade-up delay-1">
        Empieza por el puesto<br><em>que más te tensiona hoy</em>
      </div>
      <p class="cta-sub fade-up delay-2">
        Empiezas con <strong>60 días del plan Pro completo</strong>, sin tarjeta. Cuando terminan,
        tu cuenta pasa al plan gratuito: no pierdes lo que hayas montado ni te quedas fuera.
        Decides pagar cuando tengas motivos, no cuando se acabe un contador.
      </p>
      <div class="cta-actions fade-up delay-3">
        <a href="https://app.gmvsolutions.es/registro" class="btn-primary"
           data-cta data-cta-intent="registro" data-cta-location="footer" data-cta-label="Probar gratis">
          Empezar gratis con una máquina
        </a>
      </div>
      <div class="cta-note fade-up delay-4">
        Sin tarjeta · Sin compromiso · Lo pruebas con tu operativa real y decides después
      </div>
    </section>


</BaseLayout>

<style>
  .casos-header,
  .perfiles-header {
    text-align: center;
    margin-bottom: 48px;
  }
  .casos-header .eyebrow,
  .perfiles-header .eyebrow {
    justify-content: center;
  }
  .casos-header .eyebrow::after,
  .perfiles-header .eyebrow::after {
    content: '';
    width: 28px;
    height: 1px;
    background: var(--orange);
  }
  .casos-header .section-sub,
  .perfiles-header .section-sub {
    margin: 0 auto;
  }

  /* La clase .casos es global y esta a 3 columnas, colapsando a 1 por debajo de
     1000px (global.css). Aqui hay CUATRO escenas, asi que en la home se reparten
     2x2: con 3+1 quedaria una tarjeta huerfana en la segunda fila. Se sobreescribe
     solo aqui para no tocar la clase global, que usa tambien un articulo del blog.
     Al ser estilo scoped, estas dos reglas ganan a las globales en toda la escala:
     la de 760px es la que devuelve la columna unica en movil. */
  .casos {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  @media (max-width: 760px) {
    .casos {
      grid-template-columns: 1fr;
    }
  }


  .steps-cta {
    text-align: center;
    margin-top: 48px;
  }

  .steps-grid.steps-grid-four {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .perfiles-grid.perfiles-grid-four {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  @media (max-width: 1200px) {
    .steps-grid.steps-grid-four {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .perfiles-grid.perfiles-grid-four {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .visual-proof-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 700px) {
    .steps-grid.steps-grid-four {
      grid-template-columns: 1fr;
    }

    .perfiles-grid.perfiles-grid-four {
      grid-template-columns: 1fr;
    }

    .visual-proof-grid {
      grid-template-columns: 1fr;
    }
  }

  .screenshots-cta {
    margin-top: 32px;
    text-align: center;
  }

  .visual-proof-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
    margin-top: 32px;
  }

  .visual-proof-card {
    background: rgba(255,255,255,.03);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 24px 22px;
    text-align: left;
  }

  .visual-proof-tag {
    font-family: 'DM Mono', monospace;
    font-size: .62rem;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--orange);
    margin-bottom: 10px;
  }

  .visual-proof-title {
    font-family: 'Oswald', sans-serif;
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: .03em;
    margin-bottom: 10px;
  }

  .visual-proof-desc {
    font-size: .86rem;
    color: var(--gray);
    line-height: 1.65;
  }

  /* Pilot section */
  .pilot-block {
    max-width: 680px;
    margin: 48px auto 0;
    text-align: left;
  }

  .pilot-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 32px;
    margin-bottom: 20px;
  }

  .pilot-card-top {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    margin-bottom: 16px;
  }

  .pilot-icon {
    font-size: 2rem;
    flex-shrink: 0;
  }

  .pilot-label {
    font-family: 'DM Mono', monospace;
    font-size: .6rem;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--orange);
    margin-bottom: 4px;
  }

  .pilot-title {
    font-size: .95rem;
    font-weight: 500;
    color: var(--white);
  }

  .pilot-desc {
    font-size: .88rem;
    color: var(--gray);
    line-height: 1.65;
  }

  .pilot-note {
    font-size: .85rem;
    color: var(--gray);
    line-height: 1.6;
    text-align: center;
  }

  .pilot-note a {
    color: var(--orange);
    text-decoration: none;
  }

  .pilot-note a:hover {
    text-decoration: underline;
  }
</style>
