---
import BaseLayout from '../layouts/BaseLayout.astro';
import Screenshot from '../components/Screenshot.astro';
import Ilustracion from '../components/Ilustracion.astro';
import FaqSection from '../components/FaqSection.astro';
import { faqPageSchema } from '../lib/seo';

const title = "Software español para digitalizar la planta industrial | REELEVO";
const description = "Software español para digitalizar la planta industrial: control de producción, continuidad ante bajas y trazabilidad, sin la complejidad de un MES.";
const canonical = "https://www.gmvsolutions.es/";

// La Organization se emite globalmente desde BaseLayout (src/lib/seo.ts).
// Aqui: WebSite (propio de la home) + SoftwareApplication con oferta (S2-C1).
const schema = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "REELEVO",
    "url": "https://www.gmvsolutions.es"
  },
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "@id": "https://www.gmvsolutions.es/#software",
    "name": "REELEVO",
    "applicationCategory": "BusinessApplication",
    "operatingSystem": "Web, Android, iOS",
    "inLanguage": "es-ES",
    "description": description,
    "url": "https://www.gmvsolutions.es/",
    "publisher": { "@id": "https://www.gmvsolutions.es/#organization" },
    "featureList": [
      "Procedimientos en el puesto sin cuenta de operario",
      "Registro verificable de ejecución",
      "Monitor de actividad de turno",
      "Gestión de competencias y certificaciones",
      "Trazabilidad por pieza y lote",
      "OEE y análisis Lean sobre datos de ejecución",
      "Mantenimiento preventivo",
      "Kaizen y mejora continua",
      "API REST y webhooks",
      "Resistencia a cortes de conexión en el flujo de ejecución"
    ],
    "offers": {
      "@type": "AggregateOffer",
      "priceCurrency": "EUR",
      "lowPrice": "0",
      "highPrice": "129",
      "offerCount": "3",
      "offers": [
        {
          "@type": "Offer",
          "name": "Free",
          "price": "0",
          "priceCurrency": "EUR",
          "url": "https://app.gmvsolutions.es/registro",
          "priceSpecification": {
            "@type": "UnitPriceSpecification",
            "price": "0",
            "priceCurrency": "EUR",
            "billingIncrement": "1",
            "unitText": "MES / EMPRESA"
          }
        },
        {
          "@type": "Offer",
          "name": "Starter",
          "price": "49",
          "priceCurrency": "EUR",
          "url": "https://app.gmvsolutions.es/registro",
          "priceSpecification": {
            "@type": "UnitPriceSpecification",
            "price": "49",
            "priceCurrency": "EUR",
            "billingIncrement": "1",
            "unitText": "MES / EMPRESA"
          }
        },
        {
          "@type": "Offer",
          "name": "Pro",
          "price": "129",
          "priceCurrency": "EUR",
          "url": "https://app.gmvsolutions.es/registro",
          "priceSpecification": {
            "@type": "UnitPriceSpecification",
            "price": "129",
            "priceCurrency": "EUR",
            "billingIncrement": "1",
            "unitText": "MES / EMPRESA"
          }
        }
      ]
    },
    "potentialAction": [
      {
        "@type": "RegisterAction",
        "name": "Registrarse en REELEVO",
        "target": "https://app.gmvsolutions.es/registro"
      }
    ]
  }
];

// Pictogramas del recorrido de implantacion (estilo señalética ISO 7010).
const pictos = import.meta.glob('../assets/pictogramas/*.svg', { query: '?raw', import: 'default', eager: true }) as Record<string, string>;
const picto = (n: string) => pictos[`../assets/pictogramas/${n}.svg`];

// Objeciones previas al alta. Mismo texto para el bloque visible y el FAQPage.
// Solo afirmaciones que el resto del sitio ya sostiene (featureList, /modo-offline,
// /precios).
const faqs = [
  { q: '¿Necesita cada operario una cuenta?', a: 'No. Los procedimientos se ejecutan en el puesto sin cuenta de operario: el operario abre el proceso de su máquina y lo sigue paso a paso.' },
  { q: '¿Funciona en tablet o móvil?', a: 'Sí. REELEVO funciona en web, Android e iOS, así que vale la tablet del puesto o el móvil del supervisor.' },
  { q: '¿Y si se cae la conexión en planta?', a: 'El flujo de ejecución aguanta los cortes de wifi: lo ya abierto sigue disponible y lo registrado se encola y se sincroniza solo al volver la conexión.' },
  { q: '¿Qué pasa al acabar los 60 días de prueba?', a: 'Tu cuenta pasa al plan gratuito. No pierdes lo que hayas montado y decides después si te compensa un plan de pago.' },
];
schema.push(faqPageSchema(faqs));
---
<BaseLayout title={title} description={description} canonical={canonical} schema={schema} activeNav="" pageType="core">

  <!-- ═══ HERO ═══ -->
  <section class="h-hero">
    <div class="h-wrap h-hero-grid">
      <div class="h-hero-copy">
        <div class="h-ref"><span class="h-ref-tag">REF. 00</span> Software español · pymes industriales</div>
        <h1 class="h-title">Controla tu planta sin la complejidad de un MES.</h1>
        <p class="h-lead">
          Tu planta depende de dos o tres personas. Si una falta un martes a las seis, lo notas en la línea. REELEVO pone lo que saben en el puesto, para que el turno siga sin ellas.
        </p>
        <div class="h-actions">
          <a href="https://app.gmvsolutions.es/registro" class="btn-primary"
             data-cta data-cta-intent="registro" data-cta-location="hero" data-cta-label="Probar gratis 60 días">Probar gratis 60 días →</a>
          <a href="/video-demo/" class="btn-ghost"
             data-cta data-cta-intent="demo" data-cta-location="hero" data-cta-label="Ver demo de 2 min">Ver demo de 2 min</a>
        </div>
        <p class="h-note">Sin tarjeta · Sin compromiso · Sin llamada comercial</p>
      </div>
      <Ilustracion escena="hero" class="h-hero-ilus" />
    </div>

    <!-- Ficha técnica. Los 60 dias salen de TRIAL_DURATION_DAYS en
         reelevo-app/lib/billing.ts: si cambia, cambiar aqui, en el CTA final,
         en la FAQ y en /precios. -->
    <div class="h-wrap">
      <dl class="h-spec">
        <div><dt>Prueba</dt><dd>60 días del plan Pro</dd></div>
        <div><dt>Operarios</dt><dd>Sin cuenta en el puesto</dd></div>
        <div><dt>Dispositivos</dt><dd>Web · Android · iOS</dd></div>
        <div><dt>Conexión</dt><dd>Aguanta cortes en planta</dd></div>
      </dl>
    </div>
  </section>

  <!-- ═══ §01 EL DÍA A DÍA ═══ -->
  <section class="h-sec" id="casos">
    <div class="h-wrap">
      <div class="h-head fade-up">
        <div>
          <div class="h-kicker">§01 · El día a día</div>
          <h2 class="h-h2">Cuatro partes que se repiten en cualquier planta</h2>
        </div>
        <p class="h-head-sub">
          REELEVO es el software español para digitalizar la planta industrial de las pymes: control de producción, continuidad ante bajas y trazabilidad, sin implantar un MES. Está hecho para estas cuatro escenas.
        </p>
      </div>
      <div class="h-inc fade-up delay-1">
        <article class="h-inc-card">
          <div class="h-inc-top"><span>INC-01</span><span>MAR · 06:30</span></div>
          <div class="h-inc-body">
            <div class="h-inc-tag">El experto no ha venido</div>
            <h3>«Javi está de baja. ¿Quién arranca la llenadora?»</h3>
            <p>Su sustituto no domina el proceso y la línea no arranca hasta que Javi coja el teléfono.</p>
          </div>
        </article>
        <article class="h-inc-card">
          <div class="h-inc-top"><span>INC-02</span><span>LUN · 08:00</span></div>
          <div class="h-inc-body">
            <div class="h-inc-tag">Incorporación nueva</div>
            <h3>«Es su primer día. Alguien tiene que enseñarle.»</h3>
            <p>Tu mejor operario deja su máquina para hacer de tutor. Dos personas ocupadas, un puesto produciendo.</p>
          </div>
        </article>
        <article class="h-inc-card">
          <div class="h-inc-top"><span>INC-03</span><span>MIÉ · 09:15</span></div>
          <div class="h-inc-body">
            <div class="h-inc-tag">La operación diaria</div>
            <h3>«¿Quién hizo qué ayer en la línea 3?»</h3>
            <p>La producción pasa y no queda registro: ni quién ejecutó ni cuántas unidades salieron.</p>
          </div>
        </article>
        <article class="h-inc-card">
          <div class="h-inc-top"><span>INC-04</span><span>3 TURNOS</span></div>
          <div class="h-inc-body">
            <div class="h-inc-tag">Tres turnos, tres criterios</div>
            <h3>«La misma pieza sale distinta según quién esté.»</h3>
            <p>Nadie lo hace mal a propósito: no hay una versión única del proceso.</p>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- ═══ §02 DATOS ═══ -->
  <section class="h-dark">
    <div class="h-wrap">
      <div class="h-kicker h-kicker--dark">§02 · Lo que dicen los números</div>
      <h2 class="h-h2">El coste que nadie mide</h2>
      <div class="h-read">
        <div class="h-read-item">
          <div class="h-read-label">Absentismo medio</div>
          <div class="h-read-num">7,2<span>%</span></div>
          <div class="h-bar"><i style="width:7.2%"></i></div>
          <p>1 de cada 14 trabajadores falta cada día.</p>
        </div>
        <div class="h-read-item">
          <div class="h-read-label">Días hasta rendir</div>
          <div class="h-read-num">3–5<span class="h-read-unit"> d</span></div>
          <div class="h-bar"><i style="width:60%"></i></div>
          <p>Hasta que una incorporación rinde como el titular.</p>
        </div>
        <div class="h-read-item">
          <div class="h-read-label">Llaman al experto</div>
          <div class="h-read-num">40<span>%</span></div>
          <div class="h-bar"><i style="width:40%"></i></div>
          <p>De jefes de planta llaman al experto aunque esté de baja.</p>
        </div>
      </div>
      <p class="h-source">Fuente: Encuesta REELEVO 2025 sobre dependencia operativa en pymes industriales españolas (n=347, empresas de 10-200 empleados del sector manufacturero).</p>
    </div>
  </section>

  <!-- ═══ §03 RECORRIDO DE IMPLANTACIÓN ═══ -->
  <section class="h-sec" id="producto">
    <div class="h-wrap">
      <div class="h-head fade-up">
        <div>
          <div class="h-kicker">§03 · Recorrido de implantación</div>
          <h2 class="h-h2">De la cuenta al turno controlado, puesto a puesto</h2>
        </div>
        <p class="h-head-sub">No hay que implantarlo todo de golpe. Empiezas por una máquina y vas extendiendo cuando el primer puesto ya funciona solo.</p>
      </div>

      <div class="h-phases" aria-hidden="true">
        <span class="h-ph h-ph--2">Fase A · Arranque</span>
        <span class="h-ph h-ph--2">Fase B · Primer puesto</span>
        <span class="h-ph">Fase C · Operación</span>
        <span class="h-ph h-ph--last">Fase D · Escala</span>
      </div>
      <div class="h-lane" aria-hidden="true"><i></i><b></b></div>

      <ol class="h-route fade-up delay-1">
        <li class="h-st">
          <span class="h-st-plate">E-01</span>
          <Fragment set:html={picto('e01')} />
          <span class="h-st-role">Gerencia</span>
          <h3>Crea la cuenta</h3>
          <p>Registro sin tarjeta. Tienes 60 días del plan Pro completo.</p>
          <a href="/precios/" class="h-st-link">→ Registro y planes</a>
        </li>
        <li class="h-st">
          <span class="h-st-plate">E-02</span>
          <Fragment set:html={picto('e02')} />
          <span class="h-st-role">Gerencia + producción</span>
          <h3>Elige el primer puesto</h3>
          <p>El que más te tensiona hoy: el que depende de una sola persona.</p>
          <a href="/casos-de-uso/cobertura-bajas/" class="h-st-link">→ Cobertura de bajas</a>
        </li>
        <li class="h-st">
          <span class="h-st-plate">E-03</span>
          <Fragment set:html={picto('e03')} />
          <span class="h-st-role">El experto</span>
          <h3>Documenta el proceso</h3>
          <p>El que sabe lo graba en pasos, con foto o vídeo. Una vez.</p>
          <a href="/documentacion-procesos/" class="h-st-link">→ Documentación de procesos</a>
        </li>
        <li class="h-st">
          <span class="h-st-plate">E-04</span>
          <Fragment set:html={picto('e04')} />
          <span class="h-st-role">Operario o sustituto</span>
          <h3>Ejecuta en el puesto</h3>
          <p>Sin cuenta de operario. Valida cada paso o avisa si hay un problema.</p>
          <a href="/portal-operario/" class="h-st-link">→ Portal del operario</a>
        </li>
        <li class="h-st">
          <span class="h-st-plate">E-05</span>
          <Fragment set:html={picto('e05')} />
          <span class="h-st-role">Jefe de producción</span>
          <h3>Ve el turno en directo</h3>
          <p>Quién hace qué, en qué máquina y cuánto tarda, mientras pasa.</p>
          <a href="/control-produccion/" class="h-st-link">→ Control de producción</a>
        </li>
        <li class="h-st h-st--last">
          <span class="h-st-plate">E-06</span>
          <Fragment set:html={picto('e06')} />
          <span class="h-st-role">Toda la planta</span>
          <h3>Extiende a más puestos</h3>
          <p>Competencias, trazabilidad, mantenimiento, OEE. Cuando el primero ya va solo.</p>
          <a href="/como-funciona/" class="h-st-link">→ Cómo funciona</a>
        </li>
      </ol>

      <figure class="h-shot fade-up">
        <figcaption class="h-shot-bar"><span>Monitor de operarios · tiempo real</span><span>Captura real del producto</span></figcaption>
        <Screenshot name="monitor-actividad" alt="Monitor de operarios de REELEVO con el estado en tiempo real de cada máquina y operario" layout="full" />
      </figure>
    </div>
  </section>

  <!-- ═══ §04 PARA QUIÉN ═══ -->
  <section class="h-sec h-sec--line">
    <div class="h-wrap">
      <div class="h-kicker">§04 · Para quién</div>
      <h2 class="h-h2">Elige tu puesto</h2>
      <div class="h-roles">
        <a href="/para-quien/gerente-propietario/" class="h-role">
          <span class="h-role-n">Rol / 01</span>
          <span class="h-role-t">Gerente o propietario</span>
          <span class="h-role-d">Menos dependencia de personas clave.</span>
          <span class="h-role-go">Ver →</span>
        </a>
        <a href="/para-quien/jefe-de-produccion/" class="h-role">
          <span class="h-role-n">Rol / 02</span>
          <span class="h-role-t">Jefe de producción</span>
          <span class="h-role-d">El turno a la vista mientras pasa.</span>
          <span class="h-role-go">Ver →</span>
        </a>
        <a href="/para-quien/responsable-calidad/" class="h-role">
          <span class="h-role-n">Rol / 03</span>
          <span class="h-role-t">Calidad</span>
          <span class="h-role-d">Registro verificable de cada ejecución.</span>
          <span class="h-role-go">Ver →</span>
        </a>
        <a href="/para-quien/responsable-rrhh/" class="h-role">
          <span class="h-role-n">Rol / 04</span>
          <span class="h-role-t">RRHH</span>
          <span class="h-role-d">Incorporaciones y competencias en orden.</span>
          <span class="h-role-go">Ver →</span>
        </a>
      </div>
    </div>
  </section>

  <FaqSection items={faqs} heading="Lo que preguntan antes de probarlo" eyebrow="§05 · Preguntas de planta" />

  <!-- ═══ CTA FINAL ═══ -->
  <section class="h-cta">
    <div class="h-tape" aria-hidden="true"></div>
    <div class="h-wrap h-cta-inner">
      <div class="h-kicker h-kicker--dark">¿Quieres verlo en tu planta?</div>
      <h2 class="h-cta-title">Empieza por el puesto que más te tensiona hoy</h2>
      <p class="h-cta-sub">60 días del plan Pro completo, sin tarjeta. Al terminar, tu cuenta pasa al plan gratuito: no pierdes lo que hayas montado.</p>
      <div class="h-actions">
        <a href="https://app.gmvsolutions.es/registro" class="btn-primary"
           data-cta data-cta-intent="registro" data-cta-location="footer" data-cta-label="Empezar gratis con una máquina">Empezar gratis con una máquina →</a>
        <a href="/blog/plantilla-sop-produccion/" class="btn-ghost h-ghost-dark"
           data-cta data-cta-intent="contenido" data-cta-location="footer" data-cta-label="Descargar plantilla SOP">Descargar plantilla SOP</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .h-wrap { max-width: 1280px; margin: 0 auto; padding: 0 32px; }
  .h-kicker { font-family: 'IBM Plex Mono', monospace; font-size: .78rem; letter-spacing: .06em; text-transform: uppercase; color: var(--orange-ink); margin-bottom: 14px; }
  .h-kicker--dark { color: var(--orange); }
  .h-h2 { font-family: 'Archivo Narrow', sans-serif; font-weight: 700; text-transform: uppercase; font-size: clamp(2rem, 4vw, 3.4rem); line-height: .98; margin: 0; }

  /* HERO */
  .h-hero { padding: 120px 0 0; border-bottom: 1px solid var(--border); }
  .h-hero-grid { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: 48px; align-items: center; padding-bottom: 56px; }
  .h-hero-copy { display: flex; flex-direction: column; gap: 26px; }
  .h-ref { font-family: 'IBM Plex Mono', monospace; font-size: .78rem; letter-spacing: .06em; text-transform: uppercase; color: var(--gray2); display: flex; gap: 12px; align-items: center; flex-wrap: wrap; }
  .h-ref-tag { border: 1px solid var(--steel); color: var(--steel); padding: 3px 8px; }
  .h-title { font-family: 'Archivo Narrow', sans-serif; font-weight: 700; text-transform: uppercase; font-size: clamp(2.6rem, 5vw, 4.3rem); line-height: .94; letter-spacing: -.005em; margin: 0; }
  .h-lead { font-size: 1.2rem; line-height: 1.55; color: var(--gray); max-width: 520px; margin: 0; }
  .h-actions { display: flex; gap: 12px; flex-wrap: wrap; }
  .h-note { font-family: 'IBM Plex Mono', monospace; font-size: .78rem; color: var(--gray2); margin: 0; }
  .h-spec { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); margin: 0; border-top: 1px solid var(--steel); border-left: 1px solid var(--border); background: var(--paper); }
  .h-spec > div { padding: 20px 24px; border-right: 1px solid var(--border); border-bottom: 1px solid var(--border); }
  .h-spec dt { font-family: 'IBM Plex Mono', monospace; font-size: .7rem; letter-spacing: .06em; text-transform: uppercase; color: var(--gray2); }
  .h-spec dd { margin: 6px 0 0; font-weight: 700; font-size: 1.05rem; }

  /* SECCIONES */
  .h-sec { padding: 104px 0; }
  .h-sec--line { border-top: 1px solid var(--border); }
  .h-head { display: flex; justify-content: space-between; align-items: end; gap: 40px; margin-bottom: 48px; flex-wrap: wrap; }
  .h-head > div { max-width: 720px; }
  .h-head-sub { max-width: 420px; margin: 0; font-size: 1rem; line-height: 1.6; color: var(--gray); }

  /* INCIDENCIAS */
  .h-inc { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; }
  .h-inc-card { background: var(--paper); border: 1px solid var(--border); border-top: 4px solid var(--steel); }
  .h-inc-top { display: flex; justify-content: space-between; padding: 12px 18px; border-bottom: 1px dashed var(--border); font-family: 'IBM Plex Mono', monospace; font-size: .75rem; color: var(--gray2); }
  .h-inc-body { padding: 20px 18px 24px; display: flex; flex-direction: column; gap: 10px; }
  .h-inc-tag { font-family: 'IBM Plex Mono', monospace; font-size: .72rem; font-weight: 600; text-transform: uppercase; color: var(--orange-ink); }
  .h-inc-body h3 { font-size: 1.3rem; line-height: 1.2; font-weight: 700; margin: 0; }
  .h-inc-body p { font-size: .95rem; line-height: 1.6; color: var(--gray); margin: 0; }

  /* BANDA OSCURA DE DATOS */
  .h-dark { background: var(--steel); color: #ECEAE5; padding: 104px 0; }
  .h-dark .h-h2 { color: #ECEAE5; margin-bottom: 40px; }
  .h-read { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-top: 1px solid #3A3E44; }
  .h-read-item { padding: 32px; border-right: 1px solid #3A3E44; display: flex; flex-direction: column; gap: 14px; }
  .h-read-item:first-child { padding-left: 0; }
  .h-read-item:last-child { border-right: 0; }
  .h-read-label { font-family: 'IBM Plex Mono', monospace; font-size: .75rem; text-transform: uppercase; color: #9A978F; }
  .h-read-num { font-family: 'IBM Plex Mono', monospace; font-weight: 500; font-size: clamp(3.4rem, 6vw, 5.4rem); line-height: 1; }
  .h-read-num span { color: var(--orange); }
  .h-read-unit { font-size: .4em; }
  .h-bar { height: 6px; background: #2A2E33; }
  .h-bar i { display: block; height: 6px; background: var(--orange); }
  .h-read-item p { margin: 0; font-size: .95rem; line-height: 1.6; color: #B9B6AE; }
  .h-source { margin: 0; padding-top: 20px; border-top: 1px solid #3A3E44; font-family: 'IBM Plex Mono', monospace; font-size: .72rem; line-height: 1.6; color: #9A978F; max-width: none; }

  /* RECORRIDO */
  .h-phases { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 16px; margin-bottom: 16px; }
  .h-ph { border-top: 2px solid var(--steel); padding-top: 10px; font-family: 'IBM Plex Mono', monospace; font-size: .72rem; letter-spacing: .06em; text-transform: uppercase; }
  .h-ph--2 { grid-column: span 2; }
  .h-ph--last { border-color: var(--orange); color: var(--orange-ink); }
  .h-lane { position: relative; height: 12px; margin-bottom: -26px; top: 18px; }
  .h-lane i { position: absolute; left: 0; right: 28px; top: 0; height: 12px; background: repeating-linear-gradient(-45deg, var(--orange) 0 14px, var(--steel) 14px 28px); }
