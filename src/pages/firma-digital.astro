---
import BaseLayout from '../layouts/BaseLayout.astro';
import FaqSection from '../components/FaqSection.astro';
import { softwareApplicationSchema, faqPageSchema, type FaqItem } from '../lib/seo';
import Ilustracion from '../components/Ilustracion.astro';

const title = "Firma digital operativa industrial | REELEVO";
const description = "Firma digital en el flujo de planta: el operario firma al completar y el supervisor al validar. Evidencia para auditorías ISO sin papel.";
const canonical = "https://www.gmvsolutions.es/firma-digital/";

// Una sola lista alimenta el bloque visible y el FAQPage del head (auditoria P6).
//
// La seccion "Enfoque prudente" repetia literalmente la primera pregunta, asi
// que se elimino y su unico dato propio —disponible desde el plan Pro— se
// incorporo a la respuesta (tarea C4 de
// PLAN_SIMPLIFICACION_EDITORIAL_WEB_2026-08.md).
const faqs: FaqItem[] = [
  {
    q: '¿Es firma electrónica cualificada?',
    a: 'No, y conviene decirlo claro. No es una firma cualificada con certificado reconocido en el sentido del reglamento eIDAS, así que no está pensada para contratos ni para efectos jurídicos frente a terceros. Es firma operativa: evidencia interna de quién ejecutó y quién validó. Está disponible desde el plan Pro.',
  },
  {
    q: '¿Para qué sirve entonces?',
    a: 'Para cerrar el círculo de responsabilidad dentro de la planta: el operario firma al completar un proceso y el supervisor al validar la producción. Sustituye al papel firmado que se archiva en una carpeta, con la ventaja de que la firma queda unida al registro de la ejecución concreta.',
  },
  {
    q: '¿Vale como evidencia en una auditoría?',
    a: 'Como evidencia operativa interna, sí: demuestra que hubo una validación, de quién y cuándo, ligada al proceso y su versión. Si tu auditoría exige firma cualificada para un documento concreto, ese documento necesita otra herramienta; para el día a día de planta esto es lo que suele pedirse.',
  },
  {
    q: '¿Cómo firma el operario?',
    a: 'En el mismo momento y en el mismo sitio donde termina el trabajo, desde su móvil. Lo importante no es el gesto sino el cuándo: una firma que se recoge en bloque al final del turno certifica un recuerdo, no una ejecución.',
  },
];

const pageSchema = softwareApplicationSchema();

const schema = [pageSchema, faqPageSchema(faqs)];
---

<BaseLayout title={title} description={description} canonical={canonical} schema={schema} activeNav="" pageType="capacidad">

  <!-- HERO + PROBLEMA -->
  <section class="page-hero">
    <div class="eyebrow fade-up">Firma digital · Validaciones · Evidencia para auditorías · Integrado en el flujo QR</div>
    <h1 class="fade-up delay-1">La firma del operario <br><em>sin papel, sin burocracia adicional</em></h1>
    <p class="fade-up delay-2">El registro existe y el proceso se ejecutó, pero no hay prueba de quién lo aprobó: la validación se hace de palabra, o en un papel que alguien imprime, firma y archiva. Con REELEVO el operario firma al completar y el supervisor al validar, y la firma queda unida al registro de esa ejecución concreta.</p>
    <div class="hero-cta fade-up delay-3">
      <a href="https://app.gmvsolutions.es/registro" class="btn-primary"
         data-cta data-cta-intent="registro" data-cta-location="hero" data-cta-trigger="01" data-cta-label="Registrarse gratis">Registrarse gratis</a>
    </div>
    <Ilustracion escena="firma-digital" />
  </section>

  <div class="divider"></div>

  <!-- CÓMO FUNCIONA — bloque dominante -->
  <section class="section">
    <div class="section-inner">
      <div class="fade-up">
        <div class="eyebrow">Cómo funciona</div>
        <h2 class="section-title">La firma ocurre en el mismo momento que la acción</h2>
        <p class="section-sub">No es un paso adicional. Una firma que se recoge en bloque al final del turno certifica un recuerdo; esta certifica una ejecución.</p>
      </div>

      <div class="sign-scenarios fade-up delay-1">
        <div class="sign-card">
          <div class="sign-who">Operario</div>
          <h3>Al completar un proceso</h3>
          <p>Termina los pasos del SOP, registra la finalización y firma ahí mismo desde su móvil. La firma queda unida a esa ejecución y a la versión del proceso que siguió.</p>
        </div>

        <div class="sign-card">
          <div class="sign-who">Supervisor</div>
          <h3>Al validar la producción</h3>
          <p>Revisa las sesiones del turno y firma cada validación. Queda registrado quién dio el visto bueno y cuándo, en lugar de una aprobación de palabra.</p>
        </div>

        <div class="sign-card">
          <div class="sign-who">Responsable</div>
          <h3>Al aprobar una certificación</h3>
          <p>Cuando un operario queda certificado al completar las ejecuciones requeridas, el responsable añade su firma al registro de competencia.</p>
        </div>
      </div>

      <div class="sign-result fade-up delay-2">
        <h3>Lo que queda registrado en cada firma</h3>
        <div class="sign-fields">
          <div class="sign-field">Identidad del firmante, con su rol</div>
          <div class="sign-field">Fecha y hora exacta</div>
          <div class="sign-field">Contexto: proceso, sesión o certificación</div>
          <div class="sign-field">Dispositivo desde el que se firmó</div>
        </div>
      </div>
    </div>
  </section>

  <div class="divider"></div>

  <!-- PARA AUDITORÍAS -->
  <section class="section">
    <div class="section-inner">
      <div class="fade-up">
        <div class="eyebrow">Para auditorías</div>
        <h2 class="section-title">Toda la evidencia en segundos — sin buscar en archivadores</h2>
        <p class="section-sub">Cuando llega una auditoría ISO 9001 o interna, el historial de firmas se filtra por proceso y fecha desde el panel, y se exporta.</p>
      </div>

      <div class="audit-vs fade-up delay-1">
        <div class="vs-col vs-bad">
          <div class="vs-label">Sin firma digital</div>
          <ul>
            <li>Buscar en archivadores físicos</li>
            <li>Registros incompletos o ilegibles</li>
            <li>No siempre sabes quién firmó qué</li>
            <li>Horas de preparación</li>
          </ul>
        </div>

        <div class="vs-col vs-good">
          <div class="vs-label">Con REELEVO</div>
          <ul>
            <li>Filtro por proceso y fecha en segundos</li>
            <li>Registros completos y fechados</li>
            <li>Firmante siempre trazable</li>
            <li>Exportable al momento para el auditor</li>
          </ul>
        </div>
      </div>

      <p class="roles-line fade-up delay-2">Relacionado: <a href="/calidad-y-conformidad/">calidad y conformidad</a> · <a href="/documentacion-procesos/">documentación de procesos</a>.</p>
    </div>
  </section>

  <div class="divider"></div>

  <FaqSection items={faqs} />

  <div class="divider"></div>

  <!-- SIGUIENTE PASO -->
  <section class="cta-section">
    <div class="cta-eyebrow fade-up">Firma con contexto</div>
    <h3 class="cta-title fade-up delay-1">
      Empieza por el control <br><em>que hoy se firma al final del turno</em>
    </h3>
    <p class="cta-sub fade-up delay-2">
      No hace falta firmarlo todo. Con un proceso ya se ve la diferencia entre certificar una ejecución y certificar un recuerdo.
    </p>
    <div class="cta-actions fade-up delay-3">
      <a href="https://app.gmvsolutions.es/registro" class="btn-primary"
         data-cta data-cta-intent="registro" data-cta-location="footer" data-cta-trigger="01" data-cta-label="Registrarme en REELEVO">
        Activarlo en un proceso
      </a>
      <a href="/calidad-y-conformidad/" class="btn-ghost">
        Ver calidad y conformidad →
      </a>
    </div>
  </section>

</BaseLayout>

<style>
  /* FIRMAS — bloque dominante */
  .sign-scenarios {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
    margin-top: 44px;
  }

  @media (max-width: 860px) {
    .sign-scenarios { grid-template-columns: 1fr; }
  }

  .sign-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 24px;
  }

  .sign-who {
    font-family: 'DM Mono', monospace;
    font-size: .7rem;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--orange-ink);
    margin-bottom: 12px;
  }

  .sign-card h3 {
    font-family: 'Oswald', sans-serif;
    font-size: 1rem;
    margin-bottom: 10px;
    color: var(--white);
  }

  .sign-card p {
    font-size: .95rem;
    line-height: 1.65;
    color: var(--gray);
    margin: 0;
  }

  .sign-result {
    margin-top: 32px;
    padding: 24px 26px;
    background: var(--surface2);
    border: 1px solid var(--border);
    border-radius: 8px;
    max-width: 900px;
  }

  .sign-result h3 {
    font-family: 'Oswald', sans-serif;
    font-size: 1rem;
    margin: 0 0 16px;
    color: var(--white);
  }

  .sign-fields {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px 24px;
  }

  @media (max-width: 700px) {
    .sign-fields { grid-template-columns: 1fr; }
  }

  .sign-field {
    position: relative;
    padding-left: 20px;
    font-size: .95rem;
    line-height: 1.6;
    color: var(--gray);
  }

  .sign-field::before {
    content: '';
    position: absolute;
    left: 0;
    top: .72em;
    width: 8px;
    height: 1px;
    background: var(--orange);
  }

  /* AUDITORÍAS */
  .audit-vs {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    margin-top: 40px;
    max-width: 900px;
  }

  @media (max-width: 760px) {
    .audit-vs { grid-template-columns: 1fr; }
  }

  .vs-col {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 24px;
  }

  .vs-col.vs-bad { border-left: 3px solid var(--gray2); }
  .vs-col.vs-good { border-left: 3px solid var(--green); }

  .vs-label {
    font-family: 'DM Mono', monospace;
    font-size: .7rem;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--gray2);
    margin-bottom: 14px;
  }

  .vs-good .vs-label { color: var(--green); }

  .vs-col ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .vs-col li {
    position: relative;
    padding-left: 18px;
    margin-bottom: 10px;
    font-size: .95rem;
    line-height: 1.6;
    color: var(--gray);
  }

  .vs-col li:last-child { margin-bottom: 0; }

  .vs-col li::before {
    content: '';
    position: absolute;
    left: 0;
    top: .7em;
    width: 7px;
    height: 1px;
    background: var(--border-hover);
  }

  .vs-good li::before { background: var(--green); }

  .roles-line {
    margin-top: 28px;
    font-size: .95rem;
    color: var(--gray);
  }

  .roles-line a {
    color: var(--orange-ink);
    text-decoration: none;
    border-bottom: 1px solid rgba(244, 82, 30, .35);
  }

  .roles-line a:hover {
    border-bottom-color: var(--orange);
  }
</style>
