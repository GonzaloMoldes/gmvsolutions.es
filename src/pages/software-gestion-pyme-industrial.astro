---
import BaseLayout from '../layouts/BaseLayout.astro';
import FaqSection from '../components/FaqSection.astro';
import { softwareApplicationSchema, faqPageSchema, type FaqItem } from '../lib/seo';

const title = "Software de gestión para pyme industrial | REELEVO";
const description = "Software de gestión para pymes industriales: producción, competencias, mantenimiento y procesos de planta. No es un ERP contable.";
const canonical = "https://www.gmvsolutions.es/software-gestion-pyme-industrial/";

// Una sola lista alimenta el bloque visible y el FAQPage del head (auditoria P6).
//
// Esta pagina montaba su propio bloque <details> y su propio FAQPage inline en
// vez de usar FaqSection + faqPageSchema(). Migrada al componente compartido
// para que no haya dos implementaciones del mismo bloque.
//
// La seccion "Que tipo de software es" (rejilla SI/NO) se elimino: tres de las
// cinco preguntas ya respondian lo mismo, y lo esencial pasa al hero
// (tarea C4 de PLAN_SIMPLIFICACION_EDITORIAL_WEB_2026-08.md).
const faqs: FaqItem[] = [
  {
    q: '¿REELEVO es un software de gestión para pymes?',
    a: 'Sí, pero acotado: es un software de gestión para pymes industriales enfocado en las operaciones de planta (producción, competencias, procesos y mantenimiento). No es un software de gestión administrativa ni un ERP de contabilidad o facturación.',
  },
  {
    q: '¿Sirve como software de empresa o necesito un ERP?',
    a: 'Depende de lo que busques. Si necesitas contabilidad, nóminas o facturación, eso es un ERP y REELEVO no lo sustituye. Si lo que quieres es un software de empresa para gestionar lo que pasa en el taller —quién produce qué, con qué procedimiento y con qué formación—, REELEVO lo cubre y se integra con tu ERP por API.',
  },
  {
    q: '¿Qué incluye la gestión de pymes industriales con REELEVO?',
    a: 'Control de producción en tiempo real, matriz de competencias y polivalencia, documentación de procesos (SOP) en el puesto, planes de mantenimiento preventivo y planificación semanal de turnos. Todo conectado y sin papel. Lo que no cubre: contabilidad, facturación, nóminas ni gestión administrativa, y tampoco te obliga a un proyecto MES de meses.',
  },
  {
    q: '¿Es un software para una empresa de cualquier sector?',
    a: 'Está diseñado para la pyme industrial: talleres, fabricación, mecanizado, alimentación y producción en general. No es un software genérico para una empresa de servicios u oficina; su valor está en la planta.',
  },
];

const schema = [softwareApplicationSchema(), faqPageSchema(faqs)];

const modulos = [
  ['/control-produccion/', 'Control de producción', 'Registro en tiempo real, paradas con causa y KPIs del día sin partes en papel.'],
  ['/gestion-competencias/', 'Gestión de competencias', 'Matriz de polivalencia, certificaciones y alertas de cobertura por proceso.'],
  ['/documentacion-procesos/', 'Documentación de procesos', 'SOP paso a paso en máquina que el operario realmente consulta.'],
  ['/mantenimiento/', 'Mantenimiento preventivo', 'Planes por máquina y órdenes automáticas en la agenda del operario.'],
  ['/cobertura-turnos/', 'Planificación y turnos', 'Planificación semanal con alerta antes de que un turno se quede corto.'],
  ['/api-integraciones/', 'Integraciones', 'Conecta con tu ERP, Power BI y Teams. El dato de planta donde lo necesitas.'],
  ['/oee/', 'OEE y análisis Lean', 'Disponibilidad, rendimiento y calidad por máquina, con TIMWOODS, VSM y takt.'],
  ['/seguridad/', 'Seguridad y RGPD', 'Aislamiento por empresa, permisos por rol, auditoría y datos en la UE.'],
];
---

<BaseLayout title={title} description={description} canonical={canonical} schema={schema} activeNav="" pageType="capacidad">

  <!-- HERO + POSICIONAMIENTO -->
  <section class="page-hero">
    <div class="eyebrow fade-up">Software de gestión para pyme industrial</div>
    <h1 class="fade-up delay-1">El software de gestión <br><em>que vive en la planta, no en la oficina</em></h1>
    <p class="fade-up delay-2">Cuando una pyme industrial busca «software de gestión» encuentra ERPs horizontales pensados para administración. REELEVO gestiona lo otro: quién produce qué, con qué procedimiento y con qué formación. No es contabilidad ni facturación —eso es un ERP, y se conecta con él por API— y no te obliga a un proyecto MES de meses.</p>
    <div class="hero-cta fade-up delay-3" style="display:flex;gap:14px;justify-content:center;flex-wrap:wrap;">
      <a href="https://app.gmvsolutions.es/registro" class="btn-primary"
         data-cta data-cta-intent="registro" data-cta-location="hero" data-cta-label="Registrarme en REELEVO">Registrarme en REELEVO</a>
      <a href="/video-demo/" class="btn-ghost"
         data-cta data-cta-intent="navegacion" data-cta-location="hero" data-cta-label="Ver el demo">Ver el demo →</a>
    </div>
  </section>

  <div class="divider"></div>

  <!-- MÓDULOS — bloque dominante -->
  <section class="section">
    <div class="section-inner">
      <div class="fade-up">
        <div class="eyebrow">Todo en una herramienta</div>
        <h2 class="section-title">La gestión de la pyme industrial, módulo a módulo</h2>
        <p class="section-sub">Empieza por lo que más te aprieta y añade el resto cuando quieras. Cada módulo funciona solo, y mejor en conjunto.</p>
      </div>

      <div class="module-grid fade-up delay-1">
        {modulos.map(([href, titulo, desc]) => (
          <a class="module-cell" href={href}>
            <h3>{titulo}</h3>
            <p>{desc}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <div class="divider"></div>

  <!-- CUANDO LA EMPRESA CRECE -->
  <!-- Verificado en reelevo-app: app/empresa/plantas (+ /comparar), rol
       plant_manager en lib/company-permissions.ts, i18n es/en/pt,
       app/empresa/operarios/horas y cron hour-deviation-alerts (>10%,
       semanal). Recordatorio: NO hay limite de plantas por plan. -->
  <section class="section">
    <div class="section-inner">
      <div class="fade-up">
        <div class="eyebrow">Cuando la empresa crece</div>
        <h2 class="section-title">Lo que suele obligar a cambiar de herramienta <br><em>aquí ya está</em></h2>
        <p class="section-sub">
Lo que aparece cuando dejas de ser una nave con un turno, y suele obligar a migrar a un sistema más caro.
        </p>
      </div>

      <div class="grow-grid fade-up delay-1">
        <article class="grow-card">
          <div class="grow-tag">Varias plantas</div>
          <h3 class="grow-title">Multi-planta, sin coste por centro</h3>
          <p class="grow-desc">
Plantas y áreas sin límite por plan, con comparativa entre centros. El rol <strong>jefe de planta</strong> gestiona solo la suya.
          </p>
        </article>

        <article class="grow-card">
          <div class="grow-tag">Plantilla multinacional</div>
          <h3 class="grow-title">Español, inglés y portugués</h3>
          <p class="grow-desc">
Cada operario trabaja en su idioma, y cada proceso puede tener su traducción sin duplicarlo.
          </p>
        </article>

        <article class="grow-card">
          <div class="grow-tag">Control de horas</div>
          <h3 class="grow-title">Horas que salen del trabajo real</h3>
          <p class="grow-desc">
Las sesiones de QR se consolidan en horas por operario, con aviso semanal de quien se desvía <strong>más de un 10 %</strong>. Sin fichar dos veces.
          </p>
        </article>
      </div>
    </div>
  </section>

  <div class="divider"></div>

  <FaqSection items={faqs} heading="Software de gestión para pymes industriales: dudas habituales" />

  <div class="divider"></div>

  <!-- SIGUIENTE PASO -->
  <section class="cta-section">
    <div class="cta-eyebrow fade-up">Gestión de planta, sin papel</div>
    <h3 class="cta-title fade-up delay-1">
      El software de gestión <br><em>que tu taller sí va a usar</em>
    </h3>
    <p class="cta-sub fade-up delay-2">
      Empieza por producción, competencias o procesos — sin montar un ERP ni un proyecto de meses.
    </p>
    <div class="cta-actions fade-up delay-3">
      <a href="https://app.gmvsolutions.es/registro" class="btn-primary"
         data-cta data-cta-intent="registro" data-cta-location="footer" data-cta-label="Registrarme en REELEVO">
        Registrarme en REELEVO
      </a>
      <a href="/precios/" class="btn-ghost">
        Ver precios →
      </a>
    </div>
    <div class="cta-trust fade-up delay-4">Sin tarjeta de crédito · Te acompañamos en la primera configuración</div>
  </section>

</BaseLayout>

<style>
  /* MÓDULOS — bloque dominante, y router de la plataforma */
  .module-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 20px;
    margin-top: 44px;
  }

  @media (max-width: 1100px) {
    .module-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 620px) {
    .module-grid { grid-template-columns: 1fr; }
  }

  .module-cell {
    display: block;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 22px 20px;
    text-decoration: none;
    transition: border-color .25s, transform .25s;
  }

  .module-cell:hover {
    border-color: var(--orange);
    transform: translateY(-2px);
  }

  .module-cell h3 {
    font-family: 'Archivo Narrow', sans-serif;
    font-size: .98rem;
    margin-bottom: 10px;
    color: var(--white);
  }

  .module-cell p {
    font-size: .95rem;
    line-height: 1.6;
    color: var(--gray);
    margin: 0;
  }

  /* CUANDO LA EMPRESA CRECE */
  .grow-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
    margin-top: 40px;
  }

  @media (max-width: 900px) {
    .grow-grid { grid-template-columns: 1fr; }
  }

  .grow-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 24px;
  }

  .grow-tag {
    font-family: 'IBM Plex Mono', monospace;
    font-size: .7rem;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--orange-ink);
    margin-bottom: 12px;
  }

  .grow-title {
    font-family: 'Archivo Narrow', sans-serif;
    font-size: 1rem;
    margin-bottom: 10px;
    color: var(--white);
  }

  .grow-desc {
    font-size: .95rem;
    line-height: 1.65;
    color: var(--gray);
    margin: 0;
  }

  .grow-desc strong { color: var(--white); font-weight: 500; }

  .cta-trust {
    margin-top: 16px;
    font-size: 0.82rem;
    color: rgba(20,22,24, 0.45);
    letter-spacing: .04em;
  }
</style>
