---
import BaseLayout from '../layouts/BaseLayout.astro';
import FaqSection from '../components/FaqSection.astro';
import { softwareApplicationSchema, faqPageSchema, type FaqItem } from '../lib/seo';
import Screenshot from '../components/Screenshot.astro';

const title = "Documentación y gestión de procesos industriales para pymes | REELEVO";
const description = "Documentación de procesos: SOPs estandarizados en el puesto para reducir errores, acelerar el onboarding y sostener la continuidad operativa.";
const canonical = "https://www.gmvsolutions.es/documentacion-procesos/";

// Una sola lista alimenta el bloque visible y el FAQPage del head (auditoria P6).
const faqs: FaqItem[] = [
  {
    q: '¿Qué diferencia hay entre esto y tener los SOPs en PDF?',
    a: 'Dónde vive el documento y si alguien lo mira. Un PDF en una carpeta compartida obliga al operario a ir a buscarlo, así que en la práctica pregunta al veterano. Aquí el proceso aparece en el puesto, con fotos y vídeo del paso, y con una única versión vigente para toda la planta.',
  },
  {
    q: '¿Cómo accede el operario al proceso en el puesto?',
    a: 'Escaneando un QR colocado en la máquina desde su móvil. No necesita instalar nada, ni crear una cuenta, ni recordar una contraseña, que es justo lo que hace fracasar la adopción con personal temporal o con plantilla poco habituada a herramientas digitales.',
  },
  {
    q: '¿Cuántos procesos hay que documentar para empezar?',
    a: 'Entre dos y cinco. Los que más rotación tienen o más reprocesos generan. Documentar la planta entera antes de empezar a usar nada es el camino corto a que el proyecto se abandone; un proceso resuelto y en uso convence más que un plan de doce meses.',
  },
  {
    q: '¿Hay que teclear todos los procedimientos desde cero?',
    a: 'No. Puedes subir los que ya tengas en Word o PDF y la IA propone el proceso troceado en pasos, en el idioma original del documento. Para lo que nunca se escribió, puedes grabar en vídeo al operario haciéndolo y se proponen los pasos a partir de lo que se ve. En los dos casos el resultado queda pendiente de revisión: tú lo corriges y lo apruebas antes de que llegue al puesto.',
  },
  {
    q: '¿Quién debe redactar la documentación?',
    a: 'El operario que domina el proceso, acompañado de alguien que le dé estructura. Cuando lo redacta calidad desde un despacho sale un documento formalmente correcto que pierde los detalles reales del puesto, que son precisamente los que evitan el error.',
  },
  {
    q: '¿Qué pasa cuando cambia un proceso?',
    a: 'Se actualiza una vez y el cambio llega a todos los puestos a la vez, con su versión. Desaparece la situación de tener tres revisiones distintas conviviendo en tres líneas, y no hay que reimprimir ni recoger copias antiguas.',
  },
];

const pageSchema = softwareApplicationSchema();

const schema = [pageSchema, faqPageSchema(faqs)];
---

<BaseLayout title={title} description={description} canonical={canonical} schema={schema} activeNav="" pageType="capacidad">
  <!-- PAGE HERO -->
  <section class="page-hero">
    <div class="eyebrow fade-up">Documentación y gestión de procesos</div>
    <h1 class="fade-up delay-1">Documentación de procesos<br><em>industriales accesible</em></h1>
    <p class="fade-up delay-2">La gestión de la documentación de procesos sin fricción: procedimientos paso a paso en máquina y SOP que los operarios realmente consultan. Sin manuales de 50 páginas que nadie usa.</p>
    <div class="hero-cta fade-up delay-3" style="display:flex;gap:14px;justify-content:center;flex-wrap:wrap;">
      <a href="/video-demo/" class="btn-primary"
         data-cta data-cta-intent="demo" data-cta-location="hero" data-cta-label="Solicitar demo">Solicitar demo</a>
      <a href="https://app.gmvsolutions.es/registro" class="btn-ghost"
         data-cta data-cta-intent="registro" data-cta-location="hero" data-cta-label="Registrarse gratis">Registrarse gratis</a>
    </div>
  </section>

  <div class="divider"></div>

  <!-- EL PROBLEMA -->
  <section class="section">
    <div class="section-inner">
      <div class="fade-up">
        <div class="eyebrow">La realidad</div>
        <h2 class="section-title">Los SOPs que nadie consulta</h2>
      </div>

      <div class="problem-showcase fade-up delay-1">
        <div class="bad-approach">
          <h3>❌ El enfoque tradicional</h3>
          <ul>
            <li>Alguien de calidad documenta 40 páginas en Word</li>
            <li>Diagramas, capturas de pantalla, formato perfecto</li>
            <li>Se guarda en carpeta de servidor "Documentación/SOP/Línea1/"</li>
            <li>Operario necesita encender el ordenador</li>
            <li>Navegar carpetas ("¿dónde estaba?")</li>
            <li>Abrir PDF</li>
            <li>Buscar página relevante</li>
            <li>Realidad: Operario llama al tutor en lugar de consultar</li>
          </ul>
          <p class="result">Resultado: 100% de los SOP documentados. 0% de uso.</p>
        </div>

        <div class="good-approach">
          <h3>✓ El enfoque REELEVO</h3>
          <ul>
            <li>Operario experto documenta MIENTRAS ejecuta el proceso</li>
            <li>App lo guía por los pasos: "¿Cuál es el siguiente paso?"</li>
            <li>A un click de distancia del SOP: foto, video, checklist</li>
            <li>Disponible en la máquina por QR, y resistente a los cortes de wifi</li>
            <li>Operario nuevo consulta 10 segundos</li>
            <li>Sigue el procedimiento</li>
            <li>¡Listo!</li>
            <li>Tutor verifica resultado, no enseña</li>
          </ul>
          <p class="result">Resultado: SOPs documentados Y usados en planta.</p>
        </div>
      </div>

      <div class="data-point fade-up delay-2">
        <p><strong>Dato:</strong> 77% de pymes industriales españolas NO tiene procedimientos operativos documentados y actualizados. Del 23% que sí, menos del 10% de sus procedimientos se consultan habitualmente en planta.</p>
      </div>
    </div>
  </section>

  <div class="divider"></div>

  <!-- LA SOLUCIÓN -->
  <section class="section">
    <div class="section-inner">
      <div class="fade-up">
        <div class="eyebrow">La solución</div>
        <h2 class="section-title">Documentación que se consulta</h2>
      </div>

      <div class="solution-approach fade-up delay-1">
        <div class="feature">
          <div class="feature-icon">📱</div>
          <h3>Accesible en 3 segundos</h3>
          <p>QR en máquina + scan = SOP abierto directamente. O app preinstalada. Sin buscar nada. Y si la wifi cae con el SOP ya abierto, sigue ahí.</p>
        </div>

        <div class="feature">
          <div class="feature-icon">👷</div>
          <h3>Documentado por el experto</h3>
          <p>El operario que sabe hace el SOP mientras trabaja. Incluye los puntos críticos que solo él conoce. Es la verdad operativa.</p>
        </div>

        <div class="feature">
          <div class="feature-icon">🛠️</div>
          <h3>Incluye troubleshooting</h3>
          <p>"Si la presión sube, espera 30 segundos." "Si el material se atasca, esto significa…" — El conocimiento tácito documentado.</p>
        </div>

        <div class="feature">
          <div class="feature-icon">📊</div>
          <h3>Versionado y actual</h3>
          <p>Cuando cambia un parámetro por nueva máquina, se actualiza fácil. Todos ven la última versión. Sin confusión.</p>
        </div>

        <div class="feature">
          <div class="feature-icon">✓</div>
          <h3>Checklisteable</h3>
          <p>No es "lee esto y luego adivina el siguiente paso". Es: paso 1 → check ✓ → paso 2 → check ✓. Secuencial.</p>
        </div>

        <div class="feature">
          <div class="feature-icon">👥</div>
          <h3>Colaborativo sin entorpecer</h3>
          <p>Cuando algo no está claro, el tutor lo anota. En el siguiente turno, el novato lo ve actualizado. Mejora continua.</p>
        </div>
      </div>

      <div class="screenshot-pair fade-up delay-2">
        <figure class="screenshot-fig">
          <Screenshot name="sop-operario" alt="Vista del operario ejecutando un SOP en REELEVO: paso a paso con vídeo, confirmación y botón de incidencia" class="screenshot-img" layout="pair" />
          <figcaption class="screenshot-caption">Vista del operario — SOP paso a paso con vídeo integrado y confirmación de cada paso</figcaption>
        </figure>
        <figure class="screenshot-fig">
          <Screenshot name="gestion-productos-procesos" alt="Gestión de productos y procesos en REELEVO: lista de productos con secuencias de procesos por máquina" class="screenshot-img" layout="pair" />
          <figcaption class="screenshot-caption">Gestión de productos — secuencias de procesos por máquina y producto</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <div class="divider"></div>

  <!-- TIPOS DE PROCEDIMIENTOS -->
  <section class="section">
    <div class="section-inner">
      <div class="fade-up">
        <h2 class="section-title">¿Qué documentar con REELEVO?</h2>
      </div>

      <div class="procedures-grid fade-up delay-1">
        <div class="procedure-type">
          <h3>🚀 Arranque/Parada</h3>
          <p>Secuencia exacta. Orden de pasos importa. Qué hay que esperar en cada etapa. Cuándo está listo para producir.</p>
        </div>

        <div class="procedure-type">
          <h3>⚙️ Cambio de parámetros</h3>
          <p>Configuración de máquina. Valores exactos. Tolerancias. Cómo verificar que quedó bien. Qué NO hacer.</p>
        </div>

        <div class="procedure-type">
          <h3>🔧 Mantenimiento básico</h3>
          <p>Lubricación. Limpieza. Inspección visual. Cuándo hacer qué. Dónde están los puntos de lubricación.</p>
        </div>

        <div class="procedure-type">
          <h3>❌ Troubleshooting</h3>
          <p>Máquina para. ¿Qué significa este sonido? ¿Qué hacer primero? Árbol de diagnóstico de problemas comunes.</p>
        </div>

        <div class="procedure-type">
          <h3>✓ Control de calidad</h3>
          <p>Cómo sabe el operario que una pieza está bien o mal. Qué mira, qué toca, qué mide. Criterios visuales.</p>
        </div>

        <div class="procedure-type">
          <h3>🧹 Limpieza GMP</h3>
          <p>Si necesitas conformidad ISO/IATF: checklist paso a paso de limpieza por zona. Con foto de "antes" y "después".</p>
        </div>
      </div>
    </div>
  </section>

  <div class="divider"></div>

  <!-- IMPORTACIÓN CON IA -->
  <!-- Datos verificados en reelevo-app: /api/empresa/import/start (PDF y DOCX,
       10 MB, Claude Sonnet) y /api/empresa/procesos/video-to-steps (hasta 15
       frames extraidos en el navegador con FFmpeg WASM, Claude vision). El job
       queda en estado needs_review: no se publica nada sin aprobar. -->
  <section class="section" id="importar">
    <div class="section-inner">
      <div class="fade-up">
        <div class="eyebrow">La objeción de verdad</div>
        <h2 class="section-title">«Pasar mis procedimientos a esto<br><em>me va a costar meses</em>»</h2>
        <p class="section-sub">
          Es la razón real por la que estos proyectos no arrancan. No es el precio ni la resistencia
          del operario: es que alguien tiene que sentarse a escribir cien procedimientos desde cero.
          REELEVO ataca justo esa parte.
        </p>
      </div>

      <div class="import-grid fade-up delay-1">
        <article class="import-card">
          <div class="import-tag">Word y PDF</div>
          <h3 class="import-title">Lo que ya tienes escrito</h3>
          <p class="import-desc">
            Sueltas el documento —hasta 10 MB— y la IA lee el procedimiento y propone el proceso ya
            troceado: título, tipo, descripción y hasta 20 pasos con su detalle. Respeta el idioma
            original del documento.
          </p>
        </article>

        <article class="import-card">
          <div class="import-tag">Vídeo</div>
          <h3 class="import-title">Lo que solo está en la cabeza de alguien</h3>
          <p class="import-desc">
            Para lo que nunca se escribió: grabas al operario haciéndolo. REELEVO toma fotogramas a lo
            largo del vídeo y propone los pasos a partir de lo que se ve. Si el vídeo tiene voz, la
            transcripción manda sobre la imagen.
          </p>
        </article>

        <article class="import-card">
          <div class="import-tag">Siempre revisado</div>
          <h3 class="import-title">La IA propone, tú apruebas</h3>
          <p class="import-desc">
            El resultado queda en estado <strong>pendiente de revisión</strong>. Lo abres, corriges lo
            que haga falta y lo apruebas o lo rechazas. Nada llega al puesto de trabajo sin que una
            persona lo haya validado.
          </p>
        </article>
      </div>

      <div class="import-note fade-up delay-2">
        <strong>Lo que esto no es:</strong> no documenta tu planta sola. El criterio de qué es crítico,
        qué tolerancia aplica y qué se hace cuando algo va mal lo sigue poniendo quien conoce la máquina.
        Lo que se ahorra es la página en blanco y el tecleo — que es justo donde estos proyectos se paran.
      </div>
    </div>
  </section>

  <div class="divider"></div>

  <!-- CROSS-LINKS -->
  <section class="section section-center">
    <div class="section-inner">
      <div class="fade-up">
        <div class="eyebrow">Sigue explorando</div>
        <h2 class="section-title">Dónde encaja la documentación de procesos</h2>
        <p class="section-sub">
          La documentación en puesto es la base de la cobertura de bajas y del onboarding.
          Mira cómo se aplica en cada caso o por rol.
        </p>
        <div class="hero-cta" style="display:flex;gap:14px;justify-content:center;flex-wrap:wrap;margin-top:24px;">
          <a href="/casos-de-uso/cobertura-bajas/" class="btn-ghost">Cobertura de bajas →</a>
          <a href="/casos-de-uso/onboarding-operarios/" class="btn-ghost">Onboarding de operarios →</a>
          <a href="/para-quien/responsable-calidad/" class="btn-ghost">Para calidad →</a>
        </div>
      </div>
    </div>
  </section>

  <div class="divider"></div>

  <!-- CTA -->
  <FaqSection items={faqs} />

  <div class="divider"></div>

  <section class="cta-section">
    <div class="cta-eyebrow fade-up">Empieza por uno</div>
    <div class="cta-title fade-up delay-1">
      Documenta primero<br><em>el proceso que más te cuesta repetir</em>
    </div>
    <p class="cta-sub fade-up delay-2">
      No hace falta ordenar toda la planta de golpe. Si capturas un proceso crítico y lo dejas disponible donde se trabaja, ya estás cambiando la forma de operar.
    </p>
    <div class="cta-actions fade-up delay-3">
      <a href="/video-demo/" class="btn-primary"
         data-cta data-cta-intent="demo" data-cta-location="footer" data-cta-label="Solicitar demo">
        Solicitar demo
      </a>
      <a href="https://app.gmvsolutions.es/registro" class="btn-ghost"
         data-cta data-cta-intent="registro" data-cta-location="footer" data-cta-label="Registrarse gratis">
        Registrarse gratis
      </a>
    </div>
  </section>

</BaseLayout>

<style>
  .problem-showcase {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    margin-top: 40px;
  }

  .bad-approach,
  .good-approach {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 28px;
  }

  .good-approach {
    border-color: var(--orange);
    background: rgba(255, 150, 0, 0.02);
  }

  .bad-approach h3,
  .good-approach h3 {
    font-family: 'Oswald', sans-serif;
    font-size: 1.1rem;
    margin-bottom: 16px;
  }

  .bad-approach ul,
  .good-approach ul {
    list-style: none;
    padding: 0;
  }

  .bad-approach li,
  .good-approach li {
    padding: 8px 0;
    color: var(--gray);
    font-size: 0.9rem;
    line-height: 1.5;
  }

  .bad-approach li:before,
  .good-approach li:before {
    margin-right: 8px;
    font-weight: 600;
  }

  .bad-approach li:before {
    content: "→ ";
    color: #c86464;
  }

  .good-approach li:before {
    content: "✓ ";
    color: var(--orange);
  }

  .result {
    margin-top: 16px;
    padding-top: 16px;
    border-top: 1px solid var(--border);
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--text);
  }

  .data-point {
    background: rgba(100, 150, 200, 0.08);
    border-left: 4px solid #6496c8;
    padding: 20px;
    border-radius: 4px;
    margin-top: 40px;
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .failure-reasons {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
    margin-top: 40px;
  }

  .reason {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 24px;
  }

  .reason-title {
    font-family: 'Oswald', sans-serif;
    font-size: 0.95rem;
    font-weight: 600;
    margin-bottom: 12px;
  }

  .reason p {
    color: var(--gray);
    font-size: 0.9rem;
    line-height: 1.5;
  }

  .solution-approach {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    margin-top: 40px;
  }

  .feature {
    text-align: center;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 24px;
  }

  .feature-icon {
    font-size: 2rem;
    margin-bottom: 12px;
  }

  .feature h3 {
    font-family: 'Oswald', sans-serif;
    font-size: 0.95rem;
    margin-bottom: 12px;
  }

  .feature p {
    color: var(--gray);
    font-size: 0.85rem;
    line-height: 1.5;
  }

  .procedures-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-top: 40px;
  }

  .procedure-type {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 24px;
  }

  .procedure-type h3 {
    font-size: 0.95rem;
    font-weight: 600;
    margin-bottom: 12px;
  }

  .procedure-type p {
    font-size: 0.85rem;
    color: var(--gray);
    line-height: 1.5;
  }

  /* IMPORTACIÓN CON IA */
  .import-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
    margin-top: 40px;
  }

  .import-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 26px 24px;
  }

  .import-tag {
    font-family: 'DM Mono', monospace;
    font-size: .62rem;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--orange);
    margin-bottom: 12px;
  }

  .import-title {
    font-family: 'Oswald', sans-serif;
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: .02em;
    margin-bottom: 10px;
  }

  .import-desc {
    font-size: .87rem;
    color: var(--gray);
    line-height: 1.65;
  }

  .import-desc strong { color: var(--white); font-weight: 500; }

  /* El limite se marca en el mismo bloque que la promesa, no escondido al pie:
     prometer "documentacion automatica" es exactamente como se pierde la
     confianza en la primera reunion tecnica. */
  .import-note {
    max-width: 780px;
    margin: 28px auto 0;
    padding: 20px 24px;
    background: rgba(255, 255, 255, .03);
    border-left: 2px solid var(--orange);
    border-radius: 0 4px 4px 0;
    font-size: .87rem;
    line-height: 1.7;
    color: var(--gray);
  }

  .import-note strong { color: var(--white); font-weight: 500; }

  .impact-metrics {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
    margin-top: 40px;
  }

  .metric {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 24px;
  }

  .metric-label {
    font-family: 'Oswald', sans-serif;
    font-size: 0.95rem;
    font-weight: 600;
    margin-bottom: 16px;
  }

  .metric-before,
  .metric-after {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 12px 0;
    border-bottom: 1px solid var(--border);
    font-size: 0.9rem;
  }

  .metric-after {
    border-bottom: none;
  }

  .metric-before {
    color: #888;
  }

  .metric-after {
    color: var(--orange);
    font-weight: 600;
  }

  .startup-steps {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    margin-top: 40px;
  }

  .startup-box {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 24px;
  }

  .startup-box h3 {
    font-family: 'Oswald', sans-serif;
    font-size: 0.95rem;
    margin-bottom: 16px;
  }

  .startup-box ul {
    list-style: none;
    padding: 0;
  }

  .startup-box li {
    padding: 8px 0;
    color: var(--gray);
    font-size: 0.85rem;
    line-height: 1.5;
  }

  .startup-box li:before {
    content: "→ ";
    color: var(--orange);
    font-weight: 600;
    margin-right: 8px;
  }

  @media (max-width: 900px) {
    .problem-showcase,
    .solution-approach,
    .impact-metrics,
    .startup-steps {
      grid-template-columns: 1fr;
    }

    .failure-reasons,
    .procedures-grid,
    .import-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
