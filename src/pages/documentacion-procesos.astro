---
import Icon from '../components/Icon.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import FaqSection from '../components/FaqSection.astro';
import { softwareApplicationSchema, faqPageSchema, type FaqItem } from '../lib/seo';
import Screenshot from '../components/Screenshot.astro';
import Ilustracion from '../components/Ilustracion.astro';
import { getPagina, conNegritas, conSaltos, sinMarcas } from '../lib/contenido';

// Textos editables desde Sanity (Páginas de funcionalidad). Respaldo: src/data/paginas/documentacion-procesos.json.
const pagina = await getPagina('documentacion-procesos');

const title = pagina.seo.title;
const description = pagina.seo.description;
const canonical = "https://www.gmvsolutions.es/documentacion-procesos/";

// Una sola lista alimenta el bloque visible y el FAQPage del head (auditoria P6).
const faqs: FaqItem[] = pagina.faq.items.map(({ q, a }) => ({ q, a: sinMarcas(a) }));

const pageSchema = softwareApplicationSchema();

const schema = [pageSchema, faqPageSchema(faqs)];

---

<BaseLayout title={title} description={description} canonical={canonical} schema={schema} activeNav="" pageType="capacidad">
  <!-- HERO + PROBLEMA -->
  <section class="page-hero">
    <div class="eyebrow fade-up">{pagina.hero.antetitulo}</div>
    <h1 class="fade-up delay-1"><Fragment set:html={conSaltos(pagina.hero.titulo)} />{pagina.hero.tituloDestacado && <> <br> <em>{pagina.hero.tituloDestacado}</em></>}</h1>
    <p class="fade-up delay-2" set:html={conNegritas(pagina.hero.texto)} />
    <div class="hero-cta fade-up delay-3" style="display:flex;gap:14px;justify-content:center;flex-wrap:wrap;">
      {pagina.hero.botones[0] && (
<a href={pagina.hero.botones[0].url} class="btn-primary"
         data-cta data-cta-intent="registro" data-cta-location="hero" data-cta-trigger="06" data-cta-label="Registrarme en REELEVO">{pagina.hero.botones[0].texto}</a>
)}
      {pagina.hero.botones[1] && (
<a href={pagina.hero.botones[1].url} class="btn-ghost"
         data-cta data-cta-intent="navegacion" data-cta-location="hero" data-cta-label="Ver el demo">{pagina.hero.botones[1].texto}</a>
)}
    </div>
    <Ilustracion escena="documentacion-procesos" />
  </section>

  <div class="divider"></div>

  <!-- CÓMO FUNCIONA — bloque dominante -->
  <section class="section">
    <div class="section-inner">
      <div class="fade-up">
        <div class="eyebrow">Cómo funciona</div>
        <h2 class="section-title">Instrucciones de trabajo que se consultan</h2>
        <p class="section-sub">Un software de instrucciones de trabajo digitales no cambia el contenido de la instrucción de trabajo: cambia dónde vive y quién la escribe.</p>
      </div>

      <div class="solution-approach fade-up delay-1">
        <div class="feature">
          <Icon name="movil" class="feature-icon icon--draw" />
          <h3>Accesible en tres segundos</h3>
          <p>QR en la máquina y la instrucción de trabajo se abre directa desde el móvil, sin instalar nada, sin cuenta y sin contraseña que recordar. Si la wifi cae con el proceso ya abierto, sigue ahí.</p>
        </div>

        <div class="feature">
          <Icon name="persona" class="feature-icon icon--draw" />
          <h3>Escrito por quien lo domina</h3>
          <p>El operario experto escribe la instrucción de trabajo mientras trabaja, así que incluye los puntos críticos y el troubleshooting que solo él conoce: «si la presión sube, espera 30 segundos».</p>
        </div>

        <div class="feature">
          <Icon name="ciclo" class="feature-icon icon--draw" />
          <h3>Paso a paso, con confirmación</h3>
          <p>No es «lee esto y adivina el siguiente paso»: es paso 1, check, paso 2, check. Con foto y vídeo en cada uno.</p>
        </div>

        <div class="feature">
          <Icon name="grafica" class="feature-icon icon--draw" />
          <h3>Una sola versión vigente</h3>
          <p>Cambia un parámetro, se actualiza una vez y llega a todos los puestos a la vez. Y cuando el tutor anota algo que no estaba claro, el turno siguiente ya lo ve.</p>
        </div>
      </div>

      <p class="data-point fade-up delay-2">
        El <strong>77 % de las pymes industriales españolas</strong> no tiene procedimientos operativos
        documentados y actualizados.
        <span class="data-source">Fuente: Encuesta REELEVO 2025 sobre dependencia operativa en pymes industriales.</span>
      </p>

      <div class="screenshot-pair fade-up delay-2">
        <figure class="screenshot-fig">
          <Screenshot name="sop-operario" alt="Vista del operario siguiendo una instrucción de trabajo digital en REELEVO: paso a paso con vídeo, confirmación y botón de incidencia" class="screenshot-img" layout="pair" />
          <figcaption class="screenshot-caption">Vista del operario — instrucción de trabajo paso a paso con vídeo integrado y confirmación de cada paso</figcaption>
        </figure>
        <figure class="screenshot-fig">
          <Screenshot name="gestion-productos-procesos" alt="Gestión de productos y procesos en REELEVO: lista de productos con secuencias de procesos" class="screenshot-img" layout="pair" />
          <figcaption class="screenshot-caption">Gestión de productos — secuencias de procesos por máquina y producto</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <div class="divider"></div>

  <!-- PRUEBA / LA OBJECIÓN -->
  <!-- Datos verificados en reelevo-app: /api/empresa/import/start (PDF y DOCX,
       10 MB, Claude Sonnet) y /api/empresa/procesos/video-to-steps (hasta 15
       frames extraidos en el navegador con FFmpeg WASM, Claude vision). El job
       queda en estado needs_review: no se publica nada sin aprobar. -->
  <section class="section" id="importar">
    <div class="section-inner">
      <div class="fade-up">
        <div class="eyebrow">La objeción de verdad</div>
        <h2 class="section-title">«Pasar mis instrucciones de trabajo a esto <br><em>me va a costar meses</em>»</h2>
        <p class="section-sub">
          No es el precio ni la resistencia del operario: es que alguien tiene que escribir cien instrucciones de trabajo desde cero.
        </p>
      </div>

      <div class="import-grid fade-up delay-1">
        <article class="import-card">
          <div class="import-tag">Word y PDF</div>
          <h3 class="import-title">Lo que ya tienes escrito</h3>
          <p class="import-desc">
            Sueltas el documento —hasta 10 MB— y la IA lo propone troceado en hasta 20 pasos, en su idioma original.
          </p>
        </article>

        <article class="import-card">
          <div class="import-tag">Vídeo</div>
          <h3 class="import-title">Lo que solo está en la cabeza de alguien</h3>
          <p class="import-desc">
            Grabas al operario haciéndolo y los pasos se proponen a partir de lo que se ve.
          </p>
        </article>

        <article class="import-card">
          <div class="import-tag">Siempre revisado</div>
          <h3 class="import-title">La IA propone, tú apruebas</h3>
          <p class="import-desc">
            Queda <strong>pendiente de revisión</strong>: nada llega al puesto sin que una persona lo valide.
          </p>
        </article>
      </div>

      <p class="roles-line fade-up delay-2">Es la base de otras cosas: <a href="/casos-de-uso/cobertura-bajas/">cobertura de bajas</a> · <a href="/casos-de-uso/onboarding-operarios/">onboarding de operarios</a> · <a href="/para-quien/responsable-calidad/">para calidad</a>.</p>

      <div class="import-note fade-up delay-3">
        <strong>Lo que esto no es:</strong> no documenta tu planta sola. El criterio lo sigue poniendo
        quien conoce la máquina. Lo que se ahorra es la página en blanco — que es donde estos proyectos se paran.
      </div>
    </div>
  </section>

  <div class="divider"></div>

  <!-- GESTIÓN DOCUMENTAL — PRL, calidad y politicas (gestion documental generica, sept. 2026).
       Limites: alcance = toda la plantilla, certificados en el proceso o asignados en
       planificacion (sin asignacion por puesto/area); el acuse no es firma avanzada eIDAS. -->
  <section class="section" id="gestion-documental">
    <div class="section-inner">
      <div class="fade-up">
        <div class="eyebrow">Gestión documental</div>
        <h2 class="section-title">PRL, calidad y políticas <br><em>en la misma gestión documental</em></h2>
        <p class="section-sub">No solo las instrucciones de trabajo de máquina: las instrucciones de prevención, los procedimientos de calidad y las normas generales viven en el mismo sitio, con el mismo control de versiones y la misma evidencia.</p>
      </div>

      <div class="solution-approach fade-up delay-1">
        <div class="feature">
          <h3>Pendientes que se mantienen solos</h3>
          <p>Al publicar una versión nueva, los afectados vuelven a quedar pendientes. Cada instrucción muestra quién la ha aceptado y quién falta, y cada trabajador ve todos sus pendientes en su portal.</p>
        </div>
        <div class="feature">
          <h3>Lectura, test y acuse</h3>
          <p>El trabajador lee, responde al test si lo hay y acepta la versión vigente con su código personal. Queda registrado quién, qué versión y cuándo.</p>
        </div>
        <div class="feature">
          <h3>Certificación con caducidad</h3>
          <p>Superar el test y aceptar deja al trabajador habilitado en esa instrucción, con caducidad configurable y aviso de lo que vence.</p>
        </div>
        <div class="feature">
          <h3>Evidencia para auditoría</h3>
          <p>El informe PDF periódico incluye los acuses del periodo: trabajador, instrucción, versión, fecha y vía. Sin carpetas ni hojas de firmas.</p>
        </div>
      </div>

      <p class="roles-line fade-up delay-2">Cómo se desborda la gestión documental en papel y cómo se recupera: <a href="/blog/gestion-instrucciones-prl-e-it/">gestión documental de PRL e instrucciones de trabajo</a> · <a href="/blog/acuse-de-lectura-instrucciones-prl/">acuse de lectura</a> · <a href="/blog/como-digitalizar-instrucciones-de-trabajo/">cómo digitalizar las instrucciones de trabajo</a></p>
      <p class="roles-line fade-up delay-2">¿Lo llevas hoy en Excel? Empieza por la <a href="/recursos/plantilla-gestion-documental-prl/">plantilla gratuita de gestión documental de PRL</a>: versión vigente, acuses, pendientes y caducidades por trabajador.</p>
    </div>
  </section>

  <div class="divider"></div>

  <!-- FORMATO DE INSTRUCCION DE TRABAJO (SEO oct. 2026: "hoja de instrucciones de trabajo",
       "formato de instruccion de trabajo"). ISO 9001: solo lo que dice el apartado 7.5. -->
  <section class="section" id="formato-instruccion-de-trabajo">
    <div class="section-inner">
      <div class="fade-up">
        <div class="eyebrow">El formato</div>
        <h2 class="section-title">Hoja de instrucciones de trabajo: <br><em>qué debe llevar el formato</em></h2>
        <p class="section-sub">Sea en papel, en Word o en REELEVO, una hoja de instrucción de trabajo que se usa en el puesto lleva siempre lo mismo. Si te falta alguno de estos bloques, es lo primero que se echa de menos cuando alguien nuevo la sigue.</p>
      </div>

      <div class="solution-approach fade-up delay-1">
        <div class="feature">
          <h3>Cabecera con versión</h3>
          <p>Código, puesto o máquina, versión vigente, fecha y quién la aprobó. Sin versión no hay forma de saber si la que está en el puesto es la buena.</p>
        </div>
        <div class="feature">
          <h3>Seguridad y EPI</h3>
          <p>Los riesgos del puesto y el equipo de protección necesario, antes del primer paso, no al final.</p>
        </div>
        <div class="feature">
          <h3>Pasos con foto y puntos críticos</h3>
          <p>Una acción por paso, con imagen, y marcados los que afectan a la calidad o a la seguridad.</p>
        </div>
        <div class="feature">
          <h3>Autocontrol y anomalías</h3>
          <p>Qué comprobar al terminar y qué hacer si algo sale mal: a quién avisar y cuándo parar.</p>
        </div>
      </div>

      <p class="roles-line fade-up delay-2">Tienes este formato listo para rellenar en la <a href="/blog/plantilla-instruccion-de-trabajo/">plantilla de instrucción de trabajo en Word</a>, con un ejemplo hecho. Si trabajas con ISO 9001, la norma no impone un formato concreto, pero sí que la información documentada esté identificada, revisada y aprobada, con control de versiones y disponible donde se usa (apartado 7.5): justo lo que la cabecera y el puesto resuelven.</p>
    </div>
  </section>

  <div class="divider"></div>

  <FaqSection items={faqs} />

  <div class="divider"></div>

  <!-- SIGUIENTE PASO -->
  <section class="cta-section">
    <div class="cta-eyebrow fade-up">{pagina.ctaFinal.antetitulo}</div>
    <h3 class="cta-title fade-up delay-1"><Fragment set:html={conSaltos(pagina.ctaFinal.titulo)} />{pagina.ctaFinal.tituloDestacado && <> <br> <em>{pagina.ctaFinal.tituloDestacado}</em></>}</h3>
    <p class="cta-sub fade-up delay-2" set:html={conNegritas(pagina.ctaFinal.texto)} />
    <div class="cta-actions fade-up delay-3">
      {pagina.ctaFinal.botones[0] && (
<a href={pagina.ctaFinal.botones[0].url} class="btn-primary"
         data-cta data-cta-intent="registro" data-cta-location="footer" data-cta-trigger="06" data-cta-label="Registrarme en REELEVO">{pagina.ctaFinal.botones[0].texto}</a>
)}
      {pagina.ctaFinal.botones[1] && (
<a href={pagina.ctaFinal.botones[1].url} class="btn-ghost">{pagina.ctaFinal.botones[1].texto}</a>
)}
    </div>
  </section>

</BaseLayout>

<style>
  /* CÓMO FUNCIONA — bloque dominante */
  .solution-approach {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
    margin-top: 44px;
  }

  @media (max-width: 860px) {
    .solution-approach { grid-template-columns: 1fr; }
  }

  .feature {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 24px;
  }

  .feature-icon { margin-bottom: 12px; }

  .feature h3 {
    font-family: 'Oswald', sans-serif;
    font-size: 1rem;
    margin-bottom: 10px;
    color: var(--white);
  }

  .feature p {
    font-size: .95rem;
    color: var(--gray);
    line-height: 1.65;
    margin: 0;
  }

  .data-point {
    max-width: 68ch;
    margin: 28px 0 0;
    font-size: .95rem;
    line-height: 1.7;
    color: var(--gray);
  }

  .data-point strong { color: var(--white); font-weight: 500; }

  .data-source {
    display: block;
    margin-top: 6px;
    font-size: .8rem;
    color: var(--gray2);
  }

  /* IMPORTACIÓN CON IA */
  .import-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
    margin-top: 40px;
  }

  @media (max-width: 860px) {
    .import-grid { grid-template-columns: 1fr; }
  }

  .import-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 24px;
  }

  .import-tag {
    font-family: 'DM Mono', monospace;
    font-size: .7rem;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--orange-ink);
    margin-bottom: 12px;
  }

  .import-title {
    font-family: 'Oswald', sans-serif;
    font-size: 1rem;
    margin-bottom: 10px;
    color: var(--white);
  }

  .import-desc {
    font-size: .95rem;
    line-height: 1.65;
    color: var(--gray);
    margin: 0;
  }

  .import-desc strong { color: var(--white); font-weight: 500; }

  .import-note {
    max-width: 900px;
    margin-top: 28px;
    padding: 20px 24px;
    background: rgba(20,22,24, .03);
    border-left: 2px solid var(--orange);
    border-radius: 0 4px 4px 0;
    font-size: .92rem;
    line-height: 1.7;
    color: var(--gray);
  }

  .import-note strong { color: var(--white); font-weight: 500; }

  .roles-line {
    margin-top: 28px;
    font-size: .95rem;
    color: var(--gray);
  }

  .roles-line a {
    color: var(--orange-ink);
    text-decoration: none;
    border-bottom: 1px solid rgba(244, 82, 30, .35);
  }

  .roles-line a:hover {
    border-bottom-color: var(--orange);
  }
</style>
