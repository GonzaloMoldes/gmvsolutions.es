---
import Icon from '../components/Icon.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import FaqSection from '../components/FaqSection.astro';
import { softwareApplicationSchema, faqPageSchema, type FaqItem } from '../lib/seo';
import Screenshot from '../components/Screenshot.astro';

const title = "Software de instrucciones de trabajo digitales para pymes | REELEVO";
const description = "Software de instrucciones de trabajo digitales para pymes industriales: SOPs paso a paso en el puesto, con QR, foto y vídeo, para reducir errores y acelerar el onboarding.";
const canonical = "https://www.gmvsolutions.es/documentacion-procesos/";

// Una sola lista alimenta el bloque visible y el FAQPage del head (auditoria P6).
const faqs: FaqItem[] = [
  {
    q: '¿Qué es un software de instrucciones de trabajo digitales?',
    a: 'Una herramienta que sustituye los procedimientos en papel o en PDF por instrucciones paso a paso que el operario abre en el propio puesto, con foto y vídeo en cada paso y una única versión vigente. REELEVO es un software de instrucciones de trabajo digitales pensado para pymes industriales: se documenta desde el móvil y se consulta escaneando un QR en la máquina.',
  },
  {
    q: '¿Qué diferencia hay entre esto y tener los SOPs en PDF?',
    a: 'Dónde vive el documento y si alguien lo mira. Un PDF en una carpeta compartida obliga al operario a ir a buscarlo, así que en la práctica pregunta al veterano. Aquí el proceso aparece en el puesto, con fotos y vídeo del paso, y con una única versión vigente para toda la planta.',
  },
  {
    q: '¿Cómo accede el operario al proceso en el puesto?',
    a: 'Escaneando un QR colocado en la máquina desde su móvil. No necesita instalar nada, ni crear una cuenta, ni recordar una contraseña, que es justo lo que hace fracasar la adopción con personal temporal o con plantilla poco habituada a herramientas digitales.',
  },
  {
    q: '¿Cuántos procesos hay que documentar para empezar?',
    a: 'Entre dos y cinco: los que más rotación tienen o más reprocesos generan. Los seis tipos que más se repiten son arranque y parada (la secuencia exacta y qué esperar en cada etapa), cambio de parámetros (valores, tolerancias y qué NO hacer), mantenimiento básico, troubleshooting (el árbol de diagnóstico de los fallos habituales), control de calidad (qué mira, toca y mide el operario) y limpieza GMP con checklist por zona para conformidad ISO/IATF. Documentar la planta entera antes de empezar a usar nada es el camino corto a que el proyecto se abandone.',
  },
  {
    q: '¿Hay que teclear todos los procedimientos desde cero?',
    a: 'No. Puedes subir los que ya tengas en Word o PDF y la IA propone el proceso troceado en pasos, en el idioma original del documento. Para lo que nunca se escribió, puedes grabar en vídeo al operario haciéndolo y se proponen los pasos a partir de lo que se ve. En los dos casos el resultado queda pendiente de revisión: tú lo corriges y lo apruebas antes de que llegue al puesto.',
  },
  {
    q: '¿Quién debe redactar la documentación?',
    a: 'El operario que domina el proceso, acompañado de alguien que le dé estructura. Cuando lo redacta calidad desde un despacho sale un documento formalmente correcto que pierde los detalles reales del puesto, que son precisamente los que evitan el error.',
  },
  {
    q: '¿Qué pasa cuando cambia un proceso?',
    a: 'Se actualiza una vez y el cambio llega a todos los puestos a la vez, con su versión. Desaparece la situación de tener tres revisiones distintas conviviendo en tres líneas, y no hay que reimprimir ni recoger copias antiguas.',
  },
];

const pageSchema = softwareApplicationSchema();

const schema = [pageSchema, faqPageSchema(faqs)];

---

<BaseLayout title={title} description={description} canonical={canonical} schema={schema} activeNav="" pageType="capacidad">
  <!-- HERO + PROBLEMA -->
  <section class="page-hero">
    <div class="eyebrow fade-up">Software de instrucciones de trabajo digitales</div>
    <h1 class="fade-up delay-1">El procedimiento no sirve <br><em>si está en una carpeta del servidor</em></h1>
    <p class="fade-up delay-2">Nadie abre un PDF del servidor con las manos sucias y la máquina parada. Por eso el procedimiento acaba siendo lo que recuerda el veterano, y por eso se documenta el 100 % y se usa el 0 %. Aquí vive en la máquina, se abre con el móvil y se consulta en tres segundos.</p>
    <div class="hero-cta fade-up delay-3" style="display:flex;gap:14px;justify-content:center;flex-wrap:wrap;">
      <a href="https://app.gmvsolutions.es/registro" class="btn-primary"
         data-cta data-cta-intent="registro" data-cta-location="hero" data-cta-trigger="06" data-cta-label="Registrarme en REELEVO">Registrarme en REELEVO</a>
      <a href="/video-demo/" class="btn-ghost"
         data-cta data-cta-intent="navegacion" data-cta-location="hero" data-cta-label="Ver el demo">Ver el demo →</a>
    </div>
  </section>

  <div class="divider"></div>

  <!-- CÓMO FUNCIONA — bloque dominante -->
  <section class="section">
    <div class="section-inner">
      <div class="fade-up">
        <div class="eyebrow">Cómo funciona</div>
        <h2 class="section-title">Documentación que se consulta</h2>
        <p class="section-sub">Un software de instrucciones de trabajo digitales no cambia el contenido del procedimiento: cambia dónde vive y quién lo escribe.</p>
      </div>

      <div class="solution-approach fade-up delay-1">
        <div class="feature">
          <Icon name="movil" class="feature-icon icon--draw" />
          <h3>Accesible en tres segundos</h3>
          <p>QR en la máquina y el SOP se abre directo desde el móvil, sin instalar nada, sin cuenta y sin contraseña que recordar. Si la wifi cae con el proceso ya abierto, sigue ahí.</p>
        </div>

        <div class="feature">
          <Icon name="persona" class="feature-icon icon--draw" />
          <h3>Escrito por quien lo domina</h3>
          <p>El operario experto lo documenta mientras trabaja, así que incluye los puntos críticos y el troubleshooting que solo él conoce: «si la presión sube, espera 30 segundos».</p>
        </div>

        <div class="feature">
          <Icon name="ciclo" class="feature-icon icon--draw" />
          <h3>Paso a paso, con confirmación</h3>
          <p>No es «lee esto y adivina el siguiente paso»: es paso 1, check, paso 2, check. Con foto y vídeo en cada uno.</p>
        </div>

        <div class="feature">
          <Icon name="grafica" class="feature-icon icon--draw" />
          <h3>Una sola versión vigente</h3>
          <p>Cambia un parámetro, se actualiza una vez y llega a todos los puestos a la vez. Y cuando el tutor anota algo que no estaba claro, el turno siguiente ya lo ve.</p>
        </div>
      </div>

      <p class="data-point fade-up delay-2">
        El <strong>77 % de las pymes industriales españolas</strong> no tiene procedimientos operativos
        documentados y actualizados.
        <span class="data-source">Fuente: Encuesta REELEVO 2025 sobre dependencia operativa en pymes industriales.</span>
      </p>

      <div class="screenshot-pair fade-up delay-2">
        <figure class="screenshot-fig">
          <Screenshot name="sop-operario" alt="Vista del operario ejecutando un SOP en REELEVO: paso a paso con vídeo, confirmación y botón de incidencia" class="screenshot-img" layout="pair" />
          <figcaption class="screenshot-caption">Vista del operario — SOP paso a paso con vídeo integrado y confirmación de cada paso</figcaption>
        </figure>
        <figure class="screenshot-fig">
          <Screenshot name="gestion-productos-procesos" alt="Gestión de productos y procesos en REELEVO: lista de productos con secuencias de procesos" class="screenshot-img" layout="pair" />
          <figcaption class="screenshot-caption">Gestión de productos — secuencias de procesos por máquina y producto</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <div class="divider"></div>

  <!-- PRUEBA / LA OBJECIÓN -->
  <!-- Datos verificados en reelevo-app: /api/empresa/import/start (PDF y DOCX,
       10 MB, Claude Sonnet) y /api/empresa/procesos/video-to-steps (hasta 15
       frames extraidos en el navegador con FFmpeg WASM, Claude vision). El job
       queda en estado needs_review: no se publica nada sin aprobar. -->
  <section class="section" id="importar">
    <div class="section-inner">
      <div class="fade-up">
        <div class="eyebrow">La objeción de verdad</div>
        <h2 class="section-title">«Pasar mis procedimientos a esto <br><em>me va a costar meses</em>»</h2>
        <p class="section-sub">
          No es el precio ni la resistencia del operario: es que alguien tiene que escribir cien procedimientos desde cero.
        </p>
      </div>

      <div class="import-grid fade-up delay-1">
        <article class="import-card">
          <div class="import-tag">Word y PDF</div>
          <h3 class="import-title">Lo que ya tienes escrito</h3>
          <p class="import-desc">
            Sueltas el documento —hasta 10 MB— y la IA lo propone troceado en hasta 20 pasos, en su idioma original.
          </p>
        </article>

        <article class="import-card">
          <div class="import-tag">Vídeo</div>
          <h3 class="import-title">Lo que solo está en la cabeza de alguien</h3>
          <p class="import-desc">
            Grabas al operario haciéndolo y los pasos se proponen a partir de lo que se ve.
          </p>
        </article>

        <article class="import-card">
          <div class="import-tag">Siempre revisado</div>
          <h3 class="import-title">La IA propone, tú apruebas</h3>
          <p class="import-desc">
            Queda <strong>pendiente de revisión</strong>: nada llega al puesto sin que una persona lo valide.
          </p>
        </article>
      </div>

      <p class="roles-line fade-up delay-2">Es la base de otras cosas: <a href="/casos-de-uso/cobertura-bajas/">cobertura de bajas</a> · <a href="/casos-de-uso/onboarding-operarios/">onboarding de operarios</a> · <a href="/para-quien/responsable-calidad/">para calidad</a>.</p>

      <div class="import-note fade-up delay-3">
        <strong>Lo que esto no es:</strong> no documenta tu planta sola. El criterio lo sigue poniendo
        quien conoce la máquina. Lo que se ahorra es la página en blanco — que es donde estos proyectos se paran.
      </div>
    </div>
  </section>

  <div class="divider"></div>

  <FaqSection items={faqs} />

  <div class="divider"></div>

  <!-- SIGUIENTE PASO -->
  <section class="cta-section">
    <div class="cta-eyebrow fade-up">Empieza por uno</div>
    <h3 class="cta-title fade-up delay-1">
      Documenta primero <br><em>el proceso que más te cuesta repetir</em>
    </h3>
    <p class="cta-sub fade-up delay-2">
      No hace falta ordenar toda la planta de golpe. Con un proceso crítico disponible donde se trabaja ya cambia la forma de operar.
    </p>
    <div class="cta-actions fade-up delay-3">
      <a href="https://app.gmvsolutions.es/registro" class="btn-primary"
         data-cta data-cta-intent="registro" data-cta-location="footer" data-cta-trigger="06" data-cta-label="Registrarme en REELEVO">
        Registrarme en REELEVO
      </a>
      <a href="/gestion-competencias/" class="btn-ghost">
        Ver gestión de competencias →
      </a>
    </div>
  </section>

</BaseLayout>

<style>
  /* CÓMO FUNCIONA — bloque dominante */
  .solution-approach {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
    margin-top: 44px;
  }

  @media (max-width: 860px) {
    .solution-approach { grid-template-columns: 1fr; }
  }

  .feature {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 24px;
  }

  .feature-icon { margin-bottom: 12px; }

  .feature h3 {
    font-family: 'Oswald', sans-serif;
    font-size: 1rem;
    margin-bottom: 10px;
    color: var(--white);
  }

  .feature p {
    font-size: .95rem;
    color: var(--gray);
    line-height: 1.65;
    margin: 0;
  }

  .data-point {
    max-width: 68ch;
    margin: 28px 0 0;
    font-size: .95rem;
    line-height: 1.7;
    color: var(--gray);
  }

  .data-point strong { color: var(--white); font-weight: 500; }

  .data-source {
    display: block;
    margin-top: 6px;
    font-size: .8rem;
    color: var(--gray2);
  }

  /* IMPORTACIÓN CON IA */
  .import-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
    margin-top: 40px;
  }

  @media (max-width: 860px) {
    .import-grid { grid-template-columns: 1fr; }
  }

  .import-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 24px;
  }

  .import-tag {
    font-family: 'DM Mono', monospace;
    font-size: .7rem;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--orange);
    margin-bottom: 12px;
  }

  .import-title {
    font-family: 'Oswald', sans-serif;
    font-size: 1rem;
    margin-bottom: 10px;
    color: var(--white);
  }

  .import-desc {
    font-size: .95rem;
    line-height: 1.65;
    color: var(--gray);
    margin: 0;
  }

  .import-desc strong { color: var(--white); font-weight: 500; }

  .import-note {
    max-width: 900px;
    margin-top: 28px;
    padding: 20px 24px;
    background: rgba(255, 255, 255, .03);
    border-left: 2px solid var(--orange);
    border-radius: 0 4px 4px 0;
    font-size: .92rem;
    line-height: 1.7;
    color: var(--gray);
  }

  .import-note strong { color: var(--white); font-weight: 500; }

  .roles-line {
    margin-top: 28px;
    font-size: .95rem;
    color: var(--gray);
  }

  .roles-line a {
    color: var(--orange);
    text-decoration: none;
    border-bottom: 1px solid rgba(244, 82, 30, .35);
  }

  .roles-line a:hover {
    border-bottom-color: var(--orange);
  }
</style>
