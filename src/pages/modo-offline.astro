---
import Ilustracion from '../components/Ilustracion.astro';
import Icon from '../components/Icon.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import FaqSection from '../components/FaqSection.astro';
import { softwareApplicationSchema, faqPageSchema, type FaqItem } from '../lib/seo';
import { getPagina, conNegritas, sinMarcas } from '../lib/contenido';

// Textos editables desde Sanity (Páginas de funcionalidad). Respaldo: src/data/paginas/modo-offline.json.
const pagina = await getPagina('modo-offline');

const title = pagina.seo.title;
const description = pagina.seo.description;
const canonical = "https://www.gmvsolutions.es/modo-offline/";

// Una sola lista alimenta el bloque visible y el FAQPage del head (auditoria P6).
//
// La seccion "Que es una PWA" (tabla comparativa de 10 items) se elimino: la
// segunda pregunta ya respondia lo mismo, y se le anadio el detalle que solo
// estaba en la tabla (tarea C3 de PLAN_SIMPLIFICACION_EDITORIAL_WEB_2026-08.md).
const faqs: FaqItem[] = pagina.faq.items.map(({ q, a }) => ({ q, a: sinMarcas(a) }));

const pageSchema = softwareApplicationSchema();

const schema = [pageSchema, faqPageSchema(faqs)];
---

<BaseLayout title={title} description={description} canonical={canonical} schema={schema} activeNav="" pageType="capacidad">

  <!-- HERO + PROBLEMA -->
  <section class="page-hero">
    <div class="eyebrow fade-up">{pagina.hero.antetitulo}</div>
    <h1 class="fade-up delay-1">{pagina.hero.titulo}{pagina.hero.tituloDestacado && <> <br> <em>{pagina.hero.tituloDestacado}</em></>}</h1>
    <p class="fade-up delay-2" set:html={conNegritas(pagina.hero.texto)} />
    <div class="hero-cta fade-up delay-3">
      {pagina.hero.botones[0] && (
<a href={pagina.hero.botones[0].url} class="btn-primary"
         data-cta data-cta-intent="registro" data-cta-location="hero" data-cta-label="Registrarse gratis">{pagina.hero.botones[0].texto}</a>
)}
    </div>
    <Ilustracion escena="modo-offline" />
  </section>

  <div class="divider"></div>

  <!-- CÓMO FUNCIONA — bloque dominante -->
  <section class="section">
    <div class="section-inner">
      <div class="fade-up">
        <div class="eyebrow">Modo offline</div>
        <h2 class="section-title">La conexión se corta — el trabajo no se para</h2>
        <p class="section-sub">La tecnología tiene que funcionar en las condiciones de planta, no en las ideales. Si depende de conexión estable, deja de servir justo en el momento que importa.</p>
      </div>

      <div class="offline-flow fade-up delay-1">
        <div class="offline-step">
          <Icon name="conexion" class="os-icon icon--draw" />
          <div class="os-content">
            <h3>Con conexión: todo normal</h3>
            <p>El operario abre el proceso desde el QR y trabaja. Los datos viajan al servidor según ocurren y el supervisor ve la actividad en vivo.</p>
          </div>
        </div>

        <div class="offline-arrow">→</div>

        <div class="offline-step offline-cut">
          <Icon name="conexion" class="os-icon icon--draw" />
          <div class="os-content">
            <h3>Se cae la señal: el proceso abierto sigue</h3>
            <p>Lo que ya tenía delante no desaparece y puede seguir avanzando por los pasos. Lo que registra —unidades, incidencias, firmas— queda en una cola en el propio dispositivo.</p>
          </div>
        </div>

        <div class="offline-arrow">→</div>

        <div class="offline-step">
          <Icon name="ciclo" class="os-icon icon--draw" />
          <div class="os-content">
            <h3>Vuelve la conexión: se envía solo</h3>
            <p>La cola se sincroniza sola en segundo plano. El operario no tiene que acordarse de nada y el supervisor recupera la actividad del hueco.</p>
          </div>
        </div>
      </div>

      <div class="cache-note fade-up delay-2">
        <h3>Qué sigue disponible sin cobertura</h3>
        <div class="cache-items">
          <div class="cache-item">La aplicación en sí, sin esperar a que cargue</div>
          <div class="cache-item">Los procesos y pantallas ya abiertos en ese móvil</div>
          <div class="cache-item">Las fotos y recursos que ya se habían visto</div>
          <div class="cache-item">La cola de lo registrado, hasta que vuelva la red</div>
        </div>
        <p class="cache-limit">
          <strong>Y qué no:</strong> un proceso que ese dispositivo no haya abierto nunca necesita conexión
          para descargarse la primera vez. El modo offline cubre los cortes de cobertura durante la ejecución
          —que es el problema real en una nave— no una operación desconectada de principio a fin.
        </p>
      </div>
    </div>
  </section>

  <div class="divider"></div>

  <!-- QUÉ INCLUYE -->
  <section class="section">
    <div class="section-inner">
      <div class="fade-up">
        <div class="eyebrow">Cuándo es especialmente útil</div>
        <h2 class="section-title">No todas las plantas tienen la misma conectividad</h2>
      </div>

      <div class="usecase-grid fade-up delay-1">
        <div class="usecase-card">
          <h3>Naves con zonas muertas</h3>
          <p>Maquinaria pesada y estructuras metálicas que interfieren la señal, con el operario moviéndose entre puestos.</p>
        </div>

        <div class="usecase-card">
          <h3>Obra e instalación en cliente</h3>
          <p>Basta con abrir los procesos del día antes de salir para trabajar donde no hay wifi.</p>
        </div>

        <div class="usecase-card">
          <h3>Dispositivos sin datos móviles</h3>
          <p>Tablets o móviles de empresa sin SIM: el modo offline es la red de seguridad cuando la wifi falla.</p>
        </div>

        <div class="usecase-card">
          <h3>Sectores con interferencias</h3>
          <p>Alimentaria, metalúrgica o química, donde la maquinaria o los protocolos de higiene limitan la cobertura.</p>
        </div>
      </div>

      <p class="roles-line fade-up delay-2">Relacionado: <a href="/portal-operario/">portal del operario</a> · <a href="/documentacion-procesos/">documentación de procesos</a>.</p>
    </div>
  </section>

  <div class="divider"></div>

  <FaqSection items={faqs} />

  <div class="divider"></div>

  <!-- SIGUIENTE PASO -->
  <section class="cta-section">
    <div class="cta-eyebrow fade-up">{pagina.ctaFinal.antetitulo}</div>
    <h3 class="cta-title fade-up delay-1">{pagina.ctaFinal.titulo}{pagina.ctaFinal.tituloDestacado && <> <br> <em>{pagina.ctaFinal.tituloDestacado}</em></>}</h3>
    <p class="cta-sub fade-up delay-2" set:html={conNegritas(pagina.ctaFinal.texto)} />
    <div class="cta-actions fade-up delay-3">
      {pagina.ctaFinal.botones[0] && (
<a href={pagina.ctaFinal.botones[0].url} class="btn-primary"
         data-cta data-cta-intent="registro" data-cta-location="footer" data-cta-label="Registrarme en REELEVO">{pagina.ctaFinal.botones[0].texto}</a>
)}
      {pagina.ctaFinal.botones[1] && (
<a href={pagina.ctaFinal.botones[1].url} class="btn-ghost">{pagina.ctaFinal.botones[1].texto}</a>
)}
    </div>
  </section>

</BaseLayout>

<style>
  /* FLUJO OFFLINE — bloque dominante */
  .offline-flow {
    display: grid;
    grid-template-columns: 1fr auto 1fr auto 1fr;
    gap: 16px;
    align-items: stretch;
    margin-top: 48px;
  }

  @media (max-width: 900px) {
    .offline-flow { grid-template-columns: 1fr; }
    .offline-arrow { transform: rotate(90deg); justify-self: center; }
  }

  .offline-step {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 26px 22px;
  }

  .offline-step.offline-cut { border-color: var(--orange); }

  .os-icon { margin-bottom: 14px; }

  .os-content h3 {
    font-family: 'Oswald', sans-serif;
    font-size: 1.02rem;
    margin-bottom: 10px;
    color: var(--white);
  }

  .os-content p {
    font-size: .95rem;
    line-height: 1.65;
    color: var(--gray);
    margin: 0;
  }

  .offline-arrow {
    display: flex;
    align-items: center;
    font-size: 1.4rem;
    color: var(--orange-ink);
  }

  .cache-note {
    margin-top: 36px;
    padding: 26px 28px;
    background: var(--surface2);
    border: 1px solid var(--border);
    border-radius: 8px;
    max-width: 900px;
  }

  .cache-note h3 {
    font-family: 'Oswald', sans-serif;
    font-size: 1.02rem;
    margin: 0 0 16px;
    color: var(--white);
  }

  .cache-items {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px 24px;
  }

  @media (max-width: 700px) {
    .cache-items { grid-template-columns: 1fr; }
  }

  .cache-item {
    position: relative;
    padding-left: 20px;
    font-size: .95rem;
    line-height: 1.6;
    color: var(--gray);
  }

  .cache-item::before {
    content: '';
    position: absolute;
    left: 0;
    top: .72em;
    width: 8px;
    height: 1px;
    background: var(--green);
  }

  .cache-limit {
    margin: 20px 0 0;
    padding-top: 18px;
    border-top: 1px solid var(--border);
    font-size: .92rem;
    line-height: 1.7;
    color: var(--gray);
  }

  .cache-limit strong { color: var(--orange-ink); font-weight: 500; }

  /* CUÁNDO ES ÚTIL */
  .usecase-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 20px;
    margin-top: 40px;
  }

  @media (max-width: 1000px) {
    .usecase-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 620px) {
    .usecase-grid { grid-template-columns: 1fr; }
  }

  .usecase-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 22px 20px;
  }

  .usecase-card h3 {
    font-family: 'Oswald', sans-serif;
    font-size: .98rem;
    margin-bottom: 10px;
    color: var(--white);
  }

  .usecase-card p {
    font-size: .95rem;
    line-height: 1.6;
    color: var(--gray);
    margin: 0;
  }

  .roles-line {
    margin-top: 28px;
    font-size: .95rem;
    color: var(--gray);
  }

  .roles-line a {
    color: var(--orange-ink);
    text-decoration: none;
    border-bottom: 1px solid rgba(244, 82, 30, .35);
  }

  .roles-line a:hover {
    border-bottom-color: var(--orange);
  }
</style>
