---
import BaseLayout from '../layouts/BaseLayout.astro';
import FaqSection from '../components/FaqSection.astro';
import { softwareApplicationSchema, faqPageSchema, type FaqItem } from '../lib/seo';

const title = "Software industrial en modo offline | REELEVO";
const description = "El flujo de ejecución de REELEVO aguanta los cortes de wifi de planta: lo ya abierto sigue disponible y lo registrado se encola y sincroniza solo.";
const canonical = "https://www.gmvsolutions.es/modo-offline/";

// Una sola lista alimenta el bloque visible y el FAQPage del head (auditoria P6).
const faqs: FaqItem[] = [
  {
    q: '¿Aguanta REELEVO los cortes de wifi en planta?',
    a: 'Sí, en el flujo de ejecución. Lo que el operario ya ha abierto con cobertura sigue disponible cuando la señal cae, y lo que registra se guarda en el dispositivo y se envía solo al recuperar la red. Está pensado para las zonas muertas de una nave, que es el caso real en un taller.',
  },
  {
    q: '¿Hay que instalar una app desde la tienda?',
    a: 'No. Se accede desde el navegador del móvil, normalmente escaneando un QR en la máquina. Evitar la tienda de aplicaciones importa más de lo que parece: con personal temporal, cualquier paso previo de instalación o registro tumba la adopción.',
  },
  {
    q: '¿Qué pasa con los datos mientras no hay conexión?',
    a: 'Las acciones quedan en una cola en el propio dispositivo y se envían cuando vuelve la cobertura, sin que el operario tenga que acordarse de sincronizar. Es lo que permite que un hueco de señal a mitad de proceso no obligue a repetir el registro.',
  },
  {
    q: '¿Puede empezar un proceso que no ha abierto nunca, estando sin cobertura?',
    a: 'No. Sin conexión sigue disponible lo que ya se había cargado en ese dispositivo; un proceso que no se ha abierto antes necesita red para descargarse la primera vez. Por eso lo describimos como resistencia a los cortes de cobertura y no como un modo offline completo.',
  },
  {
    q: '¿Cuánto tiempo puede estar un dispositivo sin conexión?',
    a: 'Está pensado para huecos de cobertura dentro de una jornada: zonas muertas, sótanos, naves con estructura metálica. No está pensado para trabajar semanas completamente desconectado, porque entonces nadie en oficina ve lo que pasa en planta.',
  },
];

const pageSchema = softwareApplicationSchema();

const schema = [pageSchema, faqPageSchema(faqs)];
---

<BaseLayout title={title} description={description} canonical={canonical} schema={schema} activeNav="" pageType="capacidad">

  <!-- PAGE HERO -->
  <section class="page-hero">
    <div class="eyebrow fade-up">PWA · Modo offline · Sincronización automática · Sin app store</div>
    <h1 class="fade-up delay-1">La wifi de planta se cae.<br><em>El proceso no se interrumpe.</em></h1>
    <p class="fade-up delay-2">REELEVO es una Progressive Web App que el operario instala en su móvil en un toque — sin App Store ni Google Play. Si la señal cae a mitad de un proceso, lo que ya tenía abierto sigue ahí y lo que registra se encola y se envía solo al volver la red.</p>
    <div class="hero-cta fade-up delay-3">
      <a href="https://app.gmvsolutions.es/registro" class="btn-primary"
         data-cta data-cta-intent="registro" data-cta-location="hero" data-cta-label="Registrarse gratis">Registrarse gratis</a>
    </div>
  </section>

  <div class="divider"></div>

  <!-- EL PROBLEMA -->
  <section class="section">
    <div class="section-inner">
      <div class="fade-up">
        <div class="eyebrow">El problema</div>
        <h2 class="section-title">Planta industrial y conectividad fiable no siempre van juntas</h2>
      </div>

      <div class="challenge-content fade-up delay-1">
        <div class="challenge-list">
          <div class="challenge-item">
            <span class="icon">❌</span>
            <span>La señal wifi en planta es irregular — hay zonas muertas cerca de la maquinaria pesada o las estanterías metálicas</span>
          </div>
          <div class="challenge-item">
            <span class="icon">❌</span>
            <span>El operario no puede dejar la máquina parada mientras espera que la app cargue — necesita que funcione ahora mismo</span>
          </div>
          <div class="challenge-item">
            <span class="icon">❌</span>
            <span>Instalar apps en los dispositivos de los operarios requiere pasar por IT, por tiendas de apps, por gestión de cuentas — demasiada fricción</span>
          </div>
          <div class="challenge-item">
            <span class="icon">❌</span>
            <span>Los móviles personales del operario pueden no tener datos — o la empresa no quiere depender de los datos del empleado</span>
          </div>
        </div>
      </div>

      <div class="risk-box fade-up delay-2">
        <h3>La tecnología tiene que funcionar en las condiciones de planta — no en las condiciones ideales</h3>
        <p>Si la herramienta depende de conexión estable para funcionar, deja de ser útil en el momento más importante: cuando el operario está en planta produciendo.</p>
      </div>
    </div>
  </section>

  <div class="divider"></div>

  <!-- PWA EXPLICADA -->
  <section class="section">
    <div class="section-inner">
      <div class="fade-up">
        <div class="eyebrow">Qué es una PWA</div>
        <h2 class="section-title">Una app que no requiere la tienda de apps</h2>
        <p class="section-sub">Una Progressive Web App (PWA) es una web que se comporta como una aplicación nativa. Se instala en la pantalla de inicio del móvil, aguanta los cortes de conexión y recibe actualizaciones automáticamente — sin que el usuario haga nada.</p>
      </div>

      <div class="pwa-compare fade-up delay-1">
        <div class="pwa-col">
          <div class="pwa-col-title">App nativa (App Store / Google Play)</div>
          <ul class="pwa-list pwa-bad">
            <li>El operario necesita cuenta de tienda</li>
            <li>IT tiene que gestionar la instalación en cada dispositivo</li>
            <li>Las actualizaciones requieren acción del usuario</li>
            <li>Diferentes versiones entre dispositivos</li>
            <li>Ocupa espacio de almacenamiento significativo</li>
          </ul>
        </div>
        <div class="pwa-col">
          <div class="pwa-col-title">REELEVO como PWA</div>
          <ul class="pwa-list pwa-good">
            <li>El operario toca "Instalar" en el navegador — listo</li>
            <li>Sin cuenta de tienda, sin gestión de IT</li>
            <li>Las actualizaciones llegan solas, sin avisar</li>
            <li>Todos los dispositivos siempre en la misma versión</li>
            <li>Mínimo espacio — es una web optimizada</li>
          </ul>
        </div>
      </div>
    </div>
  </section>
  <!-- CTA intermedio (PROPUESTA_9_DISPARADORES_COMERCIAL_2026-08, M6b): esta
       pagina solo ofrecia registrarse en el hero y en el cierre. Quien llega por
       busqueda a media pagina no tenia salida sin hacer scroll hasta el final. -->
  <div class="divider"></div>

  <section class="section section-center">
    <div class="section-inner" style="max-width:680px;">
      <p class="section-sub fade-up" style="margin-bottom:24px;">La forma honesta de comprobar esto es en el punto muerto de tu propia nave, no en una demo con wifi de oficina.</p>
      <div class="fade-up delay-1">
        <a href="https://app.gmvsolutions.es/registro" class="btn-primary"
           data-cta data-cta-intent="registro" data-cta-location="mitad" data-cta-label="Probarlo en tu nave">Probarlo en tu nave</a>
      </div>
      <p class="cta-note fade-up delay-2" style="margin-top:16px;">60 días del plan Pro, sin tarjeta</p>
    </div>
  </section>


  <div class="divider"></div>

  <!-- MODO OFFLINE -->
  <section class="section">
    <div class="section-inner">
      <div class="fade-up">
        <div class="eyebrow">Modo offline</div>
        <h2 class="section-title">La conexión se corta — el trabajo no se para</h2>
      </div>

      <div class="offline-flow fade-up delay-1">
        <div class="offline-step">
          <div class="os-icon">📶</div>
          <div class="os-content">
            <h3>Con conexión: todo normal</h3>
            <p>El operario abre el proceso desde el QR y trabaja. Los datos viajan al servidor según ocurren, y el supervisor ve la actividad del turno mientras pasa. De paso, lo que se abre queda guardado en el dispositivo.</p>
          </div>
        </div>

        <div class="offline-arrow">→</div>

        <div class="offline-step offline-cut">
          <div class="os-icon">📵</div>
          <div class="os-content">
            <h3>Se cae la señal: el proceso abierto sigue</h3>
            <p>El proceso que el operario ya tenía delante no desaparece, y puede seguir avanzando por los pasos. Lo que registra —unidades, paradas, checklist— se guarda en una cola en el propio móvil en lugar de perderse.</p>
          </div>
        </div>

        <div class="offline-arrow">→</div>

        <div class="offline-step">
          <div class="os-icon">🔄</div>
          <div class="os-content">
            <h3>Vuelve la conexión: se envía solo</h3>
            <p>Al recuperar la red, la cola se envía sola en segundo plano. El operario no tiene que acordarse de sincronizar nada, y el supervisor ve los registros aparecer sin haber tenido que reclamarlos.</p>
          </div>
        </div>
      </div>

      <div class="cache-note fade-up delay-2">
        <h3>Qué sigue disponible sin cobertura</h3>
        <div class="cache-items">
          <div class="cache-item">La aplicación en sí, sin esperar a que cargue</div>
          <div class="cache-item">Los procesos y pantallas ya abiertos en ese móvil</div>
          <div class="cache-item">Las fotos y recursos que ya se habían visto</div>
          <div class="cache-item">La cola de lo registrado, hasta que vuelva la red</div>
        </div>
        <p class="cache-limit">
          <strong>Y qué no:</strong> un proceso que ese dispositivo no haya abierto nunca necesita conexión
          para descargarse la primera vez. El modo offline cubre los cortes de cobertura durante la ejecución
          —que es el problema real en una nave— no una operación desconectada de principio a fin.
        </p>
      </div>
    </div>
  </section>

  <div class="divider"></div>

  <!-- PARA QUIÉN -->
  <section class="section">
    <div class="section-inner">
      <div class="fade-up">
        <div class="eyebrow">Cuándo es especialmente útil</div>
        <h2 class="section-title">No todas las plantas tienen la misma conectividad</h2>
      </div>

      <div class="usecase-grid fade-up delay-1">
        <div class="usecase-card">
          <h3>Plantas grandes con zonas muertas</h3>
          <p>Naves industriales amplias con maquinaria pesada que interfiere la señal wifi. El operario se mueve entre puestos y la conexión varía. Con modo offline, el trabajo no depende de dónde esté el router.</p>
        </div>

        <div class="usecase-card">
          <h3>Trabajo exterior o en obra</h3>
          <p>Si el equipo trabaja en instalaciones de cliente, en obra o en zonas sin wifi, basta con abrir los procesos del día antes de salir: quedan disponibles en el dispositivo aunque allí no haya cobertura.</p>
        </div>

        <div class="usecase-card">
          <h3>Dispositivos sin datos móviles</h3>
          <p>Si los operarios usan tablets o móviles de empresa sin tarjeta SIM, el modo offline es la red de seguridad cuando la wifi falla — sin depender de los datos del empleado.</p>
        </div>

        <div class="usecase-card">
          <h3>Sectores con interferencias</h3>
          <p>Industria alimentaria, metalúrgica o química donde la maquinaria, las estructuras metálicas o los protocolos de higiene limitan el uso de dispositivos conectados constantemente.</p>
        </div>
      </div>
    </div>
  </section>

  <div class="divider"></div>

  <!-- CTA -->
  <FaqSection items={faqs} />

  <div class="divider"></div>

  <section class="cta-section">
    <div class="cta-eyebrow fade-up">Sigue aunque falle la red</div>
    <h3 class="cta-title fade-up delay-1">
      Una herramienta que funciona<br><em>cuando la conexión no acompaña</em>
    </h3>
    <p class="cta-sub fade-up delay-2">
      Haz una prueba en tu planta y comprueba cómo responde la PWA en el suelo real de trabajo, no solo en la oficina.
    </p>
    <div class="cta-actions fade-up delay-3">
      <a href="https://app.gmvsolutions.es/registro" class="btn-primary"
         data-cta data-cta-intent="registro" data-cta-location="footer" data-cta-label="Registrarme en REELEVO">
        Registrarse gratis
      </a>
      <a href="/portal-operario/" class="btn-ghost">
        Ver el portal del operario →
      </a>
    </div>
    <div class="cta-trust fade-up delay-4">Sin tarjeta de crédito · El operario lo instala solo y sigue trabajando</div>
  </section>

</BaseLayout>

<style>
  .challenge-content { max-width: 700px; margin-top: 40px; }

  .challenge-list {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin: 24px 0;
  }

  .challenge-item {
    display: flex;
    gap: 16px;
    align-items: flex-start;
    padding: 12px 16px;
    background: var(--surface);
    border-left: 3px solid rgba(255, 100, 0, 0.3);
    border-radius: 4px;
  }

  .challenge-item .icon { font-size: 1.2rem; flex-shrink: 0; }

  .challenge-item span:last-child {
    color: var(--gray);
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .risk-box {
    background: rgba(255, 100, 0, 0.08);
    border: 1px solid rgba(255, 150, 0, 0.25);
    border-radius: 6px;
    padding: 28px;
    margin-top: 32px;
    max-width: 700px;
  }

  .risk-box h3 { font-family: 'Oswald', sans-serif; margin-bottom: 12px; color: var(--text); }
  .risk-box p { color: var(--gray); line-height: 1.6; margin: 0; }

  /* PWA COMPARE */
  .pwa-compare {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
    margin-top: 40px;
    border: 1px solid var(--border);
    border-radius: 8px;
    overflow: hidden;
    max-width: 760px;
  }

  @media (max-width: 580px) {
    .pwa-compare { grid-template-columns: 1fr; }
  }

  .pwa-col { padding: 28px; }

  .pwa-col + .pwa-col {
    border-left: 1px solid var(--border);
    background: rgba(255, 100, 0, 0.04);
  }

  @media (max-width: 580px) {
    .pwa-col + .pwa-col { border-left: none; border-top: 1px solid var(--border); }
  }

  .pwa-col-title {
    font-family: 'Oswald', sans-serif;
    font-size: 0.82rem;
    text-transform: uppercase;
    letter-spacing: .05em;
    margin-bottom: 16px;
    color: var(--gray);
  }

  .pwa-col:last-child .pwa-col-title { color: var(--orange); }

  .pwa-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .pwa-list li {
    font-size: 0.88rem;
    color: var(--gray);
    line-height: 1.5;
    padding-left: 14px;
    position: relative;
  }

  .pwa-list li::before { content: '·'; position: absolute; left: 0; color: var(--orange); }

  /* OFFLINE FLOW */
  .offline-flow {
    display: flex;
    align-items: stretch;
    gap: 0;
    margin-top: 40px;
    max-width: 900px;
  }

  @media (max-width: 700px) {
    .offline-flow { flex-direction: column; }
    .offline-arrow { transform: rotate(90deg); text-align: center; padding: 8px 0; }
  }

  .offline-step {
    flex: 1;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .offline-step.offline-cut {
    border-color: rgba(255, 100, 0, 0.4);
    background: rgba(255, 100, 0, 0.04);
  }

  .offline-arrow {
    display: flex;
    align-items: center;
    padding: 0 12px;
    font-size: 1.5rem;
    color: var(--orange);
    flex-shrink: 0;
  }

  .os-icon { font-size: 1.8rem; }

  .os-content h3 {
    font-family: 'Oswald', sans-serif;
    font-size: 0.9rem;
    color: var(--text);
    margin-bottom: 6px;
  }

  .os-content p {
    font-size: 0.85rem;
    color: var(--gray);
    line-height: 1.55;
    margin: 0;
  }

  .cache-note {
    margin-top: 28px;
    padding: 20px 24px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 6px;
    max-width: 600px;
  }

  .cache-note h3 {
    font-family: 'Oswald', sans-serif;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: .05em;
    color: var(--gray);
    margin-bottom: 14px;
  }

  .cache-items {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .cache-item {
    font-size: 0.82rem;
    padding: 5px 12px;
    background: rgba(255, 100, 0, 0.07);
    border: 1px solid rgba(255, 100, 0, 0.15);
    border-radius: 3px;
    color: var(--gray);
  }

  /* El limite va junto a lo que si funciona, y no en una nota al pie: quien
     compra esto necesita saber donde acaba el offline antes de prometerlo
     en su planta. */
  .cache-limit {
    margin-top: 16px;
    padding-top: 16px;
    border-top: 1px solid var(--border);
    font-size: 0.85rem;
    line-height: 1.65;
    color: var(--gray);
  }

  .cache-limit strong { color: var(--white); font-weight: 500; }

  /* USE CASES */
  .usecase-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
    margin-top: 40px;
  }

  @media (max-width: 640px) {
    .usecase-grid { grid-template-columns: 1fr; }
  }

  .usecase-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 24px;
  }

  .usecase-card h3 {
    font-family: 'Oswald', sans-serif;
    font-size: 0.95rem;
    margin-bottom: 10px;
    color: var(--text);
  }

  .usecase-card p {
    font-size: 0.88rem;
    color: var(--gray);
    line-height: 1.6;
    margin: 0;
  }

  .cta-trust {
    margin-top: 16px;
    font-size: 0.82rem;
    color: rgba(255, 255, 255, 0.45);
    letter-spacing: .04em;
  }
</style>
