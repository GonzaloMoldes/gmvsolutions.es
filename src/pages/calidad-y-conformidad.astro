---
import Ilustracion from '../components/Ilustracion.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import FaqSection from '../components/FaqSection.astro';
import { faqPageSchema, type FaqItem } from '../lib/seo';
import Screenshot from '../components/Screenshot.astro';

const title = "Trazabilidad operativa de calidad industrial | REELEVO";
const description = "Trazabilidad operativa de calidad para auditoría interna en planta: qué proceso se siguió, cuándo y con qué resultado, sin depender de la memoria.";
const canonical = "https://www.gmvsolutions.es/calidad-y-conformidad/";

// Una sola lista alimenta el bloque visible y el FAQPage del head (auditoria P6).
//
// La quinta pregunta recoge la seccion "Continuidad del dato" (exportacion,
// historico y acompanamiento), que era un bloque de 3 tarjetas y solapaba con
// la pregunta de exportacion que ya existia (tarea C2 de
// PLAN_SIMPLIFICACION_EDITORIAL_WEB_2026-08.md).
const faqs: FaqItem[] = [
  {
    q: '¿Sirve REELEVO para una auditoría ISO 9001?',
    a: 'Sirve como evidencia operativa: qué proceso se siguió, en qué versión, quién lo ejecutó y con qué resultado. Eso cubre la parte que suele costar más de reconstruir en una auditoría interna. Lo que no hace es sustituir tu sistema de calidad ni garantizarte una certificación: eso sigue dependiendo del criterio del responsable y del alcance de la norma que te apliquen.',
  },
  {
    q: '¿Qué evidencia queda registrada de cada ejecución?',
    a: 'El proceso y su versión vigente en ese momento, el operario que lo ejecutó, la máquina o puesto, la fecha y hora, el resultado y las verificaciones o incidencias que aparecieron por el camino. Cuando la empresa lo necesita, puede añadirse además un identificador interno de seguimiento.',
  },
  {
    q: '¿Es lo mismo que un software de gestión de calidad (QMS)?',
    a: 'No. Un QMS cubre el sistema completo: política, auditorías, acciones correctivas, gestión documental normativa. REELEVO aporta la capa de abajo, la trazabilidad operativa de lo que realmente pasó en planta, que es justo la que suele faltar cuando llega la auditoría.',
  },
  {
    q: '¿Se puede exportar el histórico?',
    a: 'Sí. Los procesos, las instrucciones y los registros se pueden exportar para adjuntarlos a un informe de auditoría o cruzarlos con otros sistemas, y también consultarse vía API. El conocimiento documentado sigue siendo de la empresa, sin letra pequeña.',
  },
  {
    q: '¿Y si calidad necesita ver cómo encaja esto en su operativa?',
    a: 'Lo aterrizamos contigo sin vender humo regulatorio. Preferimos decirte que una parte de tu norma no queda cubierta a que lo descubras a mitad de una auditoría.',
  },
];

const pageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": title,
  "description": description,
  "url": canonical,
  "audience": {
    "@type": "Audience",
    "audienceType": "Quality Manager"
  }
};

const schema = [pageSchema, faqPageSchema(faqs)];
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  schema={schema}
  activeNav=""
  pageType="capacidad"
>
  <!-- HERO + PROBLEMA -->
  <section class="page-hero">
    <div class="eyebrow fade-up">Calidad y conformidad</div>
    <h1 class="fade-up delay-1">«¿Qué pasó con este lote?» <br><em>y la respuesta tarda tres días</em></h1>
    <p class="fade-up delay-2">
      Reconstruir a mano quién hizo qué, con qué versión del procedimiento y en qué máquina se lleva días,
      y acaba dependiendo de que alguien se acuerde. Cuando cada ejecución deja su registro, esa respuesta
      pasa a estar a un clic.
    </p>
    <div class="hero-cta-group fade-up delay-3">
      <a href="https://app.gmvsolutions.es/registro" class="btn-primary"
         data-cta data-cta-intent="registro" data-cta-location="hero" data-cta-trigger="01" data-cta-label="Registrarme en REELEVO">Registrarme en REELEVO</a>
      <a href="/video-demo/" class="btn-ghost"
         data-cta data-cta-intent="navegacion" data-cta-location="hero" data-cta-label="Ver el demo">Ver el demo →</a>
    </div>
    <div class="hero-cta-note fade-up delay-4">Sin promesas legales infladas · Enfoque práctico para revisión interna</div>
    <Ilustracion escena="calidad" />
  </section>

  <div class="divider"></div>

  <!-- CÓMO FUNCIONA — bloque dominante -->
  <!-- Verificado en reelevo-app: app/api/empresa/recalls/route.ts define
       severity informative|precautionary|mandatory y scope_type
       lot_reference|production_order|date_range|obra. El cron
       traceability-completeness vigila piezas sin lote y recalls con piezas
       pendientes >48 h. OJO: trazabilidad y recalls NO estan capados por plan
       (tarea A9 pendiente de decision), asi que no se atribuyen a ningun plan. -->
  <section class="section" id="recalls">
    <div class="section-inner">
      <div class="fade-up">
        <div class="eyebrow">Cuando algo sale mal</div>
        <h2 class="section-title">«Un cliente reclama un lote» <br><em>y hay que reconstruirlo a mano</em></h2>
        <p class="section-sub">
          Es el peor día del responsable de calidad: alguien pregunta por una entrega de hace tres meses
          y la respuesta está repartida entre partes en papel, un Excel y la memoria de quien estaba ese turno.
        </p>
      </div>

      <div class="recall-grid fade-up delay-1">
        <article class="recall-card">
          <div class="recall-tag">Buscar</div>
          <h3 class="recall-title">Localizar lo afectado</h3>
          <p class="recall-desc">De una referencia de lote sales a las piezas, las obras, los procesos ejecutados y los operarios que intervinieron.</p>
        </article>

        <article class="recall-card">
          <div class="recall-tag">Acotar</div>
          <h3 class="recall-title">Definir el alcance</h3>
          <p class="recall-desc">Por <strong>lote</strong>, <strong>orden de producción</strong>, <strong>rango de fechas</strong> u <strong>obra</strong>. Es lo que evita retirar de más —caro— o de menos —peor—.</p>
        </article>

        <article class="recall-card">
          <div class="recall-tag">Clasificar</div>
          <h3 class="recall-title">Tres niveles de severidad</h3>
          <p class="recall-desc"><strong>Obligatorio</strong>, <strong>precautorio</strong> o <strong>informativo</strong>: no es lo mismo avisar de una desviación menor que retirar producto del mercado.</p>
        </article>

        <article class="recall-card">
          <div class="recall-tag">Contener</div>
          <h3 class="recall-title">Cuarentena por pieza</h3>
          <p class="recall-desc">Cada pieza lleva su estado dentro de la retirada, así que siempre se sabe qué queda pendiente y qué está resuelto.</p>
        </article>

        <article class="recall-card">
          <div class="recall-tag">Demostrar</div>
          <h3 class="recall-title">Informe público por pieza</h3>
          <p class="recall-desc">QR y página de trazabilidad con obra, producto, operarios, ejecuciones y lote, con informe descargable. Si lo activas, lo consulta el cliente final.</p>
        </article>

        <article class="recall-card">
          <div class="recall-tag">Vigilar</div>
          <h3 class="recall-title">Huecos detectados solos</h3>
          <p class="recall-desc">Una revisión diaria avisa de piezas producidas sin lote y de retiradas con piezas sin revisar, antes de que el hueco lo encuentre un cliente.</p>
        </article>
      </div>

      <div class="recall-note fade-up delay-2">
        <strong>Lo que hace posible todo esto</strong> no es un módulo de trazabilidad aparte, sino que el
        operario ya registra la ejecución en el puesto. La cadena lote → pieza → proceso → persona → turno
        se construye sola mientras se produce, que es la única forma de que esté completa el día que
        alguien pregunta.
      </div>
    </div>
  </section>

  <div class="divider"></div>

  <!-- QUÉ INCLUYE -->
  <section class="section">
    <div class="section-inner">
      <div class="fade-up">
        <div class="eyebrow">Qué deja el trabajo</div>
        <h2 class="section-title">Qué queda registrado de cada ejecución</h2>
      </div>

      <div class="proof-grid fade-up delay-1">
        <div class="proof-card proof-shot">
          <div class="proof-frame">
            <Screenshot name="admin-dashboard" alt="Panel empresa REELEVO para seguimiento operativo" layout="pair" />
          </div>
          <div class="proof-caption">Panel empresa: procesos, puestos y seguimiento interno en un solo lugar.</div>
        </div>

        <div class="proof-card proof-points">
          <div class="proof-point"><strong>Proceso y puesto:</strong> qué referencia se siguió y en qué contexto.</div>
          <div class="proof-point"><strong>Momento y versión:</strong> fecha, hora y versión visible del proceso.</div>
          <div class="proof-point"><strong>Resultado:</strong> si el flujo quedó completado y dónde hubo incidencias.</div>
          <div class="proof-point"><strong>Seguimiento:</strong> identificador interno cuando la empresa lo necesita.</div>
          <div class="proof-point"><strong>Revisión:</strong> validación o sign-off interno en los flujos que lo pidan.</div>
        </div>
      </div>

      <p class="roles-line fade-up delay-2">Aterrízalo en tu caso: <a href="/sectores/mecanizado-cnc/">mecanizado y CNC</a> · <a href="/para-quien/responsable-calidad/">para responsable de calidad</a> · <a href="/obras-trazabilidad/">obras y trazabilidad</a>.</p>
    </div>
  </section>

  <div class="divider"></div>

  <!-- LÍMITE -->
  <section class="section">
    <div class="section-inner">
      <div class="fade-up">
        <div class="eyebrow">Límites y alcance</div>
        <h2 class="section-title">Lo que sí es y lo que <em>no vamos a inflar</em></h2>
      </div>

      <div class="boundary-grid fade-up delay-1">
        <article class="boundary-card ok">
          <h3 class="boundary-title">Sí es</h3>
          <ul class="boundary-list">
            <li>Una base útil para revisión interna y operativa</li>
            <li>Más claridad para calidad, formación y seguimiento</li>
            <li>Soporte práctico para auditoría interna y conformidad operativa</li>
          </ul>
        </article>

        <article class="boundary-card caution">
          <h3 class="boundary-title">No es por sí solo</h3>
          <ul class="boundary-list">
            <li>Un sustituto automático de tu sistema de calidad</li>
            <li>Una certificación formal de competencias</li>
            <li>Una garantía legal universal para cualquier norma o sector</li>
            <li>Un reemplazo del criterio del responsable de calidad</li>
          </ul>
        </article>
      </div>
    </div>
  </section>

  <div class="divider"></div>

  <FaqSection items={faqs} />

  <div class="divider"></div>

  <!-- SIGUIENTE PASO -->
  <section class="cta-section">
    <div class="cta-eyebrow fade-up">¿Tiene sentido para tu caso?</div>
    <h3 class="cta-title fade-up delay-1">
      Si calidad necesita más claridad, <br><em>te enseñamos el encaje real</em>
    </h3>
    <p class="cta-sub fade-up delay-2">
      Sin promesas regulatorias infladas: te decimos qué parte queda cubierta y cuál no.
    </p>
    <div class="cta-actions fade-up delay-3">
      <a href="https://app.gmvsolutions.es/registro" class="btn-primary"
         data-cta data-cta-intent="registro" data-cta-location="footer" data-cta-trigger="01" data-cta-label="Registrarme en REELEVO">
        Registrarme en REELEVO
      </a>
      <a href="/firma-digital/" class="btn-ghost">
        Ver firma digital →
      </a>
    </div>
  </section>

</BaseLayout>

<style>
  /* RECALLS — bloque dominante */
  .recall-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
    margin-top: 44px;
  }

  @media (max-width: 1000px) {
    .recall-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 680px) {
    .recall-grid { grid-template-columns: 1fr; }
  }

  .recall-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 24px;
  }

  .recall-tag {
    font-family: 'IBM Plex Mono', monospace;
    font-size: .7rem;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--orange-ink);
    margin-bottom: 12px;
  }

  .recall-title {
    font-family: 'Archivo Narrow', sans-serif;
    font-size: 1rem;
    margin-bottom: 10px;
    color: var(--white);
  }

  .recall-desc {
    font-size: .95rem;
    line-height: 1.65;
    color: var(--gray);
    margin: 0;
  }

  .recall-desc strong { color: var(--white); font-weight: 500; }

  .recall-note {
    max-width: 900px;
    margin-top: 28px;
    padding: 20px 24px;
    background: rgba(20,22,24, .03);
    border-left: 2px solid var(--orange);
    border-radius: 0 4px 4px 0;
    font-size: .92rem;
    line-height: 1.75;
    color: var(--gray);
  }

  .recall-note strong { color: var(--white); font-weight: 500; }

  /* QUÉ QUEDA REGISTRADO */
  .proof-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    margin-top: 40px;
    align-items: start;
  }

  @media (max-width: 900px) {
    .proof-grid { grid-template-columns: 1fr; }
  }

  .proof-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 22px;
  }

  .proof-frame { border-radius: 4px; overflow: hidden; }

  .proof-caption {
    margin-top: 12px;
    font-family: 'IBM Plex Mono', monospace;
    font-size: .7rem;
    letter-spacing: .05em;
    color: var(--gray2);
    line-height: 1.5;
  }

  .proof-point {
    font-size: .95rem;
    line-height: 1.65;
    color: var(--gray);
    padding: 12px 0;
  }

  .proof-point + .proof-point { border-top: 1px solid var(--border); }

  .proof-point strong { color: var(--white); font-weight: 500; }

  /* LÍMITES */
  .boundary-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    margin-top: 40px;
    max-width: 900px;
  }

  @media (max-width: 760px) {
    .boundary-grid { grid-template-columns: 1fr; }
  }

  .boundary-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 24px;
  }

  .boundary-card.ok { border-left: 3px solid var(--green); }
  .boundary-card.caution { border-left: 3px solid var(--orange); }

  .boundary-title {
    font-family: 'Archivo Narrow', sans-serif;
    font-size: 1rem;
    margin-bottom: 14px;
    color: var(--white);
  }

  .boundary-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .boundary-list li {
    position: relative;
    padding-left: 18px;
    margin-bottom: 10px;
    font-size: .95rem;
    line-height: 1.6;
    color: var(--gray);
  }

  .boundary-list li:last-child { margin-bottom: 0; }

  .boundary-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: .7em;
    width: 7px;
    height: 1px;
    background: var(--orange);
  }

  .roles-line {
    margin-top: 28px;
    font-size: .95rem;
    color: var(--gray);
  }

  .roles-line a {
    color: var(--orange-ink);
    text-decoration: none;
    border-bottom: 1px solid rgba(244, 82, 30, .35);
  }

  .roles-line a:hover {
    border-bottom-color: var(--orange);
  }
</style>
