---
import Ilustracion from '../../components/Ilustracion.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FaqSection from '../../components/FaqSection.astro';
import { faqPageSchema, type FaqItem } from '../../lib/seo';

const title = "Software de operaciones para mecanizado CNC | REELEVO";
const description = "Software de operaciones para mecanizado CNC: continuidad en puestos críticos, procesos en el puesto y competencias visibles, sin la complejidad de un MES.";
const canonical = "https://www.gmvsolutions.es/sectores/mecanizado-cnc/";

// Esta pagina no tenia FAQ ni FAQPage en el head. Se anade, y absorbe las
// secciones "Lo que aporta" y "Limites y alcance" (tarea D4 de
// PLAN_SIMPLIFICACION_EDITORIAL_WEB_2026-08.md).
const faqs: FaqItem[] = [
  {
    q: '¿Qué aporta REELEVO concretamente en un taller de mecanizado?',
    a: 'Cuatro cosas medibles en el día a día: el puesto aguanta mejor bajas, cambios de turno y sustituciones sin depender tanto del titular; los arranques y cambios de utillaje delicados dejan de apoyarse solo en memoria o en una llamada; producción gana información para reorganizar y ver dónde sigue habiendo fragilidad; y el onboarding en puesto crítico deja una base útil para acompañar la autonomía del que aprende.',
  },
  {
    q: '¿Sirve si cada pieza que hacemos es distinta?',
    a: 'Sí, es el caso habitual en mecanizado por encargo. Lo que se documenta no es la pieza sino el proceso —el arranque de la máquina, el cambio de utillaje, el criterio de control— que se repite aunque la referencia cambie. Y cada unidad puede llevar su trazabilidad individual si el cliente la exige.',
  },
  {
    q: '¿Qué no hay que esperar de esto?',
    a: 'No es un sustituto de todos tus sistemas de planta, ni una promesa universal para cualquier proceso complejo, ni un reemplazo del criterio de producción o calidad. Tampoco es una garantía de rendimiento sin acompañamiento operativo: lo que sí aporta es menos improvisación en arranques y puestos críticos, más claridad para producción y calidad, y más continuidad cuando falta la persona clave.',
  },
];

const pageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "REELEVO para mecanizado y CNC - Onboarding software",
  "description": description,
  "url": canonical,
  "keywords": "onboarding software mecanizado, gestión de competencias CNC, HR software manufacturing",
  "audience": {
    "@type": "Audience",
    "audienceType": "CNC Machining Operations and HR"
  }
};

const schema = [pageSchema, faqPageSchema(faqs)];
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  schema={schema}
  activeNav=""
  pageType="sector"
>
  <section class="page-hero">
    <div class="eyebrow fade-up">Software de operaciones para mecanizado CNC</div>
    <h1 class="fade-up delay-1">Continuidad operativa en <br><em>mecanizado y CNC</em></h1>
    <p class="fade-up delay-2">
      En talleres y plantas CNC, los arranques, los cambios de referencia y las ausencias en puestos
      críticos no deberían parar la operación. REELEVO deja el proceso en el puesto y la competencia
      visible, para sostener la continuidad sin depender de una sola persona.
    </p>
    <div class="hero-cta-group fade-up delay-3">
      <a href="https://app.gmvsolutions.es/registro" class="btn-ghost"
         data-cta data-cta-intent="registro" data-cta-location="hero" data-cta-label="Registrarme en REELEVO">Registrarme en REELEVO</a>
    </div>
    <div class="hero-cta-note fade-up delay-4">Enfoque prudente · Continuidad operativa para puestos críticos</div>
    <Ilustracion escena="mecanizado-cnc" />
  </section>

  <div class="divider"></div>

  <section class="section">
    <div class="section-inner">
      <div class="fade-up">
        <div class="eyebrow">Dónde encaja mejor</div>
        <h2 class="section-title">Cuando un taller necesita <br><em>menos trabajo a ciegas</em></h2>
        <p class="section-sub">
          No hablamos de vender un MES ni una capa enterprise pesada.
          Hablamos de sostener mejor la operación cuando el saber hacer está demasiado concentrado
          en pocos puestos, pocas máquinas y pocas personas.
        </p>
      </div>

      <div class="fit-grid fade-up delay-1">
        <article class="fit-card">
          <div class="fit-tag">Puestos críticos</div>
          <h3 class="fit-title">Cuando la máquina depende demasiado del operario de siempre</h3>
          <p class="fit-desc">Ayuda a que la continuidad del puesto no viva solo en la memoria del titular ni en llamadas de última hora.</p>
        </article>

        <article class="fit-card">
          <div class="fit-tag">Cambios y ajustes</div>
          <h3 class="fit-title">Cuando un cambio de referencia no debería obligar a reconstruir el contexto</h3>
          <p class="fit-desc">Aporta una referencia más clara para arrancar, ajustar y trabajar con menos dudas en cambios sensibles.</p>
        </article>

        <article class="fit-card">
          <div class="fit-tag">Cobertura y onboarding</div>
          <h3 class="fit-title">Cuando cubrir una ausencia o incorporar a alguien castiga demasiado al equipo</h3>
          <p class="fit-desc">Reduce parte de la tutoría repetitiva y da más orden a incorporaciones en puestos donde el aprendizaje pesa mucho.</p>
        </article>
      </div>
    </div>
  </section>

  <div class="divider"></div>

  <section class="section">
    <div class="section-inner">
      <div class="fade-up">
        <div class="eyebrow">Escenarios reales</div>
        <h2 class="section-title">Tres momentos donde esto sí puede <br><em>marcar diferencia</em></h2>
      </div>

      <div class="scenario-grid fade-up delay-1">
        <article class="scenario-card">
          <div class="scenario-card-tag">Arranque</div>
          <h3 class="scenario-card-title">Cuando toca arrancar sin el titular del puesto</h3>
          <div class="scenario-before">
            <strong>Sin REELEVO:</strong>
            <ul>
              <li>El equipo busca a quién llamar antes de arrancar</li>
              <li>La máquina espera mientras se reconstruye el contexto</li>
              <li>Producción depende de la memoria de la persona clave</li>
            </ul>
          </div>
          <div class="scenario-after">
            <strong>Con REELEVO:</strong>
            <ul>
              <li>El puesto trabaja con una referencia más clara</li>
              <li>El sustituto arranca con menos dudas y menos espera</li>
              <li>Producción gana continuidad con menos trabajo a ciegas</li>
            </ul>
          </div>
        </article>

        <article class="scenario-card">
          <div class="scenario-card-tag">Cambio</div>
          <h3 class="scenario-card-title">Cuando una referencia nueva exige volver a explicar demasiado</h3>
          <div class="scenario-before">
            <strong>Sin REELEVO:</strong>
            <ul>
              <li>El cambio depende de explicaciones verbales y criterio tácito</li>
              <li>Cuesta ver qué estaba visible realmente en el puesto</li>
              <li>El aprendizaje se vuelve irregular según quién acompañe</li>
            </ul>
          </div>
          <div class="scenario-after">
            <strong>Con REELEVO:</strong>
            <ul>
              <li>El cambio aterriza con una base más clara en el puesto</li>
              <li>Hay más información útil para revisar cómo se está usando</li>
              <li>Producción y calidad comparten mejor la misma lectura</li>
            </ul>
          </div>
        </article>

        <article class="scenario-card">
          <div class="scenario-card-tag">Cobertura</div>
          <h3 class="scenario-card-title">Cuando una baja o una incorporación tensiona demasiado al taller</h3>
          <div class="scenario-before">
            <strong>Sin REELEVO:</strong>
            <ul>
              <li>Los perfiles más fuertes vuelven a enseñar lo mismo</li>
              <li>La producción pierde tiempo productivo para cubrir el hueco</li>
              <li>La continuidad del puesto se resiente justo cuando más duele</li>
            </ul>
          </div>
          <div class="scenario-after">
            <strong>Con REELEVO:</strong>
            <ul>
              <li>La cobertura gana más orden desde el primer día</li>
              <li>Se reduce parte del tiempo que hoy se va en tutoría repetitiva</li>
              <li>El taller sostiene mejor puestos críticos y cambios de turno</li>
            </ul>
          </div>
        </article>
      </div>
    </div>
  </section>

  <div class="divider"></div>

  <FaqSection items={faqs} />

  <div class="divider"></div>

  <section class="cta-section">
    <div class="cta-eyebrow fade-up">¿Tiene sentido en tu taller?</div>
    <h3 class="cta-title fade-up delay-1">
      Si trabajas en mecanizado o CNC, <br><em>vemos el encaje real contigo</em>
    </h3>
    <p class="cta-sub fade-up delay-2">
      Si te encaja, regístrate en REELEVO y pruébalo en tu planta y valora si puede aportar más continuidad,
      más claridad y menos dependencia del titular en tu operativa real.
    </p>
    <div class="cta-actions fade-up delay-3">
      <a href="https://app.gmvsolutions.es/registro" class="btn-primary"
         data-cta data-cta-intent="registro" data-cta-location="footer" data-cta-label="Registrarme en REELEVO">Registrarme en REELEVO</a>
      <a href="/como-funciona/" class="btn-ghost">Ver cómo funciona →</a>
    </div>
    <div class="cta-note fade-up delay-4"> <br />Ver también <a href="/para-quien/jefe-de-produccion/">jefe de producción</a>, <a href="/para-quien/responsable-calidad/">responsable de calidad</a> o el sector <a href="/sectores/alimentacion/">alimentación</a>.</div>
  </section>
</BaseLayout>

<style>
  .fit-grid,
  .scenario-grid,
  .value-grid,
  .boundary-grid {
    display: grid;
    gap: 24px;
  }

  .fit-grid {
    grid-template-columns: repeat(3, 1fr);
    margin-top: 48px;
  }

  .scenario-grid {
    grid-template-columns: repeat(3, 1fr);
    margin-top: 48px;
  }

  .value-grid {
    grid-template-columns: repeat(4, 1fr);
    margin-top: 44px;
  }

  .boundary-grid {
    grid-template-columns: repeat(2, 1fr);
    margin-top: 40px;
  }

  .fit-card,
  .scenario-card,
  .value-card,
  .boundary-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 6px;
    text-align: left;
  }

  .fit-card,
  .value-card,
  .boundary-card,
  .scenario-card {
    padding: 28px 24px;
  }

  .fit-tag,
  .scenario-card-tag {
    font-family: 'IBM Plex Mono', monospace;
    font-size: .7rem;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--orange-ink);
    margin-bottom: 12px;
  }

  .fit-title,
  .scenario-card-title,
  .value-title,
  .boundary-title {
    font-family: 'Archivo Narrow', sans-serif;
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: .03em;
    margin-bottom: 12px;
    color: var(--white);
  }

  .fit-desc,
  .value-desc,
  .scenario-before,
  .scenario-after,
  .boundary-list li {
    font-size: .95rem;
    color: var(--gray);
    line-height: 1.65;
  }

  .scenario-before,
  .scenario-after {
    margin-top: 16px;
  }

  .scenario-before strong,
  .scenario-after strong {
    display: block;
    color: var(--white);
    margin-bottom: 8px;
  }

  .scenario-before ul,
  .scenario-after ul,
  .boundary-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .scenario-before li,
  .scenario-after li,
  .boundary-list li {
    padding: 10px 0;
    border-top: 1px solid var(--border);
  }

  .scenario-before li:first-child,
  .scenario-after li:first-child,
  .boundary-list li:first-child {
    border-top: none;
    padding-top: 0;
  }

  .boundary-card.ok {
    border-color: rgba(34,197,94,.2);
  }

  .boundary-card.caution {
    border-color: rgba(244,82,30,.25);
  }

  @media (max-width: 1100px) {
    .fit-grid,
    .scenario-grid,
    .value-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 820px) {
    .fit-grid,
    .scenario-grid,
    .value-grid,
    .boundary-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

