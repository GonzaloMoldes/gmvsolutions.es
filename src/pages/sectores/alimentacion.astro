---
import Ilustracion from '../../components/Ilustracion.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FaqSection from '../../components/FaqSection.astro';
import { faqPageSchema, type FaqItem } from '../../lib/seo';

const title = "Software SOP para industria alimentaria | REELEVO";
const description = "Software SOP para industria alimentaria: estandariza procesos sensibles y mejora la trazabilidad en alimentación y la revisión interna en planta.";
const canonical = "https://www.gmvsolutions.es/sectores/alimentacion/";

// Esta pagina no tenia FAQ ni FAQPage en el head. Se anade, y absorbe las
// secciones "Lo que aporta" y "Limites y alcance" (tarea D4 de
// PLAN_SIMPLIFICACION_EDITORIAL_WEB_2026-08.md).
const faqs: FaqItem[] = [
  {
    q: '¿Qué aporta REELEVO concretamente en una planta alimentaria?',
    a: 'El puesto aguanta mejor bajas y rotación sin depender del titular; los cambios de formato y los protocolos de limpieza dejan de apoyarse en memoria; producción y calidad ganan información para reorganizar y revisar dónde hay fragilidad; y la formación en puesto deja una base útil para acompañar la autonomía, que con personal de campaña es justo lo que falta.',
  },
  {
    q: '¿Encaja con los requisitos de higiene y conformidad del sector?',
    a: 'Como capa operativa, sí: los checklists de limpieza por zona quedan ejecutados y fechados, con foto donde haga falta, y cada ejecución deja constancia de quién la hizo y con qué versión del procedimiento. Lo que no hace es sustituir tu sistema de calidad ni garantizarte por sí solo una certificación concreta.',
  },
  {
    q: '¿Qué no hay que esperar de esto?',
    a: 'No es un sustituto de todos tus sistemas de planta, ni una promesa universal para cualquier proceso complejo, ni un reemplazo del criterio de producción o calidad. Tampoco es una garantía de rendimiento sin acompañamiento operativo: lo que sí aporta es menos improvisación en cambios de formato y puestos críticos, más claridad para producción y calidad, y más continuidad cuando falta la persona clave.',
  },
];

const pageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "REELEVO para industria alimentaria - Onboarding software",
  "description": description,
  "url": canonical,
  "keywords": "onboarding software alimentaria, HR software manufacturing, gestión de competencias planta",
  "audience": {
    "@type": "Audience",
    "audienceType": "Food Industry HR and Operations"
  }
};

const schema = [pageSchema, faqPageSchema(faqs)];
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  schema={schema}
  activeNav=""
  pageType="sector"
>
  <section class="page-hero">
    <div class="eyebrow fade-up">Software SOP para industria alimentaria</div>
    <h1 class="fade-up delay-1">Procesos estandarizados para <br><em>industria alimentaria</em></h1>
    <p class="fade-up delay-2">
      En una planta alimentaria un cambio de formato, una incorporación o una revisión interna
      no pueden depender de la memoria. REELEVO deja el proceso documentado en el puesto,
      con competencias visibles y más claridad para la revisión interna.
    </p>
    <div class="hero-cta-group fade-up delay-3">
      <a href="https://app.gmvsolutions.es/registro" class="btn-ghost"
         data-cta data-cta-intent="registro" data-cta-location="hero" data-cta-label="Registrarme en REELEVO">Registrarme en REELEVO</a>
    </div>
    <div class="hero-cta-note fade-up delay-4">Enfoque prudente · Continuidad operativa y revisión interna</div>
    <Ilustracion escena="alimentacion" />
  </section>

  <div class="divider"></div>

  <section class="section">
    <div class="section-inner">
      <div class="fade-up">
        <div class="eyebrow">Dónde encaja mejor</div>
        <h2 class="section-title">Cuando una planta alimentaria necesita <br><em>menos trabajo a ciegas</em></h2>
        <p class="section-sub">
          No hablamos de vender una solución universal para todo el sistema de calidad.
          Hablamos de ordenar mejor lo que ya ocurre en planta cuando el proceso es sensible,
          la ejecución necesita más consistencia y la documentación de procesos de producción es clave para la revisión interna.
        </p>
      </div>

      <div class="fit-grid fade-up delay-1">
        <article class="fit-card">
          <div class="fit-tag">Cambios frecuentes</div>
          <h3 class="fit-title">Cuando el puesto cambia y no hay margen para interpretar</h3>
          <p class="fit-desc">Ayuda a que el operario trabaje con una referencia más clara en arranques, cambios de formato y tareas sensibles.</p>
        </article>

        <article class="fit-card">
          <div class="fit-tag">Campañas y refuerzos</div>
          <h3 class="fit-title">Cuando entra personal nuevo y el equipo no puede parar a enseñar siempre</h3>
          <p class="fit-desc">Aporta más orden al onboarding y reduce parte de la tutoría repetitiva justo cuando más presión hay.</p>
        </article>

        <article class="fit-card">
          <div class="fit-tag">Revisión interna</div>
          <h3 class="fit-title">Cuando calidad y operación necesitan la misma lectura del trabajo</h3>
          <p class="fit-desc">Da una base más útil para revisar referencia visible, momento, resultado y necesidad de apoyo sin perseguir contexto a posteriori.</p>
        </article>
      </div>
    </div>
  </section>

  <div class="divider"></div>

  <section class="section">
    <div class="section-inner">
      <div class="fade-up">
        <div class="eyebrow">Escenarios reales</div>
        <h2 class="section-title">Tres momentos donde esto sí puede <br><em>marcar diferencia</em></h2>
      </div>

      <div class="scenario-grid fade-up delay-1">
        <article class="scenario-card">
          <div class="scenario-card-tag">Arranque y cambio</div>
          <h3 class="scenario-card-title">Cuando producción necesita arrancar sin depender del titular</h3>
          <div class="scenario-before">
            <strong>Sin REELEVO:</strong>
            <ul>
              <li>El criterio vive en quien mejor conoce el puesto</li>
              <li>El arranque depende de encontrar a la persona adecuada</li>
              <li>Un cambio sensible puede generar más dudas de las necesarias</li>
            </ul>
          </div>
          <div class="scenario-after">
            <strong>Con REELEVO:</strong>
            <ul>
              <li>El puesto trabaja con una referencia más clara</li>
              <li>El sustituto arranca con menos trabajo a ciegas</li>
              <li>Producción gana continuidad con menos llamadas y menos espera</li>
            </ul>
          </div>
        </article>

        <article class="scenario-card">
          <div class="scenario-card-tag">Campaña</div>
          <h3 class="scenario-card-title">Cuando la planta absorbe refuerzos o personal temporal</h3>
          <div class="scenario-before">
            <strong>Sin REELEVO:</strong>
            <ul>
              <li>Los mejores perfiles vuelven a enseñar lo mismo una y otra vez</li>
              <li>La consistencia depende de quién tutoriza</li>
              <li>El pico de actividad castiga aún más al equipo estable</li>
            </ul>
          </div>
          <div class="scenario-after">
            <strong>Con REELEVO:</strong>
            <ul>
              <li>La incorporación gana orden desde el primer día</li>
              <li>Se reduce parte del tiempo que hoy se va en tutoría repetitiva</li>
              <li>El conocimiento útil no desaparece en mitad de la campaña</li>
            </ul>
          </div>
        </article>

        <article class="scenario-card">
          <div class="scenario-card-tag">Calidad</div>
          <h3 class="scenario-card-title">Cuando toca revisar qué pasó realmente en planta</h3>
          <div class="scenario-before">
            <strong>Sin REELEVO:</strong>
            <ul>
              <li>La revisión mezcla papel, memoria y versiones verbales</li>
              <li>Cuesta entender qué referencia estaba visible</li>
              <li>Calidad y producción no siempre parten del mismo contexto</li>
            </ul>
          </div>
          <div class="scenario-after">
            <strong>Con REELEVO:</strong>
            <ul>
              <li>La revisión interna parte de una base más útil</li>
              <li>Hay más claridad para cambios de proceso y puestos sensibles</li>
              <li>La conversación con planta gana más hechos y menos reconstrucción</li>
            </ul>
          </div>
        </article>
      </div>
    </div>
  </section>

  <div class="divider"></div>

  <FaqSection items={faqs} />

  <div class="divider"></div>

  <section class="cta-section">
    <div class="cta-eyebrow fade-up">¿Tiene sentido en tu planta?</div>
    <h3 class="cta-title fade-up delay-1">
      Si operas en alimentación, <br><em>vemos el encaje real contigo</em>
    </h3>
    <p class="cta-sub fade-up delay-2">
      Si te encaja, regístrate en REELEVO y pruébalo en tu planta y valora si puede aportar más consistencia,
      más continuidad y una base más útil para revisión interna en tu operativa.
    </p>
    <div class="cta-actions fade-up delay-3">
      <a href="https://app.gmvsolutions.es/registro" class="btn-primary"
         data-cta data-cta-intent="registro" data-cta-location="footer" data-cta-label="Registrarme en REELEVO">Registrarme en REELEVO</a>
      <a href="/calidad-y-conformidad/" class="btn-ghost">Ver calidad y conformidad →</a>
    </div>
    <div class="cta-note fade-up delay-4"> <br />Ver también <a href="/para-quien/responsable-calidad/">responsable de calidad</a>, <a href="/calidad-y-conformidad/">calidad y conformidad</a> o el sector <a href="/sectores/mecanizado-cnc/">mecanizado CNC</a>.</div>
  </section>
</BaseLayout>

<style>
  .fit-grid,
  .scenario-grid,
  .value-grid,
  .boundary-grid {
    display: grid;
    gap: 24px;
  }

  .fit-grid {
    grid-template-columns: repeat(3, 1fr);
    margin-top: 48px;
  }

  .scenario-grid {
    grid-template-columns: repeat(3, 1fr);
    margin-top: 48px;
  }

  .value-grid {
    grid-template-columns: repeat(4, 1fr);
    margin-top: 44px;
  }

  .boundary-grid {
    grid-template-columns: repeat(2, 1fr);
    margin-top: 40px;
  }

  .fit-card,
  .scenario-card,
  .value-card,
  .boundary-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 6px;
    text-align: left;
  }

  .fit-card,
  .value-card,
  .boundary-card,
  .scenario-card {
    padding: 28px 24px;
  }

  .fit-tag,
  .scenario-card-tag {
    font-family: 'IBM Plex Mono', monospace;
    font-size: .7rem;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--orange-ink);
    margin-bottom: 12px;
  }

  .fit-title,
  .scenario-card-title,
  .value-title,
  .boundary-title {
    font-family: 'Archivo Narrow', sans-serif;
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: .03em;
    margin-bottom: 12px;
    color: var(--white);
  }

  .fit-desc,
  .value-desc,
  .scenario-before,
  .scenario-after,
  .boundary-list li {
    font-size: .95rem;
    color: var(--gray);
    line-height: 1.65;
  }

  .scenario-before,
  .scenario-after {
    margin-top: 16px;
  }

  .scenario-before strong,
  .scenario-after strong {
    display: block;
    color: var(--white);
    margin-bottom: 8px;
  }

  .scenario-before ul,
  .scenario-after ul,
  .boundary-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .scenario-before li,
  .scenario-after li,
  .boundary-list li {
    padding: 10px 0;
    border-top: 1px solid var(--border);
  }

  .scenario-before li:first-child,
  .scenario-after li:first-child,
  .boundary-list li:first-child {
    border-top: none;
    padding-top: 0;
  }

  .boundary-card.ok {
    border-color: rgba(34,197,94,.2);
  }

  .boundary-card.caution {
    border-color: rgba(244,82,30,.25);
  }

  @media (max-width: 1100px) {
    .fit-grid,
    .scenario-grid,
    .value-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 820px) {
    .fit-grid,
    .scenario-grid,
    .value-grid,
    .boundary-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

