---
import Ilustracion from '../../components/Ilustracion.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FaqSection from '../../components/FaqSection.astro';
import { faqPageSchema, type FaqItem } from '../../lib/seo';
import { getPagina, conNegritas, conSaltos, sinMarcas } from '../../lib/contenido';

// Textos editables desde Sanity (Páginas). Respaldo: src/data/paginas/sectores--alimentacion.json.
const pagina = await getPagina('sectores/alimentacion');

const title = pagina.seo.title;
const description = pagina.seo.description;
const canonical = "https://www.gmvsolutions.es/sectores/alimentacion/";

// Esta pagina no tenia FAQ ni FAQPage en el head. Se anade, y absorbe las
// secciones "Lo que aporta" y "Limites y alcance" (tarea D4 de
// PLAN_SIMPLIFICACION_EDITORIAL_WEB_2026-08.md).
const faqs: FaqItem[] = pagina.faq.items.map(({ q, a }) => ({ q, a: sinMarcas(a) }));

const pageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "REELEVO para industria alimentaria - Onboarding software",
  "description": description,
  "url": canonical,
  "keywords": "onboarding software alimentaria, HR software manufacturing, gestión de competencias planta",
  "audience": {
    "@type": "Audience",
    "audienceType": "Food Industry HR and Operations"
  }
};

const schema = [pageSchema, faqPageSchema(faqs)];
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  schema={schema}
  activeNav=""
  pageType="sector"
>
  <section class="page-hero">
    <div class="eyebrow fade-up">{pagina.hero.antetitulo}</div>
    <h1 class="fade-up delay-1"><Fragment set:html={conSaltos(pagina.hero.titulo)} />{pagina.hero.tituloDestacado && <> <br> <em>{pagina.hero.tituloDestacado}</em></>}</h1>
    <p class="fade-up delay-2" set:html={conNegritas(pagina.hero.texto)} />
    <div class="hero-cta-group fade-up delay-3">
      {pagina.hero.botones[0] && (
<a href={pagina.hero.botones[0].url} class="btn-ghost"
         data-cta data-cta-intent="registro" data-cta-location="hero" data-cta-label="Registrarme en REELEVO">{pagina.hero.botones[0].texto}</a>
)}
    </div>
    <div class="hero-cta-note fade-up delay-4">Enfoque prudente · Continuidad operativa y revisión interna</div>
    <Ilustracion escena="alimentacion" />
  </section>

  <div class="divider"></div>

  <section class="section">
    <div class="section-inner">
      <div class="fade-up">
        <div class="eyebrow">Dónde encaja mejor</div>
        <h2 class="section-title">Cuando una planta alimentaria necesita <br><em>menos trabajo a ciegas</em></h2>
        <p class="section-sub">
          No hablamos de vender una solución universal para todo el sistema de calidad.
          Hablamos de ordenar mejor lo que ya ocurre en planta cuando el proceso es sensible,
          la ejecución necesita más consistencia y la documentación de procesos de producción es clave para la revisión interna.
        </p>
      </div>

      <div class="fit-grid fade-up delay-1">
        <article class="fit-card">
          <div class="fit-tag">Cambios frecuentes</div>
          <h3 class="fit-title">Cuando el puesto cambia y no hay margen para interpretar</h3>
          <p class="fit-desc">Ayuda a que el operario trabaje con una referencia más clara en arranques, cambios de formato y tareas sensibles.</p>
        </article>

        <article class="fit-card">
          <div class="fit-tag">Campañas y refuerzos</div>
          <h3 class="fit-title">Cuando entra personal nuevo y el equipo no puede parar a enseñar siempre</h3>
          <p class="fit-desc">Aporta más orden al onboarding y reduce parte de la tutoría repetitiva justo cuando más presión hay.</p>
        </article>

        <article class="fit-card">
          <div class="fit-tag">Revisión interna</div>
          <h3 class="fit-title">Cuando calidad y operación necesitan la misma lectura del trabajo</h3>
          <p class="fit-desc">Da una base más útil para revisar referencia visible, momento, resultado y necesidad de apoyo sin perseguir contexto a posteriori.</p>
        </article>
      </div>
    </div>
  </section>

  <div class="divider"></div>

  <section class="section">
    <div class="section-inner">
      <div class="fade-up">
        <div class="eyebrow">Escenarios reales</div>
        <h2 class="section-title">Tres momentos donde esto sí puede <br><em>marcar diferencia</em></h2>
      </div>

      <div class="scenario-grid fade-up delay-1">
        <article class="scenario-card">
          <div class="scenario-card-tag">Arranque y cambio</div>
          <h3 class="scenario-card-title">Cuando producción necesita arrancar sin depender del titular</h3>
          <div class="scenario-before">
            <strong>Sin REELEVO:</strong>
            <ul>
              <li>El criterio vive en quien mejor conoce el puesto</li>
              <li>El arranque depende de encontrar a la persona adecuada</li>
              <li>Un cambio sensible puede generar más dudas de las necesarias</li>
            </ul>
          </div>
          <div class="scenario-after">
            <strong>Con REELEVO:</strong>
            <ul>
              <li>El puesto trabaja con una referencia más clara</li>
              <li>El sustituto arranca con menos trabajo a ciegas</li>
              <li>Producción gana continuidad con menos llamadas y menos espera</li>
            </ul>
          </div>
        </article>

        <article class="scenario-card">
          <div class="scenario-card-tag">Campaña</div>
          <h3 class="scenario-card-title">Cuando la planta absorbe refuerzos o personal temporal</h3>
          <div class="scenario-before">
            <strong>Sin REELEVO:</strong>
            <ul>
              <li>Los mejores perfiles vuelven a enseñar lo mismo una y otra vez</li>
              <li>La consistencia depende de quién tutoriza</li>
              <li>El pico de actividad castiga aún más al equipo estable</li>
            </ul>
          </div>
          <div class="scenario-after">
            <strong>Con REELEVO:</strong>
            <ul>
              <li>La incorporación gana orden desde el primer día</li>
              <li>Se reduce parte del tiempo que hoy se va en tutoría repetitiva</li>
              <li>El conocimiento útil no desaparece en mitad de la campaña</li>
            </ul>
          </div>
        </article>

        <article class="scenario-card">
          <div class="scenario-card-tag">Calidad</div>
          <h3 class="scenario-card-title">Cuando toca revisar qué pasó realmente en planta</h3>
          <div class="scenario-before">
            <strong>Sin REELEVO:</strong>
            <ul>
              <li>La revisión mezcla papel, memoria y versiones verbales</li>
              <li>Cuesta entender qué referencia estaba visible</li>
              <li>Calidad y producción no siempre parten del mismo contexto</li>
            </ul>
          </div>
          <div class="scenario-after">
            <strong>Con REELEVO:</strong>
            <ul>
              <li>La revisión interna parte de una base más útil</li>
              <li>Hay más claridad para cambios de proceso y puestos sensibles</li>
              <li>La conversación con planta gana más hechos y menos reconstrucción</li>
            </ul>
          </div>
        </article>
      </div>
    </div>
  </section>

  <div class="divider"></div>

  <FaqSection items={faqs} />

  <div class="divider"></div>

  <section class="cta-section">
    <div class="cta-eyebrow fade-up">{pagina.ctaFinal.antetitulo}</div>
    <h3 class="cta-title fade-up delay-1"><Fragment set:html={conSaltos(pagina.ctaFinal.titulo)} />{pagina.ctaFinal.tituloDestacado && <> <br> <em>{pagina.ctaFinal.tituloDestacado}</em></>}</h3>
    <p class="cta-sub fade-up delay-2" set:html={conNegritas(pagina.ctaFinal.texto)} />
    <div class="cta-actions fade-up delay-3">
      {pagina.ctaFinal.botones[0] && (
<a href={pagina.ctaFinal.botones[0].url} class="btn-primary"
         data-cta data-cta-intent="registro" data-cta-location="footer" data-cta-label="Registrarme en REELEVO">{pagina.ctaFinal.botones[0].texto}</a>
)}
      {pagina.ctaFinal.botones[1] && (
<a href={pagina.ctaFinal.botones[1].url} class="btn-ghost">{pagina.ctaFinal.botones[1].texto}</a>
)}
    </div>
    <div class="cta-note fade-up delay-4" set:html={conNegritas(pagina.ctaFinal.nota)} />
  </section>
</BaseLayout>

<style>
  .fit-grid,
  .scenario-grid,
  .value-grid,
  .boundary-grid {
    display: grid;
    gap: 24px;
  }

  .fit-grid {
    grid-template-columns: repeat(3, 1fr);
    margin-top: 48px;
  }

  .scenario-grid {
    grid-template-columns: repeat(3, 1fr);
    margin-top: 48px;
  }

  .value-grid {
    grid-template-columns: repeat(4, 1fr);
    margin-top: 44px;
  }

  .boundary-grid {
    grid-template-columns: repeat(2, 1fr);
    margin-top: 40px;
  }

  .fit-card,
  .scenario-card,
  .value-card,
  .boundary-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 6px;
    text-align: left;
  }

  .fit-card,
  .value-card,
  .boundary-card,
  .scenario-card {
    padding: 28px 24px;
  }

  .fit-tag,
  .scenario-card-tag {
    font-family: 'DM Mono', monospace;
    font-size: .7rem;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--orange-ink);
    margin-bottom: 12px;
  }

  .fit-title,
  .scenario-card-title,
  .value-title,
  .boundary-title {
    font-family: 'Oswald', sans-serif;
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: .03em;
    margin-bottom: 12px;
    color: var(--white);
  }

  .fit-desc,
  .value-desc,
  .scenario-before,
  .scenario-after,
  .boundary-list li {
    font-size: .95rem;
    color: var(--gray);
    line-height: 1.65;
  }

  .scenario-before,
  .scenario-after {
    margin-top: 16px;
  }

  .scenario-before strong,
  .scenario-after strong {
    display: block;
    color: var(--white);
    margin-bottom: 8px;
  }

  .scenario-before ul,
  .scenario-after ul,
  .boundary-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .scenario-before li,
  .scenario-after li,
  .boundary-list li {
    padding: 10px 0;
    border-top: 1px solid var(--border);
  }

  .scenario-before li:first-child,
  .scenario-after li:first-child,
  .boundary-list li:first-child {
    border-top: none;
    padding-top: 0;
  }

  .boundary-card.ok {
    border-color: rgba(34,197,94,.2);
  }

  .boundary-card.caution {
    border-color: rgba(244,82,30,.25);
  }

  @media (max-width: 1100px) {
    .fit-grid,
    .scenario-grid,
    .value-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 820px) {
    .fit-grid,
    .scenario-grid,
    .value-grid,
    .boundary-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

