---
import Ilustracion from '../../components/Ilustracion.astro';
import Icon from '../../components/Icon.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FaqSection from '../../components/FaqSection.astro';
import { faqPageSchema, type FaqItem } from '../../lib/seo';
import Screenshot from '../../components/Screenshot.astro';
import { getPagina, conNegritas, conSaltos, sinMarcas } from '../../lib/contenido';

// Textos editables desde Sanity (Páginas). Respaldo: src/data/paginas/para-quien--responsable-rrhh.json.
const pagina = await getPagina('para-quien/responsable-rrhh');

const title = pagina.seo.title;
const description = pagina.seo.description;
const canonical = "https://www.gmvsolutions.es/para-quien/responsable-rrhh/";

// Esta pagina no tenia FAQ ni FAQPage en el head. Se anade, y absorbe la seccion "Trazabilidad operativa"
// (tarea D4 de PLAN_SIMPLIFICACION_EDITORIAL_WEB_2026-08.md).
const faqs: FaqItem[] = pagina.faq.items.map(({ q, a }) => ({ q, a: sinMarcas(a) }));

const pageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "REELEVO para Responsables de RRHH",
  "description": "Solución específica para responsables de recursos humanos",
  "audience": {
    "@type": "Audience",
    "audienceType": "HR Manager"
  }
};

const schema = [pageSchema, faqPageSchema(faqs)];
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  schema={schema}
  activeNav=""
  pageType="rol"
>
  <!-- PAGE HERO -->
  <section class="page-hero">
    <div class="eyebrow fade-up">{pagina.hero.antetitulo}</div>
    <h1 class="fade-up delay-1"><Fragment set:html={conSaltos(pagina.hero.titulo)} />{pagina.hero.tituloDestacado && <> <br> <em>{pagina.hero.tituloDestacado}</em></>}.</h1>
    <p class="fade-up delay-2" set:html={conNegritas(pagina.hero.texto)} />
    <div class="hero-cta-group fade-up delay-3">
      {pagina.hero.botones[0] && (
<a href={pagina.hero.botones[0].url} class="btn-ghost"
         data-cta data-cta-intent="registro" data-cta-location="hero" data-cta-label="Registrarme en REELEVO">{pagina.hero.botones[0].texto}</a>
)}
    </div>
    <div class="hero-cta-note fade-up delay-4">Sin compromiso · Acompañamiento en la puesta en marcha</div>
    <Ilustracion escena="competencias" />
  </section>

  <div class="divider"></div>

  <!-- PRUEBA VISUAL -->
  <section class="section">
    <div class="section-inner">
      <div class="fade-up">
        <div class="eyebrow">Prueba visual</div>
        <h2 class="section-title">Qué deja registrado el producto <em>hoy</em></h2>
        <p class="section-sub">
          REELEVO no sustituye una certificación formal. Sí deja una base de evidencia mucho más útil
          que una lista de asistencia cuando quieres ordenar onboarding y tomar mejores decisiones de formación.
        </p>
      </div>

      <div class="proof-grid fade-up delay-1">
        <div class="proof-card proof-shot">
          <div class="proof-frame">
            <Screenshot name="admin-dashboard" alt="Panel empresa REELEVO para seguimiento operativo y procesos" layout="pair" />
          </div>
          <div class="proof-caption">Captura real del producto: panel empresa para procesos, máquinas y operativa.</div>
        </div>

        <div class="proof-card proof-points">
          <h3>Qué evidencia te deja</h3>
          <div class="proof-point"><strong>Quién:</strong> operario o sesión identificada cuando aplica.</div>
          <div class="proof-point"><strong>Qué:</strong> proceso ejecutado y puesto o máquina asociada.</div>
          <div class="proof-point"><strong>Cuándo:</strong> fecha, hora y seguimiento de ejecución.</div>
          <div class="proof-point"><strong>Resultado:</strong> base más útil para onboarding, polivalencia y competencia visible.</div>
        </div>
      </div>
    </div>
  </section>

  <div class="divider"></div>

  <!-- PROBLEMAS DE RRHH -->
  <section class="section">
    <div class="section-inner">
      <div class="fade-up" style="text-align:center;margin-bottom:64px;">
        <div class="eyebrow">Problemas de RRHH</div>
        <h2 class="section-title">Los costes ocultos de la formación tradicional</h2>
        <p class="section-sub">
          Problemas diarios que enfrentan los departamentos de RRHH
          en empresas industriales con alta rotación.
        </p>
      </div>

      <div class="hr-problems fade-up delay-1">
        <div class="problem-card high-impact">
          <Icon name="dinero" class="problem-icon icon--draw" />
          <h3 class="problem-title">Onboarding costoso sin gestión de competencias</h3>
          <div class="problem-stats">
            <div class="problem-stat">Tutoría</div>
            <div class="problem-stat-label">Onboarding repetitivo sin seguimiento de competencias</div>
          </div>
          <div class="problem-description">
            <h4>Situación actual:</h4>
            <ul>
              <li>Tu onboarding depende de tutores disponibles</li>
              <li>Sin gestión de competencias clara: no sabes quién domina qué</li>
              <li>Inconsistencias en onboarding según quién enseña</li>
              <li>Registro de competencias incompleto o inexistente</li>
              <li>Repetir onboarding si el empleado cambia de puesto</li>
            </ul>
          </div>
          <div class="problem-solution">
            <h4>Con REELEVO:</h4>
            <ul>
              <li>Onboarding software con pasos guiados en planta</li>
              <li>Gestión de competencias por ejecución real</li>
              <li>Onboarding consistente entre diferentes incorporaciones</li>
              <li>Evidencia clara de competencias adquiridas</li>
              <li>Gestión de competencias que crece por puestos</li>
            </ul>
          </div>
        </div>

        <div class="problem-card medium-impact">
          <Icon name="documento" class="problem-icon icon--draw" />
          <h3 class="problem-title">Gestión de competencias invisible</h3>
          <div class="problem-stats">
            <div class="problem-stat">Excel</div>
            <div class="problem-stat-label">Gestión de competencias en papel, hojas y memoria</div>
          </div>
          <div class="problem-description">
            <h4>Situación actual:</h4>
            <ul>
              <li>No hay gestión de competencias clara por operario</li>
              <li>Certificaciones basadas en asistencia, no en competencia real</li>
              <li>Cuesta demostrar qué ejecución realmente tiene cada persona</li>
              <li>Datos de competencias dispersos en Excel, papel, memoria</li>
              <li>Imposible hacer seguimiento actualizado de competencias</li>
            </ul>
          </div>
          <div class="problem-solution">
            <h4>Con REELEVO:</h4>
            <ul>
              <li>Gestión de competencias basada en ejecución real</li>
              <li>Evidencia operativa clara de competencias por persona</li>
              <li>Más claridad para auditorías y cumplimiento</li>
              <li>Integración posible con software de RRHH según el caso</li>
              <li>Gestión de competencias actualizada automáticamente</li>
            </ul>
          </div>
        </div>

        <div class="problem-card high-impact">
          <Icon name="ciclo" class="problem-icon icon--draw" />
          <h3 class="problem-title">Rotación y personal temporal</h3>
          <div class="problem-stats">
            <div class="problem-stat">ETT</div>
            <div class="problem-stat-label">Cada incorporación vuelve a tensionar el sistema</div>
          </div>
          <div class="problem-description">
            <h4>Situación actual:</h4>
            <ul>
              <li>Cada ETT necesita formación desde cero</li>
              <li>Inversión en formación que «se va» con la persona</li>
              <li>Imposible rentabilizar formación con alta rotación</li>
              <li>Dependencia excesiva de personal fijo para formar</li>
              <li>Sin escalabilidad para picos de demanda</li>
            </ul>
          </div>
          <div class="problem-solution">
            <h4>Con REELEVO:</h4>
            <ul>
              <li>Más facilidad para incorporar ETT con menos tutoría</li>
              <li>Formación más reutilizable y menos improvisada</li>
              <li>Mejor aprovechamiento del conocimiento interno</li>
              <li>Menor dependencia del personal fijo para enseñar siempre lo mismo</li>
              <li>Más capacidad para absorber picos estacionales</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <div class="divider"></div>

  <!-- CERTIFICACIÓN SISTEMA -->
  

  <div class="divider"></div>

  <!-- STATS BANDA -->
  <section class="stat-band">
    <div class="stat-band-inner fade-up">
      <div class="stat-item">
        <div class="stat-num">Onboarding</div>
        <div class="stat-label">Más orden en nuevas incorporaciones y menos dependencia del tutor</div>
      </div>
      <div class="stat-item">
        <div class="stat-num">Trazabilidad</div>
        <div class="stat-label">Registro de ejecución para acompañar onboarding y auditorías</div>
      </div>
      <div class="stat-item">
        <div class="stat-num">Competencias</div>
        <div class="stat-label">Más visibilidad sobre qué procesos domina cada persona</div>
      </div>
    </div>
  </section>

  <div class="divider"></div>

  <!--
  ═══════════════════════════════════════════
  CASO DE ÉXITO — COMENTADO
  Descomentar cuando tengamos casos reales documentados.
  ═══════════════════════════════════════════
  -->

  <div class="divider"></div>

  <!-- MICROCASO (escenario ilustrativo, no testimonio real) -->
  <section class="section section-center">
    <div class="section-inner">
      <div class="micro-case fade-up">
        <div class="micro-case-tag">Escenario típico de incorporación</div>
        <p class="micro-case-text">
          Entra personal de ETT para una campaña. En lugar de ocupar a un operario veterano varios días
          como tutor, cada nuevo accede al proceso en el puesto y RRHH ve qué procedimientos ya domina
          y dónde aún necesita apoyo, acortando la curva de autonomía sin frenar la línea.
        </p>
        <div class="micro-case-note">Ejemplo ilustrativo del tipo de problema que aborda REELEVO, no un caso de cliente.</div>
      </div>
    </div>
  </section>

  <div class="divider"></div>

  <!-- CTA -->
  <FaqSection items={faqs} />

  <div class="divider"></div>

  <section class="cta-section">
    <div class="cta-eyebrow fade-up">{pagina.ctaFinal.antetitulo}</div>
    <h3 class="cta-title fade-up delay-1"><Fragment set:html={conSaltos(pagina.ctaFinal.titulo)} />{pagina.ctaFinal.tituloDestacado && <> <br> <em>{pagina.ctaFinal.tituloDestacado}</em></>}</h3>
    <p class="cta-sub fade-up delay-2" set:html={conNegritas(pagina.ctaFinal.texto)} />
    <div class="fade-up delay-3" style="display:flex;gap:16px;justify-content:center;flex-wrap:wrap;">
      {pagina.ctaFinal.botones[0] && (
<a href={pagina.ctaFinal.botones[0].url} class="btn-primary"
         data-cta data-cta-intent="registro" data-cta-location="footer" data-cta-label="Registrarme en REELEVO">{pagina.ctaFinal.botones[0].texto}</a>
)}
    </div>
    <div class="cta-note fade-up delay-4" set:html={conNegritas(pagina.ctaFinal.nota)} />
  </section>
</BaseLayout>

<style>
  .proof-grid {
    display: grid;
    grid-template-columns: 1.1fr .9fr;
    gap: 24px;
    margin-top: 48px;
  }

  .proof-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 6px;
    overflow: hidden;
  }

  .proof-frame img {
    width: 100%;
    display: block;
  }

  .proof-caption {
    padding: 16px 18px;
    font-size: .8rem;
    color: var(--gray);
    line-height: 1.55;
  }

  .proof-points {
    padding: 28px 24px;
  }

  .proof-points h3 {
    font-family: 'Oswald', sans-serif;
    font-size: 1.1rem;
    font-weight: 600;
    margin-bottom: 18px;
  }

  .proof-point {
    font-size: .95rem;
    line-height: 1.65;
    color: var(--gray);
    padding: 0 0 14px;
    margin-bottom: 14px;
    border-bottom: 1px solid var(--border);
  }

  .proof-point:last-child {
    margin-bottom: 0;
    padding-bottom: 0;
    border-bottom: none;
  }

  .proof-point strong {
    color: var(--white);
  }

  /* HR Problems */
  .hr-problems {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2px;
    margin-top: 48px;
  }

  .problem-card {
    background: var(--surface);
    padding: 28px 24px;
    position: relative;
  }

  .problem-card.high-impact::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: #FF4444;
  }

  .problem-card.medium-impact::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: #FF8800;
  }

  .problem-icon {
    margin-bottom: 16px;
  }

  .problem-title {
    font-family: 'Oswald', sans-serif;
    font-size: 1rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: .03em;
    margin-bottom: 16px;
    line-height: 1.2;
  }

  .problem-stats {
    background: var(--surface2);
    padding: 16px;
    border-radius: 2px;
    text-align: center;
    margin-bottom: 20px;
  }

  .problem-stat {
    font-family: 'Oswald', sans-serif;
    font-size: 2rem;
    font-weight: 700;
    color: var(--orange-ink);
    line-height: 1;
    margin-bottom: 4px;
  }

  .problem-stat-label {
    font-size: .7rem;
    color: var(--gray);
    line-height: 1.3;
  }

  .problem-description,
  .problem-solution {
    margin-bottom: 16px;
  }

  .problem-description h4,
  .problem-solution h4 {
    font-family: 'DM Mono', monospace;
    font-size: .7rem;
    letter-spacing: .12em;
    text-transform: uppercase;
    margin-bottom: 8px;
  }

  .problem-description h4 {
    color: var(--gray2);
  }

  .problem-solution h4 {
    color: var(--orange-ink);
  }

  .problem-description ul,
  .problem-solution ul {
    list-style: none;
    font-size: .8rem;
    line-height: 1.5;
  }

  .problem-description li {
    color: var(--gray);
    margin-bottom: 3px;
  }

  .problem-description li::before {
    content: '−';
    color: var(--gray2);
    margin-right: 8px;
  }

  .problem-solution li {
    color: rgba(20,22,24, .8);
    margin-bottom: 3px;
  }

  .problem-solution li::before {
    content: '✓';
    color: var(--green);
    margin-right: 8px;
    font-weight: 600;
  }

  /* Certification comparison */
  .certification-comparison {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2px;
    margin-top: 48px;
  }

  .cert-traditional,
  .cert-reelevo {
    background: var(--surface);
    padding: 32px 28px;
  }

  .cert-traditional h3 {
    font-family: 'Oswald', sans-serif;
    font-size: 1.1rem;
    font-weight: 600;
    margin-bottom: 24px;
    color: var(--gray2);
  }

  .cert-reelevo h3 {
    font-family: 'Oswald', sans-serif;
    font-size: 1.1rem;
    font-weight: 600;
    margin-bottom: 24px;
    color: var(--orange-ink);
  }

  .cert-process {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 24px;
    justify-content: center;
  }

  .cert-step {
    background: var(--surface2);
    padding: 16px 12px;
    border-radius: 2px;
    text-align: center;
    flex: 1;
    max-width: 100px;
  }

  .cert-step-icon {
    font-size: 1.5rem;
    margin-bottom: 8px;
  }

  .cert-step-text {
    font-size: .7rem;
    line-height: 1.3;
    color: var(--gray);
  }

  .cert-arrow {
    color: var(--gray);
    font-weight: 600;
    flex-shrink: 0;
  }

  .cert-problems,
  .cert-benefits {
    margin-top: 20px;
  }

  .cert-problems h4,
  .cert-benefits h4 {
    font-family: 'DM Mono', monospace;
    font-size: .7rem;
    letter-spacing: .12em;
    text-transform: uppercase;
    margin-bottom: 8px;
  }

  .cert-problems h4 {
    color: var(--gray2);
  }

  .cert-benefits h4 {
    color: var(--orange-ink);
  }

  .cert-problems ul,
  .cert-benefits ul {
    list-style: none;
    font-size: .8rem;
    line-height: 1.5;
  }

  .cert-problems li {
    color: var(--gray);
    margin-bottom: 4px;
  }

  .cert-problems li::before {
    content: '−';
    color: var(--gray2);
    margin-right: 8px;
  }

  .cert-benefits li {
    color: rgba(20,22,24, .8);
    margin-bottom: 4px;
  }

  .cert-benefits li::before {
    content: '✓';
    color: var(--green);
    margin-right: 8px;
    font-weight: 600;
  }

  .certification-data {
    margin-top: 32px;
  }

  .cert-data-card {
    background: var(--surface);
    padding: 28px;
    border-radius: 4px;
  }

  .cert-data-card h4 {
    font-family: 'Oswald', sans-serif;
    font-size: .95rem;
    font-weight: 600;
    margin-bottom: 16px;
    color: var(--orange-ink);
  }

  .cert-data-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
  }

  .cert-data-item {
    font-size: .8rem;
    line-height: 1.5;
    color: var(--gray);
  }

  .cert-data-item strong {
    color: var(--white);
    font-weight: 500;
  }

  /* Integration grid */
  .integration-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2px;
    margin-top: 48px;
  }

  .integration-card {
    background: var(--surface);
    padding: 28px 24px;
    text-align: center;
  }

  .integration-card.featured {
    border: 2px solid var(--orange);
  }

  .integration-logo {
    font-size: 3rem;
    margin-bottom: 16px;
  }

  .integration-name {
    font-family: 'Oswald', sans-serif;
    font-size: 1.2rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: .03em;
    margin-bottom: 8px;
  }

  .integration-status {
    font-family: 'DM Mono', monospace;
    font-size: .6rem;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--orange-ink);
    margin-bottom: 20px;
  }

  .integration-features h4 {
    font-family: 'DM Mono', monospace;
    font-size: .7rem;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--orange-ink);
    margin-bottom: 8px;
  }

  .integration-features ul {
    list-style: none;
    font-size: .8rem;
    line-height: 1.6;
    text-align: left;
  }

  .integration-features li {
    margin-bottom: 4px;
    color: var(--gray);
  }

  .integration-features li::before {
    content: '→';
    color: var(--orange-ink);
    margin-right: 8px;
    font-weight: 500;
  }

  .integration-demo {
    margin-top: 32px;
    text-align: center;
  }

  .integration-demo h3 {
    font-family: 'Oswald', sans-serif;
    font-size: 1.1rem;
    font-weight: 600;
    margin-bottom: 24px;
    color: var(--orange-ink);
  }

  .integration-flow {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    flex-wrap: wrap;
  }

  .flow-step {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    max-width: 200px;
  }

  .flow-number {
    width: 40px;
    height: 40px;
    background: var(--orange);
    color: var(--white);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: 'Oswald', sans-serif;
    font-weight: 600;
  }

  .flow-content h4 {
    font-family: 'Oswald', sans-serif;
    font-size: .9rem;
    font-weight: 600;
    margin-bottom: 4px;
  }

  .flow-content p {
    font-size: .8rem;
    color: var(--gray);
    line-height: 1.4;
  }

  .flow-arrow {
    color: var(--orange-ink);
    font-size: 1.5rem;
    font-weight: 600;
  }

  /* Case study HR */
  .case-study-hr {
    max-width: 900px;
    margin: 0 auto;
  }

  .case-quote {
    background: var(--surface);
    padding: 32px;
    border-radius: 4px;
    margin-bottom: 32px;
    border-left: 4px solid var(--orange);
  }

  .case-quote blockquote {
    font-size: 1rem;
    line-height: 1.65;
    color: rgba(20,22,24, .9);
    margin-bottom: 20px;
    font-style: italic;
  }

  .case-quote blockquote strong {
    color: var(--white);
    font-weight: 500;
    font-style: normal;
  }

  .case-author {
    font-size: .85rem;
    color: var(--gray);
    line-height: 1.5;
  }

  .case-author strong {
    color: var(--white);
    font-weight: 500;
  }

  .case-metrics-hr {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2px;
    margin-bottom: 32px;
  }

  .case-metric {
    background: var(--surface);
    padding: 24px;
    text-align: center;
  }

  .case-metric-before,
  .case-metric-after {
    font-family: 'DM Mono', monospace;
    font-size: .6rem;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--gray2);
    margin-bottom: 4px;
  }

  .case-metric-number {
    font-family: 'Oswald', sans-serif;
    font-size: 1.4rem;
    font-weight: 700;
    line-height: 1;
    margin-bottom: 8px;
  }

  .case-metric-number.old {
    color: var(--gray2);
    text-decoration: line-through;
  }

  .case-metric-number.new {
    color: var(--orange-ink);
  }

  .case-metric-label {
    font-size: .75rem;
    color: var(--gray);
    line-height: 1.3;
  }

  .case-roi {
    background: rgba(34, 197, 94, 0.1);
    border: 1px solid rgba(34, 197, 94, 0.3);
    padding: 24px;
    border-radius: 4px;
  }

