---
import Ilustracion from '../../components/Ilustracion.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FaqSection from '../../components/FaqSection.astro';
import { faqPageSchema, type FaqItem } from '../../lib/seo';
import Screenshot from '../../components/Screenshot.astro';

const title = "Software calidad operativa industrial | REELEVO";
const description = "Software de calidad operativa con evidencia de ejecución: revisa qué se siguió y cuándo, soporta cambios de proceso y vigila puestos sensibles en planta.";
const canonical = "https://www.gmvsolutions.es/para-quien/responsable-calidad/";

// Esta pagina no tenia FAQ ni FAQPage en el head. Se anade, y absorbe las secciones "Valor ejecutivo" y "Limites y alcance"
// (tarea D4 de PLAN_SIMPLIFICACION_EDITORIAL_WEB_2026-08.md).
const faqs: FaqItem[] = [
  {
    q: '¿Qué gana calidad con esto sin montar más burocracia?',
    a: 'Revisar con menos intuición: menos dependencia de la memoria, de correos o de explicaciones posteriores para entender qué pasó. Más claridad para ver cómo aterrizan las nuevas referencias y los cambios operativos en el puesto. Una base más útil para hablar con producción sobre incidencias y puntos débiles. Y soporte real a la formación en puestos sensibles, más allá de listas de asistencia y firmas.',
  },
  {
    q: '¿Sustituye a mi sistema de calidad?',
    a: 'No, y no vamos a exagerarlo. Sí aporta más claridad para la revisión interna, más contexto ante cambios de proceso y desviaciones, más continuidad entre calidad, operación y formación, y una base más útil para puestos sensibles. No es un sustituto automático de tu sistema de calidad, ni una garantía legal universal para cualquier norma o sector, ni una certificación formal completa de competencias, ni un reemplazo del criterio del responsable de calidad.',
  },
  {
    q: '¿Por dónde empiezo si llevo calidad en una pyme?',
    a: 'Por el proceso donde más veces has tenido que reconstruir a posteriori qué se hizo. Con ese documentado y ejecutándose en el puesto ya se ve si el registro que deja te sirve para una revisión interna, sin haber cambiado tu sistema de calidad.',
  },
];

const pageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "REELEVO para responsables de calidad y compliance",
  "description": description,
  "url": canonical,
  "audience": {
    "@type": "Audience",
    "audienceType": "Quality Manager"
  }
};

const schema = [pageSchema, faqPageSchema(faqs)];
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  schema={schema}
  activeNav=""
  pageType="rol"
>
  <section class="page-hero">
    <div class="eyebrow fade-up">Para calidad y compliance</div>
    <h1 class="fade-up delay-1">Más claridad para revisar. <br><em>Menos dependencia de papeles y memoria.</em></h1>
    <p class="fade-up delay-2">
      REELEVO ayuda a calidad a revisar mejor lo que pasa en planta: qué referencia estaba visible,
      cuándo ocurrió el trabajo, cómo terminó y dónde sigue haciendo falta apoyo.
      Sin convertirlo en más burocracia y sin inflar el alcance legal.
    </p>
    <div class="hero-cta-group fade-up delay-3">
      <a href="https://app.gmvsolutions.es/registro" class="btn-ghost"
         data-cta data-cta-intent="registro" data-cta-location="hero" data-cta-label="Registrarme en REELEVO">Registrarme en REELEVO</a>
    </div>
    <div class="hero-cta-note fade-up delay-4">Enfoque práctico · Revisión interna con más criterio</div>
    <Ilustracion escena="calidad" />
  </section>

  <div class="divider"></div>

  <section class="section">
    <div class="section-inner">
      <div class="fade-up">
        <div class="eyebrow">Prueba visual</div>
        <h2 class="section-title">Lo que calidad puede revisar con <em>más claridad</em></h2>
        <p class="section-sub">
          No sustituye por sí solo un sistema de calidad ni una certificación formal.
          Sí deja una base mucho más útil para revisión interna que una combinación de papel,
          Excel, memoria y explicaciones cruzadas.
        </p>
      </div>

      <div class="proof-grid fade-up delay-1">
        <div class="proof-card proof-shot">
          <div class="proof-frame">
            <Screenshot name="admin-dashboard" alt="Panel de empresa REELEVO para seguimiento operativo" layout="pair" />
          </div>
          <div class="proof-caption">Panel empresa: procesos, puestos, seguimiento y continuidad operativa en un solo lugar.</div>
        </div>

        <div class="proof-card proof-points">
          <h3>Qué gana calidad</h3>
          <div class="proof-point"><strong>Más contexto para revisar:</strong> entiendes mejor qué referencia estaba visible cuando ocurrió el trabajo.</div>
          <div class="proof-point"><strong>Más criterio ante desviaciones:</strong> la revisión no parte solo de recuerdos o versiones cruzadas.</div>
          <div class="proof-point"><strong>Más apoyo a cambios de proceso:</strong> ves con más claridad cómo aterriza el cambio en planta.</div>
          <div class="proof-point"><strong>Más continuidad con operación y formación:</strong> calidad trabaja con una base más útil para acompañar puestos sensibles.</div>
        </div>
      </div>
    </div>
  </section>

  <div class="divider"></div>

  <section class="section">
    <div class="section-inner">
      <div class="fade-up" style="text-align:center;margin-bottom:64px;">
        <div class="eyebrow">Dónde duele</div>
        <h2 class="section-title">Escenarios donde calidad gana <em>algo práctico</em></h2>
        <p class="section-sub">
          REELEVO encaja mejor cuando calidad necesita revisar mejor lo que ya está ocurriendo en planta.
        </p>
      </div>

      <div class="scenario-grid fade-up delay-1">
        <article class="scenario-card">
          <div class="scenario-card-tag">Auditoría interna</div>
          <h3 class="scenario-card-title">Cuando revisar depende de demasiadas versiones</h3>
          <div class="scenario-before">
            <strong>Sin una base más útil:</strong>
            <ul>
              <li>La revisión mezcla papel, Excel y explicaciones verbales</li>
              <li>Cuesta reconstruir qué referencia se siguió realmente</li>
              <li>Se invierte tiempo en perseguir contexto en lugar de revisar</li>
            </ul>
          </div>
          <div class="scenario-after">
            <strong>Con REELEVO:</strong>
            <ul>
              <li>La revisión parte de una base más ordenada</li>
              <li>Hay más claridad sobre referencia visible, momento y resultado</li>
              <li>Calidad puede revisar con menos intuición y más información útil</li>
            </ul>
          </div>
        </article>

        <article class="scenario-card">
          <div class="scenario-card-tag">Cambios de proceso</div>
          <h3 class="scenario-card-title">Cuando un cambio tarda en aterrizar de verdad</h3>
          <div class="scenario-before">
            <strong>Sin una base de seguimiento:</strong>
            <ul>
              <li>El cambio se comunica, pero cuesta ver cómo llega al puesto</li>
              <li>Producción y calidad no siempre comparten la misma lectura</li>
              <li>La adopción real queda demasiado implícita</li>
            </ul>
          </div>
          <div class="scenario-after">
            <strong>Con REELEVO:</strong>
            <ul>
              <li>Calidad gana una referencia más útil para acompañar el cambio</li>
              <li>Es más fácil revisar qué estaba visible en el puesto</li>
              <li>La conversación con producción se apoya mejor en hechos</li>
            </ul>
          </div>
        </article>

        <article class="scenario-card">
          <div class="scenario-card-tag">Puestos sensibles</div>
          <h3 class="scenario-card-title">Cuando onboarding y conformidad se cruzan</h3>
          <div class="scenario-before">
            <strong>Sin REELEVO:</strong>
            <ul>
              <li>Cuesta ver dónde sigue haciendo falta apoyo</li>
              <li>La evidencia de aprendizaje es pobre o dispersa</li>
              <li>Calidad llega tarde a los puntos más frágiles</li>
            </ul>
          </div>
          <div class="scenario-after">
            <strong>Con REELEVO:</strong>
            <ul>
              <li>Hay más base para acompañar puestos críticos</li>
              <li>Formación, operación y calidad comparten mejor el contexto</li>
              <li>La revisión interna gana continuidad y menos fricción</li>
            </ul>
          </div>
        </article>
      </div>
    </div>
  </section>

  

  

  

  <div class="divider"></div>

  <!-- MICROCASO (escenario ilustrativo, no testimonio real) -->
  <section class="section section-center">
    <div class="section-inner">
      <div class="micro-case fade-up">
        <div class="micro-case-tag">Escenario típico de revisión</div>
        <p class="micro-case-text">
          Aparece una no conformidad en un lote. En vez de reconstruir a posteriori qué referencia
          se usó y quién operó, calidad consulta qué proceso estaba visible en el puesto, cuándo se
          ejecutó y cómo terminó, y centra la revisión en lo que de verdad cambió.
        </p>
        <div class="micro-case-note">Ejemplo ilustrativo del tipo de revisión que facilita REELEVO, no un caso de cliente.</div>
      </div>
    </div>
  </section>

  <div class="divider"></div>

  <FaqSection items={faqs} />

  <div class="divider"></div>

  <section class="cta-section">
    <div class="cta-eyebrow fade-up">Revisión final</div>
    <div class="cta-title fade-up delay-1">
      Si llevas calidad o compliance, <br><em>mira el encaje con casos reales de planta</em>
    </div>
    <p class="cta-sub fade-up delay-2">
      Regístrate, revisa el producto con tu equipo y valora si aporta más claridad a tu revisión interna,
      a los cambios de proceso y a los puestos sensibles, sin promesas infladas.
    </p>
    <div class="cta-actions fade-up delay-3">
      <a href="https://app.gmvsolutions.es/registro" class="btn-primary"
         data-cta data-cta-intent="registro" data-cta-location="footer" data-cta-label="Registrarme en REELEVO">Registrarme en REELEVO</a>
      <a href="/sobre-nosotros/#portabilidad" class="btn-ghost">Ver datos y continuidad →</a>
    </div>
    <div class="cta-note fade-up delay-4">Ver también el encaje en <a href="/sectores/mecanizado-cnc/">mecanizado y CNC</a> o <a href="/calidad-y-conformidad/">calidad y conformidad</a>. <br />Implementación asistida · Enfoque prudente para calidad y compliance</div>
  </section>
</BaseLayout>

<style>
  .proof-grid,
  .scenario-grid,
  .value-grid,
  .boundary-grid {
    display: grid;
    gap: 24px;
  }

  .proof-grid {
    grid-template-columns: 1.05fr .95fr;
    margin-top: 48px;
  }

  .scenario-grid {
    grid-template-columns: repeat(3, 1fr);
  }

  .value-grid {
    grid-template-columns: repeat(4, 1fr);
    margin-top: 44px;
  }

  .boundary-grid {
    grid-template-columns: repeat(2, 1fr);
    margin-top: 40px;
  }

  .proof-card,
  .scenario-card,
  .value-card,
  .boundary-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 6px;
  }

  .proof-frame img {
    width: 100%;
    display: block;
  }

  .proof-caption {
    padding: 16px 18px;
    font-size: .8rem;
    color: var(--gray);
    line-height: 1.55;
  }

  .proof-points,
  .value-card,
  .boundary-card,
  .scenario-card {
    padding: 28px 24px;
    text-align: left;
  }

  .proof-points h3,
  .scenario-card-title,
  .value-title,
  .boundary-title {
    font-family: 'Oswald', sans-serif;
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: .03em;
    margin-bottom: 12px;
    color: var(--white);
  }

  .proof-point,
  .value-desc {
    font-size: .95rem;
    color: var(--gray);
    line-height: 1.65;
  }

  .proof-point {
    padding: 0 0 14px;
    margin-bottom: 14px;
    border-bottom: 1px solid var(--border);
  }

  .proof-point:last-child {
    margin-bottom: 0;
    padding-bottom: 0;
    border-bottom: none;
  }

  .proof-point strong {
    color: var(--white);
  }

  .scenario-card-tag {
    font-family: 'DM Mono', monospace;
    font-size: .7rem;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--orange-ink);
    margin-bottom: 12px;
  }

  .scenario-before,
  .scenario-after {
    font-size: .84rem;
    color: var(--gray);
    line-height: 1.65;
    margin-top: 16px;
  }

  .scenario-before strong,
  .scenario-after strong {
    display: block;
    color: var(--white);
    margin-bottom: 8px;
  }

  .scenario-before ul,
  .scenario-after ul,
  .boundary-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .scenario-before li,
  .scenario-after li,
  .boundary-list li {
    padding: 10px 0;
    border-top: 1px solid var(--border);
  }

  .scenario-before li:first-child,
  .scenario-after li:first-child,
  .boundary-list li:first-child {
    border-top: none;
    padding-top: 0;
  }

  .boundary-card.ok {
    border-color: rgba(34,197,94,.2);
  }

  .boundary-card.caution {
    border-color: rgba(244,82,30,.25);
  }

  @media (max-width: 1100px) {
    .value-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 960px) {
    .proof-grid,
    .scenario-grid,
    .boundary-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 720px) {
    .value-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

