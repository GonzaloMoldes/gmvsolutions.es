---
import Ilustracion from '../../components/Ilustracion.astro';
import Icon from "../../components/Icon.astro";
import BaseLayout from '../../layouts/BaseLayout.astro';
import FaqSection from '../../components/FaqSection.astro';
import { faqPageSchema, type FaqItem } from '../../lib/seo';
import Screenshot from '../../components/Screenshot.astro';
import { getPagina, conNegritas, conSaltos, sinMarcas } from '../../lib/contenido';

// Textos editables desde Sanity (Páginas). Respaldo: src/data/paginas/para-quien--gerente-propietario.json.
const pagina = await getPagina('para-quien/gerente-propietario');

const title = pagina.seo.title;
const description = pagina.seo.description;
const canonical = "https://www.gmvsolutions.es/para-quien/gerente-propietario/";

// Esta pagina no tenia FAQ ni FAQPage en el head. Se anade, y absorbe la seccion "Cuando encaja"
// (tarea D4 de PLAN_SIMPLIFICACION_EDITORIAL_WEB_2026-08.md).
const faqs: FaqItem[] = pagina.faq.items.map(({ q, a }) => ({ q, a: sinMarcas(a) }));

const pageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "REELEVO para Gerentes y Propietarios",
  "description": "Solución específica para decisores y propietarios de empresas industriales",
  "audience": {
    "@type": "Audience",
    "audienceType": "Business Owner"
  }
};

const schema = [pageSchema, faqPageSchema(faqs)];
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  schema={schema}
  activeNav=""
  pageType="rol"
>
  <!-- PAGE HERO -->
  <section class="page-hero">
    <div class="eyebrow fade-up">{pagina.hero.antetitulo}</div>
    <h1 class="fade-up delay-1"><Fragment set:html={conSaltos(pagina.hero.titulo)} />{pagina.hero.tituloDestacado && <> <br> <em>{pagina.hero.tituloDestacado}</em></>}.</h1>
    <p class="fade-up delay-2" set:html={conNegritas(pagina.hero.texto)} />
    <div class="hero-cta-group fade-up delay-3">
      {pagina.hero.botones[0] && (
<a href={pagina.hero.botones[0].url} class="btn-ghost"
         data-cta data-cta-intent="registro" data-cta-location="hero" data-cta-label="Registrarme en REELEVO">{pagina.hero.botones[0].texto}</a>
)}
    </div>
    <div class="hero-cta-note fade-up delay-4">Precio publicado por empresa · Puesta en marcha ágil</div>
    <Ilustracion escena="gerente-propietario" />
  </section>

  <div class="divider"></div>

  <!-- PRUEBA VISUAL -->
  <section class="section">
    <div class="section-inner">
      <div class="fade-up">
        <div class="eyebrow">Prueba visual</div>
        <h2 class="section-title">Por qué no parece un proyecto <em>pesado</em></h2>
        <p class="section-sub">Lo que compra gerencia no es un catálogo infinito de features. Es una forma más simple de
          dar continuidad a la operación y ganar visibilidad sin pagar por cada operario.
        </p>
      </div>

      <div class="proof-grid fade-up delay-1">
        <div class="proof-card proof-shot">
          <div class="proof-frame">
            <Screenshot name="sop-operario" alt="Acceso al proceso desde el puesto en REELEVO" layout="pair" />
          </div>
          <div class="proof-caption">Captura real del producto: el trabajo aparece en el puesto sin añadir fricción al operario.</div>
        </div>

        <div class="proof-card proof-points">
          <h3>Lo que hace más fácil la decisión</h3>
          <div class="proof-point"><strong>Empiezas por lo crítico:</strong> no hace falta desplegar toda la planta de golpe.</div>
          <div class="proof-point"><strong>Sin coste por operario:</strong> el precio no castiga crecer o incorporar temporal.</div>
          <div class="proof-point"><strong>Más continuidad:</strong> menos dependencia de llamadas y memoria cuando falta alguien.</div>
          <div class="proof-point"><strong>Software real:</strong> la propuesta se puede enseñar ya sobre producto visible, no sobre una promesa abstracta.</div>
        </div>
      </div>
    </div>
  </section>

  <div class="divider"></div>

  <!-- EXECUTIVE SUMMARY -->
  

  <div class="divider"></div>

  <!-- STATS BANDA -->
  <section class="stat-band">
    <div class="stat-band-inner fade-up">
      <div class="stat-item">
        <div class="stat-num">49€</div>
        <div class="stat-label">Desde 49 €/mes por empresa</div>
      </div>
      <div class="stat-item">
        <div class="stat-num">Ligero</div>
        <div class="stat-label">Arranque técnico y operativo</div>
      </div>
      <div class="stat-item">
        <div class="stat-num">Fijo</div>
        <div class="stat-label">Mismo precio aunque crezca la plantilla</div>
      </div>
    </div>
  </section>

  <div class="divider"></div>

  <!-- IMPACTO EMPRESARIAL -->
  <section class="section">
    <div class="section-inner">
      <div class="fade-up">
        <div class="eyebrow">Dónde se nota</div>
        <h2 class="section-title">Tres impactos que sí importan a gerencia</h2>
        <p class="section-sub">Mensajes simples para valorar si tiene sentido mover esto ahora
          o seguir conviviendo con la improvisación.
        </p>
      </div>

      <div class="risk-matrix fade-up delay-1">
        <div class="risk-card high-risk">
          <div class="risk-level">Continuidad</div>
          <h3 class="risk-title">Menos dependencia de una sola persona</h3>
          <div class="risk-impact">
            <strong>Sin ordenar esto:</strong>
            <ul>
              <li>Una baja o un cambio de puesto tensiona más de la cuenta el turno</li>
              <li>El conocimiento sigue viviendo en conversaciones y costumbres</li></ul>
          </div>
      <div class="risk-mitigation">
            <strong>Con REELEVO:</strong>
            <ul>
              <li>Proceso documentado y accesible en el puesto</li>
              <li>Guía de incidencias ligada al trabajo real</li></ul>
          </div>
          <div class="risk-probability">Resultado: <strong>menos fragilidad operativa</strong></div>
        </div>

        <div class="risk-card medium-risk">
          <div class="risk-level">Onboarding</div>
          <h3 class="risk-title">Incorporaciones menos dependientes del tutor</h3>
          <div class="risk-impact">
            <strong>Sin ordenar esto:</strong>
            <ul>
              <li>El experto sigue perdiendo tiempo explicando lo mismo</li>
              <li>Cada incorporación depende demasiado de quién enseña</li></ul>
          </div>
          <div class="risk-mitigation">
            <strong>Con REELEVO:</strong>
            <ul>
              <li>El proceso se enseña igual en cada incorporación</li>
              <li>Se reduce la necesidad de tutoría continua</li></ul>
          </div>
          <div class="risk-probability">Resultado: <strong>menos tiempo improductivo de los expertos</strong></div>
        </div>

        <div class="risk-card low-risk">
          <div class="risk-level">Escala</div>
          <h3 class="risk-title">Crecimiento sin añadir más complejidad</h3>
          <div class="risk-impact">
            <strong>Sin ordenar esto:</strong>
            <ul>
              <li>Cada nueva incorporación multiplica el esfuerzo interno</li>
              <li>El coste de coordinar personas y procesos crece rápido</li></ul>
          </div>
          <div class="risk-mitigation">
            <strong>Con REELEVO:</strong>
            <ul>
              <li>Precio fijo por empresa</li>
              <li>Empezar por pocos procesos críticos y ampliar después</li></ul>
          </div>
          <div class="risk-probability">Resultado: <strong>más orden sin complicar la decisión</strong></div>
        </div>
      </div>
    
      <div class="fade-up" style="text-align:center;margin-bottom:64px;">
        <h3 class="sub-head">Qué compra realmente la empresa</h3>
        <p class="section-sub">No compras una herramienta más para "tener todo escrito".
 Compras continuidad operativa y menos dependencia de perfiles difíciles de sustituir.
        </p>
      </div>

      <div class="executive-grid fade-up delay-1">
        <div class="exec-card problem">
          <Icon name="alerta" class="exec-icon icon--draw" />
          <h3 class="exec-title">Lo que duele hoy</h3>
          <div class="exec-stats">
            <div class="exec-stat">
              <div class="exec-stat-number">Baja</div>
              <div class="exec-stat-label">Una ausencia en el puesto equivocado desordena el turno</div>
            </div>
            <div class="exec-stat">
              <div class="exec-stat-number">Tutor</div>
              <div class="exec-stat-label">Cuando el experto forma, deja de producir</div>
            </div>
          </div>
          <div class="exec-risks">
            <h4>Impacto habitual:</h4>
            <ul>
              <li>Procesos críticos que viven en la cabeza de una persona</li>
              <li>Incorporaciones lentas y dependientes del tutor</li>
              <li>Poca visibilidad de qué proceso está realmente cubierto</li>
            </ul>
          </div>
        </div>

        <div class="exec-card solution">
          <Icon name="diana" class="exec-icon icon--draw" />
          <h3 class="exec-title">Lo que aporta REELEVO</h3>
          <div class="exec-stats">
            <div class="exec-stat">
              <div class="exec-stat-number">49€</div>
              <div class="exec-stat-label">Desde 49 €/mes por empresa</div>
            </div>
            <div class="exec-stat">
              <div class="exec-stat-number">Ligero</div>
              <div class="exec-stat-label">Arranque técnico y operativo</div>
            </div>
          </div>
          <div class="exec-benefits">
            <h4>Valor para gerencia:</h4>
            <ul>
              <li>Menos dependencia de personas clave en puestos críticos</li>
              <li>Más visibilidad sobre lo que pasa en planta</li>
              <li>Onboarding más ordenado con precio fijo y puesta en marcha ágil</li>
            </ul>
          </div>
        </div>
      </div>

      <div class="executive-conclusion fade-up delay-2">
        <h3>Lectura rápida</h3>
        <p>
          <strong>REELEVO encaja cuando quieres reducir riesgo operativo</strong>
          sin entrar en un proyecto caro, largo o difícil de justificar.
        </p>
      </div>
  </div>
  </section>

  <div class="divider"></div>

  <!-- DECISIÓN -->
  

  <div class="divider"></div>

  <!-- MICROCASO (escenario ilustrativo, no testimonio real) -->
  <section class="section section-center">
    <div class="section-inner">
      <div class="micro-case fade-up">
        <div class="micro-case-tag">Escenario típico en planta</div>
        <p class="micro-case-text">Un taller de 35 personas con dos operarios que concentran el arranque de las líneas críticas.
 Cuando uno falta, el turno se desordena. Al documentar esos procesos en el puesto y medir
          qué queda cubierto, la dirección deja de depender de una llamada para que la línea arranque.
        </p>
        <div class="micro-case-note">Ejemplo ilustrativo del tipo de problema que aborda REELEVO, no un caso de cliente.</div>
      </div>
    </div>
  </section>

  <div class="divider"></div>

  <!-- CTA -->
  <FaqSection items={faqs} />

  <div class="divider"></div>

  <section class="cta-section">
    <div class="cta-eyebrow fade-up">{pagina.ctaFinal.antetitulo}</div>
    <h3 class="cta-title fade-up delay-1"><Fragment set:html={conSaltos(pagina.ctaFinal.titulo)} />{pagina.ctaFinal.tituloDestacado && <> <em>{pagina.ctaFinal.tituloDestacado}</em></>}</h3>
    <p class="cta-sub fade-up delay-2" set:html={conNegritas(pagina.ctaFinal.texto)} />
    <div class="fade-up delay-3" style="display:flex;gap:16px;justify-content:center;flex-wrap:wrap;">
      {pagina.ctaFinal.botones[0] && (
<a href={pagina.ctaFinal.botones[0].url} class="btn-primary"
         data-cta data-cta-intent="registro" data-cta-location="footer" data-cta-label="Registrarme en REELEVO">{pagina.ctaFinal.botones[0].texto}</a>
)}
    </div>
    <div class="cta-note fade-up delay-4" set:html={conNegritas(pagina.ctaFinal.nota)} />
    </section>
</BaseLayout>

<style>
  .proof-grid {
    display: grid;
    grid-template-columns: 1.05fr .95fr;
    gap: 24px;
    margin-top: 48px;
  }

  .proof-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 6px;
    overflow: hidden;
  }

  .proof-frame img {
    width: 100%;
    display: block;
  }

  .proof-caption {
    padding: 16px 18px;
    font-size: .8rem;
    color: var(--gray);
    line-height: 1.55;
  }

  .proof-points {
    padding: 28px 24px;
  }

  .proof-points h3 {
    font-family: 'Oswald', sans-serif;
    font-size: 1.1rem;
    font-weight: 600;
    margin-bottom: 18px;
  }

  .proof-point {
    font-size: .95rem;
    line-height: 1.65;
    color: var(--gray);
    padding: 0 0 14px;
    margin-bottom: 14px;
    border-bottom: 1px solid var(--border);
  }

  .proof-point:last-child {
    margin-bottom: 0;
    padding-bottom: 0;
    border-bottom: none;
  }

  .proof-point strong {
    color: var(--white);
  }

  /* Executive grid */
  .executive-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2px;
    margin-top: 48px;
  }

  .exec-card {
    background: var(--surface);
    padding: 32px 28px;
    position: relative;
  }

  .exec-card.problem::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: #FF4444;
  }

  .exec-card.solution::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: var(--green);
  }

  .exec-icon {
    margin-bottom: 20px;
    text-align: center;
  }

  .exec-title {
    font-family: 'Oswald', sans-serif;
    font-size: 1.4rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: .03em;
    margin-bottom: 24px;
    text-align: center;
  }

  .exec-stats {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-bottom: 24px;
  }

  .exec-stat {
    background: var(--surface2);
    padding: 16px;
    border-radius: 2px;
    text-align: center;
  }

  .exec-stat-number {
    font-family: 'Oswald', sans-serif;
    font-size: 1.6rem;
    font-weight: 700;
    color: var(--orange-ink);
    line-height: 1;
    margin-bottom: 6px;
  }

  .exec-stat-label {
    font-size: .7rem;
    color: var(--gray);
    line-height: 1.3;
  }

  .exec-risks h4,
  .exec-benefits h4 {
    font-family: 'DM Mono', monospace;
    font-size: .7rem;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--orange-ink);
    margin-bottom: 8px;
  }

  .exec-risks ul,
  .exec-benefits ul {
    list-style: none;
    font-size: .85rem;
    line-height: 1.6;
  }

  .exec-risks li {
    color: var(--gray);
    margin-bottom: 4px;
  }

  .exec-risks li::before {
    content: '−';
    color: var(--gray2);
    margin-right: 8px;
  }

  .exec-benefits li {
    color: rgba(20,22,24, .8);
    margin-bottom: 4px;
  }

  .exec-benefits li::before {
    content: '✓';
    color: var(--green);
    margin-right: 8px;
    font-weight: 600;
  }

  .executive-conclusion {
    background: var(--surface);
    padding: 28px;
    border-radius: 4px;
    text-align: center;
    margin-top: 32px;
  }

  .executive-conclusion h3 {
    font-family: 'Oswald', sans-serif;
    font-size: 1.1rem;
    font-weight: 600;
    margin-bottom: 12px;
    color: var(--orange-ink);
  }

  .executive-conclusion p {
    font-size: .95rem;
    line-height: 1.65;
    color: rgba(20,22,24, .9);
  }

  .executive-conclusion strong {
    color: var(--white);
    font-weight: 500;
  }

  /* Financial analysis */
  .financial-analysis {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 32px;
    margin-top: 48px;
  }

  .cost-breakdown h3 {
    font-family: 'Oswald', sans-serif;
    font-size: 1.1rem;
    font-weight: 600;
    margin-bottom: 20px;
    color: var(--orange-ink);
  }

  .cost-table-exec {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr 1fr;
    gap: 2px;
    background: var(--border);
    margin-bottom: 16px;
  }

  .cost-header {
    display: contents;
  }

  .cost-header > div {
    background: var(--surface2);
    padding: 12px 8px;
    font-family: 'Oswald', sans-serif;
    font-size: .8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: .03em;
    text-align: center;
  }

  .cost-row {
    display: contents;
  }

  .cost-row > div {
    background: var(--surface);
    padding: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: .8rem;
    text-align: center;
  }

  .cost-item {
    justify-content: flex-start !important;
    text-align: left !important;
    font-weight: 500;
  }

  .cost-reelevo {
    background: rgba(244, 82, 30, 0.06);
    border: 1px solid rgba(244, 82, 30, 0.15);
    font-weight: 500;
  }

  .cost-row.total > div {
    font-weight: 600;
    background: var(--surface2);
  }

  .cost-row.total .cost-reelevo {
    background: rgba(244, 82, 30, 0.1);
  }

  .cost-footnote {
    font-size: .75rem;
    color: var(--gray2);
    line-height: 1.5;
  }

  .roi-comparison h3 {
    font-family: 'Oswald', sans-serif;
    font-size: 1.1rem;
    font-weight: 600;
    margin-bottom: 20px;
    color: var(--orange-ink);
  }

  .roi-cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
  }

  .roi-card {
    background: var(--surface2);
    padding: 20px;
    border-radius: 4px;
    text-align: center;
  }

  .roi-card.winner {
    border: 2px solid var(--green);
    background: rgba(34, 197, 94, 0.06);
  }

  .roi-card.expensive {
    border: 2px solid #FF4444;
    background: rgba(255, 68, 68, 0.06);
  }

  .roi-card.moderate {
    border: 2px solid #FF8800;
    background: rgba(255, 136, 0, 0.06);
  }

  .roi-solution {
    font-family: 'Oswald', sans-serif;
    font-size: .9rem;
    font-weight: 600;
    text-transform: uppercase;
    margin-bottom: 8px;
  }

  .roi-investment,
  .roi-savings {
    font-size: .75rem;
    color: var(--gray);
    margin-bottom: 4px;
  }

  .roi-percentage {
    font-family: 'Oswald', sans-serif;
    font-size: 1.2rem;
    font-weight: 700;
    margin-bottom: 4px;
  }

  .roi-card.winner .roi-percentage {
    color: var(--green);
  }

  .roi-card.expensive .roi-percentage {
    color: #FF4444;
  }

  .roi-card.moderate .roi-percentage {
    color: #FF8800;
  }

  .roi-payback {
    font-size: .8rem;
    color: var(--gray);
  }

  /* Risk matrix */
  .risk-matrix {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2px;
    margin-top: 48px;
  }

  .risk-card {
    background: var(--surface);
    padding: 28px 24px;
    position: relative;
  }

  .risk-card.high-risk::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: #FF4444;
  }

  .risk-card.medium-risk::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: #FF8800;
  }

  .risk-card.low-risk::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: #22C55E;
  }

  .risk-level {
    font-family: 'DM Mono', monospace;
    font-size: .6rem;
    letter-spacing: .14em;
    text-transform: uppercase;
    font-weight: 600;
    margin-bottom: 12px;
  }

  .risk-title {
    font-family: 'Oswald', sans-serif;
    font-size: 1rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: .03em;
    margin-bottom: 16px;
    line-height: 1.2;
  }

  .risk-impact,
  .risk-mitigation {
    margin-bottom: 16px;
  }

  .risk-impact strong,
  .risk-mitigation strong {
    font-family: 'DM Mono', monospace;
    font-size: .7rem;
    letter-spacing: .12em;
    text-transform: uppercase;
    display: block;
    margin-bottom: 8px;
  }

  .risk-impact strong {
    color: var(--gray2);
  }

  .risk-mitigation strong {
    color: var(--orange-ink);
  }

  .risk-impact ul,
  .risk-mitigation ul {
    list-style: none;
    font-size: .8rem;
    line-height: 1.5;
  }

  .risk-impact li {
    color: var(--gray);
    margin-bottom: 3px;
  }

  .risk-impact li::before {
    content: '−';
    color: var(--gray2);
    margin-right: 8px;
  }

  .risk-mitigation li {
    color: rgba(20,22,24, .8);
    margin-bottom: 3px;
  }

  .risk-mitigation li::before {
    content: '✅';
    margin-right: 6px;
  }

  .risk-probability {
    background: var(--surface2);
    padding: 12px;
    border-radius: 2px;
    font-size: .8rem;
    color: var(--gray);
    text-align: center;
  }

  .risk-probability strong {
    color: var(--orange-ink);
    font-weight: 600;
  }

  /* Price model cards */
  .benefits-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    margin-top: 48px;
  }

  .benefit-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 32px 28px;
    text-align: center;
  }

  .benefit-card-icon {
    margin-bottom: 16px;
