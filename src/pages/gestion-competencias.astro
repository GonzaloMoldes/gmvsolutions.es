---
import BaseLayout from '../layouts/BaseLayout.astro';
import FaqSection from '../components/FaqSection.astro';
import { softwareApplicationSchema, faqPageSchema, type FaqItem } from '../lib/seo';
import Screenshot from '../components/Screenshot.astro';

const title = "Gestion de competencias industriales para pymes | REELEVO";
const description = "Visualiza matriz de habilidades por puesto, detecta brechas de competencias y reduce dependencia operativa con seguimiento real en planta.";
const canonical = "https://www.gmvsolutions.es/gestion-competencias/";

// Una sola lista alimenta el bloque visible y el FAQPage del head (auditoria P6).
const faqs: FaqItem[] = [
  {
    q: '¿Qué es una matriz de competencias o skill matrix?',
    a: 'Es el registro de qué operario está capacitado para qué proceso o máquina y en qué nivel de autonomía. Cruza personas con procesos y permite ver de un vistazo dónde depende todo de una sola persona, qué puesto queda descubierto en un turno y dónde hace falta reforzar formación.',
  },
  {
    q: '¿Cómo se mantiene actualizada?',
    a: 'Se alimenta de la ejecución real: cada vez que un operario completa un proceso, ese dato entra solo. Es la diferencia con un Excel, que refleja la foto del día que se creó porque nadie lo actualiza, y a los pocos meses deja de servir para decidir nada.',
  },
  {
    q: '¿Cuántos niveles de competencia conviene definir?',
    a: 'Tres o cuatro bastan en una pyme: en formación, apto con supervisión, autónomo y, si aporta, formador. Más niveles generan discusión sobre el matiz sin cambiar ninguna decisión. Lo que importa es que el criterio para subir de nivel sea observable y el mismo para todos.',
  },
  {
    q: '¿Sirve para planificar la formación?',
    a: 'Sí, y es de sus usos más directos. Al ver los huecos de la matriz sabes qué proceso tiene poca cobertura y a quién conviene formar antes de que una baja lo convierta en un problema, en lugar de planificar formación por intuición o por lo que se hizo el año pasado.',
  },
];

const pageSchema = softwareApplicationSchema();

const schema = [pageSchema, faqPageSchema(faqs)];
---

<BaseLayout title={title} description={description} canonical={canonical} schema={schema} activeNav="" pageType="capacidad">
  <!-- PAGE HERO -->
  <section class="page-hero">
    <div class="eyebrow fade-up">Gestión de Competencias Operativas</div>
    <h1 class="fade-up delay-1">¿Quién puede cubrir<br><em>ese puesto el lunes?</em></h1>
    <p class="fade-up delay-2">Hoy la respuesta está en la cabeza del encargado, y cambia según a quién preguntes. Con una matriz de competencias real ves quién domina cada proceso, quién está a medias y qué puestos dependen de una sola persona.</p>
    <div class="hero-cta fade-up delay-3" style="display:flex;gap:14px;justify-content:center;flex-wrap:wrap;">
      <a href="https://app.gmvsolutions.es/registro" class="btn-primary"
         data-cta data-cta-intent="registro" data-cta-location="hero" data-cta-trigger="05" data-cta-label="Registrarme en REELEVO">Registrarme en REELEVO</a>
      <a href="/video-demo/" class="btn-ghost"
         data-cta data-cta-intent="navegacion" data-cta-location="hero" data-cta-label="Ver el demo">Ver el demo →</a>
    </div>
  </section>

  <div class="divider"></div>

  <!-- PROBLEMA -->
  <section class="section">
    <div class="section-inner">
      <div class="fade-up">
        <div class="eyebrow">El reto</div>
        <h2 class="section-title">¿Quién sabe hacer qué en tu planta?</h2>
      </div>

      <div class="challenge-content fade-up delay-1">
        <p>En una pyme industrial típica:</p>
        <div class="challenge-list">
          <div class="challenge-item">
            <span class="icon">❌</span>
            <span>87% identifica dependencia de operarios clave como riesgo alto</span>
          </div>
          <div class="challenge-item">
            <span class="icon">❌</span>
            <span>Solo 23% tiene competencias documentadas y actualizadas</span>
          </div>
          <div class="challenge-item">
            <span class="icon">❌</span>
            <span>Responsable RRHH desconoce quién está habilitado para cada máquina</span>
          </div>
          <div class="challenge-item">
            <span class="icon">❌</span>
            <span>Cuando falta alguien, "llamamos al que sabe" (si está disponible)</span>
          </div>
          <div class="challenge-item">
            <span class="icon">❌</span>
            <span>No hay transparencia sobre el riesgo operativo real</span>
          </div>
        </div>
      </div>

      <div class="risk-box fade-up delay-2">
        <h3>Resultado: La bomba de tiempo de dependencia operativa</h3>
        <p>Operarios clave sin documentación de su conocimiento + matriz de competencias desconocida = riesgo de parada de producción cuando falta alguien.</p>
      </div>
    </div>
  </section>

  <div class="divider"></div>

  <!-- SOLUCIÓN -->
  <section class="section">
    <div class="section-inner">
      <div class="fade-up">
        <div class="eyebrow">La solución</div>
        <h2 class="section-title">Matriz de competencias + Documentación integrada</h2>
      </div>

      <div class="solution-grid fade-up delay-1">
        <div class="solution-cell">
          <div class="cell-number">1</div>
          <h3>Mapeo de competencias</h3>
          <p>¿Quién sabe operar cada máquina? ¿Quién está "apto", "en entrenamiento", "experto"? Matriz clara y actualizable.</p>
        </div>

        <div class="solution-cell">
          <div class="cell-number">2</div>
          <h3>Identificación de brechas</h3>
          <p>¿Hay solo una persona que domina la CNC? ¿Nadie sabe los parámetros de la extrusora? REELEVO lo identifica.</p>
        </div>

        <div class="solution-cell">
          <div class="cell-number">3</div>
          <h3>Análisis de riesgo</h3>
          <p>Score de dependencia operativa por máquina. Sabes exactamente dónde está el riesgo. Prioriza documentación donde más importa.</p>
        </div>

        <div class="solution-cell">
          <div class="cell-number">4</div>
          <h3>Vinculación con SOP</h3>
          <p>Cada procedimiento documentado vinculado a la competencia requerida. "Este SOP enseña a operar la línea de envasado".</p>
        </div>

        <div class="solution-cell">
          <div class="cell-number">5</div>
          <h3>Capacitación planificada</h3>
          <p>Sabe exactamente a quién entrenar. Cuando alguien completa un SOP, actualiza su competencia automáticamente.</p>
        </div>

        <div class="solution-cell">
          <div class="cell-number">6</div>
          <h3>Trazabilidad</h3>
          <p>Historial de quién completó cada capacitación, cuándo, con qué resultado. Registro verificable compatible con revisiones internas y auditorías ISO.</p>
        </div>
      </div>
    </div>
  </section>

  <div class="divider"></div>

  <!-- BENEFICIOS ESPECÍFICOS PARA RRHH -->
  <section class="section">
    <div class="section-inner">
      <div class="fade-up">
        <div class="eyebrow">Para el departamento de RRHH</div>
        <h2 class="section-title">Lo que ganas con REELEVO</h2>
      </div>

      <div class="benefits-grid fade-up delay-1">
        <div class="benefit-box">
          <h3>Visibilidad real</h3>
          <p>Sabes exactamente quién está listo para cada puesto. No es intuición, son datos.</p>
        </div>

        <div class="benefit-box">
          <h3>Planificación de sucesión</h3>
          <p>Cuando alguien se jubila, ya tienes a 2-3 personas entrenadas en su competencia.</p>
        </div>

        <div class="benefit-box">
          <h3>Cobertura de bajas sin estrés</h3>
          <p>Cuando alguien falta, consultas la matriz: "Juan puede cubrir. Aquí está el SOP. Listo."</p>
        </div>

        <div class="benefit-box">
          <h3>Inversión en capacitación eficiente</h3>
          <p>Sabes dónde invertir el presupuesto de formación. Entrenar a alguien en la máquina crítica que solo domina el experto.</p>
        </div>

        <div class="benefit-box">
          <h3>Reducción de riesgo legal</h3>
          <p>Trazabilidad completa de quién tiene qué competencia. Registro verificable compatible con revisiones internas y auditorías ISO, IATF, etc.</p>
        </div>

        <div class="benefit-box">
          <h3>Rotación de personal sin pánico</h3>
          <p>Personal ETT entra entrenado siguiendo el procedimiento. Personal rotante sabe dónde consultar su competencia.</p>
        </div>
      </div>

      <div class="fade-up delay-2" style="margin-top:48px;border:1px solid var(--border);border-left:3px solid var(--orange);border-radius:6px;padding:32px 28px;background:var(--surface);">
        <h3 style="font-family:'Oswald',sans-serif;font-size:1.05rem;font-weight:600;text-transform:uppercase;letter-spacing:.03em;margin-bottom:14px;">¿Y cuánto tarda en aprenderlo el que todavía no sabe?</h3>
        <p style="font-size:.9rem;color:var(--gray);line-height:1.7;margin-bottom:16px;">
          La matriz responde quién sabe hacer qué. La otra mitad de la pregunta —cuánto le queda al que está aprendiendo—
          sale de las rutas de aprendizaje: en qué paso va, cuántas ejecuciones lleva y cuánto tarda comparado con el titular
          del puesto. Deja de ser «yo creo que en dos semanas está» y pasa a ser algo que se mira.
        </p>
        <a href="/casos-de-uso/onboarding-operarios/#cuanto-tarda" class="perfil-card-link">Ver cómo se mide el tiempo de aprendizaje →</a>
      </div>
    </div>
  </section>

  <div class="divider"></div>

  <!-- MATRIZ VISUAL -->
  <section class="section">
    <div class="section-inner">
      <div class="fade-up">
        <h2 class="section-title">¿Cómo se ve en REELEVO?</h2>
      </div>

      <div class="matrix-example fade-up delay-1">
        <p class="matrix-title">Matriz de competencias - Línea de envasado alimentaria</p>
        <table class="matrix-table">
          <thead>
            <tr>
              <th>Operario</th>
              <th>Configuraciónlínea</th>
              <th>Atasco material</th>
              <th>Parámetros velocidad</th>
              <th>Etiquetado</th>
              <th>Limpieza GMP</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>Antonio</td>
              <td class="level-3">✓ Experto</td>
              <td class="level-3">✓ Experto</td>
              <td class="level-3">✓ Experto</td>
              <td class="level-2">Apto</td>
              <td class="level-1">Entrenando</td>
            </tr>
            <tr>
              <td>María</td>
              <td class="level-2">Apto</td>
              <td class="level-2">Apto</td>
              <td class="level-1">Entrenando</td>
              <td class="level-3">✓ Experta</td>
              <td class="level-3">✓ Experta</td>
            </tr>
            <tr>
              <td>Pedro</td>
              <td class="level-1">Entrenando</td>
              <td class="level-2">Apto</td>
              <td class="level-1">Entrenando</td>
              <td class="level-2">Apto</td>
              <td class="level-2">Apto</td>
            </tr>
            <tr>
              <td>Carmen</td>
              <td class="level-2">Apto</td>
              <td class="level-1">Entrenando</td>
              <td class="level-2">Apto</td>
              <td class="level-1">Entrenando</td>
              <td class="level-3">✓ Experta</td>
            </tr>
          </tbody>
        </table>
        <div class="matrix-analysis">
          <p><strong>RRHH ve:</strong> "Configuración línea tiene riesgo (solo Antonio): PRIORIDAD entrenar a María. Limpieza GMP está bien distribuida."</p>
        </div>
      </div>

      <div class="screenshot-pair fade-up delay-2">
        <figure class="screenshot-fig">
          <Screenshot name="equipo-operaciones" alt="Panel de equipo de operaciones en REELEVO: procesos completados, minutos acumulados y última actividad por operario" class="screenshot-img" layout="pair" />
          <figcaption class="screenshot-caption">Panel de equipo — actividad y procesos completados por operario</figcaption>
        </figure>
        <figure class="screenshot-fig">
          <Screenshot name="competencias-operario" alt="Detalle de competencias de un operario en REELEVO: certificaciones activas, en proceso y caducadas" class="screenshot-img" layout="pair" />
          <figcaption class="screenshot-caption">Detalle de competencias — certificaciones activas con fecha de expiración</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <div class="divider"></div>

  <!-- LO QUE DETECTA SOLO -->
  <!-- Verificado en reelevo-app/app/api/cron/: skill-decay (hitos 60/90/180
       dias), cert-expiry (aviso a <=7 dias, diario 07:00 UTC),
       knowledge-signals, shift-coverage-risk. -->
  <section class="section">
    <div class="section-inner">
      <div class="fade-up">
        <div class="eyebrow">Sin que nadie lo mire</div>
        <h2 class="section-title">Una matriz que se degrada sola<br><em>no sirve de nada</em></h2>
        <p class="section-sub">
          El problema de las matrices de competencias en Excel no es construirlas: es que a los seis meses
          ya no reflejan la realidad y nadie se fía. Estas revisiones se ejecutan a diario sin que nadie
          las lance.
        </p>
      </div>

      <div class="auto-grid fade-up delay-1">
        <article class="auto-card">
          <div class="auto-tag">Diario</div>
          <h3 class="auto-title">Competencias que se oxidan</h3>
          <p class="auto-desc">
            Si alguien lleva mucho sin ejecutar un proceso, su capacitación deja de ser real aunque
            siga marcada en la matriz. REELEVO lo detecta por hitos de <strong>60, 90 y 180 días</strong>
            sin práctica, configurables.
          </p>
        </article>

        <article class="auto-card">
          <div class="auto-tag">Diario</div>
          <h3 class="auto-title">Certificaciones a punto de vencer</h3>
          <p class="auto-desc">
            Aviso automático de las certificaciones que caducan en los <strong>próximos 7 días</strong>,
            para que la renovación se planifique en vez de descubrirse el día que hace falta la persona.
          </p>
        </article>

        <article class="auto-card">
          <div class="auto-tag">Diario</div>
          <h3 class="auto-title">Conocimiento en riesgo</h3>
          <p class="auto-desc">
            Señala los procesos que <strong>dependen de una sola persona</strong>, los que llevan
            demasiado tiempo sin revisarse y los que muestran una variación anómala entre quienes
            los ejecutan.
          </p>
        </article>

        <article class="auto-card">
          <div class="auto-tag">Diario</div>
          <h3 class="auto-title">Turnos sin quien cubra</h3>
          <p class="auto-desc">
            Cruza el turno planificado con las certificaciones activas y avisa de los procesos críticos
            que se quedan sin nadie capacitado, mientras aún se puede reorganizar.
            <a href="/cobertura-turnos/">Ver cobertura de turnos →</a>
          </p>
        </article>
      </div>
    </div>
  </section>

  <div class="divider"></div>

  <!-- CTA -->
  <FaqSection items={faqs} />

  <div class="divider"></div>

  <section class="cta-section">
    <div class="cta-eyebrow fade-up">Siguiente paso</div>
    <div class="cta-title fade-up delay-1">
      Construye tu matriz de <em>competencias hoy</em>
    </div>
    <p class="cta-sub fade-up delay-2">
      Visualiza el riesgo operativo real. Identifica dónde invertir capacitación. Reduce la dependencia de personas clave.
    </p>
    <div class="cta-actions fade-up delay-3">
      <a href="https://app.gmvsolutions.es/registro" class="btn-primary"
         data-cta data-cta-intent="registro" data-cta-location="footer" data-cta-trigger="05" data-cta-label="Registrarme en REELEVO">
        Registrarme en REELEVO
      </a>
    </div>
    <div class="cta-note fade-up delay-4" style="margin-top:18px;">
      Relacionado:
      <a href="/cobertura-turnos/">cobertura de turnos</a> ·
      <a href="/para-quien/responsable-rrhh/">para RRHH</a>
    </div>
  </section>

</BaseLayout>

<style>
  /* LO QUE DETECTA SOLO */
  .auto-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 18px;
    margin-top: 40px;
  }

  .auto-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 24px 22px;
  }

  .auto-tag {
    font-family: 'DM Mono', monospace;
    font-size: .6rem;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--orange);
    margin-bottom: 12px;
  }

  .auto-title {
    font-family: 'Oswald', sans-serif;
    font-size: .96rem;
    font-weight: 600;
    letter-spacing: .02em;
    margin-bottom: 10px;
  }

  .auto-desc {
    font-size: .84rem;
    color: var(--gray);
    line-height: 1.7;
  }

  .auto-desc strong { color: var(--white); font-weight: 500; }

  .auto-desc a {
    color: var(--orange);
    text-decoration: none;
    white-space: nowrap;
  }

  .auto-desc a:hover { text-decoration: underline; }

  @media (max-width: 1100px) {
    .auto-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 640px) {
    .auto-grid { grid-template-columns: 1fr; }
  }

  .challenge-content {
    max-width: 700px;
    margin-top: 40px;
  }

  .challenge-list {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin: 24px 0;
  }

  .challenge-item {
    display: flex;
    gap: 16px;
    align-items: flex-start;
    padding: 12px;
    background: var(--surface);
    border-left: 3px solid rgba(255, 100, 0, 0.3);
    border-radius: 4px;
  }

  .challenge-item .icon {
    font-size: 1.3rem;
    flex-shrink: 0;
  }

  .challenge-item span:last-child {
    color: var(--gray);
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .risk-box {
    background: rgba(255, 100, 0, 0.1);
    border: 1px solid rgba(255, 150, 0, 0.3);
    border-radius: 6px;
    padding: 28px;
    margin-top: 32px;
  }

  .risk-box h3 {
    font-family: 'Oswald', sans-serif;
    margin-bottom: 12px;
    color: var(--text);
  }

  .risk-box p {
    color: var(--gray);
    line-height: 1.6;
  }

  .solution-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
    margin-top: 40px;
  }

  .solution-cell {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 24px;
  }

  .cell-number {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    background: var(--orange);
    color: white;
    border-radius: 50%;
    font-weight: 600;
    font-size: 1.1rem;
    margin-bottom: 16px;
  }

  .solution-cell h3 {
    font-family: 'Oswald', sans-serif;
    font-size: 1rem;
    margin-bottom: 12px;
  }

  .solution-cell p {
    font-size: 0.9rem;
    color: var(--gray);
    line-height: 1.6;
  }

  .benefits-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
    margin-top: 40px;
  }

  .benefit-box {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 24px;
  }

  .benefit-box h3 {
    font-family: 'Oswald', sans-serif;
    font-size: 1rem;
    margin-bottom: 12px;
    color: var(--text);
  }

  .benefit-box p {
    font-size: 0.9rem;
    color: var(--gray);
    line-height: 1.6;
  }

  .case-story {
    display: grid;
    grid-template-columns: 1fr 1fr 1.2fr;
    gap: 24px;
    margin-top: 40px;
  }

  .story-section {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 24px;
  }

  .story-section.highlight {
    border-color: var(--orange);
    background: rgba(255, 150, 0, 0.02);
  }

  .story-section h3 {
    font-family: 'Oswald', sans-serif;
    font-size: 1rem;
    margin-bottom: 16px;
  }

  .story-section p {
    font-size: 0.9rem;
    color: var(--gray);
    line-height: 1.6;
    margin-bottom: 12px;
  }

  .story-section ul {
    list-style: none;
    padding: 0;
  }

  .story-section li {
    padding: 8px 0;
    font-size: 0.9rem;
    color: var(--gray);
    line-height: 1.5;
  }

  .story-section li:before {
    content: "✓ ";
    color: var(--orange);
    font-weight: 600;
    margin-right: 8px;
  }

  .matrix-example {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 32px;
    margin-top: 40px;
  }

  .matrix-title {
    font-family: 'Oswald', sans-serif;
    font-size: 0.95rem;
    font-weight: 600;
    margin-bottom: 20px;
  }

  .matrix-table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 20px;
  }

  .matrix-table th,
  .matrix-table td {
    padding: 12px 8px;
    text-align: left;
    border: 1px solid var(--border);
    font-size: 0.85rem;
  }

  .matrix-table th {
    background: var(--surface2);
    font-weight: 600;
  }

  .matrix-table td:first-child {
    font-weight: 500;
  }

  .level-1 {
    background: rgba(200, 100, 100, 0.15);
    color: #c86464;
  }

  .level-2 {
    background: rgba(255, 180, 100, 0.15);
    color: #d4991a;
  }

  .level-3 {
    background: rgba(100, 200, 100, 0.15);
    color: #64c864;
  }

  .matrix-analysis {
    background: rgba(255, 150, 0, 0.1);
    padding: 16px;
    border-radius: 4px;
    border-left: 3px solid var(--orange);
    font-size: 0.9rem;
    line-height: 1.6;
  }

  @media (max-width: 900px) {
    .solution-grid,
    .benefits-grid,
    .case-story {
      grid-template-columns: 1fr;
    }

    .case-story {
      grid-template-columns: 1fr;
    }

    .matrix-table {
      font-size: 0.75rem;
    }

    .matrix-table th,
    .matrix-table td {
      padding: 8px 4px;
    }
  }
</style>
