---
import Ilustracion from '../components/Ilustracion.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import FaqSection from '../components/FaqSection.astro';
import { softwareApplicationSchema, faqPageSchema, type FaqItem } from '../lib/seo';
import Screenshot from '../components/Screenshot.astro';
import { getPagina, conNegritas, sinMarcas } from '../lib/contenido';

// Textos editables desde Sanity (Páginas de funcionalidad). Respaldo: src/data/paginas/gestion-competencias.json.
const pagina = await getPagina('gestion-competencias');

const title = pagina.seo.title;
const description = pagina.seo.description;
const canonical = "https://www.gmvsolutions.es/gestion-competencias/";

// Una sola lista alimenta el bloque visible y el FAQPage del head (auditoria P6).
const faqs: FaqItem[] = pagina.faq.items.map(({ q, a }) => ({ q, a: sinMarcas(a) }));

const pageSchema = softwareApplicationSchema();

const schema = [pageSchema, faqPageSchema(faqs)];
---

<BaseLayout title={title} description={description} canonical={canonical} schema={schema} activeNav="" pageType="capacidad">

  <!-- HERO + PROBLEMA -->
  <section class="page-hero">
    <div class="eyebrow fade-up">{pagina.hero.antetitulo}</div>
    <h1 class="fade-up delay-1">{pagina.hero.titulo}{pagina.hero.tituloDestacado && <> <br> <em>{pagina.hero.tituloDestacado}</em></>}</h1>
    <p class="fade-up delay-2" set:html={conNegritas(pagina.hero.texto)} />
    <div class="hero-cta fade-up delay-3" style="display:flex;gap:14px;justify-content:center;flex-wrap:wrap;">
      {pagina.hero.botones[0] && (
<a href={pagina.hero.botones[0].url} class="btn-primary"
         data-cta data-cta-intent="registro" data-cta-location="hero" data-cta-trigger="05" data-cta-label="Registrarme en REELEVO">{pagina.hero.botones[0].texto}</a>
)}
      {pagina.hero.botones[1] && (
<a href={pagina.hero.botones[1].url} class="btn-ghost"
         data-cta data-cta-intent="navegacion" data-cta-location="hero" data-cta-label="Ver el demo">{pagina.hero.botones[1].texto}</a>
)}
    </div>
    <Ilustracion escena="competencias" />
  </section>

  <div class="divider"></div>

  <!-- CÓMO FUNCIONA — bloque dominante -->
  <section class="section">
    <div class="section-inner">
      <div class="fade-up">
        <div class="eyebrow">Cómo se ve en REELEVO</div>
        <h2 class="section-title">Personas por procesos, y el riesgo a la vista</h2>
        <p class="section-sub">La matriz cruza quién sabe hacer qué y en qué nivel. Se alimenta sola de la ejecución real: cuando un operario completa un proceso, su nivel se actualiza sin que nadie toque un Excel.</p>
      </div>

      <div class="matrix-example fade-up delay-1">
        <p class="matrix-title">Matriz de competencias — Línea de envasado alimentaria</p>
        <div class="matrix-scroll">
          <table class="matrix-table">
            <thead>
              <tr>
                <th>Operario</th>
                <th>Configuración línea</th>
                <th>Atasco material</th>
                <th>Parámetros velocidad</th>
                <th>Etiquetado</th>
                <th>Limpieza GMP</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>Antonio</td>
                <td class="level-3">Experto</td>
                <td class="level-3">Experto</td>
                <td class="level-3">Experto</td>
                <td class="level-2">Apto</td>
                <td class="level-1">Entrenando</td>
              </tr>
              <tr>
                <td>María</td>
                <td class="level-2">Apto</td>
                <td class="level-2">Apto</td>
                <td class="level-1">Entrenando</td>
                <td class="level-3">Experta</td>
                <td class="level-3">Experta</td>
              </tr>
              <tr>
                <td>Pedro</td>
                <td class="level-1">Entrenando</td>
                <td class="level-2">Apto</td>
                <td class="level-1">Entrenando</td>
                <td class="level-2">Apto</td>
                <td class="level-2">Apto</td>
              </tr>
              <tr>
                <td>Carmen</td>
                <td class="level-2">Apto</td>
                <td class="level-1">Entrenando</td>
                <td class="level-2">Apto</td>
                <td class="level-1">Entrenando</td>
                <td class="level-3">Experta</td>
              </tr>
            </tbody>
          </table>
        </div>
        <p class="matrix-analysis">
          <strong>Lo que se lee de un vistazo:</strong> «Configuración línea» depende solo de Antonio —ahí está el riesgo,
          y la prioridad es formar a María—. «Limpieza GMP» está bien cubierta. Eso es un plan de formación en treinta segundos,
          en vez de una intuición.
        </p>
      </div>

      <h3 class="sub-head fade-up delay-2">Lo que se saca de ella</h3>

      <div class="solution-grid fade-up delay-2">
        <div class="solution-cell">
          <h3>Mapeo y brechas</h3>
          <p>Quién opera cada máquina y en qué nivel, con las brechas señaladas: si solo una persona domina la CNC, se ve.</p>
        </div>

        <div class="solution-cell">
          <h3>Score de dependencia</h3>
          <p>Riesgo operativo por máquina, para priorizar dónde documentar y a quién formar primero.</p>
        </div>

        <div class="solution-cell">
          <h3>Vinculada al SOP</h3>
          <p>Cada procedimiento enseña una competencia concreta, y al completarlo el nivel del operario se actualiza solo, con su historial trazable.</p>
        </div>
      </div>

      <p class="roles-line fade-up delay-3">Lo que gana cada uno: <a href="/para-quien/responsable-rrhh/">RRHH</a> · <a href="/cobertura-turnos/">cobertura de turnos</a> · <a href="/casos-de-uso/onboarding-operarios/#faq">tiempo de aprendizaje</a>.</p>

      <div class="screenshot-pair fade-up delay-3">
        <figure class="screenshot-fig">
          <Screenshot name="equipo-operaciones" alt="Panel de equipo de operaciones en REELEVO: procesos completados, minutos acumulados y actividad por operario" class="screenshot-img" layout="pair" />
          <figcaption class="screenshot-caption">Panel de equipo — actividad y procesos completados por operario</figcaption>
        </figure>
        <figure class="screenshot-fig">
          <Screenshot name="competencias-operario" alt="Detalle de competencias de un operario en REELEVO: certificaciones activas, en curso y fecha de expiración" class="screenshot-img" layout="pair" />
          <figcaption class="screenshot-caption">Detalle de competencias — certificaciones activas con fecha de expiración</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <div class="divider"></div>

  <!-- LO QUE DETECTA SOLO -->
  <!-- Verificado en reelevo-app/app/api/cron/: skill-decay (hitos 60/90/180
       dias), cert-expiry (aviso a <=7 dias, diario 07:00 UTC),
       knowledge-signals, shift-coverage-risk. -->
  <section class="section">
    <div class="section-inner">
      <div class="fade-up">
        <div class="eyebrow">Sin que nadie lo mire</div>
        <h2 class="section-title">Una matriz que se degrada sola <br><em>no sirve de nada</em></h2>
        <p class="section-sub">
          El problema de las matrices en Excel no es construirlas: es que a los seis meses ya no reflejan
          la realidad. Estas cuatro revisiones se ejecutan a diario sin que nadie las lance.
        </p>
      </div>

      <div class="auto-grid fade-up delay-1">
        <article class="auto-card">
          <h3 class="auto-title">Competencias que se oxidan</h3>
          <p class="auto-desc">Quien lleva mucho sin ejecutar un proceso deja de estar realmente capacitado. Se detecta por hitos de <strong>60, 90 y 180 días</strong> sin práctica, configurables.</p>
        </article>

        <article class="auto-card">
          <h3 class="auto-title">Certificaciones por vencer</h3>
          <p class="auto-desc">Aviso de las que caducan en los <strong>próximos 7 días</strong>, para renovar con margen en vez de descubrirlo el día que hace falta la persona.</p>
        </article>

        <article class="auto-card">
          <h3 class="auto-title">Conocimiento en riesgo</h3>
          <p class="auto-desc">Procesos que <strong>dependen de una sola persona</strong>, que llevan demasiado sin revisarse o que muestran variación anómala entre quienes los ejecutan.</p>
        </article>

        <article class="auto-card">
          <h3 class="auto-title">Turnos sin quien cubra</h3>
          <p class="auto-desc">Cruza el turno planificado con las certificaciones activas y avisa de los procesos críticos que se quedan sin nadie, mientras aún se puede reorganizar.</p>
        </article>
      </div>
    </div>
  </section>

  <div class="divider"></div>

  <FaqSection items={faqs} />

  <div class="divider"></div>

  <!-- SIGUIENTE PASO -->
  <section class="cta-section">
    <div class="cta-eyebrow fade-up">{pagina.ctaFinal.antetitulo}</div>
    <h3 class="cta-title fade-up delay-1">{pagina.ctaFinal.titulo}{pagina.ctaFinal.tituloDestacado && <> <em>{pagina.ctaFinal.tituloDestacado}</em></>}</h3>
    <p class="cta-sub fade-up delay-2" set:html={conNegritas(pagina.ctaFinal.texto)} />
    <div class="cta-actions fade-up delay-3">
      {pagina.ctaFinal.botones[0] && (
<a href={pagina.ctaFinal.botones[0].url} class="btn-primary"
         data-cta data-cta-intent="registro" data-cta-location="footer" data-cta-trigger="05" data-cta-label="Registrarme en REELEVO">{pagina.ctaFinal.botones[0].texto}</a>
)}
      {pagina.ctaFinal.botones[1] && (
<a href={pagina.ctaFinal.botones[1].url} class="btn-ghost">{pagina.ctaFinal.botones[1].texto}</a>
)}
    </div>
  </section>

</BaseLayout>

<style>
  /* MATRIZ — bloque dominante */
  .matrix-example {
    margin-top: 44px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 26px;
  }

  .matrix-title {
    font-family: 'DM Mono', monospace;
    font-size: .7rem;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--orange-ink);
    margin: 0 0 20px;
  }

  .matrix-scroll { overflow-x: auto; }

  .matrix-table {
    width: 100%;
    min-width: 640px;
    border-collapse: collapse;
    font-size: .9rem;
  }

  .matrix-table th {
    font-family: 'Oswald', sans-serif;
    font-size: .85rem;
    font-weight: 600;
    text-align: left;
    padding: 10px 14px;
    color: var(--white);
    border-bottom: 1px solid var(--border-hover);
    white-space: nowrap;
  }

  .matrix-table td {
    padding: 11px 14px;
    border-bottom: 1px solid var(--border);
    color: var(--gray);
  }

  .matrix-table tbody tr:last-child td { border-bottom: none; }

  .matrix-table td:first-child {
    font-family: 'Oswald', sans-serif;
    font-weight: 600;
    color: var(--white);
  }

  .level-3 { color: var(--green) !important; font-weight: 500; }
  .level-2 { color: var(--gray) !important; }
  .level-1 { color: var(--orange-ink) !important; }

  .matrix-analysis {
    margin: 22px 0 0;
    padding-top: 18px;
    border-top: 1px solid var(--border);
    font-size: .95rem;
    line-height: 1.7;
    color: var(--gray);
  }

  .matrix-analysis strong { color: var(--white); font-weight: 500; }

  .sub-head {
    font-family: 'Oswald', sans-serif;
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--white);
    margin: 48px 0 0;
  }

  /* QUÉ INCLUYE */
  .solution-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    margin-top: 40px;
  }

  @media (max-width: 860px) {
    .solution-grid { grid-template-columns: 1fr; }
  }

  .solution-cell {
    background: var(--surface);
    border: 1px solid var(--border);
    border-top: 2px solid var(--orange);
    border-radius: 6px;
    padding: 24px;
  }

  .solution-cell h3 {
    font-family: 'Oswald', sans-serif;
    font-size: 1rem;
    margin-bottom: 10px;
    color: var(--white);
  }

  .solution-cell p {
    font-size: .95rem;
    color: var(--gray);
    line-height: 1.65;
    margin: 0;
  }

  /* REVISIONES AUTOMÁTICAS */
  .auto-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 20px;
    margin-top: 40px;
  }

  @media (max-width: 1000px) {
    .auto-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 620px) {
    .auto-grid { grid-template-columns: 1fr; }
  }

  .auto-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-top: 2px solid var(--orange);
    border-radius: 6px;
    padding: 22px 20px;
  }

  .auto-title {
    font-family: 'Oswald', sans-serif;
    font-size: .98rem;
    margin-bottom: 10px;
    color: var(--white);
  }

  .auto-desc {
    font-size: .95rem;
    line-height: 1.6;
    color: var(--gray);
    margin: 0;
  }

  .auto-desc strong { color: var(--white); font-weight: 500; }

  .roles-line {
    margin-top: 28px;
    font-size: .95rem;
    color: var(--gray);
  }

  .roles-line a {
    color: var(--orange-ink);
    text-decoration: none;
    border-bottom: 1px solid rgba(244, 82, 30, .35);
  }

  .roles-line a:hover {
    border-bottom-color: var(--orange);
  }
</style>
