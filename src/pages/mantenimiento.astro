---
import Ilustracion from '../components/Ilustracion.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import FaqSection from '../components/FaqSection.astro';
import { softwareApplicationSchema, faqPageSchema, type FaqItem } from '../lib/seo';

const title = "Software de mantenimiento preventivo y correctivo industrial | REELEVO";
const description = "Mantenimiento preventivo integrado en el trabajo diario: planes preventivos y correctivos, órdenes automáticas y registro de intervenciones.";
const canonical = "https://www.gmvsolutions.es/mantenimiento/";

// Una sola lista alimenta el bloque visible y el FAQPage del head (auditoria P6).
//
// La cuarta pregunta carga el argumento que antes ocupaba una tabla comparativa
// de 167 palabras a mitad de pagina ("Lo que nos diferencia"): el mantenimiento
// integrado frente al sistema aparte. El argumento sobrevive, la seccion no
// (tarea B2 de PLAN_SIMPLIFICACION_EDITORIAL_WEB_2026-08.md).
const faqs: FaqItem[] = [
  {
    q: '¿Es un GMAO o CMMS?',
    a: 'Cubre lo que una pyme industrial suele necesitar de un GMAO —planes preventivos, órdenes, registro de intervenciones e histórico por equipo— sin la complejidad de una herramienta dedicada. Si necesitas gestión de repuestos, almacén técnico o costes de mantenimiento detallados, ahí un GMAO específico va más lejos.',
  },
  {
    q: '¿Cubre mantenimiento preventivo y correctivo?',
    a: 'Los dos, en el mismo módulo. El preventivo se programa por tiempo o por horas de máquina y genera la orden sola; el correctivo entra cuando alguien reporta una avería desde el puesto. Tenerlos juntos evita el clásico de que el correctivo se gestione por WhatsApp.',
  },
  {
    q: '¿Cómo se generan las órdenes de trabajo?',
    a: 'Automáticamente a partir del plan, con su responsable o turno asignado. La tarea aparece en la agenda del operario junto a las de producción, no en un sistema aparte que hay que acordarse de abrir.',
  },
  {
    q: '¿Por qué integrar el mantenimiento con la operación y no llevarlo aparte?',
    a: 'Porque cuando el preventivo vive en un Excel que solo abre el responsable, basta con que esté de vacaciones para que nadie lo recuerde, y siempre pierde la competición por la atención frente a la producción. Integrado en la misma agenda, el operario ya sabe usarlo: es la misma pantalla que abre cada día, y el SOP de la intervención es un proceso más al que llega por QR.',
  },
];

const pageSchema = softwareApplicationSchema();

const schema = [pageSchema, faqPageSchema(faqs)];
---

<BaseLayout title={title} description={description} canonical={canonical} schema={schema} activeNav="" pageType="capacidad">

  <!-- HERO + PROBLEMA -->
  <section class="page-hero">
    <div class="eyebrow fade-up">Mantenimiento preventivo y correctivo</div>
    <h1 class="fade-up delay-1">El mantenimiento que no ves <br><em>es el que para la línea</em></h1>
    <p class="fade-up delay-2">Software de mantenimiento preventivo para pyme industrial. Hoy el plan vive en un Excel que solo abre una persona y el operario no sabe que le toca hasta que alguien se lo dice. Con REELEVO defines el plan de cada máquina una vez, las órdenes de trabajo se generan solas y aparecen en la agenda del operario junto a las de producción.</p>
    <div class="hero-cta fade-up delay-3" style="display:flex;gap:14px;justify-content:center;flex-wrap:wrap;">
      <a href="https://app.gmvsolutions.es/registro" class="btn-primary"
         data-cta data-cta-intent="registro" data-cta-location="hero" data-cta-label="Registrarme en REELEVO">Registrarme en REELEVO</a>
      <a href="/video-demo/" class="btn-ghost"
         data-cta data-cta-intent="navegacion" data-cta-location="hero" data-cta-label="Ver el demo">Ver el demo →</a>
    </div>
    <Ilustracion escena="mantenimiento" />
  </section>

  <div class="divider"></div>

  <!-- CÓMO FUNCIONA — bloque dominante -->
  <section class="section">
    <div class="section-inner">
      <div class="fade-up">
        <div class="eyebrow">Cómo funciona en REELEVO</div>
        <h2 class="section-title">Planificado, asignado y registrado — sin gestión manual</h2>
        <p class="section-sub">El mantenimiento no es un módulo aparte que alguien tiene que acordarse de abrir. Vive en la misma agenda que la producción, y por eso deja de competir con ella.</p>
      </div>

      <div class="kaizen-flow fade-up delay-1">
        <div class="flow-step">
          <div class="flow-num">1</div>
          <div class="flow-content">
            <h3>Configuras el plan una vez</h3>
            <p>Para cada máquina defines qué trabajos de mantenimiento preventivo hay que hacer, con qué frecuencia —diaria, semanal, mensual o por horas de uso—, quién es responsable y qué proceso SOP debe seguirse.</p>
          </div>
        </div>

        <div class="flow-arrow">↓</div>

        <div class="flow-step">
          <div class="flow-num">2</div>
          <div class="flow-content">
            <h3>Las órdenes se generan solas</h3>
            <p>REELEVO crea la orden de trabajo cuando toca, con su responsable ya asignado. Nadie tiene que recordarlo ni crearla a mano cada semana. El correctivo entra por el mismo sitio cuando alguien reporta una avería.</p>
          </div>
        </div>

        <div class="flow-arrow">↓</div>

        <div class="flow-step">
          <div class="flow-num">3</div>
          <div class="flow-content">
            <h3>El operario lo ve en su agenda</h3>
            <p>La tarea aparece junto a sus tareas de producción del día, con el SOP de la intervención accesible por QR desde la propia máquina. Sin llamadas, sin Post-its, sin abrir un segundo sistema.</p>
          </div>
        </div>

        <div class="flow-arrow">↓</div>

        <div class="flow-step">
          <div class="flow-num">4</div>
          <div class="flow-content">
            <h3>La intervención queda registrada</h3>
            <p>Al cerrar la tarea, el operario anota qué hizo, cuánto tardó y si hubo incidencias. Queda en el histórico de la máquina con fecha, operario y resultado: trazabilidad completa de cada intervención, evidencia para auditorías ISO 9001 y base para analizar fallos que se repiten.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <div class="divider"></div>

  <!-- QUÉ INCLUYE -->
  <section class="section">
    <div class="section-inner">
      <div class="fade-up">
        <div class="eyebrow">Qué incluye</div>
        <h2 class="section-title">Preventivo y correctivo en un solo módulo</h2>
      </div>

      <div class="solution-grid fade-up delay-1">
        <div class="solution-cell">
          <h3>Planes preventivos por máquina</h3>
          <p>Qué hay que hacer y cada cuánto, con el SOP asociado para que el operario sepa cómo. Con alertas por adelantado de los próximos mantenimientos programados.</p>
        </div>

        <div class="solution-cell">
          <h3>Correctivo en el mismo sitio</h3>
          <p>La avería se reporta desde el puesto, se asigna y queda en seguimiento hasta cerrarse. Sin que se gestione por WhatsApp.</p>
        </div>

        <div class="solution-cell">
          <h3>Histórico por máquina</h3>
          <p>Todas las intervenciones de cada equipo: quién, cuándo, cuánto duró y con qué resultado. Visible en segundos desde el panel.</p>
        </div>
      </div>

      <p class="roles-line fade-up delay-2">Lo que cambia según tu papel: <a href="/para-quien/jefe-de-produccion/">jefe de producción</a>, <a href="/para-quien/responsable-calidad/">responsable de calidad</a>, <a href="/para-quien/gerente-propietario/">gerente</a>.</p>
    </div>
  </section>

  <div class="divider"></div>

  <!-- LÍMITE -->
  <section class="section">
    <div class="section-inner">
      <div class="fade-up">
        <div class="eyebrow">Enfoque prudente</div>
        <h2 class="section-title">Hasta dónde llega — y cuándo necesitas un GMAO</h2>
      </div>

      <div class="honest-note fade-up delay-1">
        <p>Si hoy gestionas el mantenimiento en Excel o de memoria y tienes entre 5 y 200 operarios, esto es suficiente y se implanta en días. Si necesitas gestión de repuestos, almacén técnico, análisis de vibraciones o sensores IoT, necesitas un GMAO dedicado: REELEVO no lo sustituye.</p>
      </div>
    </div>
  </section>

  <div class="divider"></div>

  <FaqSection items={faqs} />

  <div class="divider"></div>

  <!-- SIGUIENTE PASO -->
  <section class="cta-section">
    <div class="cta-eyebrow fade-up">Mantenimiento en marcha</div>
    <h3 class="cta-title fade-up delay-1">
      El mantenimiento que no ves <br><em>deja de pillarte a contrapié</em>
    </h3>
    <p class="cta-sub fade-up delay-2">
      Arranca con el plan de una sola máquina y deja de depender de notas sueltas y de la memoria de una persona.
    </p>
    <div class="cta-actions fade-up delay-3">
      <a href="https://app.gmvsolutions.es/registro" class="btn-primary"
         data-cta data-cta-intent="registro" data-cta-location="footer" data-cta-label="Registrarme en REELEVO">
        Registrarme en REELEVO
      </a>
      <a href="/control-produccion/" class="btn-ghost">
        Ver control de producción →
      </a>
    </div>
    <div class="cta-trust fade-up delay-4">Te acompañamos en la puesta en marcha · Sin compromiso y con foco práctico</div>
  </section>

</BaseLayout>

<style>
  /* FLUJO — bloque dominante de la pagina */
  .kaizen-flow {
    display: flex;
    flex-direction: column;
    gap: 0;
    margin-top: 48px;
    max-width: 720px;
  }

  .flow-step {
    display: flex;
    gap: 24px;
    align-items: flex-start;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 28px;
  }

  .flow-num {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    min-width: 44px;
    background: var(--orange);
    color: var(--steel, #141618);
    border-radius: 50%;
    font-family: 'Oswald', sans-serif;
    font-size: 1.2rem;
    font-weight: 600;
  }

  .flow-content h3 {
    font-family: 'Oswald', sans-serif;
    font-size: 1.05rem;
    margin-bottom: 8px;
    color: var(--white);
  }

  .flow-content p {
    color: var(--gray);
    font-size: .95rem;
    line-height: 1.65;
    margin: 0;
  }

  .flow-arrow {
    text-align: center;
    font-size: 1.6rem;
    color: var(--orange-ink);
    padding: 6px 0;
    margin-left: 22px;
  }

  /* QUE INCLUYE — 3 tarjetas */
  .solution-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    margin-top: 40px;
  }

  @media (max-width: 860px) {
    .solution-grid { grid-template-columns: 1fr; }
  }

  .solution-cell {
    background: var(--surface);
    border: 1px solid var(--border);
    border-top: 2px solid var(--orange);
    border-radius: 6px;
    padding: 24px;
  }

  .solution-cell h3 {
    font-family: 'Oswald', sans-serif;
    font-size: 1rem;
    margin-bottom: 10px;
    color: var(--white);
  }

  .solution-cell p {
    font-size: .95rem;
    color: var(--gray);
    line-height: 1.65;
    margin: 0;
  }

  /* Sustituye a la seccion "Lo que cambia para cada perfil" (6 subtitulos,
     193 palabras). Conserva el enlazado interno a /para-quien/ en una linea. */
  .roles-line {
    margin-top: 28px;
    font-size: .95rem;
    color: var(--gray);
  }

  .roles-line a {
    color: var(--orange-ink);
    text-decoration: none;
    border-bottom: 1px solid rgba(244, 82, 30, .35);
  }

  .roles-line a:hover {
    border-bottom-color: var(--orange);
  }

  /* LIMITE */
  .honest-note {
    padding: 20px 24px;
    border-left: 3px solid var(--orange);
    background: var(--surface);
    border-radius: 0 6px 6px 0;
    max-width: 760px;
    margin-top: 32px;
  }

  .honest-note p {
    color: var(--gray);
    font-size: .95rem;
    line-height: 1.65;
    margin: 0;
  }

  .cta-trust {
    margin-top: 16px;
    font-size: 0.82rem;
    color: rgba(20,22,24, 0.45);
    letter-spacing: .04em;
  }
</style>
