---
import Icon from '../components/Icon.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import FaqSection from '../components/FaqSection.astro';
import { softwareApplicationSchema, faqPageSchema, type FaqItem } from '../lib/seo';

const title = "Cobertura de turnos en produccion industrial | REELEVO";
const description = "Detecta huecos de cobertura por turno en planta antes de que paren la línea y reorganiza asignaciones con la matriz de habilidades en tiempo real.";

// Una sola lista alimenta el bloque visible y el FAQPage del head (auditoria P6).
const faqs: FaqItem[] = [
  {
    q: '¿Qué es un hueco de cobertura?',
    a: 'Es un proceso o puesto que en un turno concreto no tiene a nadie capacitado para ejecutarlo. No es lo mismo que faltar personal: puedes tener el turno completo y aun así descubrir a media mañana que nadie de los presentes sabe arrancar una línea concreta.',
  },
  {
    q: '¿Cómo sabe REELEVO quién puede cubrir un puesto?',
    a: 'Cruza la asignación del turno con la matriz de competencias, que registra qué operario está capacitado para qué proceso y en qué nivel. Como esa matriz se alimenta de la ejecución real y no de una hoja que alguien actualiza a mano, refleja quién sabe hacer qué hoy, no hace seis meses.',
  },
  {
    q: '¿Sustituye a mi sistema de planificación de turnos?',
    a: 'No. REELEVO no decide horarios ni gestiona nóminas ni vacaciones. Lo que aporta es la capa de capacidad: dado el turno que ya has planificado, qué procesos quedan sin cubrir y quién podría cubrirlos. Conviven con el sistema que uses para planificar.',
  },
  {
    q: '¿Con cuánta antelación avisa de un hueco?',
    a: 'El análisis se hace antes del inicio de cada turno, que es cuando aún se puede reorganizar sin parar nada. El objetivo es justo ese: que el responsable vea el problema mientras todavía es una decisión de asignación, y no cuando la línea ya se ha detenido.',
  },
];

const pageSchema = softwareApplicationSchema();

const schema = [pageSchema, faqPageSchema(faqs)];

const mapa = [
  ['Config. inyectora CNC-3', ['ok', '3 ops'], ['warn', '1 op'], ['ok', '2 ops']],
  ['Línea envasado — arranque', ['ok', '4 ops'], ['ok', '3 ops'], ['danger', '0 ops']],
  ['Control calidad BRC paso 4', ['ok', '2 ops'], ['ok', '2 ops'], ['warn', '1 op']],
  ['Fresadora Hermle — setup', ['ok', '3 ops'], ['ok', '2 ops'], ['ok', '2 ops']],
];
---

<BaseLayout title={title} description={description} canonical="https://www.gmvsolutions.es/cobertura-turnos/" schema={schema} activeNav="" pageType="capacidad">

  <!-- HERO + PROBLEMA -->
  <section class="page-hero">
    <div class="eyebrow fade-up">Cobertura de turnos en producción</div>
    <h1 class="fade-up delay-1">¿Tiene tu turno de tarde <br><em>quien sepa arrancar la línea 2?</em></h1>
    <p class="fade-up delay-2">Puedes tener el turno completo y descubrir a las seis de la mañana que ninguno de los presentes está certificado en la inyectora. No es un problema de intención, es de datos: si las competencias viven en un Excel y las asignaciones en otro, el hueco se ve cuando la línea ya está parada. REELEVO cruza las dos cosas antes de que empiece el turno.</p>
    <div class="hero-cta fade-up delay-3" style="display:flex;gap:14px;justify-content:center;flex-wrap:wrap;">
      <a href="https://app.gmvsolutions.es/registro" class="btn-primary"
         data-cta data-cta-intent="registro" data-cta-location="hero" data-cta-trigger="03" data-cta-label="Registrarme en REELEVO">Registrarme en REELEVO</a>
      <a href="/video-demo/" class="btn-ghost"
         data-cta data-cta-intent="navegacion" data-cta-location="hero" data-cta-label="Ver el demo">Ver el demo →</a>
    </div>
  </section>

  <div class="divider"></div>

  <!-- CÓMO FUNCIONA — bloque dominante -->
  <section class="section">
    <div class="section-inner">
      <div class="fade-up">
        <div class="eyebrow">Cómo funciona</div>
        <h2 class="section-title">Análisis automático antes del inicio de cada turno</h2>
        <p class="section-sub">Antes de que arranque cada turno —mañana, tarde y noche— se cruzan los operarios asignados con sus certificaciones activas.</p>
      </div>

      <div class="coverage-flow fade-up delay-1">
        <div class="cf-step">
          <div class="cf-num">1</div>
          <h3>Asignación de turno</h3>
          <p>El responsable asigna operarios desde el panel de planificación, con las máquinas y procesos que cubre cada uno.</p>
        </div>

        <div class="cf-step">
          <div class="cf-num">2</div>
          <h3>Cruce con certificaciones</h3>
          <p>Se contrasta con la matriz de competencias y se marca qué procesos tienen cobertura suficiente —dos operarios o más— y cuáles no.</p>
        </div>

        <div class="cf-step">
          <div class="cf-num">3</div>
          <h3>Alerta automática</h3>
          <p>Si hay riesgo, el responsable recibe el aviso antes del inicio del turno, con tiempo para reorganizar.</p>
        </div>

        <div class="cf-step">
          <div class="cf-num">4</div>
          <h3>Acción correctora</h3>
          <p>Ajusta la asignación o prioriza formar a alguien en ese proceso. La decisión queda registrada.</p>
        </div>
      </div>

      <h3 class="sub-head fade-up delay-2">El mapa de cobertura, de un vistazo</h3>

      <div class="coverage-map fade-up delay-2">
        <div class="cm-row cm-header">
          <div class="cm-label">Proceso</div>
          <div class="cm-turn">Mañana</div>
          <div class="cm-turn">Tarde</div>
          <div class="cm-turn">Noche</div>
        </div>
        {mapa.map(([proceso, ...turnos]) => (
          <div class="cm-row">
            <div class="cm-label">{proceso}</div>
            {turnos.map(([estado, txt]) => (
              <div class={`cm-cell cm-${estado}`}>{txt}</div>
            ))}
          </div>
        ))}
      </div>

      <div class="coverage-legend fade-up delay-3">
        <div class="legend-item"><span class="leg-ok">●</span> Cobertura suficiente (2 o más certificados)</div>
        <div class="legend-item"><span class="leg-warn">●</span> Cobertura mínima (1 operario — riesgo si falta)</div>
        <div class="legend-item"><span class="leg-danger">●</span> Sin cobertura — alerta automática activa</div>
        <p class="cm-note">Ejemplo ilustrativo; la vista real usa los datos de tu empresa.</p>
      </div>
    </div>
  </section>

  <div class="divider"></div>

  <!-- QUÉ INCLUYE -->
  <section class="section">
    <div class="section-inner">
      <div class="fade-up">
        <div class="eyebrow">Tracking de horas</div>
        <h2 class="section-title">Cómo distribuye el equipo su tiempo — sin formularios</h2>
        <p class="section-sub">Cada sesión de trabajo se categoriza sola, sin que nadie rellene un parte.</p>
      </div>

      <div class="hours-grid fade-up delay-1">
        <div class="hours-cat">
          <Icon name="maquina" class="hc-icon" />
          <h3>Producción</h3>
          <p>Por operario, proceso y máquina, contra el objetivo semanal configurado.</p>
        </div>

        <div class="hours-cat">
          <Icon name="formacion" class="hc-icon" />
          <h3>Aprendizaje</h3>
          <p>El tiempo real que dedica el equipo a formarse en el puesto.</p>
        </div>

        <div class="hours-cat">
          <Icon name="herramienta" class="hc-icon" />
          <h3>Resolución de problemas</h3>
          <p>Qué procesos y máquinas se llevan el tiempo de incidencias.</p>
        </div>

        <div class="hours-cat">
          <Icon name="idea" class="hc-icon" />
          <h3>Contribuciones</h3>
          <p>Propuestas de mejora y documentación de soluciones.</p>
        </div>
      </div>

      <div class="hours-insight fade-up delay-2">
        <strong>Para qué sirve el dato:</strong> si el 30 % del tiempo de un turno se va en resolver problemas,
        hay un proceso mal documentado o un fallo recurrente que nadie ha atacado.
      </div>

      <p class="roles-line fade-up delay-3">Relacionado: <a href="/gestion-competencias/">gestión de competencias</a> · <a href="/casos-de-uso/cobertura-bajas/">cobertura de bajas</a> · <a href="/para-quien/jefe-de-produccion/">para jefe de producción</a>.</p>
    </div>
  </section>

  <div class="divider"></div>

  <FaqSection items={faqs} />

  <div class="divider"></div>

  <!-- SIGUIENTE PASO -->
  <section class="cta-section">
    <div class="cta-eyebrow fade-up">Siguiente paso</div>
    <h3 class="cta-title fade-up delay-1">
      Detecta el turno descubierto <br><em>antes de que pare la línea</em>
    </h3>
    <p class="cta-sub fade-up delay-2">
      La alerta de cobertura es de las primeras cosas que ven los jefes de producción cuando empiezan.
    </p>
    <div class="cta-actions fade-up delay-3">
      <a href="https://app.gmvsolutions.es/registro" class="btn-primary"
         data-cta data-cta-intent="registro" data-cta-location="footer" data-cta-trigger="03" data-cta-label="Registrarme en REELEVO">
        Registrarme en REELEVO
      </a>
      <a href="/gestion-competencias/" class="btn-ghost">
        Ver gestión de competencias →
      </a>
    </div>
  </section>

</BaseLayout>

<style>
  /* FLUJO — bloque dominante */
  .coverage-flow {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 20px;
    margin-top: 44px;
  }

  @media (max-width: 1000px) {
    .coverage-flow { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 600px) {
    .coverage-flow { grid-template-columns: 1fr; }
  }

  .cf-step {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 22px 20px;
  }

  .cf-num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    background: var(--orange);
    color: var(--steel, #141618);
    border-radius: 50%;
    font-family: 'Archivo Narrow', sans-serif;
    font-weight: 600;
    font-size: .95rem;
    margin-bottom: 14px;
  }

  .cf-step h3 {
    font-family: 'Archivo Narrow', sans-serif;
    font-size: .98rem;
    margin-bottom: 10px;
    color: var(--white);
  }

  .cf-step p {
    font-size: .95rem;
    line-height: 1.6;
    color: var(--gray);
    margin: 0;
  }

  .sub-head {
    font-family: 'Archivo Narrow', sans-serif;
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--white);
    margin: 48px 0 20px;
  }

  /* MAPA DE COBERTURA */
  .coverage-map {
    border: 1px solid var(--border);
    border-radius: 6px;
    overflow: hidden;
    max-width: 900px;
  }

  .cm-row {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: 1px;
    background: var(--border);
  }

  .cm-row + .cm-row { border-top: 1px solid var(--border); }

  .cm-label,
  .cm-turn,
  .cm-cell {
    background: var(--surface);
    padding: 13px 16px;
    font-size: .92rem;
  }

  .cm-label { color: var(--white); }

  .cm-header .cm-label,
  .cm-turn {
    font-family: 'IBM Plex Mono', monospace;
    font-size: .72rem;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: var(--gray2);
  }

  .cm-cell { font-family: 'IBM Plex Mono', monospace; font-size: .82rem; }

  .cm-ok { color: var(--green); }
  .cm-warn { color: var(--orange-ink); }
  .cm-danger { color: var(--red); }

  @media (max-width: 700px) {
    .cm-row { grid-template-columns: 1.6fr 1fr 1fr 1fr; }
    .cm-label, .cm-turn, .cm-cell { padding: 10px; font-size: .8rem; }
  }

  .coverage-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 28px;
    margin-top: 18px;
    font-size: .88rem;
    color: var(--gray);
    max-width: 900px;
  }

  .leg-ok { color: var(--green); }
  .leg-warn { color: var(--orange-ink); }
  .leg-danger { color: var(--red); }

  .cm-note {
    flex-basis: 100%;
    margin: 4px 0 0;
    font-size: .8rem;
    color: var(--gray2);
  }

  /* TRACKING DE HORAS */
  .hours-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 20px;
    margin-top: 40px;
  }

  @media (max-width: 1000px) {
    .hours-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 600px) {
    .hours-grid { grid-template-columns: 1fr; }
  }

  .hours-cat {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 22px 20px;
  }

  .hc-icon { margin-bottom: 12px; }

  .hours-cat h3 {
    font-family: 'Archivo Narrow', sans-serif;
    font-size: .98rem;
    margin-bottom: 8px;
    color: var(--white);
  }

  .hours-cat p {
    font-size: .95rem;
    color: var(--gray);
    line-height: 1.6;
    margin: 0;
  }

  .hours-insight {
    margin-top: 28px;
    padding: 20px 24px;
    background: var(--surface);
    border-left: 3px solid var(--orange);
    border-radius: 0 6px 6px 0;
    max-width: 900px;
    font-size: .95rem;
    line-height: 1.7;
    color: var(--gray);
  }

  .hours-insight strong { color: var(--white); font-weight: 500; }

  .roles-line {
    margin-top: 28px;
    font-size: .95rem;
    color: var(--gray);
  }

  .roles-line a {
    color: var(--orange-ink);
    text-decoration: none;
    border-bottom: 1px solid rgba(244, 82, 30, .35);
  }

  .roles-line a:hover {
    border-bottom-color: var(--orange);
  }
</style>
