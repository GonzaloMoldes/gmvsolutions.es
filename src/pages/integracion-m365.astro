---
import Icon from '../components/Icon.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import FaqSection from '../components/FaqSection.astro';
import { softwareApplicationSchema, faqPageSchema, type FaqItem } from '../lib/seo';
import Ilustracion from '../components/Ilustracion.astro';
import { getPagina, conNegritas, conSaltos, sinMarcas } from '../lib/contenido';

// Textos editables desde Sanity (Páginas de funcionalidad). Respaldo: src/data/paginas/integracion-m365.json.
const pagina = await getPagina('integracion-m365');

const title = pagina.seo.title;
const description = pagina.seo.description;
const canonical = "https://www.gmvsolutions.es/integracion-m365/";

// Una sola lista alimenta el bloque visible y el FAQPage del head (auditoria P6).
//
// La quinta pregunta recoge la tabla "Que esta incluido en cada plan", que era
// seccion propia; los limites concretos se conservan porque son el dato que
// se busca (tarea C3 de PLAN_SIMPLIFICACION_EDITORIAL_WEB_2026-08.md).
const faqs: FaqItem[] = pagina.faq.items.map(({ q, a }) => ({ q, a: sinMarcas(a) }));

const pageSchema = softwareApplicationSchema();

const schema = [pageSchema, faqPageSchema(faqs)];

const flujos = [
  ['Producción completada', 'resumen publicado en el canal de Teams de producción'],
  ['Alerta de cobertura de turno', 'aviso al responsable y actualización del planning en SharePoint'],
  ['Certificación emitida', 'registro de formación actualizado en SharePoint y aviso a RRHH'],
  ['Propuesta Kaizen creada', 'tarea en Planner y aviso al responsable de mejora continua'],
];
---

<BaseLayout title={title} description={description} canonical={canonical} schema={schema} activeNav="" pageType="capacidad">

  <!-- HERO + PROBLEMA -->
  <section class="page-hero">
    <div class="eyebrow fade-up">{pagina.hero.antetitulo}</div>
    <h1 class="fade-up delay-1"><Fragment set:html={conSaltos(pagina.hero.titulo)} />{pagina.hero.tituloDestacado && <> <br> <em>{pagina.hero.tituloDestacado}</em></>}</h1>
    <p class="fade-up delay-2" set:html={conNegritas(pagina.hero.texto)} />
    <div class="hero-cta fade-up delay-3">
      {pagina.hero.botones[0] && (
<a href={pagina.hero.botones[0].url} class="btn-primary"
         data-cta data-cta-intent="registro" data-cta-location="hero" data-cta-label="Registrarse gratis">{pagina.hero.botones[0].texto}</a>
)}
      {pagina.hero.botones[1] && (
<a href={pagina.hero.botones[1].url} class="btn-ghost">{pagina.hero.botones[1].texto}</a>
)}
    </div>
    <Ilustracion escena="integracion-m365" />
  </section>

  <div class="divider"></div>

  <!-- POWER BI — bloque dominante -->
  <section class="section">
    <div class="section-inner">
      <div class="fade-up">
        <div class="eyebrow">Power BI Integration Kit</div>
        <h2 class="section-title">Cuatro dashboards listos en un día — sin escribir una query desde cero</h2>
        <p class="section-sub">El kit trae las queries Power Query (M) y las medidas DAX base. Lo importas en Power BI Desktop, conectas tu cuenta y ya tienes datos reales de planta dentro.</p>
      </div>

      <div class="pbi-views fade-up delay-1">
        <div class="pbi-view">
          <Icon name="grafica" class="pbi-icon icon--draw" />
          <h3>Operaciones</h3>
          <p>Producción diaria y semanal por operario, proceso y máquina. Cumplimiento de objetivos, paradas con su causa y tendencia frente al periodo anterior.</p>
        </div>

        <div class="pbi-view">
          <Icon name="diana" class="pbi-icon icon--draw" />
          <h3>Calidad</h3>
          <p>Tasa de completado de SOPs por proceso, incidencias registradas, sesiones con variaciones y evolución del índice de conformidad.</p>
        </div>

        <div class="pbi-view">
          <Icon name="formacion" class="pbi-icon icon--draw" />
          <h3>Formación y compliance</h3>
          <p>Estado de certificaciones del equipo, las que están próximas a caducar y las rutas de aprendizaje activas con su progreso.</p>
        </div>

        <div class="pbi-view">
          <Icon name="documento" class="pbi-icon icon--draw" />
          <h3>Skill Matrix</h3>
          <p>Distribución de competencias por turno, procesos con riesgo de cobertura y evolución del índice de riesgo de conocimiento.</p>
        </div>
      </div>

      <div class="pbi-features fade-up delay-2">
        <h3>Cómo se actualiza</h3>
        <div class="refresh-options">
          <div class="refresh-opt">
            <span class="refresh-label">Manual</span>
            <span class="refresh-desc">cuando quieras, desde Power BI Desktop o Service</span>
          </div>
          <div class="refresh-opt">
            <span class="refresh-label">Programado</span>
            <span class="refresh-desc">cada hora, cada día o antes de cada turno</span>
          </div>
          <div class="refresh-opt">
            <span class="refresh-label">Por evento</span>
            <span class="refresh-desc">un webhook de REELEVO dispara el refresh cuando cambia un dato relevante</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <div class="divider"></div>

  <!-- QUÉ INCLUYE -->
  <section class="section">
    <div class="section-inner">
      <div class="fade-up">
        <div class="eyebrow">Power Automate y Teams</div>
        <h2 class="section-title">Que la planta avise sola, donde ya está el equipo</h2>
        <p class="section-sub">Importas el conector de REELEVO en Power Automate y montas flujos con cualquiera de los 21 eventos, sin escribir código. Vienen cuatro plantillas como punto de partida:</p>
      </div>

      <ul class="flujos-list fade-up delay-1">
        {flujos.map(([t, a]) => (
          <li><span class="flujo-t">{t}</span><span class="flujo-a">{a}</span></li>
        ))}
      </ul>

      <p class="teams-note fade-up delay-2">
        En <strong>Teams</strong> es donde más se nota: cobertura en riesgo, incidencias, resumen de turno y
        certificaciones, en el canal que el equipo ya tiene abierto.
      </p>

      <p class="roles-line fade-up delay-3">Relacionado: <a href="/api-integraciones/">API y webhooks</a> · <a href="/oee/">OEE y análisis Lean</a> · <a href="/precios/">planes y precios</a>.</p>
    </div>
  </section>

  <div class="divider"></div>

  <FaqSection items={faqs} />

  <div class="divider"></div>

  <!-- SIGUIENTE PASO -->
  <section class="cta-section">
    <div class="cta-eyebrow fade-up">{pagina.ctaFinal.antetitulo}</div>
    <h3 class="cta-title fade-up delay-1"><Fragment set:html={conSaltos(pagina.ctaFinal.titulo)} />{pagina.ctaFinal.tituloDestacado && <> <br> <em>{pagina.ctaFinal.tituloDestacado}</em></>}</h3>
    <p class="cta-sub fade-up delay-2" set:html={conNegritas(pagina.ctaFinal.texto)} />
    <div class="cta-actions fade-up delay-3">
      {pagina.ctaFinal.botones[0] && (
<a href={pagina.ctaFinal.botones[0].url} class="btn-primary"
         data-cta data-cta-intent="registro" data-cta-location="footer" data-cta-label="Registrarme en REELEVO">{pagina.ctaFinal.botones[0].texto}</a>
)}
      {pagina.ctaFinal.botones[1] && (
<a href={pagina.ctaFinal.botones[1].url} class="btn-ghost">{pagina.ctaFinal.botones[1].texto}</a>
)}
    </div>
  </section>

</BaseLayout>

<style>
  /* POWER BI — bloque dominante */
  .pbi-views {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
    margin-top: 44px;
  }

  @media (max-width: 860px) {
    .pbi-views { grid-template-columns: 1fr; }
  }

  .pbi-view {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 24px;
  }

  .pbi-icon { margin-bottom: 12px; }

  .pbi-view h3 {
    font-family: 'Oswald', sans-serif;
    font-size: 1rem;
    margin-bottom: 10px;
    color: var(--white);
  }

  .pbi-view p {
    font-size: .95rem;
    line-height: 1.65;
    color: var(--gray);
    margin: 0;
  }

  .pbi-features {
    margin-top: 32px;
    padding: 24px 26px;
    background: var(--surface2);
    border: 1px solid var(--border);
    border-radius: 8px;
    max-width: 900px;
  }

  .pbi-features h3 {
    font-family: 'Oswald', sans-serif;
    font-size: 1rem;
    margin: 0 0 16px;
    color: var(--white);
  }

  .refresh-options {
    display: grid;
    gap: 12px;
  }

  .refresh-opt {
    display: flex;
    gap: 14px;
    align-items: baseline;
    font-size: .95rem;
    line-height: 1.6;
  }

  .refresh-label {
    font-family: 'DM Mono', monospace;
    font-size: .78rem;
    letter-spacing: .06em;
    text-transform: uppercase;
    color: var(--orange-ink);
    min-width: 100px;
    flex: 0 0 auto;
  }

  .refresh-desc { color: var(--gray); }

  @media (max-width: 620px) {
    .refresh-opt { flex-direction: column; gap: 4px; }
  }

  /* FLUJOS */
  .flujos-list {
    list-style: none;
    margin: 40px 0 0;
    padding: 0;
    border: 1px solid var(--border);
    border-radius: 6px;
    overflow: hidden;
    max-width: 900px;
  }

  .flujos-list li {
    display: grid;
    grid-template-columns: 260px 1fr;
    gap: 20px;
    padding: 14px 20px;
    background: var(--surface);
    font-size: .95rem;
    line-height: 1.6;
  }

  .flujos-list li + li { border-top: 1px solid var(--border); }

  .flujo-t {
    font-family: 'Oswald', sans-serif;
    font-weight: 600;
    color: var(--white);
  }

  .flujo-a { color: var(--gray); }

  @media (max-width: 760px) {
    .flujos-list li { grid-template-columns: 1fr; gap: 4px; }
  }

  .teams-note {
    max-width: 900px;
    margin-top: 28px;
    padding: 20px 24px;
    background: rgba(20,22,24, .03);
    border-left: 2px solid var(--orange);
    border-radius: 0 4px 4px 0;
    font-size: .95rem;
    line-height: 1.75;
    color: var(--gray);
  }

  .teams-note strong { color: var(--white); font-weight: 500; }

  .roles-line {
    margin-top: 28px;
    font-size: .95rem;
    color: var(--gray);
  }

  .roles-line a {
    color: var(--orange-ink);
    text-decoration: none;
    border-bottom: 1px solid rgba(244, 82, 30, .35);
  }

  .roles-line a:hover {
    border-bottom-color: var(--orange);
  }
</style>
