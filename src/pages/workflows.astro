---
import BaseLayout from '../layouts/BaseLayout.astro';
import FaqSection from '../components/FaqSection.astro';
import { softwareApplicationSchema, faqPageSchema, type FaqItem } from '../lib/seo';
import Screenshot from '../components/Screenshot.astro';

const title = "Workflows operativos industriales | REELEVO";
const description = "Flujos de trabajo multi-paso y multi-operario con editor visual: aprobaciones, checkpoints y ramas paralelas para lo que supera un SOP simple.";
const canonical = "https://www.gmvsolutions.es/workflows/";

// Una sola lista alimenta el bloque visible y el FAQPage del head (auditoria P6).
//
// La quinta pregunta recoge el limite honesto sobre el editor, que antes era
// media seccion de "Enfoque prudente". La otra mitad (cuando basta un SOP) ya
// estaba en la primera pregunta, asi que la seccion se elimina en vez de
// repetirse (tarea C2 de PLAN_SIMPLIFICACION_EDITORIAL_WEB_2026-08.md).
const faqs: FaqItem[] = [
  {
    q: '¿Qué diferencia hay entre un workflow y un SOP?',
    a: 'Un SOP describe cómo ejecuta una persona una tarea. Un workflow encadena varios pasos con distintos responsables, condiciones y validaciones entre ellos. Si tu proceso lo hace una sola persona de principio a fin, un SOP basta y añadir un workflow solo mete complejidad.',
  },
  {
    q: '¿Qué procesos merecen un workflow?',
    a: 'Los que pasan por varias manos y se atascan en las transiciones. Un cambio de utillaje o de formato: parar, desmontar, ajustar, probar y validar, con un operario distinto en cada fase. Una puesta en marcha de línea donde dos equipos preparan en paralelo y el arranque espera a que ambos terminen. Una auditoría interna de ocho fases en tres días, cada una con su responsable y su checkpoint. También liberación de producto con validación de calidad, no conformidades y aprobaciones antes de expedir. Es decir, donde el problema no es ejecutar sino coordinar.',
  },
  {
    q: '¿Hace falta saber programar para diseñarlos?',
    a: 'No. Se montan en un editor visual encadenando pasos, responsables y condiciones. La parte difícil no suele ser la herramienta, sino ponerse de acuerdo en cómo debería funcionar realmente el proceso, que es una conversación que conviene tener igualmente.',
  },
  {
    q: '¿Se puede ver por dónde va cada proceso en curso?',
    a: 'Sí, con el estado de cada instancia y en qué paso está parada. Es lo que responde a la pregunta habitual de qué falta para poder expedir, sin ir preguntando de departamento en departamento.',
  },
  {
    q: '¿Cualquiera puede diseñar un workflow que funcione?',
    a: 'El editor es visual, pero no lo llamaríamos trivial: diseñar un flujo bien estructurado exige que quien lo monte conozca de verdad el proceso y sus excepciones. Nuestra recomendación es empezar por un proceso que ya se hace bien y estructurarlo, en vez de intentar arreglar con un workflow un proceso que todavía no está claro.',
  },
];

const pageSchema = softwareApplicationSchema();

const schema = [pageSchema, faqPageSchema(faqs)];

// Los 17 tipos verificados en reelevo-app: start, end, process, operation,
// machine, manual_task, measurement, supervisor_approval, decision, checkpoint,
// incident, rework, blocked_wait, delay, parallel_split, parallel_join, note.
// Si se toca esta lista hay que volver a contar: la cifra del titulo debe
// cuadrar con los elementos.
const nodos = [
  { i: '●', n: 'Inicio', d: 'por dónde arranca' },
  { i: '▶', n: 'Operación', d: 'tarea con SOP' },
  { i: '⚙', n: 'Proceso', d: 'proceso ya documentado, embebido' },
  { i: '🏭', n: 'Máquina', d: 'paso en una máquina concreta' },
  { i: '✓', n: 'Tarea manual', d: 'sin SOP, descripción libre' },
  { i: '📏', n: 'Medición', d: 'registra un valor' },
  { i: '◆', n: 'Decisión', d: 'bifurca según resultado' },
  { i: '👁', n: 'Aprobación', d: 'bloquea hasta visto bueno del supervisor' },
  { i: '🏁', n: 'Checkpoint', d: 'validación explícita' },
  { i: '⚠', n: 'Incidencia', d: 'rama para cuando algo falla' },
  { i: '↺', n: 'Retrabajo', d: 'devuelve a un paso anterior' },
  { i: '⏸', n: 'Espera bloqueada', d: 'no avanza hasta cumplirse una condición' },
  { i: '⏱', n: 'Retardo', d: 'curado, enfriado, secado' },
  { i: '⇥', n: 'Split paralelo', d: 'abre varias ramas a la vez' },
  { i: '⇤', n: 'Join paralelo', d: 'espera a que todas terminen' },
  { i: '📝', n: 'Nota', d: 'anotación sin efecto' },
  { i: '◉', n: 'Fin', d: 'dónde se cierra' },
];
---

<BaseLayout title={title} description={description} canonical={canonical} schema={schema} activeNav="" pageType="capacidad">

  <!-- HERO + PROBLEMA -->
  <section class="page-hero">
    <div class="eyebrow fade-up">Workflows operativos industriales</div>
    <h1 class="fade-up delay-1">Algunos procesos necesitan <br><em>más de un operario y más de un paso</em></h1>
    <p class="fade-up delay-2">Un cambio de utillaje pasa por cuatro manos en secuencia; una auditoría interna tiene seis fases con responsables distintos. Sin nada que los estructure, esos procesos se coordinan por WhatsApp y de viva voz: pasos saltados, aprobaciones que llegan tarde y nadie sabe quién bloquea qué.</p>
    <div class="hero-cta fade-up delay-3">
      <a href="https://app.gmvsolutions.es/registro" class="btn-primary"
         data-cta data-cta-intent="registro" data-cta-location="hero" data-cta-label="Registrarse gratis">Registrarse gratis</a>
    </div>
  </section>

  <div class="divider"></div>

  <!-- CÓMO FUNCIONA — bloque dominante -->
  <section class="section">
    <div class="section-inner">
      <div class="fade-up">
        <div class="eyebrow">Cómo funciona</div>
        <h2 class="section-title">Diseñas una vez — el workflow se ejecuta solo</h2>
        <p class="section-sub">Un workflow es una secuencia de pasos con responsables, condiciones y validaciones entre ellos. Lo que un SOP no cubre porque un SOP lo ejecuta una sola persona.</p>
      </div>

      <div class="kaizen-flow fade-up delay-1">
        <div class="flow-step">
          <div class="flow-num">1</div>
          <div class="flow-content">
            <h3>Diseñas el workflow en el editor visual</h3>
            <p>Arrastras y conectas los nodos que necesitas, y defines quién responde de cada paso y qué condiciones debe cumplir cada transición para poder avanzar.</p>
          </div>
        </div>

        <div class="flow-arrow">↓</div>

        <div class="flow-step">
          <div class="flow-num">2</div>
          <div class="flow-content">
            <h3>Lo lanzas cuando lo necesitas — o se lanza solo</h3>
            <p>Manualmente, asociado a una obra o de forma independiente. O programado para que arranque solo cada día, cada semana o cada mes: el control de calidad periódico deja de depender de que alguien se acuerde.</p>
          </div>
        </div>

        <div class="flow-arrow">↓</div>

        <div class="flow-step">
          <div class="flow-num">3</div>
          <div class="flow-content">
            <h3>Cada operario ve sus pasos en su agenda</h3>
            <p>El workflow materializa los pasos en la agenda de cada responsable. Cuando le toca su turno, el paso le aparece: nadie tiene que avisarle de que ya puede empezar.</p>
          </div>
        </div>

        <div class="flow-arrow">↓</div>

        <div class="flow-step">
          <div class="flow-num">4</div>
          <div class="flow-content">
            <h3>El supervisor ve el avance y desbloquea</h3>
            <p>El panel de flujos activos muestra cuáles están en curso, en qué paso y si hay bloqueo. Cuando un paso exige aprobación, le llega y el proceso no sigue hasta que responde — que es justo el control que se busca.</p>
          </div>
        </div>
      </div>

      <div class="screenshot-single fade-up delay-2">
        <figure class="screenshot-fig">
          <Screenshot name="kaizen-panel" alt="Editor visual de workflows en REELEVO con paleta de nodos" class="screenshot-img" layout="single" />
          <figcaption class="screenshot-caption">Editor visual de workflows — paleta de nodos: operación, decisión, aprobación, bifurcación paralela</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <div class="divider"></div>

  <!-- QUÉ INCLUYE -->
  <section class="section">
    <div class="section-inner">
      <div class="fade-up">
        <div class="eyebrow">Qué incluye</div>
        <h2 class="section-title">Los 17 tipos de nodo del editor</h2>
        <p class="section-sub">Con estas piezas se monta desde una liberación de producto con validación de calidad hasta una puesta en marcha en paralelo.</p>
      </div>

      <ul class="nodes-list fade-up delay-1">
        {nodos.map((x) => (
          <li>
            <span class="node-i" aria-hidden="true">{x.i}</span>
            <span class="node-n">{x.n}</span>
            <span class="node-d">{x.d}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <div class="divider"></div>

  <p class="roles-line roles-line--solo fade-up">Relacionado: <a href="/documentacion-procesos/">documentación de procesos</a> · <a href="/calidad-y-conformidad/">calidad y conformidad</a> · <a href="/obras-trazabilidad/">obras y trazabilidad</a>.</p>

  <div class="divider"></div>

  <!-- SIGUIENTE PASO -->
  <section class="cta-section">
    <div class="cta-eyebrow fade-up">Siguiente paso</div>
    <h3 class="cta-title fade-up delay-1">
      Empieza por el proceso <br><em>que siempre se atasca en la misma transición</em>
    </h3>
    <p class="cta-sub fade-up delay-2">
      Coge uno que ya se hace bien y estructúralo.
    </p>
    <div class="cta-actions fade-up delay-3">
      <a href="https://app.gmvsolutions.es/registro" class="btn-primary"
         data-cta data-cta-intent="registro" data-cta-location="footer" data-cta-label="Registrarme en REELEVO">
        Registrarse gratis
      </a>
      <a href="/portal-operario/" class="btn-ghost">
        Ver el portal del operario →
      </a>
    </div>
    <div class="cta-trust fade-up delay-4">Te acompañamos en la puesta en marcha · Sin compromiso y con foco práctico</div>
  </section>

</BaseLayout>

<style>
  /* FLUJO — bloque dominante */
  .kaizen-flow {
    display: flex;
    flex-direction: column;
    gap: 0;
    margin-top: 48px;
    max-width: 720px;
  }

  .flow-step {
    display: flex;
    gap: 24px;
    align-items: flex-start;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 28px;
  }

  .flow-num {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    min-width: 44px;
    background: var(--orange);
    color: var(--steel, #141618);
    border-radius: 50%;
    font-family: 'Archivo Narrow', sans-serif;
    font-size: 1.2rem;
    font-weight: 600;
  }

  .flow-content h3 {
    font-family: 'Archivo Narrow', sans-serif;
    font-size: 1.05rem;
    margin-bottom: 8px;
    color: var(--white);
  }

  .flow-content p {
    color: var(--gray);
    font-size: .95rem;
    line-height: 1.65;
    margin: 0;
  }

  .flow-arrow {
    text-align: center;
    font-size: 1.6rem;
    color: var(--orange-ink);
    padding: 6px 0;
    margin-left: 22px;
  }

  /* NODOS — sustituye a la rejilla de 17 tarjetas por una lista compacta.
     Los 17 nombres se conservan enteros; lo que se recorta es la descripcion. */
  .nodes-list {
    list-style: none;
    margin: 40px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    background: var(--border);
    border: 1px solid var(--border);
    border-radius: 6px;
    overflow: hidden;
  }

  .nodes-list li {
    display: flex;
    align-items: baseline;
    gap: 12px;
    background: var(--surface);
    padding: 14px 18px;
    font-size: .95rem;
    line-height: 1.5;
  }

  .node-i {
    color: var(--orange-ink);
    min-width: 20px;
    font-size: .95rem;
  }

  .node-n {
    font-family: 'Archivo Narrow', sans-serif;
    font-weight: 600;
    color: var(--white);
    white-space: nowrap;
  }

  .node-d {
    color: var(--gray);
    font-size: .88rem;
  }

  @media (max-width: 760px) {
    .nodes-list { grid-template-columns: 1fr; }
    .nodes-list li { flex-wrap: wrap; gap: 8px; }
  }

  .roles-line--solo {
    max-width: 1100px;
    margin-left: auto;
    margin-right: auto;
    padding: 0 32px 96px;
  }

  .roles-line {
    margin-top: 28px;
    font-size: .95rem;
    color: var(--gray);
  }

  .roles-line a {
    color: var(--orange-ink);
    text-decoration: none;
    border-bottom: 1px solid rgba(244, 82, 30, .35);
  }

  .roles-line a:hover {
    border-bottom-color: var(--orange);
  }

  .cta-trust {
    margin-top: 16px;
    font-size: 0.82rem;
    color: rgba(20,22,24, 0.45);
    letter-spacing: .04em;
  }
</style>
