---
import BaseLayout from '../layouts/BaseLayout.astro';
import { faqPageSchema } from '../lib/seo';
import { getPaginaFaqs, parrafos, sinMarcas, etiquetaCta } from '../lib/contenido';

// Textos editables desde Sanity (Página de preguntas frecuentes); cada pregunta
// es un documento «Pregunta frecuente» reutilizable. Respaldo: src/data/faqs.default.json.
const pagina = await getPaginaFaqs();

const title = pagina.seo.title;
const description = pagina.seo.description;
const canonical = "https://www.gmvsolutions.es/faqs/";

// El FAQPage sale del mismo texto que se ve (antes eran dos versiones distintas).
const faqSchema = faqPageSchema(
  pagina.categorias.flatMap((c) => c.preguntas.map(({ q, a }) => ({ q, a: sinMarcas(a) }))),
);
---

<BaseLayout
  title={title}
  description={description}
  schema={faqSchema}
  canonical={canonical}
  activeNav="recursos" pageType="core">
  <!-- PAGE HERO -->
  <section class="page-hero">
    <div class="eyebrow fade-up">{pagina.hero.antetitulo}</div>
    <h1 class="fade-up delay-1">{pagina.hero.titulo}</h1>
    <p class="fade-up delay-2">{pagina.hero.texto}</p>
  </section>

  <div class="divider"></div>

  <section class="section">
    <div class="section-inner">
      {pagina.categorias.map((cat, i) => (
        <>
          {i > 0 && <div class="divider-light"></div>}
          <div class="faq-category fade-up">
            <div class="faq-category-label">{cat.nombre}</div>
            <div class="faq-grid">
              {cat.preguntas.map((p) => (
                <div class="faq-item">
                  <button class="faq-question">
                    <span>{p.q}</span>
                    <svg viewBox="0 0 24 24" stroke="currentColor"><polyline points="6,9 12,15 18,9"></polyline></svg>
                  </button>
                  <div class="faq-answer">
                    <div class="faq-answer-inner" set:html={parrafos(p.a)} />
                  </div>
                </div>
              ))}
            </div>
          </div>
        </>
      ))}
    </div>
  </section>

  
  <!-- CTA intermedio (M6b/M6d): la pagina solo ofrecia crear cuenta al final. -->
  <div class="divider"></div>

  <section class="section section-center">
    <div class="section-inner" style="max-width:680px;">
      <p class="section-sub fade-up" style="margin-bottom:24px;">{pagina.ctaIntermedio.texto}</p>
      <div class="fade-up delay-1">
        <a href={pagina.ctaIntermedio.cta.url} class="btn-primary"
           data-cta data-cta-intent="registro" data-cta-location="mitad" data-cta-label={etiquetaCta(pagina.ctaIntermedio.cta.texto)}>{pagina.ctaIntermedio.cta.texto}</a>
      </div>
      <p class="cta-note fade-up delay-2" style="margin-top:16px;">{pagina.ctaIntermedio.nota}</p>
    </div>
  </section>
<div class="divider"></div>

  <!-- CTA -->
  <section class="cta-section">
    <div class="cta-eyebrow fade-up">{pagina.ctaFinal.antetitulo}</div>
    <h3 class="cta-title fade-up delay-1">
      {pagina.ctaFinal.titulo}
    </h3>
    <p class="cta-sub fade-up delay-2">
      {pagina.ctaFinal.texto}
    </p>
    <div class="cta-actions fade-up delay-3">
      <a href={pagina.ctaFinal.ctaPrincipal.url} class="btn-primary"
         data-cta data-cta-intent="registro" data-cta-location="footer" data-cta-label={etiquetaCta(pagina.ctaFinal.ctaPrincipal.texto)}>{pagina.ctaFinal.ctaPrincipal.texto}</a>
      <a href={pagina.ctaFinal.ctaSecundario.url} class="btn-ghost">{pagina.ctaFinal.ctaSecundario.texto}</a>
    </div>
    <div class="cta-note fade-up delay-4">
      {pagina.ctaFinal.nota}
    </div>
  </section>
</BaseLayout>

<style>
  .faq-category {
    margin-bottom: 48px;
  }

  .faq-category-label {
    font-family: 'DM Mono', monospace;
    font-size: .7rem;
    letter-spacing: .15em;
    text-transform: uppercase;
    color: var(--orange-ink);
    margin-bottom: 20px;
  }

  .divider-light {
    height: 1px;
    background: var(--border);
    margin: 48px 0;
    opacity: 0.5;
  }
</style>

<script>
  // Las relaciones ARIA se cablean aqui y no en el marcado para no repetir
  // ids a mano en 20 bloques. Sin aria-expanded, un lector de pantalla anuncia
  // los 20 botones igual esten abiertos o cerrados (fallo WCAG 4.1.2).
  const questions = document.querySelectorAll<HTMLButtonElement>('.faq-question');

  questions.forEach((button, index) => {
    const item = button.closest('.faq-item');
    const answer = item?.querySelector('.faq-answer');
    if (answer) {
      answer.id = answer.id || `faq-answer-${index + 1}`;
      button.setAttribute('aria-controls', answer.id);
    }
    button.setAttribute('aria-expanded', 'false');

    button.addEventListener('click', () => {
      const wasOpen = item?.classList.contains('open');
      // Es un acordeon de uno en uno: al abrir cualquiera se cierran los demas,
      // asi que hay que devolver TODOS los aria-expanded a false, no solo el
      // del que se pulsa.
      document.querySelectorAll('.faq-item').forEach(i => i.classList.remove('open'));
      questions.forEach(b => b.setAttribute('aria-expanded', 'false'));

      if (!wasOpen) {
        item?.classList.add('open');
        button.setAttribute('aria-expanded', 'true');
      }
    });
  });
</script>
