---
import BaseLayout from '../layouts/BaseLayout.astro';
import FaqSection from '../components/FaqSection.astro';
import { faqPageSchema, type FaqItem } from '../lib/seo';

const title = "Por qué usar REELEVO en tu pyme industrial | REELEVO";
const description = "Los nueve problemas por los que una pyme industrial acaba comprando REELEVO: errores que se repiten, incorporaciones lentas, dependencia de una persona y procesos que cada turno hace distinto.";
const canonical = "https://www.gmvsolutions.es/por-que-usar-reelevo/";

// Hub de autodiagnostico (PROPUESTA_9_DISPARADORES_COMERCIAL_2026-08, M2).
// Cada tarjeta es un disparador de compra escrito con las palabras del cliente,
// no con las nuestras. El titulo es lo que el visitante diria en voz alta; la
// linea de abajo es lo unico que cambia si lo resuelve.
//
// Las nueve tarjetas apuntan ya a su pagina definitiva. Si se anade un
// disparador nuevo, la regla es que tenga pagina propia antes de entrar aqui:
// una tarjeta que promete algo y aterriza en una pagina prestada convierte peor
// que no tener la tarjeta.
const problemas = [
  {
    n: '01',
    dolor: '«Cometemos errores que se podrían evitar»',
    cambio: 'El criterio correcto está delante en el momento de decidir, no en un plastificado de hace tres años.',
    href: '/errores-en-planta/',
    ancla: 'Ver por qué se repite',
  },
  {
    n: '02',
    dolor: '«Cada vez que entra alguien hay que enseñárselo todo»',
    cambio: 'El proceso está en la máquina desde el primer día. El tutor deja de repetir lo mismo cada vez.',
    href: '/casos-de-uso/onboarding-operarios/',
    ancla: 'Ver el onboarding en planta',
  },
  {
    n: '03',
    dolor: '«Si falta Martínez, ese puesto no arranca»',
    cambio: 'Lo que sabe Martínez está en el puesto, no solo en su cabeza. El sustituto abre y trabaja.',
    href: '/casos-de-uso/cobertura-bajas/',
    ancla: 'Ver la cobertura de bajas',
  },
  {
    n: '04',
    dolor: '«Cuando alguien se va, se lleva su forma de trabajar»',
    cambio: 'El proceso queda escrito, versionado y accesible antes de que se marche.',
    href: '/casos-de-uso/transferencia-conocimiento/',
    ancla: 'Ver la transferencia de conocimiento',
  },
  {
    n: '05',
    dolor: '«Tarda semanas en ir solo»',
    cambio: 'Ves en qué paso se atasca y cuánto tarda frente al titular, en vez de estimarlo a ojo.',
    href: '/gestion-competencias/',
    ancla: 'Ver quién sabe hacer qué',
  },
  {
    n: '06',
    dolor: '«Cada uno tiene su método»',
    cambio: 'Una sola versión vigente, y quien está certificado en ese proceso recibe el aviso cuando cambia.',
    href: '/consistencia-entre-turnos/',
    ancla: 'Ver cómo se unifica',
  },
  {
    n: '07',
    dolor: '«No hay dos turnos que lo hagan igual»',
    cambio: 'REELEVO señala qué procesos tienen más variación entre personas, para arreglar esos primero.',
    href: '/consistencia-entre-turnos/',
    ancla: 'Ver la consistencia entre turnos',
  },
  {
    n: '08',
    dolor: '«El que sabía esto ya no está»',
    cambio: 'Grabas al que se quedó haciéndolo y sale un proceso editable. También desde tus Word y PDF sueltos.',
    href: '/casos-de-uso/transferencia-conocimiento/',
    ancla: 'Ver cómo se recupera',
  },
  {
    n: '09',
    dolor: '«Me llaman para todo»',
    cambio: 'El operario resuelve en el puesto lo que hoy resuelve una llamada al encargado.',
    href: '/portal-operario/',
    ancla: 'Ver el portal del operario',
  },
];

// Una sola lista alimenta el bloque visible y el FAQPage del head (auditoria P6).
const faqs: FaqItem[] = [
  {
    q: '¿Tengo que resolver los nueve a la vez?',
    a: 'No, y no conviene. Casi ninguna planta los tiene los nueve, y las que arrancan bien lo hacen por dos o tres procesos concretos: el que más se para, el que más errores repite o el que solo sabe hacer una persona. El resto se añade cuando el primero ya está funcionando.',
  },
  {
    q: '¿Qué problema resuelve REELEVO exactamente?',
    a: 'La dependencia de personas concretas. Cuando el conocimiento de cómo se hace cada trabajo vive solo en la cabeza de unos pocos, cada baja, jubilación o incorporación desordena el turno. REELEVO lleva ese conocimiento al puesto y registra la ejecución para que deje de depender de quién esté.',
  },
  {
    q: '¿En qué se diferencia de un MES?',
    a: 'Un MES cubre planificación de capacidad, integración con el ERP y a menudo captura de datos de máquina, con la inversión que eso implica. REELEVO se queda en la capa operativa: el proceso en el puesto y la ejecución registrada. Para una pyme suele ser el primer paso y el que más retorno da.',
  },
  {
    q: '¿Por qué no basta con Excel y carpetas compartidas?',
    a: 'Porque no tienen coste de licencia pero sí coste oculto: el operario no abre un PDF del servidor, llama al veterano; circulan varias versiones del mismo documento y nadie sabe cuál vale; y no queda rastro de qué se hizo. El problema no es el formato, es dónde vive la información.',
  },
  {
    q: '¿Qué hace falta por nuestra parte para empezar?',
    a: 'Elegir dos o tres procesos críticos y documentarlos con quien los domina, idealmente grabando mientras se ejecutan. La configuración técnica es de un día; el trabajo real es ese, y es el que no puede hacer el proveedor por ti.',
  },
];

const pageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "headline": "Por qué usar REELEVO",
  "description": description,
  "author": {
    "@type": "Organization",
    "name": "GMV Solutions"
  }
};

const schema = [pageSchema, faqPageSchema(faqs)];
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  schema={schema}
  activeNav="por-que-usar-reelevo" pageType="core">
  <!-- PAGE HERO -->
  <section class="page-hero">
    <div class="eyebrow fade-up">Autodiagnóstico · Nueve problemas de planta</div>
    <h1 class="fade-up delay-1">¿Cuál de estos<br><em>nueve problemas tienes hoy?</em></h1>
    <p class="fade-up delay-2">Casi ninguna pyme industrial los tiene los nueve. Con dos basta para que la planta vaya a trompicones. Elige el tuyo y verás qué cambia exactamente.</p>
  </section>

  <div class="divider"></div>

  <!-- LOS NUEVE PROBLEMAS -->
  <section class="section" id="problemas">
    <div class="section-inner">
      <div class="fade-up">
        <div class="eyebrow">El día a día</div>
        <h2 class="section-title">Frases que se oyen<br><em>en una planta cualquiera</em></h2>
        <p class="section-sub">Ninguna de las nueve es un fallo de las personas. Todas son el mismo problema visto desde un sitio distinto: el proceso no está donde se trabaja.</p>
      </div>

      <div class="problema-grid fade-up delay-1">
        {problemas.map((p) => (
          <a
            href={p.href}
            class="problema-card"
            data-cta
            data-cta-intent="navegacion"
            data-cta-location="hub-problemas"
            data-cta-trigger={p.n}
            data-cta-label={`problema-${p.n}`}
          >
            <div class="problema-num">{p.n}</div>
            <h3 class="problema-dolor">{p.dolor}</h3>
            <p class="problema-cambio">{p.cambio}</p>
            <span class="problema-ancla">{p.ancla} →</span>
          </a>
        ))}
      </div>

      <div class="problema-cta fade-up delay-2">
        <p class="problema-cta-text">
          Si has reconocido dos o más, el orden importa menos de lo que parece: todos se atacan con el mismo primer paso.
        </p>
        <a href="https://app.gmvsolutions.es/registro" class="btn-primary"
           data-cta data-cta-intent="registro" data-cta-location="hub-problemas" data-cta-label="Empezar por un proceso">Empezar por un proceso</a>
        <span class="problema-cta-note">60 días del plan Pro, sin tarjeta</span>
      </div>
    </div>
  </section>

  <div class="divider"></div>

  <!-- LA SOLUCIÓN -->
  <section class="section" id="solucion">
    <div class="section-inner">
      <div class="fade-up">
        <div class="eyebrow">La raíz común</div>
        <h2 class="section-title">Los nueve salen<br><em>del mismo sitio</em></h2>
        <p class="section-sub">El procedimiento vive en la cabeza de alguien, o en un papel que nadie consulta. Todo lo demás —los errores, las tutorías eternas, la dependencia del titular— viene de ahí. REELEVO mueve el proceso al puesto y registra lo que se ejecuta.</p>
      </div>

      <div class="feature-grid fade-up delay-1">
        <div class="feature-card">
          <div class="feature-icon">🧱</div>
          <h3 class="feature-title">El experto lo cuenta una vez</h3>
          <p class="feature-desc">No hace falta sacarlo de planta durante días para redactar manuales. Se graba mientras ejecuta, o se suben los documentos que ya tenéis, y de ahí sale un proceso paso a paso que él revisa.</p>
        </div>

        <div class="feature-card">
          <div class="feature-icon">⚡</div>
          <h3 class="feature-title">El proceso aparece en la máquina</h3>
          <p class="feature-desc">El operario escanea el QR del puesto y tiene delante la versión vigente, con fotos y vídeo. Sin cuenta, sin contraseña y sin instalar nada. Es el mismo gesto para el titular, para el sustituto y para el que entró ayer.</p>
        </div>

        <div class="feature-card">
          <div class="feature-icon">📈</div>
          <h3 class="feature-title">Queda el rastro de lo que pasó</h3>
          <p class="feature-desc">Quién ejecutó qué, cuándo, cuánto tardó y con qué resultado. De ahí salen la gestión de competencias, la revisión de calidad y la respuesta a «¿por qué se repite este fallo?» sin reconstruirla a llamadas.</p>
        </div>
      </div>
    </div>
  </section>

  <div class="divider"></div>

  <!-- CÓMO EMPIEZA -->
  <section class="section section-center" id="numeros">
    <div class="section-inner">
      <div class="fade-up">
        <div class="eyebrow">Lo que hace fácil empezar</div>
        <h2 class="section-title">Un proyecto asumible para<br><em>una pyme industrial</em></h2>
      </div>

      <div class="stats-grid fade-up delay-1">
        <div class="stat-block">
          <div class="stat-number">1</div>
          <p class="stat-desc">Un proceso basta para empezar. El que más te tensiona hoy: el que se para, el que repite errores o el que solo sabe hacer una persona.</p>
        </div>

        <div class="stat-block stat-block-featured">
          <div class="stat-label-top">Prueba</div>
          <div class="stat-number">60<span class="stat-unit"> días</span></div>
          <p class="stat-desc">Del plan Pro completo, sin tarjeta. Al terminar, la cuenta pasa al plan gratuito y no pierdes lo que hayas montado.</p>
        </div>

        <div class="stat-block">
          <div class="stat-number">Fijo</div>
          <p class="stat-desc">Precio por empresa, no por operario. Los planes de pago empiezan en 49 €/mes, con precio publicado.</p>
        </div>
      </div>
    </div>
  </section>

  <div class="divider"></div>

  <!-- TRIAL BAND -->
  <div class="trial-band">
    <div class="trial-title fade-up">¿Cuánto te costaría mañana que<br><em>tu operario clave no viniera?</em></div>
    <div class="trial-bullets fade-up delay-1">
      <div class="trial-bullet"><span>✓</span>Lo pruebas con tu operativa real</div>
      <div class="trial-bullet"><span>✓</span>Precio fijo por empresa</div>
      <div class="trial-bullet"><span>✓</span>Sin tarjeta y sin llamada comercial</div>
    </div>
    <div class="cta-actions fade-up delay-2">
      <a href="https://app.gmvsolutions.es/registro" class="btn-primary"
         data-cta data-cta-intent="registro" data-cta-location="body" data-cta-label="Registrarme en REELEVO">Registrarme en REELEVO</a>
      <a href="/precios/" class="btn-ghost">Ver planes →</a>
    </div>
  </div>

  <div class="divider"></div>

  <!-- FINAL CTA -->
  <FaqSection items={faqs} />

  <div class="divider"></div>

  <section class="cta-section">
    <div class="cta-eyebrow fade-up">Empieza por lo crítico</div>
    <h3 class="cta-title fade-up delay-1">
      Empieza por el problema<br><em>que has reconocido primero</em>
    </h3>
    <p class="cta-sub fade-up delay-2">
      No hace falta ordenar la planta entera para notar la diferencia. Coge el proceso que hoy depende de una sola persona
      y móntalo. Si eso funciona, el resto es repetir.
    </p>
    <div class="cta-actions fade-up delay-3">
      <a href="https://app.gmvsolutions.es/registro" class="btn-primary"
         data-cta data-cta-intent="registro" data-cta-location="footer" data-cta-label="Registrarme en REELEVO">Registrarme en REELEVO</a>
      <a href="/precios/" class="btn-ghost">Ver planes →</a>
    </div>
    <div class="cta-note fade-up delay-4">
      Precio publicado · Implantación ligera · Soporte en español
    </div>
  </section>

</BaseLayout>

<style>
  /* Rejilla de los nueve problemas (hub de autodiagnostico) */
  .problema-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
    margin-top: 48px;
  }

  .problema-card {
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 28px 26px;
    text-decoration: none;
    color: inherit;
    transition: border-color .25s, transform .25s;
  }

  .problema-card:hover {
    border-color: var(--orange);
    transform: translateY(-2px);
  }

  .problema-num {
    font-family: 'DM Mono', monospace;
    font-size: .65rem;
    letter-spacing: .14em;
    color: var(--orange);
    margin-bottom: 16px;
  }

  .problema-dolor {
    font-family: 'Oswald', sans-serif;
    font-size: 1.02rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: .02em;
    line-height: 1.3;
    margin-bottom: 12px;
  }

  .problema-cambio {
    font-size: .88rem;
    color: var(--gray);
    line-height: 1.65;
    margin-bottom: 20px;
    flex: 1;
  }

  .problema-ancla {
    font-family: 'DM Mono', monospace;
    font-size: .68rem;
    letter-spacing: .06em;
    text-transform: uppercase;
    color: var(--orange);
  }

  .problema-cta {
    margin-top: 48px;
    text-align: center;
  }

  .problema-cta-text {
    font-size: .95rem;
    color: var(--gray);
    line-height: 1.7;
    max-width: 620px;
    margin: 0 auto 24px;
  }

  .problema-cta-note {
    display: block;
    margin-top: 14px;
    font-family: 'DM Mono', monospace;
    font-size: .68rem;
    letter-spacing: .08em;
    text-transform: uppercase;
    color: var(--gray2);
  }

  /* Feature grid */
  .feature-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    margin-top: 48px;
  }

  .feature-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 36px 28px;
    transition: border-color .25s;
  }

  .feature-card:hover {
    border-color: var(--orange);
  }

  .feature-icon {
    font-size: 2.5rem;
    margin-bottom: 20px;
  }

  .feature-title {
    font-family: 'Oswald', sans-serif;
    font-size: 1.05rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: .03em;
    margin-bottom: 14px;
  }

  .feature-desc {
    font-size: .9rem;
    color: var(--gray);
    line-height: 1.7;
  }

  /* Stats grid */
  .stats-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    margin-top: 48px;
  }

  .stat-block {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 40px 28px;
    text-align: center;
    transition: border-color .25s;
  }

  .stat-block-featured {
    border-color: var(--orange);
  }

  .stat-label-top {
    font-family: 'DM Mono', monospace;
    font-size: .65rem;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: var(--orange);
    margin-bottom: 4px;
  }

  .stat-number {
    font-family: 'Oswald', sans-serif;
    font-size: 3.2rem;
    font-weight: 700;
    color: var(--orange);
    line-height: 1;
    margin-bottom: 16px;
  }

  .stat-unit {
    font-size: 1.6rem;
    font-weight: 400;
  }

  .stat-desc {
    font-size: .85rem;
    color: var(--gray);
    line-height: 1.65;
  }

  /* Trial band */
  .trial-band {
    background: var(--surface2);
    padding: 64px 32px;
    text-align: center;
  }

  .trial-title {
    font-family: 'Oswald', sans-serif;
    font-size: clamp(1.6rem, 3.5vw, 2.2rem);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .02em;
    margin-bottom: 32px;
  }

  .trial-title em {
    color: var(--orange);
    font-style: normal;
  }

  .trial-bullets {
    display: flex;
    justify-content: center;
    gap: 32px;
    flex-wrap: wrap;
    margin-bottom: 36px;
  }

  .trial-bullet {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: .85rem;
    color: var(--gray);
  }

  .trial-bullet span {
    color: var(--green);
    font-weight: 600;
  }

  /* Responsive */
  @media (max-width: 980px) {
    .problema-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 900px) {
    .feature-grid,
    .stats-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 620px) {
    .problema-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 600px) {
    .trial-bullets {
      flex-direction: column;
      align-items: center;
      gap: 16px;
    }
  }
</style>
