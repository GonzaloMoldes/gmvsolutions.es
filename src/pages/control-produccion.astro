---
import Ilustracion from '../components/Ilustracion.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import FaqSection from '../components/FaqSection.astro';
import { softwareApplicationSchema, faqPageSchema, type FaqItem } from '../lib/seo';
import Screenshot from '../components/Screenshot.astro';

const title = "Control y gestión de producción en pyme industrial | REELEVO";
const description = "Control de producción: registra por operario y máquina, detecta paradas con causa y revisa KPIs diarios sin papel ni Excel.";

// Una sola lista alimenta el bloque visible y el FAQPage del head (auditoria P6).
//
// La segunda pregunta ya cubre el limite frente a un MES, asi que la seccion
// "Enfoque prudente" se elimina en vez de repetir el argumento dos veces
// (tarea C1 de PLAN_SIMPLIFICACION_EDITORIAL_WEB_2026-08.md).
const faqs: FaqItem[] = [
  {
    q: '¿Qué es un software de control de producción?',
    a: 'Es la herramienta que registra qué se fabrica, quién lo hace, en qué máquina y con qué resultado, en el momento en que ocurre. Sustituye al parte en papel que se rellena de memoria al cerrar el turno, y convierte esa información en tiempos reales y KPIs que se pueden mirar mientras la planta sigue trabajando.',
  },
  {
    q: '¿En qué se diferencia de un MES?',
    a: 'Un MES cubre además planificación de capacidad, listas de materiales, integración con el ERP y a menudo captura de datos de máquina, con la inversión e implantación que eso supone. El control de producción de REELEVO se queda en la capa operativa: la ejecución registrada en el puesto, trazable por operario, proceso y máquina. Para una pyme suele ser el primer paso, y el que más retorno da.',
  },
  {
    q: '¿Hace falta conectar las máquinas o poner sensores?',
    a: 'No. El dato lo introduce el operario desde el puesto al iniciar y cerrar cada sesión de trabajo, lo que no requiere cablear autómatas ni instalar sensores. Conectar máquina aporta precisión adicional, pero es un proyecto mucho más caro y rara vez es por donde conviene empezar en una pyme.',
  },
  {
    q: '¿Cuánto tiempo le quita al operario registrar la producción?',
    a: 'Segundos por sesión: iniciar el trabajo y cerrarlo indicando cantidad y, si la hubo, la causa de parada. La regla que seguimos es que registrar no puede costar más que el papel al que sustituye, porque en cuanto añade carga el operario lo rellena mal o lo esquiva, y entonces el dato deja de servir.',
  },
  {
    q: '¿Sirve si trabajamos con órdenes pequeñas o fabricación por encargo?',
    a: 'Sí. El registro va por sesión de trabajo asociada a proceso, operario y máquina, así que funciona igual en series largas que en lotes pequeños o piezas únicas. Para fabricación por encargo, además, cada unidad puede llevar su trazabilidad individual y su avance de obra.',
  },
];

const schema = [softwareApplicationSchema(), faqPageSchema(faqs)];
---

<BaseLayout title={title} description={description} canonical="https://www.gmvsolutions.es/control-produccion/" schema={schema} activeNav="" pageType="capacidad">

  <!-- HERO + PROBLEMA -->
  <section class="page-hero">
    <div class="eyebrow fade-up">Control y gestión de producción para pyme industrial</div>
    <h1 class="fade-up delay-1">¿Cuánto se produjo hoy? <br><em>Con REELEVO lo sabes en tiempo real</em></h1>
    <p class="fade-up delay-2">Hoy el jefe de producción gestiona de memoria lo que no está registrado en ningún sitio, y el parte se rellena al cerrar el turno. REELEVO registra cada sesión vinculada a operario, proceso y máquina, y te deja ver los KPIs del día mientras la planta trabaja. Sin partes en papel y sin consolidar Excel el lunes.</p>
    <div class="hero-cta fade-up delay-3" style="display:flex;gap:14px;justify-content:center;flex-wrap:wrap;">
      <a href="https://app.gmvsolutions.es/registro" class="btn-primary"
         data-cta data-cta-intent="registro" data-cta-location="hero" data-cta-label="Registrarme en REELEVO">Registrarme en REELEVO</a>
      <a href="/video-demo/" class="btn-ghost"
         data-cta data-cta-intent="navegacion" data-cta-location="hero" data-cta-label="Ver el demo">Ver el demo →</a>
    </div>
    <Ilustracion escena="control-produccion" />
  </section>

  <div class="divider"></div>

  <!-- CÓMO FUNCIONA — bloque dominante -->
  <section class="section">
    <div class="section-inner">
      <div class="fade-up">
        <div class="eyebrow">Cómo funciona en REELEVO</div>
        <h2 class="section-title">Del QR al dato — sin ningún paso manual adicional</h2>
        <p class="section-sub">El registro ocurre como subproducto de la ejecución: cuando el operario trabaja con el QR, el dato queda puesto solo. Nadie rellena nada aparte.</p>
      </div>

      <div class="kaizen-flow fade-up delay-1">
        <div class="flow-step">
          <div class="flow-num">1</div>
          <div class="flow-content">
            <h3>El supervisor planifica la semana</h3>
            <p>Asigna qué operario hace qué proceso, en qué máquina y cuándo. La vista de carga por turno avisa sola cuando hay riesgo de cobertura insuficiente.</p>
          </div>
        </div>

        <div class="flow-arrow">↓</div>

        <div class="flow-step">
          <div class="flow-num">2</div>
          <div class="flow-content">
            <h3>El operario trabaja desde su agenda</h3>
            <p>Llega al puesto, escanea el QR de la máquina y ve su agenda del día. Elige la tarea asignada, abre el SOP y arranca la sesión de producción.</p>
          </div>
        </div>

        <div class="flow-arrow">↓</div>

        <div class="flow-step">
          <div class="flow-num">3</div>
          <div class="flow-content">
            <h3>Las unidades quedan registradas en tiempo real</h3>
            <p>Registra las unidades al cerrar cada ciclo y, si hubo parada, su causa y duración —avería, falta de material, espera, cambio de utillaje—. Todo queda vinculado a operario, proceso y máquina.</p>
          </div>
        </div>

        <div class="flow-arrow">↓</div>

        <div class="flow-step">
          <div class="flow-num">4</div>
          <div class="flow-content">
            <h3>El supervisor ve los KPIs y valida</h3>
            <p>Desde el monitor de actividad: qué se está produciendo, quién trabaja y cuántas unidades llevas frente al objetivo. Revisa las sesiones completadas, añade correcciones y las valida.</p>
          </div>
        </div>
      </div>

      <div class="screenshot-pair fade-up delay-2">
        <figure class="screenshot-fig">
          <Screenshot name="monitor-actividad" alt="Monitor de operarios en tiempo real en REELEVO: quién está en proceso, en qué máquina y cuánto tiempo lleva" class="screenshot-img" layout="pair" />
          <figcaption class="screenshot-caption">Monitor en tiempo real — estado de cada operario y máquina activa</figcaption>
        </figure>
        <figure class="screenshot-fig">
          <Screenshot name="analitica-productividad" alt="Dashboard de analítica de productividad en REELEVO: top operarios, resumen por proceso, unidades y duración" class="screenshot-img" layout="pair" />
          <figcaption class="screenshot-caption">Analítica de productividad — ranking de operarios y rendimiento por proceso</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <div class="divider"></div>

  <!-- QUÉ INCLUYE -->
  <section class="section">
    <div class="section-inner">
      <div class="fade-up">
        <div class="eyebrow">Qué incluye</div>
        <h2 class="section-title">Registro, planificación y análisis en un solo módulo</h2>
      </div>

      <div class="solution-grid fade-up delay-1">
        <div class="solution-cell">
          <h3>Sesiones con inicio, fin y causa de parada</h3>
          <p>Hora de inicio y fin, operario, proceso, máquina, unidades y la causa de cada parada.</p>
        </div>

        <div class="solution-cell">
          <h3>KPIs del día y planificación semanal</h3>
          <p>Unidades, sesiones activas, operarios en planta y cumplimiento de objetivo, con el calendario de asignaciones por turno.</p>
        </div>

        <div class="solution-cell">
          <h3>Histórico validado y exportable</h3>
          <p>El encargado valida las sesiones, con filtros por fecha, operario o producto y exportación a CSV, Power BI o el ERP.</p>
        </div>
      </div>

      <p class="roles-line fade-up delay-2">Cada rol ve su vista, sin información de más ni de menos: <a href="/para-quien/jefe-de-produccion/">jefe de producción</a>, <a href="/portal-operario/">operario</a>, <a href="/para-quien/gerente-propietario/">gerente</a>.</p>
    </div>
  </section>

  <div class="divider"></div>

  <!-- PRUEBA -->
  <section class="section">
    <div class="section-inner">
      <div class="fade-up">
        <div class="eyebrow">En el producto</div>
        <h2 class="section-title">Planificación y registro <em>en una sola vista</em></h2>
        <p class="section-sub">Asignas quién hace qué cada semana y, cuando el operario ejecuta el proceso, la producción queda registrada sola. Sin partes manuales ni consolidados de Excel.</p>
      </div>

      <div class="screenshot-pair fade-up delay-2">
        <figure class="screenshot-fig">
          <Screenshot name="planificacion-semanal" alt="Vista de planificación semanal en REELEVO: calendario con asignaciones por operario y día" class="screenshot-img" layout="pair" />
          <figcaption class="screenshot-caption">Planificación semanal — asignaciones por operario y turno</figcaption>
        </figure>
        <figure class="screenshot-fig">
          <Screenshot name="detalle-procesos" alt="Registro detallado de ejecuciones en REELEVO: proceso, operario, fecha, duración, pasos y firmas" class="screenshot-img" layout="pair" />
          <figcaption class="screenshot-caption">Registro de ejecuciones — trazabilidad por proceso y operario</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <div class="divider"></div>

  <FaqSection items={faqs} />

  <div class="divider"></div>

  <!-- SIGUIENTE PASO -->
  <section class="cta-section">
    <div class="cta-eyebrow fade-up">Visibilidad diaria</div>
    <h3 class="cta-title fade-up delay-1">
      Deja de gestionar de memoria <br><em>lo que nadie tiene registrado</em>
    </h3>
    <p class="cta-sub fade-up delay-2">
      Empieza por un proceso y una máquina. En cuanto el primer turno queda registrado, se ve si el dato te sirve para decidir.
    </p>
    <div class="cta-actions fade-up delay-3">
      <a href="https://app.gmvsolutions.es/registro" class="btn-primary"
         data-cta data-cta-intent="registro" data-cta-location="footer" data-cta-label="Registrarme en REELEVO">
        Registrarme en REELEVO
      </a>
      <a href="/oee/" class="btn-ghost">
        Ver OEE y análisis Lean →
      </a>
    </div>
    <div class="cta-trust fade-up delay-4">Te acompañamos en la puesta en marcha · Sin compromiso y con foco práctico</div>
  </section>

</BaseLayout>

<style>
  /* FLUJO — bloque dominante */
  .kaizen-flow {
    display: flex;
    flex-direction: column;
    gap: 0;
    margin-top: 48px;
    max-width: 720px;
  }

  .flow-step {
    display: flex;
    gap: 24px;
    align-items: flex-start;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 28px;
  }

  .flow-num {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    min-width: 44px;
    background: var(--orange);
    color: var(--steel, #141618);
    border-radius: 50%;
    font-family: 'Oswald', sans-serif;
    font-size: 1.2rem;
    font-weight: 600;
  }

  .flow-content h3 {
    font-family: 'Oswald', sans-serif;
    font-size: 1.05rem;
    margin-bottom: 8px;
    color: var(--white);
  }

  .flow-content p {
    color: var(--gray);
    font-size: .95rem;
    line-height: 1.65;
    margin: 0;
  }

  .flow-arrow {
    text-align: center;
    font-size: 1.6rem;
    color: var(--orange-ink);
    padding: 6px 0;
    margin-left: 22px;
  }

  /* QUE INCLUYE */
  .solution-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    margin-top: 40px;
  }

  @media (max-width: 860px) {
    .solution-grid { grid-template-columns: 1fr; }
  }

  .solution-cell {
    background: var(--surface);
    border: 1px solid var(--border);
    border-top: 2px solid var(--orange);
    border-radius: 6px;
    padding: 24px;
  }

  .solution-cell h3 {
    font-family: 'Oswald', sans-serif;
    font-size: 1rem;
    margin-bottom: 10px;
    color: var(--white);
  }

  .solution-cell p {
    font-size: .95rem;
    color: var(--gray);
    line-height: 1.65;
    margin: 0;
  }

  /* Sustituye a la seccion "Lo que ve cada persona" (4 tarjetas de rol con
     16 items de lista, 141 palabras). Conserva el enlazado interno. */
  .roles-line {
    margin-top: 28px;
    font-size: .95rem;
    color: var(--gray);
  }

  .roles-line a {
    color: var(--orange-ink);
    text-decoration: none;
    border-bottom: 1px solid rgba(244, 82, 30, .35);
  }

  .roles-line a:hover {
    border-bottom-color: var(--orange);
  }

  .cta-trust {
    margin-top: 16px;
    font-size: 0.82rem;
    color: rgba(20,22,24, 0.45);
    letter-spacing: .04em;
  }
</style>
