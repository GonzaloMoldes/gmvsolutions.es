---
import BaseLayout from '../layouts/BaseLayout.astro';
import FaqSection from '../components/FaqSection.astro';
import { softwareApplicationSchema, faqPageSchema, type FaqItem } from '../lib/seo';
import Screenshot from '../components/Screenshot.astro';

const title = "Control y gestión de producción en pyme industrial | REELEVO";
const description = "Control de producción: registra por operario y máquina, detecta paradas con causa y revisa KPIs diarios sin papel ni Excel.";

// Una sola lista alimenta el bloque visible y el FAQPage del head (auditoria P6).
const faqs: FaqItem[] = [
  {
    q: '¿Qué es un software de control de producción?',
    a: 'Es la herramienta que registra qué se fabrica, quién lo hace, en qué máquina y con qué resultado, en el momento en que ocurre. Sustituye al parte en papel que se rellena de memoria al cerrar el turno, y convierte esa información en tiempos reales y KPIs que se pueden mirar mientras la planta sigue trabajando.',
  },
  {
    q: '¿En qué se diferencia de un MES?',
    a: 'Un MES cubre además planificación de capacidad, integración con el ERP y a menudo captura de datos de máquina, con la inversión e implantación que eso supone. El control de producción de REELEVO se queda en la capa operativa: la ejecución registrada en el puesto. Para una pyme suele ser el primer paso, y el que más retorno da.',
  },
  {
    q: '¿Hace falta conectar las máquinas o poner sensores?',
    a: 'No. El dato lo introduce el operario desde el puesto al iniciar y cerrar cada sesión de trabajo, lo que no requiere cablear autómatas ni instalar sensores. Conectar máquina aporta precisión adicional, pero es un proyecto mucho más caro y rara vez es por donde conviene empezar en una pyme.',
  },
  {
    q: '¿Cuánto tiempo le quita al operario registrar la producción?',
    a: 'Segundos por sesión: iniciar el trabajo y cerrarlo indicando cantidad y, si la hubo, la causa de parada. La regla que seguimos es que registrar no puede costar más que el papel al que sustituye, porque en cuanto añade carga el operario lo rellena mal o lo esquiva, y entonces el dato deja de servir.',
  },
  {
    q: '¿Sirve si trabajamos con órdenes pequeñas o fabricación por encargo?',
    a: 'Sí. El registro va por sesión de trabajo asociada a proceso, operario y máquina, así que funciona igual en series largas que en lotes pequeños o piezas únicas. Para fabricación por encargo, además, cada unidad puede llevar su trazabilidad individual y su avance de obra.',
  },
];

const schema = [softwareApplicationSchema(), faqPageSchema(faqs)];
---

<BaseLayout title={title} description={description} canonical="https://www.gmvsolutions.es/control-produccion/" schema={schema} activeNav="" pageType="capacidad">

  <!-- PAGE HERO -->
  <section class="page-hero">
    <div class="eyebrow fade-up">Control y gestión de producción para pyme industrial</div>
    <h1 class="fade-up delay-1">¿Cuánto se produjo hoy?<br><em>Con REELEVO lo sabes en tiempo real</em></h1>
    <p class="fade-up delay-2">REELEVO es el software de control de producción que registra cada sesión vinculada al operario, proceso y máquina. Ve los KPIs del día mientras la planta trabaja. Planifica la semana en minutos. Sin partes en papel, sin esperar al cierre de turno.</p>
    <div class="hero-cta fade-up delay-3" style="display:flex;gap:14px;justify-content:center;flex-wrap:wrap;">
      <a href="https://app.gmvsolutions.es/registro" class="btn-primary"
         data-cta data-cta-intent="registro" data-cta-location="hero" data-cta-label="Registrarme en REELEVO">Registrarme en REELEVO</a>
      <a href="/video-demo/" class="btn-ghost"
         data-cta data-cta-intent="navegacion" data-cta-location="hero" data-cta-label="Ver el demo">Ver el demo →</a>
    </div>
  </section>

  <div class="divider"></div>

  <!-- EL PROBLEMA -->
  <section class="section">
    <div class="section-inner">
      <div class="fade-up">
        <div class="eyebrow">El problema</div>
        <h2 class="section-title">El jefe de producción gestiona de memoria lo que no está registrado en ningún sitio</h2>
      </div>

      <div class="challenge-content fade-up delay-1">
        <p>En la mayoría de pymes industriales, el control de producción funciona así:</p>
        <div class="challenge-list">
          <div class="challenge-item">
            <span class="icon">❌</span>
            <span>Las piezas producidas del día se cuentan al final del turno, a veces a ojo, y se apuntan en un parte en papel que nadie consolida bien</span>
          </div>
          <div class="challenge-item">
            <span class="icon">❌</span>
            <span>Cuando hay una parada de máquina, la causa queda en la cabeza del operario — no en ningún registro</span>
          </div>
          <div class="challenge-item">
            <span class="icon">❌</span>
            <span>El jefe de producción no sabe cuánto se ha producido hoy hasta que pregunta — y a veces la respuesta no es fiable</span>
          </div>
          <div class="challenge-item">
            <span class="icon">❌</span>
            <span>La planificación semanal existe solo en la cabeza del encargado. Si falta un operario, reorganizar el turno es un caos</span>
          </div>
          <div class="challenge-item">
            <span class="icon">❌</span>
            <span>No hay datos históricos de producción por operario, proceso o máquina para detectar tendencias ni mejorar objetivos</span>
          </div>
        </div>
      </div>

      <div class="risk-box fade-up delay-2">
        <h3>Sin registro no hay mejora</h3>
        <p>No puedes mejorar lo que no mides. Y no puedes medir algo que solo existe en partes de papel y en la memoria del encargado.</p>
      </div>
    </div>
  </section>

  <div class="divider"></div>

  <!-- CÓMO FUNCIONA -->
  <section class="section">
    <div class="section-inner">
      <div class="fade-up">
        <div class="eyebrow">Cómo funciona en REELEVO</div>
        <h2 class="section-title">Del QR al dato — sin ningún paso manual adicional</h2>
        <p class="section-sub">El registro de producción en REELEVO ocurre como subproducto de la ejecución. Cuando el operario trabaja con el QR, los datos de producción quedan registrados automáticamente.</p>
      </div>

      <div class="kaizen-flow fade-up delay-1">
        <div class="flow-step">
          <div class="flow-num">1</div>
          <div class="flow-content">
            <h3>El supervisor planifica la semana</h3>
            <p>Desde el panel de planificación, asigna qué operario hace qué proceso en qué máquina y cuándo. Vista de carga por turno con alertas automáticas de cobertura insuficiente. Si hay riesgo de no tener un certificado en un proceso crítico, el sistema avisa antes.</p>
          </div>
        </div>

        <div class="flow-arrow">↓</div>

        <div class="flow-step">
          <div class="flow-num">2</div>
          <div class="flow-content">
            <h3>El operario trabaja desde su agenda</h3>
            <p>El operario llega a su puesto, escanea el QR de la máquina y ve su agenda del día. Selecciona la tarea asignada, inicia la sesión de producción y sigue el proceso SOP paso a paso. Sin papel, sin instrucciones verbales.</p>
          </div>
        </div>

        <div class="flow-arrow">↓</div>

        <div class="flow-step">
          <div class="flow-num">3</div>
          <div class="flow-content">
            <h3>Las unidades quedan registradas en tiempo real</h3>
            <p>El operario registra las unidades producidas al completar cada ciclo. Si hay una parada, registra la causa y la duración. Todo queda vinculado al operario, proceso, máquina, turno y hora — sin que nadie más tenga que hacer nada.</p>
          </div>
        </div>

        <div class="flow-arrow">↓</div>

        <div class="flow-step">
          <div class="flow-num">4</div>
          <div class="flow-content">
            <h3>El supervisor ve los KPIs y valida</h3>
            <p>El jefe de producción tiene visibilidad en tiempo real desde el monitor de actividad: qué se está produciendo, quién está trabajando, cuántas unidades van. Al cierre del turno, valida las sesiones completadas. El histórico queda para siempre.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <div class="divider"></div>

  <!-- FUNCIONALIDADES -->
  <section class="section">
    <div class="section-inner">
      <div class="fade-up">
        <div class="eyebrow">Funcionalidades</div>
        <h2 class="section-title">Registro, planificación y análisis en un solo módulo</h2>
      </div>

      <div class="solution-grid fade-up delay-1">
        <div class="solution-cell">
          <div class="cell-number">1</div>
          <h3>Sesiones de producción con inicio y fin</h3>
          <p>Cada sesión queda registrada con hora de inicio, hora de fin, operario, proceso, máquina y unidades producidas. Trazabilidad completa de cada bloque de trabajo.</p>
        </div>

        <div class="solution-cell">
          <div class="cell-number">2</div>
          <h3>Registro de paradas con causa</h3>
          <p>Cuando el operario para la producción, registra la causa (avería, falta de material, espera, cambio de utillaje). La causa queda en el historial y es analizable para detectar patrones.</p>
        </div>

        <div class="solution-cell">
          <div class="cell-number">3</div>
          <h3>KPIs en tiempo real</h3>
          <p>Dashboard de producción diaria actualizado en tiempo real: unidades producidas, sesiones activas, operarios en planta, cumplimiento de objetivo. Sin esperar al cierre del turno.</p>
        </div>

        <div class="solution-cell">
          <div class="cell-number">4</div>
          <h3>Planificación semanal</h3>
          <p>Vista de calendario con asignaciones por operario. Carga de trabajo visible por turno con alertas automáticas cuando hay riesgo de cobertura insuficiente en un proceso crítico.</p>
        </div>

        <div class="solution-cell">
          <div class="cell-number">5</div>
          <h3>Validación de supervisor</h3>
          <p>El encargado revisa y valida las sesiones de producción completadas. Puede añadir notas o correcciones. La validación queda registrada junto al dato de producción.</p>
        </div>

        <div class="solution-cell">
          <div class="cell-number">6</div>
          <h3>Histórico y exportación de datos</h3>
          <p>Accede al histórico completo de producción con filtros por fecha, operario, proceso, máquina y producto. Exporta a CSV para análisis externos o para alimentar tu ERP.</p>
        </div>
      </div>

      <div class="screenshot-pair fade-up delay-2">
        <figure class="screenshot-fig">
          <Screenshot name="monitor-actividad" alt="Monitor de operarios en tiempo real en REELEVO: quién está en proceso, en qué máquina y cuánto tiempo llevan" class="screenshot-img" layout="pair" />
          <figcaption class="screenshot-caption">Monitor en tiempo real — estado de cada operario y máquina activa</figcaption>
        </figure>
        <figure class="screenshot-fig">
          <Screenshot name="analitica-productividad" alt="Dashboard de analítica de productividad en REELEVO: top operarios, resumen por proceso, unidades y duración media" class="screenshot-img" layout="pair" />
          <figcaption class="screenshot-caption">Analítica de productividad — ranking de operarios y rendimiento por proceso</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <div class="divider"></div>

  <!-- LO QUE VE CADA ROL -->
  <section class="section">
    <div class="section-inner">
      <div class="fade-up">
        <div class="eyebrow">Lo que ve cada persona</div>
        <h2 class="section-title">Cada rol tiene su vista — sin información de más ni de menos</h2>
      </div>

      <div class="roles-grid fade-up delay-1">
        <div class="role-card">
          <div class="role-title">Operario</div>
          <ul>
            <li>Su agenda del día: qué proceso, en qué máquina, a qué hora</li>
            <li>El SOP del proceso desde el QR</li>
            <li>Registro de unidades producidas y paradas</li>
            <li>Su historial de producción personal</li>
          </ul>
        </div>

        <div class="role-card">
          <div class="role-title">Encargado de turno</div>
          <ul>
            <li>Monitor de actividad en tiempo real: quién está produciendo qué</li>
            <li>Bandeja de validaciones pendientes</li>
            <li>Alertas de paradas o incidencias en planta</li>
            <li>Notas de turno por máquina</li>
          </ul>
        </div>

        <div class="role-card">
          <div class="role-title">Jefe de producción</div>
          <ul>
            <li>Dashboard con KPIs del día y de la semana</li>
            <li>Planificación semanal de asignaciones</li>
            <li>Histórico de producción con filtros avanzados</li>
            <li>Alertas de cobertura de turno y riesgo de objetivo</li>
          </ul>
        </div>

        <div class="role-card">
          <div class="role-title">Gerente / Dirección</div>
          <ul>
            <li>Visibilidad del rendimiento productivo en números reales</li>
            <li>Comparativa real vs planificado por operario y proceso</li>
            <li>Datos para decisiones de capacidad y recursos</li>
            <li>Exportable a Power BI o al ERP</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <div class="divider"></div>

  <!-- PRODUCTO -->
  <section class="section">
    <div class="section-inner">
      <div class="fade-up">
        <div class="eyebrow">En el producto</div>
        <h2 class="section-title">Planificación semanal y registro de producción <em>en una sola vista</em></h2>
        <p class="section-sub">
          La planificación semanal por operario y el registro de cada proceso de producción conviven en el mismo
          módulo, así el dato del día está disponible sin partes manuales ni consolidados de Excel. Asignas quién
          hace qué cada semana y, cuando el operario ejecuta el proceso, la producción queda registrada sola.
        </p>
      </div>

      <div class="screenshot-pair fade-up delay-2">
        <figure class="screenshot-fig">
          <Screenshot name="planificacion-semanal" alt="Vista de planificación semanal en REELEVO: calendario con asignaciones por operario y día" class="screenshot-img" layout="pair" />
          <figcaption class="screenshot-caption">Planificación semanal — asignaciones por operario y turno</figcaption>
        </figure>
        <figure class="screenshot-fig">
          <Screenshot name="detalle-procesos" alt="Registro detallado de ejecuciones en REELEVO: proceso, operario, fecha, duración, pasos y firmas" class="screenshot-img" layout="pair" />
          <figcaption class="screenshot-caption">Registro de ejecuciones — trazabilidad completa por proceso y operario</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <div class="divider"></div>

  <!-- NOTA HONESTA -->
  <section class="section">
    <div class="section-inner">
      <div class="fade-up">
        <div class="eyebrow">Enfoque prudente</div>
        <h3 class="section-title">Control de produccion operativo: no un sistema MES ni un ERP</h3>
      </div>

      <div class="honest-note fade-up delay-1">
        <p><strong>Lo que sí hace:</strong> REELEVO registra toda la actividad productiva de forma trazable — quién hizo qué, cuándo, cuánto y en qué máquina. Te da visibilidad en tiempo real y un histórico exportable. Para la mayoría de pymes que hoy no tienen ningún sistema formal de control de producción, cubre el 90% de las necesidades.</p>
      </div>

      <div class="honest-note fade-up delay-2" style="margin-top:16px;">
        <p><strong>Lo que no hace:</strong> REELEVO no es un MES especializado. No gestiona la planificación de capacidad a largo plazo, ni las listas de materiales (BOM), ni la integración con maquinaria vía SCADA o PLC. Si necesitas esas funcionalidades, REELEVO puede complementar tu MES como capa de digitalización de procesos y formación — pero no reemplazarlo. Si hoy gestionas la producción en partes de papel o en Excel, REELEVO es el siguiente paso natural.</p>
      </div>
    </div>
  </section>

  <div class="divider"></div>

  <FaqSection items={faqs} />

  <div class="divider"></div>

  <!-- CTA -->
  <section class="cta-section">
    <div class="cta-eyebrow fade-up">Visibilidad diaria</div>
    <div class="cta-title fade-up delay-1">
      Saber qué pasa en planta<br><em>sin ir detrás de cada parte</em>
    </div>
    <p class="cta-sub fade-up delay-2">
      Prueba REELEVO y empieza a ver la producción del día con menos llamadas, menos consolidación manual y menos espera al cierre de turno.
    </p>
    <div class="cta-actions fade-up delay-3">
      <a href="https://app.gmvsolutions.es/registro" class="btn-primary"
         data-cta data-cta-intent="registro" data-cta-location="footer" data-cta-label="Registrarme en REELEVO">
        Registrarme en REELEVO
      </a>
      <a href="/para-quien/jefe-de-produccion/" class="btn-ghost">
        Para jefe de producción →
      </a>
    </div>
    <div class="cta-trust fade-up delay-4">Sin tarjeta de crédito · Te acompañamos en la primera configuración</div>
  </section>

</BaseLayout>

<style>
  .challenge-content {
    max-width: 700px;
    margin-top: 40px;
  }

  .challenge-list {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin: 24px 0;
  }

  .challenge-item {
    display: flex;
    gap: 16px;
    align-items: flex-start;
    padding: 12px 16px;
    background: var(--surface);
    border-left: 3px solid rgba(255, 100, 0, 0.3);
    border-radius: 4px;
  }

  .challenge-item .icon { font-size: 1.2rem; flex-shrink: 0; }

  .challenge-item span:last-child {
    color: var(--gray);
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .risk-box {
    background: rgba(255, 100, 0, 0.08);
    border: 1px solid rgba(255, 150, 0, 0.25);
    border-radius: 6px;
    padding: 28px;
    margin-top: 32px;
    max-width: 700px;
  }

  .risk-box h3 {
    font-family: 'Oswald', sans-serif;
    margin-bottom: 12px;
    color: var(--text);
  }

  .risk-box p { color: var(--gray); line-height: 1.6; margin: 0; }

  /* FLOW */
  .kaizen-flow {
    display: flex;
    flex-direction: column;
    gap: 0;
    margin-top: 48px;
    max-width: 720px;
  }

  .flow-step {
    display: flex;
    gap: 24px;
    align-items: flex-start;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 28px;
  }

  .flow-num {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    min-width: 44px;
    background: var(--orange);
    color: #fff;
    border-radius: 50%;
    font-family: 'Oswald', sans-serif;
    font-size: 1.2rem;
    font-weight: 600;
  }

  .flow-content h3 {
    font-family: 'Oswald', sans-serif;
    font-size: 1.05rem;
    margin-bottom: 8px;
    color: var(--text);
  }

  .flow-content p {
    color: var(--gray);
    font-size: 0.93rem;
    line-height: 1.6;
    margin: 0;
  }

  .flow-arrow {
    text-align: center;
    font-size: 1.6rem;
    color: var(--orange);
    padding: 6px 0;
    margin-left: 22px;
  }

  /* SOLUTION GRID */
  .solution-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
    margin-top: 40px;
  }

  @media (max-width: 640px) {
    .solution-grid { grid-template-columns: 1fr; }
  }

  .solution-cell {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 24px;
  }

  .cell-number {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    background: var(--orange);
    color: #fff;
    border-radius: 50%;
    font-weight: 600;
    font-size: 1rem;
    margin-bottom: 14px;
  }

  .solution-cell h3 {
    font-family: 'Oswald', sans-serif;
    font-size: 1rem;
    margin-bottom: 10px;
    color: var(--text);
  }

  .solution-cell p {
    font-size: 0.9rem;
    color: var(--gray);
    line-height: 1.6;
    margin: 0;
  }

  /* ROLES */
  .roles-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
    margin-top: 40px;
  }

  @media (max-width: 640px) {
    .roles-grid { grid-template-columns: 1fr; }
  }

  .role-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 24px;
  }

  .role-title {
    font-family: 'Oswald', sans-serif;
    font-size: 0.95rem;
    color: var(--orange);
    margin-bottom: 14px;
    text-transform: uppercase;
    letter-spacing: .04em;
  }

  .role-card ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .role-card ul li {
    font-size: 0.88rem;
    color: var(--gray);
    line-height: 1.5;
    padding-left: 14px;
    position: relative;
  }

  .role-card ul li::before {
    content: '·';
    position: absolute;
    left: 0;
    color: var(--orange);
  }

  /* CASE STORY */
  .case-story {
    display: flex;
    flex-direction: column;
    gap: 24px;
    margin-top: 40px;
    max-width: 760px;
  }

  .story-section {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 24px 28px;
  }

  .story-section h3 {
    font-family: 'Oswald', sans-serif;
    color: var(--gray);
    text-transform: uppercase;
    letter-spacing: .06em;
    font-size: .8rem;
    margin-bottom: 10px;
  }

  .story-section p {
    color: var(--gray);
    line-height: 1.65;
    margin: 0;
    font-size: 0.93rem;
  }

  .story-section.highlight {
    border-color: var(--orange);
    background: rgba(255, 100, 0, 0.05);
  }

  .story-section.highlight h3 { color: var(--orange); }

  .story-section ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .story-section ul li {
    color: var(--gray);
    font-size: 0.93rem;
    line-height: 1.55;
  }

  .story-result {
    display: flex;
    align-items: center;
    gap: 20px;
    padding: 24px 28px;
    background: rgba(255, 100, 0, 0.08);
    border: 1px solid rgba(255, 150, 0, 0.25);
    border-radius: 6px;
  }

  .result-num {
    font-family: 'Oswald', sans-serif;
    font-size: 2.8rem;
    font-weight: 700;
    color: var(--orange);
    white-space: nowrap;
  }

  .result-label {
    color: var(--gray);
    font-size: 0.93rem;
    line-height: 1.5;
  }

  /* HONEST NOTE */
