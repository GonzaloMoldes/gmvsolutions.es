---
import Ilustracion from '../components/Ilustracion.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import FaqSection from '../components/FaqSection.astro';
import { softwareApplicationSchema, faqPageSchema, type FaqItem } from '../lib/seo';
import Screenshot from '../components/Screenshot.astro';

const title = "Kaizen y mejora continua en planta industrial | REELEVO";
const description = "Kaizen digital para la mejora continua operativa: captura ideas de los operarios en el puesto, prioriza, implementa y estandariza en planta industrial.";
const canonical = "https://www.gmvsolutions.es/kaizen/";

// Una sola lista alimenta el bloque visible y el FAQPage del head (auditoria P6).
//
// La quinta pregunta recoge el limite honesto que antes era una seccion propia
// ("Lo que REELEVO hace y lo que no prometemos", 169 palabras con tabla
// comparativa). El argumento se mantiene, la seccion no: la plantilla admite
// prueba O limite, no los dos (tarea B3 de
// PLAN_SIMPLIFICACION_EDITORIAL_WEB_2026-08.md).
const faqs: FaqItem[] = [
  {
    q: '¿Qué es el Kaizen aplicado a una planta industrial?',
    a: 'Es la mejora continua hecha por quien ejecuta el trabajo: pequeños cambios propuestos desde el puesto, evaluados y, si funcionan, incorporados al estándar. No es un proyecto de consultoría ni una campaña puntual, sino un ciclo que se repite y que va afinando el proceso.',
  },
  {
    q: '¿Cómo propone una mejora el operario?',
    a: 'Desde el puesto, escaneando el QR de la máquina y dejando la propuesta en el momento en que detecta el problema. Es lo que evita el fallo clásico: la idea aparece a media mañana y se pierde antes de que alguien tenga tiempo de escucharla.',
  },
  {
    q: '¿Quién decide qué mejoras se implementan?',
    a: 'El responsable, con las propuestas priorizadas delante en lugar de sueltas en una libreta o en una conversación de pasillo. Lo relevante no es solo decidir, sino que quien propuso vea qué pasó con su idea, porque si nunca hay respuesta las propuestas dejan de llegar.',
  },
  {
    q: '¿Cómo se evita que las ideas se pierdan entre turnos?',
    a: 'Porque quedan registradas donde se generan y no dependen de que alguien se acuerde de trasladarlas al turno siguiente. El ciclo completo —propuesta, evaluación, implantación y estandarización— vive en el mismo sitio que el proceso al que afecta.',
  },
  {
    q: '¿Esto crea por sí solo una cultura de mejora continua?',
    a: 'No, y no vamos a prometerlo: eso requiere liderazgo. Lo que sí hace REELEVO es eliminar la fricción para que las ideas lleguen, para que se gestionen con visibilidad y para que las buenas terminen incorporadas al proceso. Si el equipo tiene ideas y la empresa quiere escucharlas, REELEVO es el canal que faltaba.',
  },
];

const pageSchema = softwareApplicationSchema();

const schema = [pageSchema, faqPageSchema(faqs)];
---

<BaseLayout title={title} description={description} canonical={canonical} schema={schema} activeNav="" pageType="capacidad">

  <!-- HERO + PROBLEMA -->
  <section class="page-hero">
    <div class="eyebrow fade-up">Kaizen · Mejora Continua en Planta</div>
    <h1 class="fade-up delay-1">Las mejoras nacen <br><em>donde ocurre el trabajo</em></h1>
    <p class="fade-up delay-2">El operario que ejecuta el proceso cada día ve lo que puede mejorar, pero la idea aparece a media mañana y se pierde antes de que alguien tenga tiempo de escucharla. REELEVO le da un canal para registrarla en el momento, y a ti un sistema para gestionarla hasta que se convierte en estándar.</p>
    <div class="hero-cta fade-up delay-3">
      <a href="https://app.gmvsolutions.es/registro" class="btn-primary"
         data-cta data-cta-intent="registro" data-cta-location="hero" data-cta-trigger="07" data-cta-label="Registrarse gratis">Registrarse gratis</a>
    </div>
    <Ilustracion escena="kaizen" />
  </section>

  <div class="divider"></div>

  <!-- CÓMO FUNCIONA — bloque dominante -->
  <section class="section">
    <div class="section-inner">
      <div class="fade-up">
        <div class="eyebrow">Cómo funciona en REELEVO</div>
        <h2 class="section-title">Del QR de la máquina al estándar de la empresa</h2>
        <p class="section-sub">El ciclo Kaizen de REELEVO conecta el punto de trabajo con la gestión de la mejora sin fricción extra para el operario ni para el responsable.</p>
      </div>

      <div class="kaizen-flow fade-up delay-1">
        <div class="flow-step">
          <div class="flow-num">1</div>
          <div class="flow-content">
            <h3>El operario lo registra en el momento</h3>
            <p>Botón <strong>«💡 Proponer mejora»</strong> accesible desde el flujo QR de producción. En segundos: descripción, tipo de impacto y foto opcional. El contexto —proceso, máquina, operario, fecha— se captura automáticamente.</p>
          </div>
        </div>

        <div class="flow-arrow">↓</div>

        <div class="flow-step">
          <div class="flow-num">2</div>
          <div class="flow-content">
            <h3>El responsable la gestiona en el panel Kaizen</h3>
            <p>Vista Kanban con todas las propuestas por estado: <strong>Capturada → Revisada → En implementación → Estandarizada</strong>. Priorización por impacto, asignación de responsable y registro de acciones. El propio panel lleva los KPIs del ciclo: cuántas propuestas entran, cuántas acaban implementadas y cuánto tardan en llegar al proceso.</p>
          </div>
        </div>

        <div class="flow-arrow">↓</div>

        <div class="flow-step">
          <div class="flow-num">3</div>
          <div class="flow-content">
            <h3>Se implementa y se reconoce</h3>
            <p>La mejora aprobada se asigna para implementación. El operario que la propuso recibe puntos o recompensa económica configurada por la empresa. El equipo ve que proponer funciona.</p>
          </div>
        </div>

        <div class="flow-arrow">↓</div>

        <div class="flow-step">
          <div class="flow-num">4</div>
          <div class="flow-content">
            <h3>La mejora vuelve al proceso como nuevo estándar</h3>
            <p>Una vez estandarizada, el SOP del proceso se actualiza. La próxima vez que un operario escanee el QR de esa máquina, encontrará la instrucción mejorada. El conocimiento crece solo.</p>
          </div>
        </div>
      </div>

      <div class="screenshot-single fade-up delay-2">
        <figure class="screenshot-fig">
          <Screenshot name="editor-workflows" alt="Panel Kaizen Digital en REELEVO con propuestas y detalle de acción correctiva" class="screenshot-img" layout="single" />
          <figcaption class="screenshot-caption">Panel Kaizen Digital — vista Kanban de propuestas con detalle de causa raíz y acciones correctivas</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <div class="divider"></div>

  <!-- QUÉ INCLUYE -->
  <section class="section">
    <div class="section-inner">
      <div class="fade-up">
        <div class="eyebrow">Qué incluye</div>
        <h2 class="section-title">Todo el ciclo Kaizen en una sola herramienta</h2>
      </div>

      <div class="solution-grid fade-up delay-1">
        <div class="solution-cell">
          <h3>Captura desde el QR de planta</h3>
          <p>La propuesta se deja en el puesto, en el momento, sin cambiar de aplicación ni esperar a una reunión.</p>
        </div>

        <div class="solution-cell">
          <h3>Panel Kanban de gestión</h3>
          <p>Todas las propuestas por estado, con responsable y prioridad.</p>
        </div>

        <div class="solution-cell">
          <h3>Reconocimiento al que propone</h3>
          <p>Puntos o recompensa configurable, y aviso a quien propuso cuando su idea entra en el proceso. Sin respuesta, las propuestas dejan de llegar.</p>
        </div>
      </div>

      <p class="roles-line fade-up delay-2">Lo que cambia según tu papel: <a href="/para-quien/jefe-de-produccion/">jefe de producción</a>, <a href="/para-quien/responsable-calidad/">responsable de calidad</a>, <a href="/para-quien/gerente-propietario/">gerente</a>.</p>
    </div>
  </section>

  <div class="divider"></div>

  <!-- PRUEBA -->
  <section class="section">
    <div class="section-inner">
      <div class="fade-up">
        <div class="eyebrow">Cómo se ve en una semana</div>
        <h2 class="section-title">De la idea al estándar en cuatro días</h2>
      </div>

      <ol class="timeline fade-up delay-1">
        <li><strong>Lunes 14:20</strong> — Pedro, de turno de tarde, propone desde el puesto acortar una espera de 40 segundos en el sellado.</li>
        <li><strong>Lunes 15:00</strong> — El jefe de producción la ve en el panel, la pasa a «Revisada» y la asigna a mantenimiento.</li>
        <li><strong>Miércoles</strong> — Hay un ajuste de parámetros posible; se prueba en turno de noche.</li>
        <li><strong>Jueves</strong> — Funciona: 35 segundos menos por ciclo. Pasa a «Estandarizada», el SOP se actualiza solo y Pedro recibe sus puntos y el aviso.</li>
      </ol>

      <p class="timeline-note fade-up delay-2">Escenario ilustrativo del recorrido de una propuesta dentro de la herramienta, no un caso medido en un cliente.</p>
    </div>
  </section>

  <div class="divider"></div>

  <FaqSection items={faqs} />

  <div class="divider"></div>

  <!-- SIGUIENTE PASO -->
  <section class="cta-section">
    <div class="cta-eyebrow fade-up">Mejora continua</div>
    <h3 class="cta-title fade-up delay-1">
      Dale a tu equipo un canal <br><em>para que las ideas no se pierdan</em>
    </h3>
    <p class="cta-sub fade-up delay-2">
      Las ideas están ahí. Solo necesitan un sitio donde aterrizar y un proceso para que lleguen a ser estándares.
    </p>
    <div class="cta-actions fade-up delay-3">
      <a href="https://app.gmvsolutions.es/registro" class="btn-primary"
         data-cta data-cta-intent="registro" data-cta-location="footer" data-cta-trigger="07" data-cta-label="Registrarme en REELEVO">
        Empezar gratis · Sin compromiso
      </a>
      <a href="/documentacion-procesos/" class="btn-ghost">
        Ver documentación de procesos →
      </a>
    </div>
    <div class="cta-trust fade-up delay-4">Te acompañamos en la puesta en marcha · Sin compromiso y sin reuniones de más</div>
  </section>

</BaseLayout>

<style>
  /* FLUJO — bloque dominante de la pagina */
  .kaizen-flow {
    display: flex;
    flex-direction: column;
    gap: 0;
    margin-top: 48px;
    max-width: 720px;
  }

  .flow-step {
    display: flex;
    gap: 24px;
    align-items: flex-start;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 28px;
  }

  .flow-num {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    min-width: 44px;
    background: var(--orange);
    color: var(--steel, #141618);
    border-radius: 50%;
    font-family: 'Archivo Narrow', sans-serif;
    font-size: 1.2rem;
    font-weight: 600;
  }

  .flow-content h3 {
    font-family: 'Archivo Narrow', sans-serif;
    font-size: 1.05rem;
    margin-bottom: 8px;
    color: var(--white);
  }

  .flow-content p {
    color: var(--gray);
    font-size: .95rem;
    line-height: 1.65;
    margin: 0;
  }

  .flow-arrow {
    text-align: center;
    font-size: 1.6rem;
    color: var(--orange-ink);
    padding: 6px 0;
    margin-left: 22px;
  }

  /* QUE INCLUYE — 3 tarjetas */
  .solution-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    margin-top: 40px;
  }

  @media (max-width: 860px) {
    .solution-grid { grid-template-columns: 1fr; }
  }

  .solution-cell {
    background: var(--surface);
    border: 1px solid var(--border);
    border-top: 2px solid var(--orange);
    border-radius: 6px;
    padding: 24px;
  }

  .solution-cell h3 {
    font-family: 'Archivo Narrow', sans-serif;
    font-size: 1rem;
    margin-bottom: 10px;
    color: var(--white);
  }

  .solution-cell p {
    font-size: .95rem;
    color: var(--gray);
    line-height: 1.65;
    margin: 0;
  }

  /* Sustituye a la seccion "Lo que cambia para cada persona del equipo"
     (6 subtitulos, 199 palabras). Conserva el enlazado interno a /para-quien/. */
  .roles-line {
    margin-top: 28px;
    font-size: .95rem;
    color: var(--gray);
  }

  .roles-line a {
    color: var(--orange-ink);
    text-decoration: none;
    border-bottom: 1px solid rgba(244, 82, 30, .35);
  }

  .roles-line a:hover {
    border-bottom-color: var(--orange);
  }

  /* PRUEBA — sustituye al bloque "Caso real" de 330 palabras */
  .timeline {
    margin: 40px 0 0;
    padding: 0;
    list-style: none;
    max-width: 720px;
    border-left: 2px solid var(--border);
  }

  .timeline li {
    position: relative;
    padding: 0 0 20px 26px;
    font-size: .95rem;
    line-height: 1.65;
    color: var(--gray);
  }

  .timeline li:last-child {
    padding-bottom: 0;
  }

  .timeline li::before {
    content: '';
    position: absolute;
    left: -5px;
    top: .6em;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--orange);
  }

  .timeline li strong {
    color: var(--white);
    font-weight: 500;
  }

  .timeline-note {
    margin-top: 24px;
    font-size: .82rem;
    color: var(--gray2);
    max-width: 720px;
  }

  .cta-trust {
    margin-top: 16px;
    font-size: 0.82rem;
    color: rgba(20,22,24, 0.45);
    letter-spacing: .04em;
  }
</style>
