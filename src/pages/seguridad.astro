---
import BaseLayout from '../layouts/BaseLayout.astro';
import FaqSection from '../components/FaqSection.astro';
import { softwareApplicationSchema, faqPageSchema, type FaqItem } from '../lib/seo';
import Ilustracion from '../components/Ilustracion.astro';

// Pagina deliberadamente sencilla: responde a las preguntas basicas de
// seguridad sin entrar en detalle tecnico (proveedores, cabeceras, nombres de
// roles, mecanismos internos). El detalle se da a quien lo pida por contacto.

const title = "Seguridad y protección de datos | REELEVO";
const description = "Cómo protege REELEVO los datos de tu empresa: datos separados por empresa, acceso por roles, alojamiento en la UE y cumplimiento RGPD.";
const canonical = "https://www.gmvsolutions.es/seguridad/";

// Una sola lista alimenta el bloque visible y el FAQPage del head.
const faqs: FaqItem[] = [
  {
    q: '¿Dónde se alojan los datos?',
    a: 'En infraestructura ubicada en la Unión Europea. Los procesos y la documentación que cargas son siempre propiedad de tu empresa.',
  },
  {
    q: '¿Puede otra empresa ver nuestros datos?',
    a: 'No. Los datos de cada empresa están separados y protegidos, de modo que cada cliente solo accede a su propia información.',
  },
  {
    q: '¿Es seguro que el operario entre sin cuenta ni contraseña?',
    a: 'Sí. El acceso desde el puesto es temporal y limitado a ejecutar procesos: no da entrada al panel de empresa ni a información administrativa. Y cada ejecución queda identificada, así que se mantiene la trazabilidad.',
  },
  {
    q: '¿Puedo decidir qué ve cada persona?',
    a: 'Sí. Hay distintos roles y permisos, para que cada persona vea solo lo que necesita. Por ejemplo, un jefe de línea puede trabajar con procesos sin ver la facturación.',
  },
  {
    q: '¿Cumple con el RGPD?',
    a: 'Sí. REELEVO está diseñado para cumplir el RGPD: los datos se conservan según una política de retención y puedes ejercer tus derechos desde el propio panel.',
  },
  {
    q: '¿Qué pasa con nuestros datos si dejamos de usar REELEVO?',
    a: 'Puedes exportarlos y solicitar la baja desde el panel, sin pasar por soporte. Tras la baja, los datos se eliminan.',
  },
];

const pageSchema = softwareApplicationSchema();
const schema = [pageSchema, faqPageSchema(faqs)];

const pilares = [
  ['Datos separados', 'Cada empresa accede solo a su información.'],
  ['Acceso por roles', 'Cada persona ve lo que necesita para su trabajo, y nada más.'],
  ['Alojamiento en la UE', 'Tus datos se guardan en la Unión Europea.'],
  ['RGPD', 'Exportación, baja y eliminación de datos desde el panel.'],
];
---

<BaseLayout title={title} description={description} canonical={canonical} schema={schema} activeNav="" pageType="capacidad">

  <!-- HERO -->
  <section class="page-hero">
    <div class="eyebrow fade-up">Seguridad · RGPD · Alojamiento en la UE</div>
    <h1 class="fade-up delay-1">Tus datos, <br><em>protegidos y bajo tu control</em></h1>
    <p class="fade-up delay-2">
      Respuestas claras a las preguntas de seguridad más habituales.
    </p>
    <div class="hero-cta fade-up delay-3" style="display:flex;gap:14px;justify-content:center;flex-wrap:wrap;">
      <a href="https://app.gmvsolutions.es/registro" class="btn-primary"
         data-cta data-cta-intent="registro" data-cta-location="hero" data-cta-label="Registrarme en REELEVO">Registrarme en REELEVO</a>
      <a href="mailto:hola@gmvsolutions.es" class="btn-ghost"
         data-cta data-cta-intent="contacto" data-cta-location="hero" data-cta-label="Consulta de seguridad">Hablar con nosotros</a>
    </div>
    <Ilustracion escena="seguridad" />
  </section>

  <div class="divider"></div>

  <!-- PILARES -->
  <section class="section">
    <div class="section-inner">
      <div class="fade-up">
        <div class="eyebrow">En resumen</div>
        <h2 class="section-title">Lo básico, sin letra pequeña</h2>
      </div>

      <div class="sec-grid fade-up delay-1">
        {pilares.map(([k, v]) => (
          <article class="sec-card">
            <div class="sec-tag">{k}</div>
            <p class="sec-desc">{v}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <div class="divider"></div>

  <FaqSection items={faqs} />

  <div class="divider"></div>

  <!-- SIGUIENTE PASO -->
  <section class="cta-section">
    <div class="cta-eyebrow fade-up">¿Más preguntas?</div>
    <h3 class="cta-title fade-up delay-1">
      Si tu equipo de IT necesita más detalle, <br><em>te lo contamos</em>
    </h3>
    <p class="cta-sub fade-up delay-2">
      Escríbenos y respondemos a tu evaluación de proveedor.
    </p>
    <div class="cta-actions fade-up delay-3">
      <a href="https://app.gmvsolutions.es/registro" class="btn-primary"
         data-cta data-cta-intent="registro" data-cta-location="footer" data-cta-label="Registrarme en REELEVO">
        Registrarme en REELEVO
      </a>
      <a href="mailto:hola@gmvsolutions.es" class="btn-ghost"
         data-cta data-cta-intent="contacto" data-cta-location="footer" data-cta-label="Consulta de seguridad">
        Hablar con nosotros →
      </a>
    </div>
  </section>

</BaseLayout>

<style>
  /* PILARES */
  .sec-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 24px;
    margin-top: 40px;
  }

  @media (max-width: 960px) {
    .sec-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 600px) {
    .sec-grid { grid-template-columns: 1fr; }
  }

  .sec-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 24px;
  }

  .sec-tag {
    font-family: 'DM Mono', monospace;
    font-size: .7rem;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--orange-ink);
    margin-bottom: 12px;
  }

  .sec-desc {
    font-size: .95rem;
    line-height: 1.65;
    color: var(--gray);
    margin: 0;
  }
</style>
