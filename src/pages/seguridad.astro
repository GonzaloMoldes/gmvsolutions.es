---
import BaseLayout from '../layouts/BaseLayout.astro';
import FaqSection from '../components/FaqSection.astro';
import { softwareApplicationSchema, faqPageSchema, type FaqItem } from '../lib/seo';
import Ilustracion from '../components/Ilustracion.astro';
import { getPagina, conNegritas, sinMarcas } from '../lib/contenido';

// Textos editables desde Sanity (Páginas de funcionalidad). Respaldo: src/data/paginas/seguridad.json.
const pagina = await getPagina('seguridad');

// Pagina deliberadamente sencilla: responde a las preguntas basicas de
// seguridad sin entrar en detalle tecnico (proveedores, cabeceras, nombres de
// roles, mecanismos internos). El detalle se da a quien lo pida por contacto.

const title = pagina.seo.title;
const description = pagina.seo.description;
const canonical = "https://www.gmvsolutions.es/seguridad/";

// Una sola lista alimenta el bloque visible y el FAQPage del head.
const faqs: FaqItem[] = pagina.faq.items.map(({ q, a }) => ({ q, a: sinMarcas(a) }));

const pageSchema = softwareApplicationSchema();
const schema = [pageSchema, faqPageSchema(faqs)];

const pilares = [
  ['Datos separados', 'Cada empresa accede solo a su información.'],
  ['Acceso por roles', 'Cada persona ve lo que necesita para su trabajo, y nada más.'],
  ['Alojamiento en la UE', 'Tus datos se guardan en la Unión Europea.'],
  ['RGPD', 'Exportación, baja y eliminación de datos desde el panel.'],
];
---

<BaseLayout title={title} description={description} canonical={canonical} schema={schema} activeNav="" pageType="capacidad">

  <!-- HERO -->
  <section class="page-hero">
    <div class="eyebrow fade-up">{pagina.hero.antetitulo}</div>
    <h1 class="fade-up delay-1">{pagina.hero.titulo}{pagina.hero.tituloDestacado && <> <br> <em>{pagina.hero.tituloDestacado}</em></>}</h1>
    <p class="fade-up delay-2" set:html={conNegritas(pagina.hero.texto)} />
    <div class="hero-cta fade-up delay-3" style="display:flex;gap:14px;justify-content:center;flex-wrap:wrap;">
      {pagina.hero.botones[0] && (
<a href={pagina.hero.botones[0].url} class="btn-primary"
         data-cta data-cta-intent="registro" data-cta-location="hero" data-cta-label="Registrarme en REELEVO">{pagina.hero.botones[0].texto}</a>
)}
      {pagina.hero.botones[1] && (
<a href={pagina.hero.botones[1].url} class="btn-ghost"
         data-cta data-cta-intent="contacto" data-cta-location="hero" data-cta-label="Consulta de seguridad">{pagina.hero.botones[1].texto}</a>
)}
    </div>
    <Ilustracion escena="seguridad" />
  </section>

  <div class="divider"></div>

  <!-- PILARES -->
  <section class="section">
    <div class="section-inner">
      <div class="fade-up">
        <div class="eyebrow">En resumen</div>
        <h2 class="section-title">Lo básico, sin letra pequeña</h2>
      </div>

      <div class="sec-grid fade-up delay-1">
        {pilares.map(([k, v]) => (
          <article class="sec-card">
            <div class="sec-tag">{k}</div>
            <p class="sec-desc">{v}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <div class="divider"></div>

  <FaqSection items={faqs} />

  <div class="divider"></div>

  <!-- SIGUIENTE PASO -->
  <section class="cta-section">
    <div class="cta-eyebrow fade-up">{pagina.ctaFinal.antetitulo}</div>
    <h3 class="cta-title fade-up delay-1">{pagina.ctaFinal.titulo}{pagina.ctaFinal.tituloDestacado && <> <br> <em>{pagina.ctaFinal.tituloDestacado}</em></>}</h3>
    <p class="cta-sub fade-up delay-2" set:html={conNegritas(pagina.ctaFinal.texto)} />
    <div class="cta-actions fade-up delay-3">
      {pagina.ctaFinal.botones[0] && (
<a href={pagina.ctaFinal.botones[0].url} class="btn-primary"
         data-cta data-cta-intent="registro" data-cta-location="footer" data-cta-label="Registrarme en REELEVO">{pagina.ctaFinal.botones[0].texto}</a>
)}
      {pagina.ctaFinal.botones[1] && (
<a href={pagina.ctaFinal.botones[1].url} class="btn-ghost"
         data-cta data-cta-intent="contacto" data-cta-location="footer" data-cta-label="Consulta de seguridad">{pagina.ctaFinal.botones[1].texto}</a>
)}
    </div>
  </section>

</BaseLayout>

<style>
  /* PILARES */
  .sec-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 24px;
    margin-top: 40px;
  }

  @media (max-width: 960px) {
    .sec-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 600px) {
    .sec-grid { grid-template-columns: 1fr; }
  }

  .sec-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 24px;
  }

  .sec-tag {
    font-family: 'DM Mono', monospace;
    font-size: .7rem;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--orange-ink);
    margin-bottom: 12px;
  }

  .sec-desc {
    font-size: .95rem;
    line-height: 1.65;
    color: var(--gray);
    margin: 0;
  }
</style>
