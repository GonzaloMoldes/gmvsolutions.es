---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = "Blog de documentación operativa industrial | REELEVO";
const description = "Artículos sobre onboarding software, gestión de competencias, procedimientos operativos estándar y transferencia de conocimiento en pymes industriales.";
const canonical = "https://www.gmvsolutions.es/blog/";

// Indice por intencion (S6-A2): los articulos se agrupan en clusters tematicos.
// Los datos ya no viven aqui: vienen de src/lib/blog.ts, el registro unico que
// comparten esta pagina, /sitemap.xml y /llms.txt. Anadir un articulo alli lo
// publica en los tres sitios a la vez.
import { clusters, posts as articles } from '../../lib/blog';

const schema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "headline": "Blog de REELEVO",
  "description": description,
  "url": canonical,
  "about": clusters.map((c) => c.label),
  "author": { "@type": "Organization", "name": "REELEVO" }
};
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  schema={schema}
  activeNav="blog"
  pageType="blog"
>
  <!-- PAGE HERO -->
  <section class="page-hero">
    <div class="eyebrow fade-up">Blog de REELEVO</div>
    <h1 class="fade-up delay-1">Guías, análisis y recursos<br><em>sobre documentación operativa</em></h1>
    <p class="fade-up delay-2">Artículos especializados para pymes industriales, organizados por intención: SOP, onboarding, competencias y conocimiento, y absentismo.</p>
    <nav class="blog-index fade-up delay-3" aria-label="Índice por tema">
      {clusters.map((c) => (
        <a href={`#${c.key}`} class="blog-index__link">{c.label}</a>
      ))}
    </nav>
  </section>

  <div class="divider"></div>

  <!-- ARTÍCULOS POR INTENCIÓN -->
  {clusters.map((c) => (
    <section class="section" id={c.key}>
      <div class="section-inner">
        <div class="fade-up">
          <div class="eyebrow">Tema</div>
          <h2 class="section-title">{c.label}</h2>
        </div>
        <div class="articles-grid fade-up delay-1">
          {articles.filter((a) => a.cluster === c.key).map((a) => (
            <a href={`/blog/${a.slug}/`} class="article-card">
              <div class="article-card-category">{a.category}</div>
              <h3 class="article-card-title">{a.title}</h3>
              <p class="article-card-desc">{a.desc}</p>
              <div class="article-card-meta">
                <span>{a.dateLabel}</span>
                <span>·</span>
                <span>⏱️ {a.readTime}</span>
              </div>
              <div class="article-card-link">Leer artículo →</div>
            </a>
          ))}
        </div>
      </div>
    </section>
  ))}

  <div class="divider"></div>

  <!-- CTA -->
  <section class="cta-section">
    <div class="cta-eyebrow fade-up">¿Preguntas?</div>
    <h3 class="cta-title fade-up delay-1">
      Hablemos de tu <em>documentación operativa</em>
    </h3>
    <p class="cta-sub fade-up delay-2">
      Cada empresa tiene sus propios retos. Cuéntanos tu caso
      y te ayudamos a encontrar la mejor solución.
    </p>
    <div class="cta-actions fade-up delay-3">
      <a href="https://app.gmvsolutions.es/registro" class="btn-primary"
         data-cta data-cta-intent="registro" data-cta-location="footer" data-cta-label="Registrarse en REELEVO">
        Registrarse en REELEVO
      </a>
    </div>
    <div class="cta-note fade-up delay-4">
      Precio publicado · Soporte en español
    </div>
  </section>

</BaseLayout>

<style>
  /* Indice por intencion */
  .blog-index {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    margin-top: 28px;
  }
  .blog-index__link {
    font-family: 'DM Mono', monospace;
    font-size: .68rem;
    letter-spacing: .06em;
    text-transform: uppercase;
    color: var(--gray);
    text-decoration: none;
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 8px 16px;
    transition: border-color .2s, color .2s;
  }
  .blog-index__link:hover {
    border-color: var(--orange);
    color: var(--orange);
  }

  /* Articles grid */
  .articles-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    margin-top: 40px;
  }

  .article-card {
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 32px 28px;
    text-decoration: none;
    color: inherit;
    transition: border-color .25s;
  }

  .article-card:hover {
    border-color: var(--border-hover);
  }

  .article-card-category {
    font-family: 'DM Mono', monospace;
    font-size: .6rem;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: var(--orange);
    margin-bottom: 12px;
  }

  .article-card-title {
    font-family: 'Oswald', sans-serif;
    font-size: 1.05rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: .02em;
    margin-bottom: 12px;
    line-height: 1.2;
  }

  .article-card-desc {
    font-size: .88rem;
    color: var(--gray);
    line-height: 1.65;
    margin-bottom: 20px;
    flex: 1;
  }

  .article-card-meta {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: .75rem;
    color: var(--gray2);
    margin-bottom: 20px;
  }

  .article-card-link {
    font-family: 'DM Mono', monospace;
    font-size: .7rem;
    letter-spacing: .08em;
    color: var(--orange);
    text-transform: uppercase;
  }

  @media (max-width: 900px) {
    .articles-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
