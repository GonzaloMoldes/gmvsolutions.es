const canonical = "https://gmvsolutions.es/blog/onboarding-vs-tradicional/";

// FAQPage extra: se fusiona con el BlogPosting que emite ArticleLayout.
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "¿Es siempre mejor un onboarding software que el método tradicional?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. Si incorporas a una o dos personas al año, tienes plantilla estable y los procesos son sencillos, el acompañamiento de un veterano funciona y es más barato. El software gana cuando hay rotación, personal temporal, varios turnos o procesos donde un error sale caro. La decisión depende del escenario, no de la tecnología."
      }
    },
    {
      "@type": "Question",
      "name": "¿El onboarding software sustituye al operario que tutoriza?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No lo sustituye: le cambia el papel. En lugar de explicar cada paso desde cero en cada incorporación, el tutor verifica el resultado y resuelve lo que la documentación no cubre. El objetivo es que el veterano deje de ser el único canal por el que pasa el conocimiento, no que deje de participar."
      }
    },
    {
      "@type": "Question",
      "name": "¿Qué pasa con los procesos que nadie ha documentado nunca?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Ese es el trabajo real del proyecto, y conviene no subestimarlo. La forma rápida es grabar en vídeo al operario experto ejecutando el proceso y convertir esa grabación en pasos, en lugar de pedirle que escriba un manual. Se empieza por los dos o tres puestos con más rotación o más reprocesos, no por toda la planta."
      }
    },
    {
      "@type": "Question",
      "name": "¿Cómo se mide si el cambio ha funcionado?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Con tres datos que puedes tomar antes de empezar: cuántos días tarda una persona nueva en trabajar sin supervisión, cuántas horas del tutor consume cada incorporación y cuántos errores o reprocesos aparecen en las primeras semanas. Si no mides el punto de partida, cualquier mejora posterior es una impresión, no un dato."
      }
    }
  ]
};
