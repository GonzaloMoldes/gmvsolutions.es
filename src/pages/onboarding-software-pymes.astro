---
import BaseLayout from '../layouts/BaseLayout.astro';
import FaqSection from '../components/FaqSection.astro';
import { faqPageSchema, type FaqItem } from '../lib/seo';

const title = "Onboarding software para pymes industriales | REELEVO";
const description = "Onboarding software especializado para pymes industriales. Reduce tiempo de aprendizaje, cubre bajas y documenta procesos. Implementación en 2 días.";
// Era la unica pagina sin canonical explicito: heredaba el dominio del `site` de
// astro.config, asi que al pasar el sitio a www se quedo apuntando al apex.
const canonical = "https://www.gmvsolutions.es/onboarding-software-pymes/";

// Una sola lista alimenta el bloque visible y el FAQPage del head (auditoria P6).
const faqs: FaqItem[] = [
  {
    q: '¿Qué es un onboarding software para planta?',
    a: 'Es la herramienta que ordena la incorporación de un operario: le da el proceso documentado en el puesto desde el primer día y registra qué ha ejecutado y con qué autonomía. Se diferencia de un software de RRHH en que no se queda en el papeleo del alta, sino que llega a la máquina.',
  },
  {
    q: '¿Sustituye al operario que tutoriza?',
    a: 'No, le cambia el papel. En lugar de explicar cada paso desde cero en cada incorporación, el tutor verifica el resultado y resuelve lo que la documentación no cubre. El objetivo es que el conocimiento deje de pasar por una sola persona, no prescindir de ella.',
  },
  {
    q: '¿A partir de qué tamaño de plantilla compensa?',
    a: 'Más que el tamaño, decide la rotación. Una planta de 15 personas que incorpora a alguien cada mes o trabaja con ETT lo aprovecha más que una de 60 con plantilla estable. La pregunta útil es cuántas horas de tu mejor operario se van en tutorizar cada alta.',
  },
  {
    q: '¿Cuánto se tarda en ponerlo en marcha?',
    a: 'La configuración técnica es de un día al ser SaaS. El plazo real lo marca documentar los procesos de los puestos por los que más gente pasa: empezando por dos o tres, la primera incorporación puede arrancar con el proceso en el puesto en un par de semanas.',
  },
];

const pageSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "REELEVO - Onboarding Software",
  "description": description,
  "url": "https://www.gmvsolutions.es/onboarding-software-pymes/",
  "applicationCategory": "BusinessApplication",
  "offers": {
    "@type": "Offer",
    "price": "49",
    "priceCurrency": "EUR",
    "priceValidUntil": "2026-12-31"
  }
};

const schema = [pageSchema, faqPageSchema(faqs)];
---

<BaseLayout title={title} description={description} canonical={canonical} schema={schema} activeNav="" pageType="landing">
  <!-- PAGE HERO -->
  <section class="page-hero">
    <div class="eyebrow fade-up">Onboarding Software Especializado</div>
    <h1 class="fade-up delay-1">Onboarding software<br><em>para pymes industriales</em></h1>
    <p class="fade-up delay-2">Deja de estimar cuánto tarda un operario nuevo en ir solo: lo ves paso a paso. Cubre bajas sin llamar al experto y documenta los procedimientos en el puesto.</p>
    <div class="hero-cta fade-up delay-3">
      <a href="https://app.gmvsolutions.es/registro" class="btn-primary"
         data-cta data-cta-intent="registro" data-cta-location="hero" data-cta-trigger="05" data-cta-label="Registrarse gratis">Registrarse gratis</a>
    </div>
  </section>

  <div class="divider"></div>

  <!-- PROBLEMA -->
  <section class="section">
    <div class="section-inner">
      <div class="fade-up">
        <div class="eyebrow">El problema</div>
        <h2 class="section-title">Onboarding operarios: El coste oculto</h2>
      </div>

      <div class="problem-grid fade-up delay-1">
        <div class="problem-card">
          <div class="problem-icon">⏱️</div>
          <h3>Tiempo de aprendizaje</h3>
          <p>Un operario nuevo tarda 2-4 semanas en aprender sin dependencia del tutor. En ese tiempo, produce al 60% de capacidad.</p>
        </div>

        <div class="problem-card">
          <div class="problem-icon">📞</div>
          <h3>Dependencia del tutor</h3>
          <p>El operario experto deja de producir para enseñar. Resultando en dos personas al 50% en lugar de una al 100%.</p>
        </div>

        <div class="problem-card">
          <div class="problem-icon">❌</div>
          <h3>Errores frecuentes</h3>
          <p>Sin instrucciones claras en el puesto, la incorporación decide por criterio propio en sus primeros días. De ahí salen defectos y reprocesos que nadie atribuye al onboarding.</p>
        </div>

        <div class="problem-card">
          <div class="problem-icon">💼</div>
          <h3>Personal ETT</h3>
          <p>Si usas personal temporal, cada cambio requiere el mismo ciclo de aprendizaje. Costo multiplicado por cada incorporación.</p>
        </div>
      </div>

      <div class="cost-analysis fade-up delay-2">
        <h3>¿Cuánto cuesta un mal onboarding?</h3>
        <div class="cost-calc">
          <p>Haz el cálculo con una planta tipo de 40 empleados y un 7,2 % de absentismo. Los dos primeros datos salen de la encuesta; el resto es aritmética, y los supuestos están a la vista para que puedas cambiarlos por los tuyos:</p>
          <ul>
            <li><strong>3,2 horas</strong> de producción perdida por cada baja de operario clave <span style="color:var(--gray2);">— Encuesta REELEVO 2025</span></li>
            <li><strong>150-300 €/hora</strong> de coste de línea parada <span style="color:var(--gray2);">— Encuesta REELEVO 2025</span></li>
            <li><strong>480-960 €</strong> por baja no cubierta <span style="color:var(--gray2);">— cálculo: 3,2 h × el coste/hora anterior</span></li>
            <li><strong>38.000-76.000 €/año</strong> <span style="color:var(--gray2);">— cálculo: lo anterior × 79 bajas de operario clave al año, que es lo que sale con esa plantilla y ese absentismo</span></li>
          </ul>
          <p class="highlight-box">Cambia las horas o el coste/hora por los de tu planta y el resultado se mueve mucho. Ese es el número que te interesa, no el del ejemplo. Y no incluye errores de calidad, reprocesos ni deterioro del equipo.</p>
          <p style="margin-top:16px;font-size:.78rem;color:var(--gray2);line-height:1.6;">Fuente de los datos de partida: Encuesta REELEVO 2025 sobre dependencia operativa en pymes industriales españolas (n=347, empresas de 10-200 empleados del sector manufacturero). Las dos últimas cifras son un cálculo derivado, no un dato observado.</p>
        </div>
      </div>
    </div>
  </section>

  <div class="divider"></div>

  <!-- SOLUCIÓN -->
  <section class="section">
    <div class="section-inner">
      <div class="fade-up">
        <div class="eyebrow">La solución</div>
        <h2 class="section-title">Onboarding acelerado con REELEVO</h2>
      </div>

      <div class="solution-features fade-up delay-1">
        <div class="feature-card">
          <div class="feature-num">1</div>
          <h3>Documentación paso a paso</h3>
          <p>Cada operario documenta su proceso mientras lo ejecuta. No manuales de 50 páginas: procedimientos reales, accesibles en la máquina.</p>
        </div>

        <div class="feature-card">
          <div class="feature-num">2</div>
          <h3>Acceso en el puesto</h3>
          <p>Los nuevos operarios consultan el procedimiento directamente en la máquina. No hay que buscar archivos ni hacer preguntas al tutor.</p>
        </div>

        <div class="feature-card">
          <div class="feature-num">3</div>
          <h3>Aprendizaje sin tutor</h3>
          <p>El operario nuevo sigue los pasos documentados y trabaja independientemente. El experto solo revisa el resultado, no invierte horas de enseñanza.</p>
        </div>

        <div class="feature-card">
          <div class="feature-num">4</div>
          <h3>Cobertura de bajas</h3>
          <p>Cuando el experto falta, el sustituto accede al procedimiento completo y puede arrancar sin esperar a que alguien coja el teléfono.</p>
        </div>

        <div class="feature-card">
          <div class="feature-num">5</div>
          <h3>Gestión de competencias</h3>
          <p>Matriz de habilidades integrada. Sabes quién puede cubrir cada puesto. No dependes de una sola persona.</p>
        </div>

        <div class="feature-card">
          <div class="feature-num">6</div>
          <h3>100% en español</h3>
          <p>Interfaz, procedimientos y soporte en español. Diseñado para operarios hispanohablantes, no traducido del inglés.</p>
        </div>
      </div>
    </div>
  </section>

  <div class="divider"></div>

  <!-- RESULTADOS -->
  <section class="section">
    <div class="section-inner">
      <!-- Este bloque se titulaba "Resultados medidos" y ninguna de sus cifras
           (-70%, -80%, "se paga en 1-2 meses") estaba medida en ningun cliente.
           Se sustituye por el cambio operativo real, que si se puede sostener.
           Regla: PLAN_CORRECCIONES_WEB_VS_APP_2026-08.md, Anexo III. -->
      <div class="fade-up">
        <div class="eyebrow">Qué cambia</div>
        <h2 class="section-title">Qué cambia cuando el procedimiento está en el puesto</h2>
      </div>

      <div class="results-comparison fade-up delay-1">
        <div class="result-metric">
          <div class="metric-title">Cómo aprende una incorporación</div>
          <div class="metric-before">
            <span class="label">Antes</span>
            <span class="value">Depende de quién le enseñe y de cuándo pueda</span>
          </div>
          <div class="metric-arrow">→</div>
          <div class="metric-after">
            <span class="label">Con REELEVO</span>
            <span class="value">Avanza con la guía delante y el tutor verifica</span>
          </div>
        </div>

        <div class="result-metric">
          <div class="metric-title">Cuando falta el titular del puesto</div>
          <div class="metric-before">
            <span class="label">Antes</span>
            <span class="value">Se llama al experto, esté donde esté</span>
          </div>
          <div class="metric-arrow">→</div>
          <div class="metric-after">
            <span class="label">Con REELEVO</span>
            <span class="value">El sustituto abre el proceso y arranca</span>
          </div>
        </div>

        <div class="result-metric">
          <div class="metric-title">El tiempo del que enseña</div>
          <div class="metric-before">
            <span class="label">Antes</span>
            <span class="value">Uno de tus mejores operarios, fuera de su máquina</span>
          </div>
          <div class="metric-arrow">→</div>
          <div class="metric-after">
            <span class="label">Con REELEVO</span>
            <span class="value">Acompaña en los pasos críticos, no en todos</span>
          </div>
        </div>

        <div class="result-metric">
          <div class="metric-title">Lo que queda del turno</div>
          <div class="metric-before">
            <span class="label">Antes</span>
            <span class="value">Lo que alguien recuerde en la reunión del día siguiente</span>
          </div>
          <div class="metric-arrow">→</div>
          <div class="metric-after">
            <span class="label">Con REELEVO</span>
            <span class="value">Quién lo hizo, cuándo y con qué resultado</span>
          </div>
        </div>
      </div>

      <p class="results-note fade-up delay-2">
        Son los cambios operativos que produce la herramienta. No publicamos porcentajes de mejora
        ni ROI medio porque todavía no tenemos una base de clientes que los respalde: el día que la
        tengamos, los publicaremos diciendo de dónde salen.
      </p>
    </div>
  </section>

  <div class="divider"></div>

  <!-- CÓMO FUNCIONA -->
  <section class="section">
    <div class="section-inner">
      <div class="fade-up">
        <div class="eyebrow">Implementación simple</div>
        <h2 class="section-title">Cómo funciona en 3 pasos</h2>
      </div>

      <div class="steps fade-up delay-1">
        <div class="step">
          <div class="step-number">1</div>
          <div class="step-content">
            <h3>Registrate (5 min)</h3>
            <p>Crear cuenta en REELEVO. Sin tarjeta requerida. Acceso inmediato.</p>
          </div>
        </div>

        <div class="step">
          <div class="step-number">2</div>
          <div class="step-content">
            <h3>Documenta procesos (1 día)</h3>
            <p>Tus operarios documentan cada máquina: pasos, ajustes, troubleshooting. El app los guía.</p>
          </div>
        </div>

        <div class="step">
          <div class="step-number">3</div>
          <div class="step-content">
            <h3>Comparte en planta (inmediato)</h3>
            <p>Los nuevos operarios ven los procedimientos en el puesto. Trabajan independientemente desde el primer día.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <div class="divider"></div>

  <!-- SECTORES (no son clientes: es el encaje del producto) -->
  <section class="section">
    <div class="section-inner">
      <div class="fade-up">
        <div class="eyebrow">Para qué sectores</div>
        <h2 class="section-title">Sectores para los que está diseñado</h2>
      </div>

      <div class="sectors-grid fade-up delay-1">
        <div class="sector-badge">🚗 Automoción</div>
        <div class="sector-badge">🍕 Alimentación</div>
        <div class="sector-badge">⚙️ Mecanizado CNC</div>
        <div class="sector-badge">🔧 Metal y mecánica</div>
        <div class="sector-badge">🏭 Plástico</div>
        <div class="sector-badge">⚡ Electrónica</div>
      </div>
    </div>
  </section>

  <div class="divider"></div>

  <!-- PRECIOS -->
  <!-- Las tarjetas de plan viven SOLO en /precios/. Aqui habia una segunda tabla
       con datos obsoletos (79 EUR, "acceso 1 operario", "maquinas ilimitadas") que
       contradecia a /precios/ y al propio producto. Una sola pagina es duena del
       precio: si vuelve a hacer falta el dato aqui, se enlaza, no se duplica. -->
  <section class="section section-center">
    <div class="section-inner">
      <div class="fade-up">
        <div class="eyebrow">Transparente y simple</div>
        <h2 class="section-title">Precio publicado, por empresa</h2>
        <p class="section-sub">
          Desde 49 €/mes por empresa, sin licencia por usuario y con el precio visible
          antes de hablar con nadie. Los planes suben según las capacidades que necesitas,
          no según cuánta gente lo usa.
        </p>
      </div>

      <div class="fade-up delay-1" style="margin-top:32px;">
        <a href="/precios/" class="btn-primary"
           data-cta data-cta-intent="precios" data-cta-location="body" data-cta-label="Ver planes y precios">Ver planes y precios →</a>
      </div>
    </div>
  </section>

  <div class="divider"></div>

  <!-- CTA FINAL -->
  <FaqSection items={faqs} />

  <div class="divider"></div>

  <section class="cta-section">
    <div class="cta-eyebrow fade-up">Empieza por el primer día</div>
    <h2 class="cta-title fade-up delay-1">
      Comienza tu onboarding <em>sin montar un proyecto eterno</em>
    </h2>
    <p class="cta-sub fade-up delay-2">
      Abre la puerta con una primera prueba y mira cómo baja la fricción cuando el equipo aprende con materiales que sí usa.
    </p>
    <div class="cta-actions fade-up delay-3">
      <a href="https://app.gmvsolutions.es/registro" class="btn-primary"
         data-cta data-cta-intent="registro" data-cta-location="footer" data-cta-trigger="05" data-cta-label="Registrarse gratis">
        Registrarse gratis
      </a>
      <a href="/precios/" class="btn-ghost">
        Ver cómo arrancar →
      </a>
    </div>
  </section>

</BaseLayout>

<style>
  .problem-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
    margin-top: 40px;
  }

  .problem-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 24px;
    text-align: center;
  }

  .problem-icon {
    font-size: 2.5rem;
    margin-bottom: 12px;
  }

  .problem-card h3 {
    font-size: 1rem;
    margin-bottom: 12px;
    font-family: 'Oswald', sans-serif;
  }

  .problem-card p {
    font-size: 0.9rem;
    color: var(--gray);
    line-height: 1.5;
  }

  .cost-analysis {
    background: rgba(255, 100, 0, 0.08);
    border: 1px solid rgba(255, 150, 0, 0.3);
    border-radius: 6px;
    padding: 32px;
    margin-top: 32px;
  }

  .cost-calc {
    font-size: 0.95rem;
    line-height: 1.7;
  }

  .cost-calc ul {
    list-style: none;
    padding: 16px 0;
    margin: 16px 0;
  }

  .cost-calc li {
    padding: 8px 0;
    color: var(--text);
  }

  .cost-calc li strong {
    color: var(--orange);
  }

  .highlight-box {
    background: rgba(255, 150, 0, 0.15);
    padding: 12px 16px;
    border-left: 3px solid var(--orange);
    margin-top: 16px;
    font-size: 0.9rem;
    color: var(--text);
  }

  .solution-features {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
    margin-top: 40px;
  }

  .feature-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 28px;
  }

  .feature-num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    background: var(--orange);
    color: white;
    border-radius: 50%;
    font-weight: 600;
    font-size: 1.1rem;
    margin-bottom: 16px;
  }

  .feature-card h3 {
    font-family: 'Oswald', sans-serif;
    font-size: 1rem;
    margin-bottom: 12px;
  }

  .feature-card p {
    font-size: 0.9rem;
    color: var(--gray);
    line-height: 1.6;
  }

  .results-comparison {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
    margin-top: 40px;
  }

  .result-metric {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .metric-title {
    font-family: 'Oswald', sans-serif;
    font-size: 0.95rem;
    font-weight: 600;
  }

  .metric-before,
  .metric-after {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .metric-arrow {
    text-align: center;
    color: var(--orange);
    font-weight: 600;
  }

  .label {
    font-size: 0.75rem;
    text-transform: uppercase;
    color: var(--gray2);
    letter-spacing: 0.05em;
  }

  /* Antes eran cifras sueltas ("3-5 días") a 1.3rem. Ahora son frases, asi que
     baja el cuerpo y entra interlineado: a 1.3rem una frase de linea y media
     competia con el titulo de la tarjeta. */
  .value {
    font-size: 0.95rem;
    font-weight: 500;
    line-height: 1.5;
    color: var(--text);
  }

  .metric-after .value {
    color: var(--white);
  }

  .results-note {
    max-width: 760px;
    margin-top: 24px;
    font-size: 0.85rem;
    line-height: 1.65;
    color: var(--gray2);
  }

  .steps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
    margin-top: 40px;
  }

  .step {
    text-align: center;
  }

  .step-number {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 60px;
    height: 60px;
    background: var(--orange);
    color: white;
    border-radius: 50%;
    font-size: 1.8rem;
    font-weight: 600;
    margin-bottom: 20px;
  }

  .step h3 {
    font-family: 'Oswald', sans-serif;
    margin-bottom: 12px;
  }

  .step p {
    color: var(--gray);
    font-size: 0.9rem;
    line-height: 1.6;
  }

  .sectors-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    margin-top: 40px;
  }

  .sector-badge {
    background: var(--surface);
    border: 1px solid var(--border);
    padding: 16px;
    border-radius: 6px;
    text-align: center;
    font-weight: 500;
    font-size: 0.95rem;
  }

  @media (max-width: 900px) {
    .problem-grid,
    .solution-features,
    .results-comparison,
    .sectors-grid {
      grid-template-columns: 1fr;
    }

    .steps {
      grid-template-columns: 1fr;
    }
  }
</style>
