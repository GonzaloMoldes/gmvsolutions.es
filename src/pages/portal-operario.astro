---
import Icon from '../components/Icon.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import FaqSection from '../components/FaqSection.astro';
import { softwareApplicationSchema, faqPageSchema, type FaqItem } from '../lib/seo';

const title = "Portal del operario: procesos y agenda en el móvil | REELEVO";
const description = "El operario ve su agenda del día, accede a sus procesos y sigue su progreso de formación desde el móvil. Sin instalación ni formación previa.";
const canonical = "https://www.gmvsolutions.es/portal-operario/";

// Una sola lista alimenta el bloque visible y el FAQPage del head (auditoria P6).
//
// La quinta pregunta recoge el portal del jefe de turno, que antes era una
// seccion de 4 tarjetas (193 palabras) al final de la pagina (tarea C1 de
// PLAN_SIMPLIFICACION_EDITORIAL_WEB_2026-08.md).
const faqs: FaqItem[] = [
  {
    q: '¿Qué ve el operario en su portal?',
    a: 'Su agenda del día, los procesos que le tocan con sus instrucciones, su progreso de formación y el estado de las mejoras que haya propuesto. La idea es que llegue al puesto sabiendo qué hacer sin tener que preguntar ni esperar a que alguien tenga un rato.',
  },
  {
    q: '¿El operario necesita una cuenta y una contraseña?',
    a: 'No para acceder al proceso en el puesto: basta con escanear el QR de la máquina desde el móvil. Evitar cuentas y contraseñas es deliberado, porque es donde se cae la adopción con personal temporal o con plantilla poco habituada a herramientas digitales.',
  },
  {
    q: '¿Funciona en el móvil personal del operario?',
    a: 'Sí, se accede desde el navegador sin instalar nada. También funciona en tablets compartidas por puesto, que es lo que prefieren algunas plantas cuando no quieren depender del móvil personal de nadie.',
  },
  {
    q: '¿Y si el operario no tiene soltura con la tecnología?',
    a: 'Por eso el acceso es escanear un código y ver fotos y vídeo del paso, no navegar por menús. La prueba de si una herramienta de planta está bien diseñada es si alguien puede usarla en su primer turno sin que nadie le enseñe.',
  },
  {
    q: '¿El jefe de turno usa el mismo portal que el operario?',
    a: 'No, tiene el suyo, y tampoco es el panel de dirección: un jefe de línea necesita despachar lo suyo en cinco minutos desde donde esté. En su bandeja le caen las ejecuciones pendientes de firma, los pasos que exigen visto bueno —el operario no sigue hasta que alguien responde—, las rutas de aprendizaje en curso y los avisos automáticos de procesos con anomalías o piezas sin lote.',
  },
];

const pageSchema = softwareApplicationSchema();

const schema = [pageSchema, faqPageSchema(faqs)];
---

<BaseLayout title={title} description={description} canonical={canonical} schema={schema} activeNav="casos-de-uso" pageType="capacidad">

  <!-- HERO + PROBLEMA -->
  <section class="page-hero">
    <div class="eyebrow fade-up">Portal del operario industrial</div>
    <h1 class="fade-up delay-1">El operario no necesita <br><em>que nadie le diga qué toca hoy</em></h1>
    <p class="fade-up delay-2">Un operario sin contexto depende siempre del encargado: pregunta qué toca, espera a que alguien tenga un rato y trabaja sin saber si va bien. Con REELEVO su agenda está en el móvil, sus procesos en el QR y su progreso a la vista. Sin formación previa y sin contraseñas complicadas.</p>
    <div class="hero-cta fade-up delay-3" style="display:flex;gap:14px;justify-content:center;flex-wrap:wrap;">
      <a href="https://app.gmvsolutions.es/registro" class="btn-primary"
         data-cta data-cta-intent="registro" data-cta-location="hero" data-cta-trigger="09" data-cta-label="Registrarme en REELEVO">Registrarme en REELEVO</a>
      <a href="/video-demo/" class="btn-ghost"
         data-cta data-cta-intent="navegacion" data-cta-location="hero" data-cta-label="Ver el demo">Ver el demo →</a>
    </div>
  </section>

  <div class="divider"></div>

  <!-- EL PORTAL — bloque dominante -->
  <section class="section">
    <div class="section-inner">
      <div class="fade-up">
        <div class="eyebrow">El portal del operario</div>
        <h2 class="section-title">Todo lo que el operario necesita — en su móvil</h2>
        <p class="section-sub">Es su vista personal de REELEVO, el <a href="/documentacion-procesos/">software de instrucciones de trabajo digitales</a>: se abre desde el móvil, en el puesto, sin ir al ordenador de oficina ni pedirle nada a nadie.</p>
      </div>

      <div class="portal-sections fade-up delay-1">
        <div class="portal-card">
          <div class="portal-num">1</div>
          <div class="portal-content">
            <h3>Agenda del día</h3>
            <p>Todas las tareas asignadas para hoy: qué proceso, en qué máquina y a qué hora. Producción y mantenimiento en la misma lista, no en dos sistemas.</p>
            <div class="portal-route">/operario/agenda</div>
          </div>
        </div>

        <div class="portal-card">
          <div class="portal-num">2</div>
          <div class="portal-content">
            <h3>Mis procesos y mi nivel</h3>
            <p>Los procesos disponibles con su nivel de competencia en cada uno: en qué está certificado, en qué está formándose y qué le falta. Con sus certificaciones y su fecha.</p>
            <div class="portal-route">/operario/procesos · /operario/perfil</div>
          </div>
        </div>

        <div class="portal-card">
          <div class="portal-num">3</div>
          <div class="portal-content">
            <h3>Mi semana</h3>
            <p>Horas trabajadas, unidades producidas y procesos ejecutados. El operario ve su propio rendimiento sin depender de que alguien se lo cuente.</p>
            <div class="portal-route">/operario/mi-semana</div>
          </div>
        </div>

        <div class="portal-card highlight-card">
          <div class="portal-num">4</div>
          <div class="portal-content">
            <h3>Contribuciones y recompensas</h3>
            <p>Propone una mejora desde el móvil y ve qué pasa con ella: implementada, en revisión o descartada. Gana puntos por propuesta Kaizen implementada, contribución validada o nota votada como útil por sus compañeros, y la empresa puede asociar una recompensa económica configurable.</p>
            <div class="portal-route">/operario/mis-contribuciones · /operario/recompensas</div>
          </div>
        </div>

        <div class="portal-card highlight-card">
          <div class="portal-num">5</div>
          <div class="portal-content">
            <h3>Pedir el procedimiento que falta</h3>
            <p>Cuando se encuentra una tarea sin proceso documentado, en vez de llamar al encargado la solicita desde su propio portal y queda registrada.</p>
            <div class="portal-route">/empresa/solicitudes</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <div class="divider"></div>

  <!-- CÓMO SE ACCEDE -->
  <section class="section">
    <div class="section-inner">
      <div class="fade-up">
        <div class="eyebrow">Acceso sin fricción</div>
        <h2 class="section-title">Diseñado para operarios — no para usuarios de ordenador</h2>
      </div>

      <div class="access-grid fade-up delay-1">
        <div class="access-card">
          <Icon name="movil" class="access-icon" />
          <h3>Cualquier móvil, sin aplicación</h3>
          <p>Es una web progresiva (PWA) que corre en el navegador de cualquier smartphone, también de los antiguos. Instalable en la pantalla de inicio sin pasar por App Store ni Google Play.</p>
        </div>

        <div class="access-card">
          <Icon name="conexion" class="access-icon" />
          <h3>Aguanta los cortes de wifi</h3>
          <p>Si la señal cae a mitad de un proceso, el operario sigue con lo que tenía abierto. Lo que registra se guarda en el dispositivo y se sincroniza al volver la cobertura.</p>
        </div>

        <div class="access-card">
          <Icon name="llave" class="access-icon" />
          <h3>Sin contraseñas complicadas</h3>
          <p>Se entra desde el QR del puesto o con credenciales simples. Es donde se cae la adopción con personal temporal, así que es donde menos fricción hemos dejado.</p>
        </div>
      </div>

      <p class="roles-line fade-up delay-2">Relacionado: <a href="/modo-offline/">modo offline y PWA</a> · <a href="/gestion-competencias/">gestión de competencias</a> · <a href="/kaizen/">ciclo Kaizen</a>.</p>
    </div>
  </section>

  <div class="divider"></div>

  <FaqSection items={faqs} />

  <div class="divider"></div>

  <!-- SIGUIENTE PASO -->
  <section class="cta-section">
    <div class="cta-eyebrow fade-up">El operario gana contexto</div>
    <h3 class="cta-title fade-up delay-1">
      Dale al operario su propio espacio <br><em>y la coordinación deja de ir a trompicones</em>
    </h3>
    <p class="cta-sub fade-up delay-2">
      Empieza por un puesto y un proceso. Si el operario llega y sabe qué hacer sin preguntar, ya has notado la diferencia.
    </p>
    <div class="cta-actions fade-up delay-3">
      <a href="https://app.gmvsolutions.es/registro" class="btn-primary"
         data-cta data-cta-intent="registro" data-cta-location="footer" data-cta-trigger="09" data-cta-label="Registrarme en REELEVO">
        Registrarme en REELEVO
      </a>
      <a href="/gestion-competencias/" class="btn-ghost">
        Ver gestión de competencias →
      </a>
    </div>
    <div class="cta-trust fade-up delay-4">Te acompañamos en la puesta en marcha · Sin compromiso y con foco práctico</div>
  </section>

</BaseLayout>

<style>
  /* EL PORTAL — bloque dominante */
  .portal-sections {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin-top: 48px;
    max-width: 760px;
  }

  .portal-card {
    display: flex;
    gap: 20px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 24px;
    align-items: flex-start;
  }

  .portal-card.highlight-card {
    border-color: var(--orange);
    background: rgba(255, 100, 0, 0.04);
  }

  .portal-num {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    min-width: 38px;
    background: var(--orange);
    color: #fff;
    border-radius: 50%;
    font-family: 'Oswald', sans-serif;
    font-size: 1rem;
    font-weight: 600;
  }

  .portal-content h3 {
    font-family: 'Oswald', sans-serif;
    font-size: 1rem;
    margin-bottom: 8px;
    color: var(--white);
  }

  .portal-content p {
    color: var(--gray);
    font-size: .95rem;
    line-height: 1.65;
    margin: 0 0 10px;
  }

  .portal-route {
    font-family: 'DM Mono', monospace;
    font-size: 0.78rem;
    color: rgba(255, 100, 0, 0.7);
    background: rgba(255, 100, 0, 0.07);
    border: 1px solid rgba(255, 100, 0, 0.15);
    padding: 3px 8px;
    border-radius: 3px;
    display: inline-block;
  }

  /* ACCESO */
  .access-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
    margin-top: 40px;
  }

  @media (max-width: 860px) {
    .access-grid { grid-template-columns: 1fr; }
  }

  .access-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 24px;
  }

  .access-icon { margin-bottom: 12px; }

  .access-card h3 {
    font-family: 'Oswald', sans-serif;
    font-size: 1rem;
    margin-bottom: 10px;
    color: var(--white);
  }

  .access-card p {
    font-size: .95rem;
    color: var(--gray);
    line-height: 1.65;
    margin: 0;
  }

  .roles-line {
    margin-top: 28px;
    font-size: .95rem;
    color: var(--gray);
  }

  .roles-line a {
    color: var(--orange);
    text-decoration: none;
    border-bottom: 1px solid rgba(244, 82, 30, .35);
  }

  .roles-line a:hover {
    border-bottom-color: var(--orange);
  }

  .cta-trust {
    margin-top: 16px;
    font-size: 0.82rem;
    color: rgba(255, 255, 255, 0.45);
    letter-spacing: .04em;
  }
</style>
