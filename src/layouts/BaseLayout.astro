---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import GaliciaSeal from '../components/GaliciaSeal.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import NewsletterModal from '../components/NewsletterModal.astro';
import { organizationSchema, buildBreadcrumb, BASE_URL } from '../lib/seo';
import '../styles/global.css';
import entryLogo from '../../reelevo-brand-logo-transparent-shadow.png';
import { getImage } from 'astro:assets';

export interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  activeNav?: string;
  schema?: object | object[];
  pageType?: string;
  noindex?: boolean;
  // og:type. "website" para todo el sitio; los articulos pasan "article", que es
  // lo que esperan las tarjetas sociales y los agregadores. No se deduce de
  // pageType porque /blog/ tambien es pageType "blog" y es un indice, no una pieza.
  ogType?: string;
  // ISO 8601. Solo tiene sentido junto a ogType="article".
  publishedTime?: string;
}

const {
  title,
  description,
  canonical = Astro.url.href,
  ogTitle = title,
  ogDescription = description,
  // og-default.jpg es la misma foto recortada a 1200x630, el tamano que piden
  // Open Graph y Twitter. factory-bg.jpg sigue existiendo a 2000px porque
  // global.css lo usa como fondo de .hero-bg.
  ogImage = 'https://www.gmvsolutions.es/og-default.jpg',
  activeNav,
  schema,
  pageType,
  noindex = false,
  ogType = 'website',
  publishedTime,
} = Astro.props;

// Schema sitewide (S1-C3): Organization en todas las paginas + BreadcrumbList
// generado automaticamente desde la ruta. La home omite breadcrumb.
const breadcrumbSchema = buildBreadcrumb(Astro.url.pathname);

// Version markdown de la pagina. Se anuncia con <link rel="alternate"
// type="text/markdown"> para que los agentes prefieran el texto limpio al HTML.
// Se genera aqui para TODO el sitio (auditoria P8); antes solo lo emitia
// ArticleLayout, asi que 45 paginas no ofrecian version markdown.
// La home va a /index.md porque /.md no es una URL valida.
const trimmed = canonical.replace(/\/$/, '');
const markdownUrl = trimmed === BASE_URL ? `${BASE_URL}/index.md` : `${trimmed}.md`;

// Modal de alta (newsletter + cuenta). Apagado por defecto: solo se renderiza
// cuando PUBLIC_NEWSLETTER_MODAL === 'on'. Asi el codigo puede desplegarse sin
// exponer el formulario hasta tener configuradas las credenciales en Vercel.
const showNewsletterModal = import.meta.env.PUBLIC_NEWSLETTER_MODAL === 'on';

// Logo del splash. Es el elemento que marca el First Contentful Paint, asi que
// el original (PNG de 1000x1000 y 54 KiB) para mostrarse a 300 px en movil era
// el mayor lastre de la primera pintura. Se sirve en WebP a 800 px: sigue
// sobrando resolucion para el zoom final (scale 5.6 sobre 300 px) y pesa una
// fraccion. Si se cambia el archivo de origen debe seguir siendo cuadrado.
const ENTRY_LOGO_SIZE = 800;
const entrySplashLogo = await getImage({
  src: entryLogo,
  width: ENTRY_LOGO_SIZE,
  height: ENTRY_LOGO_SIZE,
  format: 'webp',
  quality: 82,
});
---

<!doctype html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <!-- Preconnect a los origenes de la ruta critica. Va ANTES del primer script
       de terceros a proposito: uc.js de Cookiebot bloquea el renderizado 1,7 s
       y no puede pasarse a async (data-blockingmode="auto" exige que cargue
       sincrono y el primero, o deja de bloquear las cookies antes del
       consentimiento), asi que lo unico que se puede recortar es el coste de
       abrir la conexion. -->
  <link rel="preconnect" href="https://consent.cookiebot.com" crossorigin />
  <link rel="preconnect" href="https://consentcdn.cookiebot.com" crossorigin />
  <link rel="preconnect" href="https://www.googletagmanager.com" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="dns-prefetch" href="https://scripts.clarity.ms" />
  <link rel="dns-prefetch" href="https://egoi.site" />
  <link rel="icon" href="/favicon.ico" sizes="32x32" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

  <script is:inline>
    (() => {
      const root = document.documentElement;
      const splashKey = 'reelevo-entry-splash-seen';

      root.classList.add('entry-splash-booting');

      try {
        if (window.sessionStorage.getItem(splashKey) !== '1') {
          root.classList.add('show-entry-splash');
          window.sessionStorage.setItem(splashKey, '1');
        }
      } catch {
        root.classList.add('show-entry-splash');
      } finally {
        root.classList.remove('entry-splash-booting');
      }
    })();
  </script>

  <style is:inline>
    html,
    body {
      background: #000;
    }

    html.entry-splash-booting body {
      overflow: hidden;
    }

    html.show-entry-splash body {
      overflow: hidden;
    }

    /* El contenido NO se oculta con opacity/visibility mientras dura el splash.
       Chrome descarta como candidato a LCP cualquier elemento que tenga
       opacity:0 en el mismo o en un ancestro, asi que ocultar .site-shell
       retrasaba el LCP hasta que terminaba la animacion (11,5 s en movil,
       5.034 ms de "retraso de renderizado" con un TTFB de solo 121 ms).
       El splash ya es una capa opaca a pantalla completa con z-index:1000:
       tapa exactamente igual, pero deja que el hero pinte de verdad. La
       oclusion por otra capa no afecta al LCP, solo la transparencia.
       pointer-events + overflow:hidden + inert (lo pone el script del final
       del body) mantienen la pagina inerte mientras se ve el efecto. */
    html.entry-splash-booting .site-shell,
    html.show-entry-splash .site-shell {
      pointer-events: none !important;
    }

    html.entry-splash-booting .entry-splash {
      opacity: 0 !important;
      visibility: hidden !important;
      pointer-events: none !important;
    }

    html.show-entry-splash .entry-splash {
      opacity: 1 !important;
      visibility: visible !important;
      pointer-events: auto !important;
    }
  </style>

  <!-- Cookiebot -->
  <script id="Cookiebot" src="https://consent.cookiebot.com/uc.js" data-cbid="5739f0cd-fe41-422b-8b4c-a69d926cd3c0" data-blockingmode="auto" type="text/javascript"></script>
  
    <!-- Google Tag Manager -->
    <script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer','GTM-M223Z398');</script>
    <!-- End Google Tag Manager -->

  <!-- Google tag (gtag.js) — GA4 + Google Ads
       ID de GA4 del sitio: G-JJCZ6M3T8Y. Se carga AQUI y no desde GTM, a
       proposito: asi la medicion es verificable desde el repositorio y no
       depende del estado de un contenedor que no se puede revisar en el
       codigo. GTM sigue cargado para el resto de etiquetas.
       REGLA: G-JJCZ6M3T8Y debe tener UN solo cargador. Si algun dia se anade
       una etiqueta de configuracion de GA4 dentro de GTM, hay que quitar este
       bloque, o cada visita contara dos page_view. -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-JJCZ6M3T8Y"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-JJCZ6M3T8Y');
    gtag('config', 'AW-18000536518');
  </script>

  <!-- Microsoft Clarity -->
  <script is:inline type="text/javascript">
    (function(c,l,a,r,i,t,y){
        c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
        t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
        y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
    })(window, document, "clarity", "script", "x6zuugdflb");
  </script>

  <!-- Connected Sites (E-goi) -->
  <script is:inline>
    if(window._mtmReady){
      console.error('Connected sites script already loaded. You might have it dupplicated.');
    } else {
      window._mtmReady=true;
      var _mtm = window._mtm = window._mtm || [];
      _mtm.push({'mtm.startTime': (new Date().getTime()), 'event': 'mtm.Start'});
      var d=document, g=d.createElement('script'), s=d.getElementsByTagName('script')[0];
      g.async=true; g.defer=true; g.src='https://egoi.site/1782951_gmvsolutions.es.js?v='+new Date().getTime();
      s.parentNode.insertBefore(g,s);
    }
  </script>
  <!-- End Connected Sites -->

  <!-- SEO -->
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow, max-snippet:160, max-image-preview:large, max-video-preview:-1'} />
  <meta name="author" content="GMV Solutions" />
  <meta name="theme-color" content="#F4521E" />
  <link rel="canonical" href={canonical} />
  {!noindex && <link rel="alternate" type="text/markdown" href={markdownUrl} title="Versión en markdown" />}
  <!-- hreflang: arquitectura lista (hoy solo ES). Al abrir EN/PT, anadir sus alternates aqui. -->
  <link rel="alternate" hreflang="es" href={canonical} />
  <link rel="alternate" hreflang="x-default" href={canonical} />

  <!-- Open Graph -->
  <meta property="og:type" content={ogType} />
  <meta property="og:site_name" content="REELEVO by GMV Solutions" />
  <meta property="og:url" content={canonical} />
  <meta property="og:title" content={ogTitle} />
  <meta property="og:description" content={ogDescription} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:locale" content="es_ES" />
  {ogType === 'article' && publishedTime && (
    <meta property="article:published_time" content={publishedTime} />
  )}

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={ogTitle} />
  <meta name="twitter:description" content={ogDescription} />
  <meta name="twitter:image" content={ogImage} />

  <!-- Schema.org: Organization sitewide + BreadcrumbList auto + schema de pagina -->
  <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
  {breadcrumbSchema && (
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  )}
  {schema && (
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  )}

  <!-- Google Fonts (carga asíncrona, fuera de la ruta crítica).
       Los preconnect de fonts.googleapis/gstatic estan arriba, con el resto. -->
  <link
    rel="preload"
    as="style"
    href="https://fonts.googleapis.com/css2?family=Oswald:wght@400;500;600;700&family=DM+Sans:ital,wght@0,300;0,400;0,500;1,300&family=DM+Mono:wght@400;500&display=swap"
    onload="this.onload=null;this.rel='stylesheet'"
  />
  <noscript>
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Oswald:wght@400;500;600;700&family=DM+Sans:ital,wght@0,300;0,400;0,500;1,300&family=DM+Mono:wght@400;500&display=swap"
    />
  </noscript>

  <!-- Slot for page-specific head content (extra schema, etc.) -->
  <slot name="head" />
</head>

<body data-page-type={pageType}>
  <div class="entry-splash" aria-hidden="true">
    <div class="entry-splash__logo-wrap">
      <img
        class="entry-splash__logo"
        src={entrySplashLogo.src}
        width={ENTRY_LOGO_SIZE}
        height={ENTRY_LOGO_SIZE}
        alt=""
        decoding="async"
        fetchpriority="high"
      />
    </div>
  </div>

  <div class="site-shell">
    <div class="hero-bg"></div>
    <Header activeNav={activeNav} />
    <GaliciaSeal />

    <main style="position:relative;">
      <Breadcrumbs />
      <slot />
    </main>

    <Footer />
  </div>

  {showNewsletterModal && <NewsletterModal />}

  <!-- Tracking de CTAs (S1-C7): listener delegado -> dataLayer -> GA4/Ads via GTM -->
  <script is:inline>
    (() => {
      const LEAD_INTENTS = ['registro', 'diagnostico', 'demo', 'contacto'];
      document.addEventListener('click', (e) => {
        const cta = e.target.closest('[data-cta]');
        if (!cta) return;
        const intent = cta.dataset.ctaIntent || 'otro';
        const payload = {
          cta_id: cta.id || null,
          cta_label: cta.dataset.ctaLabel || (cta.textContent || '').trim(),
          cta_location: cta.dataset.ctaLocation || 'body',
          cta_intent: intent,
          // Disparador de compra 01..09 al que responde la pagina o la tarjeta
          // (ver PROPUESTA_9_DISPARADORES_COMERCIAL_2026-08.md). Solo lo llevan
          // los CTA que pertenecen a un dolor concreto; el resto va a null.
          cta_trigger: cta.dataset.ctaTrigger || null,
          cta_destination: cta.getAttribute('href'),
          page_path: location.pathname,
          page_type: document.body.dataset.pageType || null,
        };
        window.dataLayer = window.dataLayer || [];
        // Doble via a proposito:
        //  - dataLayer: lo consume GTM si algun dia hay etiquetas que lo usen.
        //  - gtag directo: garantiza que el evento LLEGA a GA4 aunque el
        //    contenedor no tenga ninguna etiqueta que reenvie cta_click, que es
        //    justo lo que estaba pasando.
        // Si se anade en GTM una etiqueta que mande cta_click a GA4, hay que
        // quitar la llamada gtag de aqui o el evento se contara dos veces.
        window.dataLayer.push({ event: 'cta_click', ...payload });
        if (typeof window.gtag === 'function') {
          window.gtag('event', 'cta_click', payload);
        }
        if (LEAD_INTENTS.includes(intent)) {
          // OJO: se dispara con el CLIC, no con el alta completada. No usar como
          // evento clave ni como conversion de Ads sin cambiar esa semantica:
          // mediria botones pulsados, no cuentas creadas. Se deja solo en
          // dataLayer para no inflar conversiones en GA4 sin decidirlo antes.
          window.dataLayer.push({ event: 'generate_lead', lead_type: intent, ...payload });
        }
      });
    })();
  </script>

  <script is:inline>
    (() => {
      const root = document.documentElement;
      // El contenido ya no se oculta con opacity (invalidaba el LCP), asi que
      // hay que neutralizarlo de verdad: pointer-events desde el CSS para el
      // raton e inert aqui para teclado y lectores de pantalla.
      const shell = document.querySelector('.site-shell');
      const logoRevealDelay = 220;
      const pulseDuration = 3000;
      const zoomDuration = 920;
      const blackoutHold = 180;
      const totalDuration = logoRevealDelay + pulseDuration + zoomDuration + blackoutHold;

      // Retira el splash y, con el, devuelve la interaccion a la pagina.
      const clearSplash = () => {
        root.classList.remove('entry-splash-zoom');
        root.classList.remove('entry-splash-logo-visible');
        root.classList.remove('show-entry-splash');
        if (shell) shell.removeAttribute('inert');
      };

      // Failsafe global: el splash nunca debe bloquear la interaccion mas alla de
      // su duracion prevista, pase lo que pase con los timers de animacion.
      // - visibilitychange: si la pestana cargo en segundo plano (timers throttled)
      //   o se restaura el foco, limpiamos poco despues de volver a verla.
      // - pageshow persisted: restauracion desde bfcache (atras/adelante).
      document.addEventListener('visibilitychange', () => {
        if (document.visibilityState === 'visible' && root.classList.contains('show-entry-splash')) {
          window.setTimeout(clearSplash, 1500);
        }
      });
      window.addEventListener('pageshow', (e) => {
        if (e.persisted) clearSplash();
      });

      if (!root.classList.contains('show-entry-splash')) {
        return;
      }

      if (shell) shell.setAttribute('inert', '');

      window.setTimeout(() => {
        root.classList.add('entry-splash-logo-visible');
      }, logoRevealDelay);

      window.setTimeout(() => {
        root.classList.add('entry-splash-zoom');
      }, logoRevealDelay + pulseDuration);

      window.setTimeout(clearSplash, totalDuration);

      // Backstop absoluto por si algun setTimeout intermedio no se ejecuta.
      window.setTimeout(clearSplash, totalDuration + 800);
    })();
  </script>
</body>
  <!-- Google Tag Manager (noscript) -->
  <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-M223Z398"
  height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
  <!-- End Google Tag Manager (noscript) -->
</html>
