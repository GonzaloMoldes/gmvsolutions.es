---
export interface Props {
  activeNav?: string; // e.g. 'como-funciona', 'precios', 'recursos'
}
const { activeNav } = Astro.props;

import { latestPublishedISO, NEW_POST_DAYS } from '../lib/blog';

// Un solo origen para el mega-menu de escritorio y el menu movil. Antes cada
// uno tenia su propio marcado con los mismos 34 enlaces escritos dos veces, y
// nada impedia que se separaran al tocar uno solo (tarea E2 de
// PLAN_SIMPLIFICACION_EDITORIAL_WEB_2026-08.md).
const PLATAFORMA = [
  {
    titulo: 'Gestión y operaciones',
    items: [
      { href: '/software-gestion-pyme-industrial/', label: 'Software de gestión industrial', sub: 'Toda la planta en una herramienta' },
      { href: '/gestion-competencias/', label: 'Gestión de competencias', sub: 'Skill matrix y certificaciones' },
      { href: '/documentacion-procesos/', label: 'Documentación de procesos', sub: 'SOPs, checklists y versionado' },
      { href: '/control-produccion/', label: 'Control de producción', sub: 'KPIs en tiempo real, sin papel' },
      { href: '/oee/', label: 'OEE y análisis Lean', sub: 'Disponibilidad × rendimiento × calidad' },
      { href: '/mantenimiento/', label: 'Mantenimiento preventivo', sub: 'Planes, órdenes y registro automático' },
      { href: '/obras-trazabilidad/', label: 'Obras y trazabilidad', sub: 'QR por pieza, historial por proyecto' },
      { href: '/kaizen/', label: 'Kaizen y mejora continua', sub: 'Del QR al estándar' },
    ],
  },
  {
    titulo: 'Herramientas avanzadas',
    items: [
      { href: '/workflows/', label: 'Workflows automatizados', sub: 'Procesos multi-operario con aprobaciones' },
      { href: '/portal-operario/', label: 'Portal del operario', sub: 'Agenda, progreso y reconocimiento' },
      { href: '/firma-digital/', label: 'Firma digital', sub: 'Evidencia trazable para auditorías' },
      { href: '/modo-offline/', label: 'Modo offline y PWA', sub: 'Funciona aunque falle la wifi de planta' },
      { href: '/api-integraciones/', label: 'API e integraciones', sub: 'ERP, Power BI, Teams y webhooks' },
      { href: '/integracion-m365/', label: 'Integración Microsoft 365', sub: 'Power BI, Power Automate y Teams' },
      { href: '/cobertura-turnos/', label: 'Cobertura de turnos', sub: 'Alerta automática antes de que falle el turno' },
      { href: '/calidad-y-conformidad/', label: 'Calidad y conformidad', sub: 'Lo que sí es y sus límites reales' },
      { href: '/seguridad/', label: 'Seguridad y RGPD', sub: 'RLS, roles, auditoría y datos en la UE' },
    ],
  },
];

const SOLUCIONES = [
  {
    titulo: 'Por caso de uso',
    items: [
      { href: '/casos-de-uso/cobertura-bajas/', label: 'Cobertura de bajas', sub: 'Cuando el experto falta' },
      { href: '/casos-de-uso/onboarding-operarios/', label: 'Onboarding operarios', sub: 'Incorporaciones más ordenadas' },
      { href: '/casos-de-uso/personal-ett/', label: 'Personal ETT', sub: 'Temporal con proceso accesible' },
      { href: '/casos-de-uso/transferencia-conocimiento/', label: 'Transferencia de conocimiento', sub: 'Captura antes de que se vayan' },
      { href: '/consistencia-entre-turnos/', label: 'Consistencia entre turnos', sub: 'Que no cada uno lo haga a su manera' },
      { href: '/errores-en-planta/', label: 'Errores que se repiten', sub: 'El fallo que vuelve cada dos semanas' },
      { href: '/portal-operario/', label: 'Menos interrupciones al encargado', sub: 'El operario resuelve en el puesto' },
    ],
  },
  {
    titulo: 'Por rol',
    items: [
      { href: '/para-quien/jefe-de-produccion/', label: 'Jefe de producción', sub: 'La línea no puede parar' },
      { href: '/para-quien/responsable-rrhh/', label: 'Responsable de RRHH', sub: 'Onboarding y competencias' },
      { href: '/para-quien/responsable-calidad/', label: 'Responsable de calidad', sub: 'Revisión interna y conformidad' },
      { href: '/para-quien/gerente-propietario/', label: 'Gerente / Propietario', sub: 'Continuidad y decisión clara' },
    ],
  },
];

const RECURSOS = [
  { href: '/recursos/', label: 'Recursos', sub: 'Guías y materiales descargables' },
  { href: '/blog/', label: 'Blog', sub: 'Artículos sobre operaciones industriales' },
  { href: '/faqs/', label: 'Preguntas frecuentes', sub: 'Dudas sobre implementación y uso' },
];
---

<header class="header">
  <a href="/" class="header-logo">REEL<span>EVO</span></a>

  <nav class="header-nav">
    <!-- Va ANTES de "Como funciona" a proposito: el visitante decide primero si
         reconoce su problema y solo despues le interesa el mecanismo. Apunta al
         hub de los nueve disparadores de compra
         (PROPUESTA_9_DISPARADORES_COMERCIAL_2026-08.md, M2). -->
    <a href="/por-que-usar-reelevo/" class={activeNav === 'por-que-usar-reelevo' ? 'nav-active' : ''}>
      Qué resuelve
    </a>

    <a href="/como-funciona/" class={activeNav === 'como-funciona' ? 'nav-active' : ''}>
      Cómo funciona
    </a>

    <!-- PLATAFORMA — mega-menu 2 columnas -->
    <div class="nav-dropdown nav-mega">
      <button type="button" class="nav-dropdown-trigger" aria-expanded="false" aria-haspopup="true">
        Plataforma
        <svg viewBox="0 0 10 6" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M1 1l4 4 4-4"/></svg>
      </button>
            <div class="nav-dropdown-menu nav-mega-menu">
        {PLATAFORMA.map((col) => (
          <div class="mega-col">
            <div class="mega-col-title">{col.titulo}</div>
            {col.items.map((it) => (
              <a href={it.href}>
                {it.label}
                <span class="nav-sub-label">{it.sub}</span>
              </a>
            ))}
          </div>
        ))}
      </div>
    </div>

    <!-- SOLUCIONES — casos de uso + para quién fusionados -->
    <div class="nav-dropdown nav-mega">
      <button type="button" class="nav-dropdown-trigger" aria-expanded="false" aria-haspopup="true">
        Soluciones
        <svg viewBox="0 0 10 6" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M1 1l4 4 4-4"/></svg>
      </button>
            <div class="nav-dropdown-menu nav-mega-menu">
        {SOLUCIONES.map((col) => (
          <div class="mega-col">
            <div class="mega-col-title">{col.titulo}</div>
            {col.items.map((it) => (
              <a href={it.href}>
                {it.label}
                <span class="nav-sub-label">{it.sub}</span>
              </a>
            ))}
          </div>
        ))}
      </div>
    </div>

    <a href="/precios/" class={activeNav === 'precios' ? 'nav-active' : ''}>Precios</a>

    <!-- RECURSOS — dropdown con Blog -->
    <div class="nav-dropdown">
      <button
        type="button"
        class={`nav-dropdown-trigger${activeNav === 'recursos' || activeNav === 'blog' ? ' nav-active' : ''}`}
        aria-expanded="false"
        aria-haspopup="true"
        data-published={latestPublishedISO}
      >
        Recursos
        <span class="new-badge">Nuevo</span>
        <svg viewBox="0 0 10 6" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M1 1l4 4 4-4"/></svg>
      </button>
      <div class="nav-dropdown-menu">
        {RECURSOS.map((it) => (
          <a href={it.href} data-published={it.href === '/blog/' ? latestPublishedISO : undefined}>
            {it.label}
            {it.href === '/blog/' && <span class="new-badge">Nuevo contenido</span>}
            <span class="nav-sub-label">{it.sub}</span>
          </a>
        ))}
      </div>
    </div>
  </nav>

  <div class="header-right">

    <!-- Es el unico CTA presente en las 60+ paginas del sitio, asi que es la
         palanca mas barata para la captacion. "Probar gratis" es cierto sin
         depender de la duracion del trial, que hoy no cuadra entre
         TRIAL_DURATION_DAYS y el email de bienvenida de la app. -->
    <a
      href="https://app.gmvsolutions.es/registro"
      class="header-cta"
      data-cta data-cta-intent="registro" data-cta-location="header" data-cta-label="Probar gratis"
    >Probar gratis</a>
    <button
      class="hamburger"
      id="hamburgerBtn"
      aria-label="Menú"
      aria-controls="mobileMenu"
      aria-expanded="false"
      data-published={latestPublishedISO}
    >
      <span></span><span></span><span></span>
    </button>
  </div>
</header>

<!-- MOBILE MENU -->
<div class="mobile-menu" id="mobileMenu">
  <a href="/por-que-usar-reelevo/">Qué resuelve</a>
  <a href="/como-funciona/">Cómo funciona</a>

  {PLATAFORMA.map((col) => (
    <>
      <div class="mobile-section-title">Plataforma — {col.titulo}</div>
      {col.items.map((it) => <a href={it.href}>{it.label}</a>)}
    </>
  ))}

  {SOLUCIONES.map((col) => (
    <>
      <div class="mobile-section-title">Soluciones — {col.titulo}</div>
      {col.items.map((it) => <a href={it.href}>{it.label}</a>)}
    </>
  ))}

  <a href="/precios/">Precios</a>

  <div class="mobile-section-title">Recursos y Blog</div>
  {RECURSOS.map((it) => it.href === '/blog/'
    ? <a href={it.href} data-published={latestPublishedISO}>{it.label} <span class="new-badge">Nuevo contenido</span></a>
    : <a href={it.href}>{it.label}</a>)}

  <div class="mobile-cta-group">

    <a href="https://app.gmvsolutions.es/registro" class="btn-primary" style="text-align:center;font-size:.8rem;padding:14px 28px;"
       data-cta data-cta-intent="registro" data-cta-location="menu_movil" data-cta-label="Probar gratis">
      Probar gratis
    </a>
    <p class="mobile-cta-note">Sin tarjeta · Sin compromiso</p>
  </div>
</div>

<script is:inline define:vars={{ newPostDays: NEW_POST_DAYS }}>
  // Se decide en el navegador y no en el build: el sitio es estatico, y una
  // comparacion en el build dejaria la marca puesta hasta el siguiente despliegue.
  // Espera al DOM completo porque las tarjetas del indice del blog van despues
  // de la cabecera.
  function marcarNuevos() {
    var ventana = newPostDays * 864e5;
    var ahora = Date.now();
    document.querySelectorAll('[data-published]').forEach(function (el) {
      var t = Date.parse(el.getAttribute('data-published') + 'T00:00:00');
      if (ahora >= t && ahora - t < ventana) el.classList.add('is-new');
    });
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', marcarNuevos);
  else marcarNuevos();
</script>

<script>
  // Astro compila este bloque como modulo con ambito propio: nada de lo que se
  // declara aqui existe en window. Por eso el cierre del menu se resuelve con un
  // listener delegado sobre el propio menu y no con onclick= en cada enlace
  // (que llamaba a una funcion global inexistente y lanzaba ReferenceError).
  const menu = document.getElementById('mobileMenu');
  const burger = document.getElementById('hamburgerBtn');

  function setMobileMenu(open: boolean) {
    menu?.classList.toggle('active', open);
    burger?.classList.toggle('active', open);
    burger?.setAttribute('aria-expanded', String(open));
    document.body.style.overflow = open ? 'hidden' : '';
  }

  burger?.addEventListener('click', () => {
    setMobileMenu(!menu?.classList.contains('active'));
  });

  // Cualquier enlace del menu lo cierra antes de navegar (incluye los anclajes
  // dentro de la misma pagina, donde no hay recarga que lo cierre por si sola).
  menu?.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) setMobileMenu(false);
  });

  // ── Desplegables de escritorio ──
  // Abrir y cerrar los gestiona el CSS (:hover y :focus-within); aqui solo
  // mantenemos aria-expanded en sintonia con lo que se ve, y anadimos Escape,
  // que es lo que espera cualquiera que navegue con teclado.
  document.querySelectorAll<HTMLElement>('.nav-dropdown').forEach((dropdown) => {
    const trigger = dropdown.querySelector<HTMLButtonElement>('.nav-dropdown-trigger');
    if (!trigger) return;

    const sync = (open: boolean) => trigger.setAttribute('aria-expanded', String(open));

    dropdown.addEventListener('mouseenter', () => sync(true));
    dropdown.addEventListener('mouseleave', () => sync(false));
    dropdown.addEventListener('focusin', () => {
      dropdown.classList.remove('is-dismissed');
      sync(true);
    });
    dropdown.addEventListener('focusout', (e) => {
      // Solo se cierra si el foco sale del desplegable entero, no al saltar
      // de un enlace a otro dentro del propio menu.
      if (!dropdown.contains(e.relatedTarget as Node)) {
        dropdown.classList.remove('is-dismissed');
        sync(false);
      }
    });

    dropdown.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') return;
      // Hace falta la clase: al devolver el foco al disparador seguiriamos
      // dentro del :focus-within que abre el menu, asi que sin desarmarlo
      // Escape no cerraria nada. Se rearma en cuanto el foco vuelve a entrar.
      dropdown.classList.add('is-dismissed');
      sync(false);
      trigger.focus();
    });
  });
</script>

