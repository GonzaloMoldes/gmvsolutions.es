// ---------------------------------------------------------------- mundo
const ESC_W = 640, ESC_H = 440, PASILLO = 170, PUERTA = 120, TECHO = 56, MUNDO_H = 560, SUELO_Y = 500;
const BASE = TECHO + 400; // línea de suelo de las escenas (donde pisan sus personajes)
const piezas: { x: number; svg: string; n: number }[] = [];
const paradasX: number[] = [];
const puertas: number[] = [];
const carteles: { x: number; zona: number }[] = [];
const huevos: { tipo: string; svg: string; dispara: number; dice: string; responde?: string; cabeza: [number, number] }[] = [];

const interior = (r: string) => {
  const m = r.match(/<svg[^>]*viewBox="([^"]+)"[^>]*>([\s\S]*)<\/svg>\s*$/);
  return { viewBox: m![1], cuerpo: m![2] };
};
// Andrés ya está en escena como guía: donde la ilustración trae al mismo jefe de
// producción, se quita (él ocupa su sitio) o, si hace de supervisor, se le cambia
// la camisa para que no parezcan la misma persona.
const AJUSTES: Record<string, { quitar?: number[]; supervisor?: number[] }> = {
  hero: { quitar: [1] },
  'control-produccion': { quitar: [0] },
  oee: { quitar: [0] },
  'firma-digital': { supervisor: [1] },
};
function ajustar(nombre: string, svg: string) {
  const a = AJUSTES[nombre];
  if (!a) return svg;
  const gs = personajes(svg);
  (a.quitar ?? []).forEach((k) => { svg = svg.replace(gs[k], ''); });
  (a.supervisor ?? []).forEach((k) => {
    const azul = gs[k].replaceAll('#FFFFFF', '#4E7FA0').replaceAll('#E4E1DA', '#3F6A88').replaceAll('#F2F0EC', '#4E7FA0');
    svg = svg.replace(gs[k], azul);
  });
  return svg;
}
const cabezas: Record<number, [number, number][]> = {};
const escena = (x: number, nombre: string, n: number) => {
  let svg = ajustar(nombre, raw(nombre));
  grupos(svg, 'ilus-bubble').forEach((b) => { svg = svg.replace(b, ''); });
  const e = interior(svg);
  // Dónde queda la cabeza de cada personaje en el mundo (para sus bocadillos).
  const [, , vw, vh] = e.viewBox.split(/\s+/).map(Number);
  const k = Math.min(ESC_W / vw, ESC_H / vh);
  const ox = x + (ESC_W - vw * k) / 2, oy = TECHO + (ESC_H - vh * k);
  cabezas[n] = personajes(svg).map((g) => {
    const t = g.match(/translate\(([-\d.]+) ([-\d.]+)\)(?: scale\(([-\d.]+)(?: ([-\d.]+))?\))?/)!;
    const sx = Number(t[3] ?? 1), sy = Math.abs(Number(t[4] ?? t[3] ?? 1));
    return [ox + (Number(t[1]) + 8 * sx) * k, oy + (Number(t[2]) - 352 * sy) * k];
  });
  piezas.push({ x, n, svg: `<svg x="${x}" y="${TECHO}" width="${ESC_W}" height="${ESC_H}" viewBox="${e.viewBox}" preserveAspectRatio="xMidYMax meet">${e.cuerpo}</svg>` });
};

// Personajes de otras escenas para los detalles de fondo.
const cafetera = sinPosicion(personajes(raw('sobre-nosotros'))[2]);
const saludador = sinPosicion(personajes(raw('onboarding-operarios'))[1]);
const tecnico = sinPosicion(personajes(raw('mantenimiento'))[0]);

function huevoCafe(sx: number) {
  const px = sx + 90, mx = sx + 168;
  const mano: [number, number] = [px + 54.6 * 0.8, BASE - 199.1 * 0.8];
  huevos.push({ tipo: 'cafe', dispara: px, cabeza: [px + 6, BASE - 290], dice: 'El primero del día. ¿Un café, Andrés?', responde: '¡Luego, que tengo visita!', svg: `
    <rect x="${mx}" y="${BASE - 150}" width="86" height="150" rx="6" fill="#DAD7D0"/><rect x="${mx}" y="${BASE - 150}" width="86" height="12" rx="6" fill="#C9C6BF"/>
    <rect x="${mx + 12}" y="${BASE - 128}" width="62" height="34" rx="4" fill="#3A3E44"/><text x="${mx + 43}" y="${BASE - 106}" text-anchor="middle" font-family="DM Mono, monospace" font-size="11" font-weight="700" fill="#F2C14E">CAFÉ</text>
    <rect x="${mx + 30}" y="${BASE - 80}" width="26" height="10" rx="2" fill="#141618"/><rect x="${mx + 24}" y="${BASE - 46}" width="38" height="5" rx="2" fill="#5A5F66"/>
    <circle cx="${mx + 72}" cy="${BASE - 80}" r="4" class="ilus-blink" fill="#3FB950"/>
    <g transform="translate(${px} ${BASE}) scale(0.8)">${cafetera}</g>
    <rect x="${mano[0] - 7}" y="${mano[1] - 15}" width="13" height="15" rx="2" fill="#fff" stroke="#141618" stroke-width="1.5"/><path d="M${mano[0] + 6} ${mano[1] - 11}q6 0 6 4t-6 4" fill="none" stroke="#141618" stroke-width="1.5"/>
    <path class="rec-vapor" d="M${mano[0] - 3} ${mano[1] - 20}q-4-6 0-12t0-12" fill="none" stroke="#B9B6AE" stroke-width="2" stroke-linecap="round"/>
    <path class="rec-vapor" style="animation-delay:.7s" d="M${mano[0] + 3} ${mano[1] - 20}q-4-6 0-12t0-12" fill="none" stroke="#B9B6AE" stroke-width="2" stroke-linecap="round"/>` });
}
function huevoSaludo(sx: number) {
  const px = sx + 150;
  huevos.push({ tipo: 'saludo', dispara: px - 40, cabeza: [px - 6, BASE - 290], dice: '¡Buenos días, jefe!', responde: '¡Buenos días, Luis! ¿Qué tal el fin de semana?', svg: `
    <g class="rec-saluda"><g transform="translate(${px} ${BASE}) scale(-0.8 0.8)">${saludador}</g></g>` });
}
function huevoTuercas(sx: number) {
  // Máquina y técnico de mantenimiento.svg, con el engranaje girando.
  const ox = sx - 170, oy = TECHO;
  huevos.push({ tipo: 'tuercas', dispara: sx + 60, cabeza: [sx + 80, BASE - 290], dice: 'Esta tuerca no se me escapa.', responde: 'Gracias, Fermín. Sin ti esto no anda.', svg: `
    <g transform="translate(${ox} ${oy})">
      <rect x="340" y="140" width="250" height="262" rx="8" fill="#DAD7D0"/><rect x="360" y="170" width="120" height="120" rx="4" fill="#3A3E44"/>
      <g class="rec-gira"><circle cx="420" cy="230" r="34" fill="none" stroke="#B9B6AE" stroke-width="10" stroke-dasharray="10 8"/><circle cx="420" cy="230" r="14" fill="#B9B6AE"/></g>
      <path d="M480 170L520 156V304L480 290Z" fill="#C9C6BF"/><rect x="540" y="170" width="34" height="10" rx="5" fill="#C9C6BF"/><circle cx="557" cy="206" r="8" class="ilus-blink" fill="#F2C14E"/>
      <g class="rec-aprieta"><g transform="translate(250 400) scale(0.8)">${tecnico}</g></g>
    </g>` });
}
function huevoCarretilla(sx: number) {
  // Carretilla de precios.svg con cajas de cartón en lugar de la caja «Pro».
  huevos.push({ tipo: 'carretilla', dispara: sx + 120, cabeza: [sx + 230, BASE - 210], dice: '¡Paso, paso, que voy cargado!', svg: `
    <g class="rec-carretilla"><g transform="translate(${sx - 300} ${TECHO + 60}) scale(0.86)">
      <rect x="480" y="160" width="12" height="242" fill="#3A3E44"/><rect x="500" y="160" width="12" height="242" fill="#3A3E44"/>
      <rect x="400" y="300" width="92" height="8" fill="#141618"/>
      <rect x="406" y="250" width="42" height="50" fill="#C9A26B" stroke="#9E7B4A" stroke-width="2"/><rect x="448" y="262" width="38" height="38" fill="#D8B37A" stroke="#9E7B4A" stroke-width="2"/><rect x="418" y="214" width="40" height="36" fill="#D8B37A" stroke="#9E7B4A" stroke-width="2"/>
      <path d="M512 300H600V380H512Z" fill="#F2C14E"/><path d="M530 300V230H580L596 300" fill="none" stroke="#141618" stroke-width="5" stroke-linejoin="round"/>
      <circle cx="536" cy="386" r="16" fill="#141618"/><circle cx="536" cy="386" r="6" fill="#8A8780"/><circle cx="586" cy="386" r="16" fill="#141618"/><circle cx="586" cy="386" r="6" fill="#8A8780"/>
      <rect x="602" y="320" width="16" height="50" fill="#3A3E44"/>
      <path d="M544 300Q545 274 562 271L572 271Q586 275 586 300Z" fill="#F4521E"/><path d="M544 300Q545 274 562 271L564 300Z" fill="#DB4618"/><path d="M545 288H586V293H545Z" fill="#F2F0EA"/><path d="M561 262h9v10h-9z" fill="#C27A5E"/><ellipse cx="566" cy="252" rx="11" ry="12" fill="#D9937A"/><path d="M576 249Q581 253 576 257Z" fill="#D9937A"/><ellipse cx="560" cy="254" rx="2.6" ry="3.8" fill="#C9826A"/><ellipse cx="572" cy="253" rx="1.5" ry="1.9" fill="#23272D"/><path d="M570 260Q573 262 575 259.5" fill="none" stroke="#A86650" stroke-width="1.4" stroke-linecap="round"/><path d="M554 248Q555 232 567 232Q580 232 580 247Z" fill="#F2C14E"/><path d="M567 232Q555 232 554 248H562Q561 236 567 232Z" fill="#E0A92E"/><path d="M552 246H585V249H552Z" fill="#E0A92E"/><path d="M550 282L532 286" stroke="#F4521E" stroke-width="10" stroke-linecap="round"/><circle cx="529" cy="286" r="5.5" fill="#4A4F57"/>
    </g></g>` });
}

let x = 40;
escena(x, 'hero', 0);
const inicioX = x + ESC_W + 60;
x += ESC_W;
huevoCafe(x + 120);
x += 420;

PARADAS.forEach((p, i) => {
  const cambia = i === 0 || PARADAS[i - 1].zona !== p.zona;
  if (cambia && p.zona === 2) { huevoCarretilla(x + 60); x += 460; }
  if (cambia) { puertas.push(x + 10); x += PUERTA; carteles.push({ x: x + 10, zona: p.zona }); }
  if (cambia && p.zona === 1) { huevoSaludo(x); x += 260; }
  if (i === 6) { huevoTuercas(x + 40); x += 420; }
  paradasX.push(x + PASILLO / 2);
  x += PASILLO;
  escena(x, p.escena, i + 1);
  x += ESC_W;
});
const finalX = x + PASILLO / 2;
x += PASILLO + 160;
const MUNDO_W = x;
const POSICIONES = [inicioX, ...paradasX, finalX];
const CHARLAS = DIALOGOS.map((d, n) => d.map(([i, texto]) => ({ texto, i, pos: cabezas[n]?.[i] })).filter((l) => l.pos));
const HUEVOS = huevos.map(({ tipo, dispara, dice, responde, cabeza }) => ({ tipo, dispara, dice, responde, cabeza }));

