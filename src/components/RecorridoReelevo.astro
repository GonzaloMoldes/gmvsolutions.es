// Recorrido interactivo por la fábrica (presentación con estética de
// juego de plataformas). Andrés, el jefe de producción, recorre una nave
// panorámica de izquierda a derecha y se para en 12 puntos. En cada parada se
// abre, dentro de la escena, una tarjeta con un gráfico dibujado que explica lo
// que hace REELEVO en ese momento (sin capturas de la app).
//
// - Va incrustado en /como-funciona/ (sección «Pruébalo tú»), en lugar de la demo de Storylane.
// - El escenario reutiliza las escenas de src/assets/ilustraciones/ tal cual,
//   sobre un único suelo. Andrés es el jefe de producción de
//   control-produccion.svg con las piernas y los brazos separados para andar.
// - Detalles de fondo con personajes de otras escenas: café, saludo, tuercas
//   y carretilla. Reaccionan cuando Andrés pasa cerca.
// - Controles: flechas ← → (o A / D), botones ◀ ▶, deslizar y la barra de paradas.
// - Con «reducir movimiento» no hay paseo: la cámara salta de parada en parada.

const escenasRaw = import.meta.glob('../assets/ilustraciones/*.svg', {
  query: '?raw', import: 'default', eager: true,
}) as Record<string, string>;
const raw = (n: string) => escenasRaw[`../assets/ilustraciones/${n}.svg`];

/** Grupos <g class="…"> de una escena (personajes o bocadillos), en orden y con sus anidados. */
function grupos(svg: string, clase: string): string[] {
  const out: string[] = [];
  let pos = 0;
  for (;;) {
    const i = svg.indexOf(`<g class="${clase}"`, pos);
    if (i < 0) break;
    let d = 0, j = i;
    const re = /<g\b[^>]*>|<\/g>/g;
    re.lastIndex = i;
    let m: RegExpExecArray | null;
    while ((m = re.exec(svg))) {
      d += m[0].startsWith('<g') ? 1 : -1;
      if (d === 0) { j = re.lastIndex; break; }
    }
    out.push(svg.slice(i, j));
    pos = j;
  }
  return out;
}
const personajes = (svg: string) => grupos(svg, 'ilus-breathe');
/** Quita el translate/scale propio del personaje para recolocarlo. */
