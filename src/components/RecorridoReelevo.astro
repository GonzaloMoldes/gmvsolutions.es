      <!-- Bocadillos en HTML (se ajustan al texto) -->
      <div class="rec-boc rec-boc-guia" id="rec-boc-guia" hidden></div>
      <div class="rec-boc rec-boc-huevo" id="rec-boc-huevo" hidden></div>
      <div class="rec-boc rec-boc-escena" id="rec-boc-escena" hidden></div>

      <!-- Tarjeta de cada parada, dentro de la escena -->
      <div class="rec-pop" id="rec-pop" aria-live="polite">
        <article class="rec-tarjeta" data-tarjeta="0">
          <div class="rec-tag" style="--c:var(--orange)">Antes de empezar</div>
          <h3>Una mañana cualquiera en la fábrica</h3>
          <p>Andrés te enseña la nave en 12 paradas: desde que se sube un procedimiento hasta que la mejora llega a todos los turnos. Fíjate también en lo que pasa por el camino.</p>
          <p class="rec-pista">Pulsa <kbd>→</kbd> o <b>▶</b> para empezar.</p>
        </article>
        {PARADAS.map((p, i) => (
          <article class="rec-tarjeta" data-tarjeta={i + 1} hidden>
            <div class="rec-tag" style={`--c:${ZONAS[p.zona].color}`}>{ZONAS[p.zona].nombre} · {String(i + 1).padStart(2, '0')}/12</div>
            <h3>{p.titulo}</h3>
            <p class="rec-cita">«{p.dice}»</p>
            <svg class="rec-grafico" viewBox="0 0 320 150" role="img" aria-label={`Esquema: ${p.titulo.toLowerCase()}`} set:html={GRAFICOS[p.grafico]} />
            <p>{p.texto}</p>
            <div class="rec-chip">{p.quien}</div>
          </article>
        ))}
        <article class="rec-tarjeta" data-tarjeta="13" hidden>
          <div class="rec-tag" style="--c:var(--green)">Fin del recorrido</div>
          <h3>Hoy faltó Javi y la punzonadora siguió funcionando</h3>
          <p>Eso es REELEVO: el procedimiento de cada máquina en el móvil del operario, y lo que pasa en planta, en tu pantalla. Sin instalar nada y sin cuentas de operario.</p>
          <div class="rec-ctas">
            <a class="btn-primary" href="https://app.gmvsolutions.es/registro" data-cta data-cta-intent="registro" data-cta-location="recorrido" data-cta-label="Registrarme gratis">Registrarme gratis</a>
            <button type="button" class="btn-ghost" id="rec-reiniciar">Volver a empezar</button>
          </div>
        </article>
      </div>

      <div class="rec-controles">
        <button type="button" class="rec-btn" id="rec-atras" aria-label="Parada anterior">◀</button>
        <span class="rec-contador" id="rec-contador" aria-live="polite">Inicio</span>
        <button type="button" class="rec-btn rec-btn-adelante" id="rec-adelante" aria-label="Siguiente parada">▶</button>
      </div>
    </div>
</div>

  <script define:vars={{ POSICIONES, MUNDO_W, MUNDO_H, HUEVOS, CHARLAS, SUELO: SUELO_Y + 6, TITULOS: ['Inicio', ...PARADAS.map((p) => p.titulo), 'Fin'], DICE: [DICE_INICIO, ...PARADAS.map((p) => p.dice), DICE_FIN] }}>
    const escenario = document.getElementById('rec-escenario');
    const mundo = document.getElementById('rec-mundo');
    const guia = document.getElementById('rec-guia');
    const cuerpo = document.getElementById('rec-guia-cuerpo');
    const piernaA = document.getElementById('rec-pierna-a');
    const piernaB = document.getElementById('rec-pierna-b');
    const brazoA = document.getElementById('rec-brazo-a');
    const brazoB = document.getElementById('rec-brazo-b');
    const senala = document.getElementById('rec-brazo-senala');
    const bocGuia = document.getElementById('rec-boc-guia');
    const bocHuevo = document.getElementById('rec-boc-huevo');
    const bocEscena = document.getElementById('rec-boc-escena');
    let charla = { timers: [], pos: null };
    const pop = document.getElementById('rec-pop');
    const contador = document.getElementById('rec-contador');
    const tarjetas = [...document.querySelectorAll('.rec-tarjeta')];
    const puntos = [...document.querySelectorAll('.rec-punto')];
    const escenas = [...document.querySelectorAll('.rec-escena')];
    const reducido = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    let parada = 0, gx = POSICIONES[0], destino = null, fase = 0, ultimo = 0, dir = 1;
    let s = 1, off = 0, ty = 0;
    const VEL = 340;
    const huevoActivo = { i: -1, hasta: 0, respuesta: 0 };
    const disparados = new Set();

    // Encuadre: en escritorio el mundo ocupa toda la altura; en móvil se ancla abajo
    // y la tarjeta ocupa la parte de arriba del escenario.
    function camara() {
      const W = escenario.clientWidth, H = escenario.clientHeight;
      const movil = W < 760;
      s = (movil ? H * 0.58 : H) / MUNDO_H;
      ty = H - MUNDO_H * s;
      let o = gx * s - W * (movil ? 0.12 : 0.25);
      // Mientras habla alguien de la escena, la cámara lo encuadra en la zona libre
      // (a la izquierda de la tarjeta en escritorio), con sitio para su bocadillo.
      if (charla.pos) {
        const libre = !movil && pop.classList.contains('abierto') ? pop.offsetLeft - 12 : W;
        const m = Math.min(150, libre / 2), sx = charla.pos[0] * s;
        o = Math.min(Math.max(o, sx - (libre - m)), sx - m);
      }
      off = Math.max(0, Math.min(o, MUNDO_W * s - W));
      mundo.style.transform = `translate(${-off}px, ${ty}px) scale(${s})`;
      colocar(bocGuia, gx + 30, SUELO - 270);
      const h = HUEVOS[huevoActivo.i];
      if (h) colocar(bocHuevo, h.cabeza[0], h.cabeza[1] - 20);
      if (charla.pos) encajar(charla.pos[0], charla.pos[1]);
    }
    // El bocadillo de la escena no puede quedar bajo la tarjeta ni salirse del
    // escenario: se desplaza y el pico sigue apuntando a quien habla.
    function encajar(wx, wy) {
      const W = escenario.clientWidth;
      const tope = pop.classList.contains('abierto') && W >= 760 ? pop.offsetLeft - 12 : W - 8;
      const w = bocEscena.offsetWidth || 250;
      const centro = wx * s - off;
      const x = Math.max(8 + w / 2, Math.min(centro, tope - w / 2));
      bocEscena.style.left = `${x}px`;
      // En móvil la tarjeta ocupa la parte de arriba: el bocadillo baja hasta quedar debajo.
      const suelo = pop.classList.contains('abierto') && W < 760 ? pop.offsetTop + pop.offsetHeight + 8 : 8;
      bocEscena.style.top = `${Math.max(wy * s + ty, suelo + bocEscena.offsetHeight)}px`;
      const dx = Math.max(-w / 2 + 18, Math.min(centro - x, w / 2 - 18));
      bocEscena.style.setProperty('--dx', `${dx}px`);
    }
    function colocar(el, wx, wy) {
      el.style.left = `${wx * s - off}px`;
      el.style.top = `${wy * s + ty}px`;
    }
    function pose(andando) {
      const a = andando ? Math.sin(fase) * 16 : 0;
      piernaA.setAttribute('transform', `rotate(${a} -11 -182)`);
      piernaB.setAttribute('transform', `rotate(${-a} 11 -182)`);
      brazoA.setAttribute('transform', `rotate(${-a * 0.8} -27 -282)`);
      brazoB.setAttribute('transform', `rotate(${a * 0.8} 28 -284)`);
      const bote = andando ? Math.abs(Math.sin(fase)) * -5 : 0;
      cuerpo.setAttribute('transform', `translate(0 ${bote}) scale(${0.78 * dir} 0.78)`);
      brazoB.style.display = andando ? '' : 'none';
      senala.style.display = andando ? 'none' : '';
      guia.setAttribute('transform', `translate(${gx} ${SUELO})`);
    }
    function decir(texto) {
      if (!texto) { bocGuia.hidden = true; return; }
      bocGuia.textContent = texto;
      bocGuia.hidden = false;
    }
    // Conversación de la parada: primero habla Andrés y luego, por turnos, los
    // personajes de la escena. Cada frase dura según lo larga que es.
    const dura = (t) => 1600 + t.length * 48;
    function callar() {
      charla.timers.forEach(clearTimeout);
      charla = { timers: [], pos: null };
      bocEscena.hidden = true;
    }
    // Punto encima de la cabeza de quien habla, medido en el dibujo (coordenadas del mundo).
    function cabeza(n, i, reserva) {
      const g = escenas.find((e) => Number(e.dataset.escena) === n)?.querySelectorAll('g.ilus-breathe')[i];
      const c = g?.querySelector('ellipse[rx="14.5"][ry="16.5"]');
      if (!c) return reserva;
      const m = mundo.getBoundingClientRect(), r = c.getBoundingClientRect();
      return [(r.left + r.width / 2 - m.left) / s, (r.top - m.top) / s - r.height / s * 0.7];
    }
    // La cámara se desliza suave cuando no es por el paseo de Andrés.
    let suaveT = 0;
    function suave() {
      mundo.classList.add('suave');
      clearTimeout(suaveT);
      suaveT = setTimeout(() => mundo.classList.remove('suave'), 650);
    }
    function conversar(n) {
      callar();
      const movil = escenario.clientWidth < 760;
      let t = movil ? 700 : dura(DICE[n]);
      (CHARLAS[n] || []).forEach((l) => {
        charla.timers.push(setTimeout(() => {
          // Uno detrás de otro: se retira el bocadillo anterior (también el de Andrés),
          // la cámara encuadra a quien habla y entonces aparece su frase.
          decir('');
          bocEscena.hidden = true;
          const antes = off;
          charla.pos = cabeza(n, l.i, l.pos);
          suave(); camara();
          bocEscena.textContent = l.texto;
          charla.timers.push(setTimeout(() => {
            bocEscena.hidden = false;
            camara();
            bocEscena.style.animation = 'none'; void bocEscena.offsetWidth; bocEscena.style.animation = '';
          }, Math.abs(off - antes) > 4 ? 620 : 120));
        }, t));
        t += dura(l.texto) + 300;
      });
    }
    // Analítica: hasta dónde llega cada visitante. Solo se envía desde la web
    // publicada (las vistas previas de Vercel comparten la propiedad de GA4).
    // Cada visita cuenta una vez por parada: «avance» solo al superar su récord.
    const PRODUCCION = /^(www\.)?gmvsolutions\.es$/.test(location.hostname);
    const medidos = (window.__recorridoEventos = []);
    let modo = 'flecha', iniciado = false, maxParada = 0, saltado = false, completado = false;
    function medir(nombre, datos) {
      medidos.push([nombre, datos]);
      if (!PRODUCCION) return;
      try { if (typeof window.gtag === 'function') window.gtag('event', nombre, datos); } catch (e) { /* sin analítica */ }
    }
    function navegar(n, como) {
      modo = como;
      if (como === 'salto') saltado = true;
      if (!iniciado && n > 0) { iniciado = true; medir('recorrido_inicio', { modo: como }); }
      ir(n);
    }
    function registrar(n) {
      if (n > maxParada) {
        maxParada = n;
        medir('recorrido_avance', { parada_max: n, titulo: TITULOS[n], modo });
      }
      if (n === 13 && !completado) {
        completado = true;
        medir('recorrido_completado', { modo: saltado ? 'salto' : 'flecha' });
      }
    }
    function mostrar(n) {
      tarjetas.forEach((t) => { t.hidden = Number(t.dataset.tarjeta) !== n; });
      pop.classList.add('abierto');
      puntos.forEach((p) => {
        const k = Number(p.dataset.ir);
        p.classList.toggle('activo', k === n);
        p.classList.toggle('visto', k < n);
        if (k === n) p.setAttribute('aria-current', 'step'); else p.removeAttribute('aria-current');
      });
      escenas.forEach((e) => { if (Number(e.dataset.escena) <= n) e.classList.add('vista'); });
      escenas.forEach((e) => e.classList.toggle('actual', Number(e.dataset.escena) === n));
      contador.textContent = n === 0 ? 'Inicio' : n === 13 ? 'Fin' : `${n} / 12 · ${TITULOS[n]}`;
      decir(DICE[n]);
      conversar(n);
      camara();
      registrar(n);
    }
    function ir(n) {
      n = Math.max(0, Math.min(13, n));
      if (n === parada && destino === null) return;
      destino = n;
      pop.classList.remove('abierto');
      decir('');
      if (charla.pos) suave();
      callar();
      if (reducido) { gx = POSICIONES[n]; llegar(); return; }
      ultimo = 0;
      requestAnimationFrame(paso);
    }
    function llegar() {
      parada = destino; destino = null; dir = 1;
      if (huevoActivo.i !== -1) {
        document.querySelector(`.rec-huevo-${HUEVOS[huevoActivo.i].tipo}`)?.classList.remove('activo');
        huevoActivo.i = -1;
      }
      bocHuevo.hidden = true;
      pose(false); mostrar(parada);
    }
    // Detalles de fondo: cuando Andrés pasa cerca, el personaje dice algo y él responde.
    function huevos(t) {
      HUEVOS.forEach((h, i) => {
        const cerca = Math.abs(gx - h.dispara) < 110;
        if (cerca && !disparados.has(i) && huevoActivo.i === -1) {
          disparados.add(i);
          huevoActivo.i = i; huevoActivo.hasta = t + 2600; huevoActivo.respuesta = t + 1300;
          bocHuevo.textContent = h.dice; bocHuevo.hidden = false;
          document.querySelector(`.rec-huevo-${h.tipo}`)?.classList.add('activo');
        }
        if (!cerca && Math.abs(gx - h.dispara) > 600) disparados.delete(i);
      });
      const h = HUEVOS[huevoActivo.i];
      if (h) {
        if (h.responde && t > huevoActivo.respuesta && bocGuia.hidden) decir(h.responde);
        if (t > huevoActivo.hasta) {
          bocHuevo.hidden = true;
          document.querySelector(`.rec-huevo-${h.tipo}`)?.classList.remove('activo');
          if (destino !== null) decir('');
          huevoActivo.i = -1;
        }
      }
    }
    function paso(t) {
      if (destino === null) return;
      const dt = ultimo ? Math.min(0.05, (t - ultimo) / 1000) : 0.016;
      ultimo = t;
      const obj = POSICIONES[destino];
      dir = obj >= gx ? 1 : -1;
      const vel = Math.abs(obj - gx) > 2500 ? VEL * 4 : VEL;
      gx += dir * vel * dt;
      fase += dt * 11;
      if ((dir > 0 && gx >= obj) || (dir < 0 && gx <= obj)) { gx = obj; llegar(); return; }
      huevos(t);
      pose(true); camara();
      requestAnimationFrame(paso);
    }
    // Al pararse, el último bocadillo de un detalle se cierra solo.
    setInterval(() => {
      if (destino === null && huevoActivo.i !== -1 && performance.now() > huevoActivo.hasta) {
        bocHuevo.hidden = true;
        document.querySelector(`.rec-huevo-${HUEVOS[huevoActivo.i].tipo}`)?.classList.remove('activo');
        huevoActivo.i = -1;
      }
    }, 500);

    const siguiente = () => navegar((destino ?? parada) + 1, 'flecha');
    const anterior = () => navegar((destino ?? parada) - 1, 'flecha');
    document.getElementById('rec-adelante').addEventListener('click', siguiente);
    document.getElementById('rec-atras').addEventListener('click', anterior);
    document.getElementById('rec-reiniciar').addEventListener('click', () => navegar(0, 'salto'));
    puntos.forEach((p) => p.addEventListener('click', () => navegar(Number(p.dataset.ir), 'salto')));
    let enVista = false;
    new IntersectionObserver(([en]) => { enVista = en.isIntersecting; }, { threshold: 0.4 }).observe(escenario);
    document.addEventListener('keydown', (e) => {
      if (!enVista) return;
      const t = e.target;
      if (t instanceof HTMLElement && (t.isContentEditable || /INPUT|TEXTAREA|SELECT/.test(t.tagName))) return;
      if (e.key === 'ArrowRight' || e.key === 'd' || e.key === 'D') { e.preventDefault(); siguiente(); }
      if (e.key === 'ArrowLeft' || e.key === 'a' || e.key === 'A') { e.preventDefault(); anterior(); }
    });
    let x0 = null;
    escenario.addEventListener('touchstart', (e) => { x0 = e.touches[0].clientX; }, { passive: true });
    escenario.addEventListener('touchend', (e) => {
      if (x0 === null) return;
      const dx = e.changedTouches[0].clientX - x0; x0 = null;
      if (Math.abs(dx) > 40) (dx < 0 ? siguiente : anterior)();
    });
    window.addEventListener('resize', camara);
    pose(false); mostrar(0);
  </script>

<style>
  .rec { text-align: left; }
  kbd { font-family: 'DM Mono', monospace; font-size: .8em; border: 1px solid var(--border); border-bottom-width: 2px; border-radius: 4px; padding: 1px 6px; background: var(--surface2); }

  .rec-barra { display: grid; grid-template-columns: 3fr 4fr 3fr 2fr; gap: 10px; margin-bottom: 12px; }
  .rec-zona { border-top: 3px solid var(--c); padding-top: 6px; }
  .rec-zona-nombre { display: block; font: 500 .66rem 'DM Mono', monospace; letter-spacing: .1em; text-transform: uppercase; color: var(--gray2); margin-bottom: 6px; }
  .rec-puntos { display: flex; gap: 6px; flex-wrap: wrap; }
  .rec-punto { width: 30px; height: 30px; border-radius: 50%; border: 1px solid var(--border); background: var(--paper); font: 600 .78rem 'Oswald', sans-serif; color: var(--gray); cursor: pointer; }
  .rec-punto.visto { background: var(--surface3); color: var(--steel); }
  .rec-punto.activo { background: var(--orange); border-color: var(--orange); color: #fff; box-shadow: 0 0 0 4px var(--orange-dim); }

  .rec-escenario { position: relative; height: clamp(440px, calc(100vh - 250px), 660px); overflow: hidden; border-radius: 10px; border: 1px solid var(--border); background: #ECEAE5; outline: none; }
  .rec-escenario:focus-visible { box-shadow: 0 0 0 3px var(--orange-dim); }
  .rec-mundo { position: absolute; left: 0; top: 0; transform-origin: 0 0; will-change: transform; }
  @media (prefers-reduced-motion: no-preference) { .rec-mundo.suave { transition: transform .6s cubic-bezier(.4, 0, .2, 1); } }

  /* Bocadillos */
  .rec-boc { position: absolute; z-index: 3; max-width: 270px; transform: translate(-20px, -100%); padding: 10px 14px; border-radius: 12px; font: 500 .9rem/1.4 'DM Sans', sans-serif; box-shadow: 0 8px 20px rgba(20,22,24,.18); pointer-events: none; }
  .rec-boc::after { content: ''; position: absolute; left: 22px; bottom: -9px; border: 10px solid transparent; border-bottom: 0; }
  .rec-boc-guia { background: var(--steel); color: #fff; transform: translate(-100%, -100%); }
  .rec-boc-guia::after { border-top-color: var(--steel); left: auto; right: 16px; }
  .rec-boc-huevo { background: #fff; color: var(--steel); border: 1px solid var(--border); }
  .rec-boc-huevo::after { border-top-color: #fff; }
  .rec-boc-escena { z-index: 6; background: #fff; color: var(--steel); border: 1px solid var(--border); transform: translate(-50%, -100%); width: max-content; max-width: 250px; }
  .rec-boc-escena::after { border-top-color: #fff; left: calc(50% - 10px + var(--dx, 0px)); }
  .rec-boc[hidden] { display: none; }
  @media (prefers-reduced-motion: no-preference) {
    .rec-boc:not([hidden]):not(.rec-boc-escena) { animation: recBoc .4s cubic-bezier(.34, 1.56, .64, 1); }
    .rec-boc-escena:not([hidden]) { animation: recBocC .4s cubic-bezier(.34, 1.56, .64, 1); }
  }

  /* Tarjeta de la parada */
  .rec-pop { position: absolute; z-index: 4; top: 16px; right: 16px; width: min(330px, 28%); max-height: calc(100% - 100px); overflow: auto; background: var(--paper); border: 1px solid var(--border); border-radius: 12px; padding: 18px 20px; box-shadow: 0 18px 40px rgba(20,22,24,.18); opacity: 0; transform: translateY(10px) scale(.97); pointer-events: none; transition: opacity .25s, transform .25s; }
  .rec-pop.abierto { opacity: 1; transform: none; pointer-events: auto; }
  .rec-tarjeta[hidden] { display: none; }
  .rec-tag { display: inline-block; font: 500 .66rem 'DM Mono', monospace; letter-spacing: .1em; text-transform: uppercase; border-left: 3px solid var(--c); padding: 2px 8px; color: var(--gray); }
  .rec-tarjeta h3 { font: 600 1.3rem/1.1 'Oswald', sans-serif; text-transform: uppercase; margin: 10px 0 10px; }
  .rec-grafico { display: block; width: 100%; height: auto; background: #fff; border-radius: 8px; border: 1px solid var(--border); padding: 6px; margin-bottom: 12px; }
  .rec-tarjeta p { color: var(--gray); line-height: 1.6; margin: 0 0 12px; font-size: .95rem; }
  .rec-pista { font-family: 'DM Mono', monospace; font-size: .85rem; }
  .rec-cita { display: none; }
  .rec-chip { display: inline-block; font: .66rem 'DM Mono', monospace; padding: 4px 8px; border-radius: 4px; background: var(--orange-dim); color: var(--orange-ink); }
  .rec-ctas { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 6px; }

  .rec-controles { position: absolute; z-index: 5; left: 0; right: 0; bottom: 12px; display: flex; justify-content: center; align-items: center; gap: 14px; pointer-events: none; }
  .rec-btn { pointer-events: auto; width: 56px; height: 56px; border-radius: 50%; border: 0; background: var(--steel); color: #fff; font-size: 1.2rem; cursor: pointer; box-shadow: 0 6px 16px rgba(20,22,24,.25); }
  .rec-btn-adelante { background: var(--orange); }
  .rec-contador { pointer-events: auto; font: 500 .74rem 'DM Mono', monospace; background: rgba(246,245,242,.92); border: 1px solid var(--border); padding: 7px 12px; border-radius: 999px; max-width: 50vw; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

  /* Animaciones de las escenas (las de Ilustracion.astro) y de los detalles */
  .rec-escena :global(.ilus-bubble) { opacity: 0; transform: translateY(10px) scale(.85); transform-box: fill-box; transform-origin: 30% 100%; }
  .rec-escena.vista :global(.ilus-bubble) { opacity: 1; transform: none; }
  @media (prefers-reduced-motion: no-preference) {
    .rec-escena.actual :global(.ilus-bubble) { opacity: 0; animation: recPop .55s cubic-bezier(.34, 1.56, .64, 1) forwards; animation-delay: calc(.2s + var(--i, 0) * .3s); }
    .rec-escena :global(.ilus-breathe), .rec-huevo :global(.ilus-breathe) { animation: recBreathe 4.2s ease-in-out infinite; animation-delay: var(--d, 0s); transform-box: fill-box; transform-origin: 50% 100%; }
    .rec-escena :global(.ilus-blink), .rec-huevo :global(.ilus-blink) { animation: recBlink 2.4s ease-in-out infinite; }
