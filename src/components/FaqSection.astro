---
// Bloque visible de preguntas frecuentes. Se alimenta de la MISMA lista que
// faqPageSchema() usa para el JSON-LD, para que el texto renderizado y el schema
// no puedan divergir (auditoria P6).
//
// Se renderiza como acordeon <details>: el texto sigue completo en el DOM (asi
// que el schema y la indexacion no cambian), pero deja de ocupar pantalla. La
// FAQ era el 15-22% del texto visible de la pagina y estaba siempre desplegada
// (tarea A2 de PLAN_SIMPLIFICACION_EDITORIAL_WEB_2026-08.md).
//
// Uso tipico en una pagina:
//   const faqs = [{ q: '...', a: '...' }];
//   const schema = [softwareApplicationSchema(), faqPageSchema(faqs)];
//   ...
//   <FaqSection items={faqs} />
import type { FaqItem } from '../lib/seo';

export interface Props {
  items: FaqItem[];
  /** Titulo de la seccion. */
  heading?: string;
  /** Kicker sobre el titulo. */
  eyebrow?: string;
}

const { items, heading = 'Preguntas frecuentes', eyebrow = 'Dudas habituales' } = Astro.props;
---

<section class="section faq-section" id="faq">
  <div class="section-inner">
    <div class="fade-up">
      <div class="eyebrow">{eyebrow}</div>
      <h2 class="section-title">{heading}</h2>
    </div>

    <div class="faq-list fade-up delay-1">
      {items.map((item, i) => (
        <details class="faq-item" open={i === 0}>
          <summary class="faq-summary">
            <h3 class="faq-q">{item.q}</h3>
            <span class="faq-icon" aria-hidden="true"></span>
          </summary>
          <p class="faq-a">{item.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq-section {
    text-align: left;
  }

  .faq-list {
    display: grid;
    gap: 12px;
    margin-top: 40px;
  }

  .faq-item {
    background: var(--surface);
    border: 1px solid var(--border);
    border-left: 3px solid var(--orange);
    border-radius: 6px;
    padding: 0 28px;
    transition: border-color .25s;
  }

  .faq-item:hover {
    border-color: var(--border-hover);
    border-left-color: var(--orange);
  }

  /* El summary es el area clicable completa. Quitamos el marcador nativo en
     ambas familias de motores: ::-webkit-details-marker para WebKit y
     list-style para Firefox/Chromium moderno. */
  .faq-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 22px 0;
    cursor: pointer;
    list-style: none;
  }

  .faq-summary::-webkit-details-marker {
    display: none;
  }

  .faq-summary:focus-visible {
    outline: 2px solid var(--orange);
    outline-offset: 4px;
    border-radius: 2px;
  }

  .faq-q {
    font-family: 'Oswald', sans-serif;
    font-size: 1.02rem;
    font-weight: 600;
    letter-spacing: .02em;
    line-height: 1.3;
    margin: 0;
    color: var(--white);
  }

  /* Chevron dibujado con bordes: no depende de ninguna fuente de iconos. */
  .faq-icon {
    flex: 0 0 auto;
    width: 9px;
    height: 9px;
    border-right: 1.5px solid var(--orange);
    border-bottom: 1.5px solid var(--orange);
    transform: rotate(45deg) translate(-2px, -2px);
    transition: transform .25s ease;
  }

  .faq-item[open] .faq-icon {
    transform: rotate(-135deg) translate(-2px, -2px);
  }

  .faq-a {
    font-size: .95rem;
    line-height: 1.7;
    color: var(--gray);
    margin: 0;
    padding: 0 0 24px;
    max-width: 68ch;
  }

  @media (max-width: 700px) {
    .faq-item {
      padding: 0 20px;
    }

    .faq-summary {
      padding: 18px 0;
    }

    .faq-a {
      padding-bottom: 20px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-icon {
      transition: none;
    }
  }
</style>
