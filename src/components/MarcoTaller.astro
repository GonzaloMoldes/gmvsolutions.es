---
// Marco de taller: decoracion fija en los bordes de la ventana, en todas las
// paginas. Herramientas «tiradas» que asoman por los lados (cable, llave fija,
// tornillos, manguera, destornillador, llave Allen) y escuadras atornilladas
// en las esquinas.
//
// Reglas para que decore sin estorbar:
//  - pointer-events:none y aria-hidden: no se puede pinchar ni lo lee un
//    lector de pantalla.
//  - Solo ocupa ~60 px de cada borde; las piezas quedan cortadas por la
//    ventana, como si estuvieran apoyadas fuera.
//  - Por debajo de 1280 px solo quedan las escuadras de las esquinas, y en
//    movil ni eso. No se imprime.
//  - Va por encima del contenido (z 50) pero por debajo de la cabecera (100).
---

<div class="marco" aria-hidden="true">
  <!-- Escuadras atornilladas en las esquinas -->
  {['tl', 'tr', 'bl', 'br'].map((c) => (
    <svg class={`m-corner m-${c}`} viewBox="0 0 64 64" width="64" height="64">
      <path d="M0 0H64V18H18V64H0Z" fill="#C9C6BF" />
      <path d="M0 0H64V4H4V64H0Z" fill="#DAD7D0" />
      <path d="M18 18H64V22H22V64H18Z" fill="#B3AFA6" />
      <g>
        <polygon points="40,4 47,8 47,15 40,19 33,15 33,8" fill="#8A8780" />
        <circle cx="40" cy="11.5" r="4" fill="#A9A59D" />
        <path d="M37 11.5h6" stroke="#6E6B65" stroke-width="1.6" />
      </g>
      <g>
        <polygon points="11,33 18,37 18,44 11,48 4,44 4,37" fill="#8A8780" />
        <circle cx="11" cy="40.5" r="4" fill="#A9A59D" />
        <path d="M11 37.5v6" stroke="#6E6B65" stroke-width="1.6" />
      </g>
    </svg>
  ))}

  <!-- Cable que cuelga por la izquierda, con conector naranja -->
  <svg class="m-tool m-cable" viewBox="0 0 90 520" width="90" height="520">
    <path d="M-10 0C40 60 50 120 20 190C-6 250 6 320 38 370C58 402 50 440 34 470" fill="none" stroke="#23272D" stroke-width="9" stroke-linecap="round" />
    <path d="M-8 4C40 62 48 120 18 188" fill="none" stroke="#4A4F57" stroke-width="2.5" stroke-linecap="round" />
    <rect x="22" y="300" width="14" height="6" rx="2" fill="#F4521E" transform="rotate(-30 29 303)" />
    <g transform="rotate(-20 34 480)">
      <rect x="24" y="468" width="22" height="30" rx="4" fill="#F4521E" />
      <rect x="24" y="468" width="8" height="30" rx="3" fill="#D9441A" />
      <rect x="28" y="498" width="4" height="12" rx="1" fill="#B9B6AE" />
      <rect x="38" y="498" width="4" height="12" rx="1" fill="#B9B6AE" />
    </g>
  </svg>

  <!-- Llave fija tirada abajo a la izquierda -->
  <svg class="m-tool m-llave" viewBox="0 0 260 70" width="260" height="70">
    <path d="M40 27H210V43H40Z" fill="#8F949B" />
    <path d="M40 27H210V32H40Z" fill="#B6BAC0" />
    <path d="M14 10C-2 18 -2 52 14 60C26 66 40 60 46 50L34 44C30 50 22 52 18 48L18 22C22 18 30 20 34 26L46 20C40 10 26 4 14 10Z" fill="#8F949B" />
    <path d="M14 10C26 4 40 10 46 20L42 22C36 14 26 10 16 14Z" fill="#B6BAC0" />
    <circle cx="226" cy="35" r="24" fill="#8F949B" />
    <circle cx="226" cy="35" r="11" fill="none" stroke="#6E737A" stroke-width="3" />
    <circle cx="226" cy="35" r="9" fill="#ECEAE5" />
    <path d="M206 22A24 24 0 0 1 246 22" fill="none" stroke="#B6BAC0" stroke-width="4" />
    <text x="120" y="40" font-family="DM Mono, monospace" font-size="10" fill="#5E636A">17 mm</text>
  </svg>

  <!-- Tornillos y tuercas sueltos -->
  <svg class="m-tool m-tornillos" viewBox="0 0 120 90" width="120" height="90">
    <g transform="rotate(24 30 20)">
      <rect x="6" y="12" width="12" height="16" rx="2" fill="#8A8780" />
      <path d="M18 16H52V24H18Z" fill="#A9A59D" />
      <path d="M22 16l2 8M28 16l2 8M34 16l2 8M40 16l2 8M46 16l2 8" stroke="#7E7B75" stroke-width="1.4" />
      <path d="M52 16L58 20L52 24Z" fill="#A9A59D" />
    </g>
    <g transform="rotate(-38 80 60)">
      <rect x="58" y="54" width="10" height="14" rx="2" fill="#8A8780" />
      <path d="M68 57H96V65H68Z" fill="#A9A59D" />
      <path d="M72 57l2 8M78 57l2 8M84 57l2 8M90 57l2 8" stroke="#7E7B75" stroke-width="1.4" />
    </g>
    <polygon points="96,10 106,16 106,28 96,34 86,28 86,16" fill="#8A8780" />
    <circle cx="96" cy="22" r="5" fill="#ECEAE5" />
    <polygon points="26,62 33,66 33,74 26,78 19,74 19,66" fill="#A9A59D" />
    <circle cx="26" cy="70" r="3.5" fill="#ECEAE5" />
  </svg>

  <!-- Manguera enrollada que asoma abajo a la derecha -->
  <svg class="m-tool m-manguera" viewBox="0 0 260 260" width="260" height="260">
    <circle cx="130" cy="130" r="104" fill="none" stroke="#D9441A" stroke-width="18" />
    <circle cx="130" cy="130" r="104" fill="none" stroke="#F4521E" stroke-width="12" />
    <circle cx="130" cy="130" r="80" fill="none" stroke="#D9441A" stroke-width="18" />
    <circle cx="130" cy="130" r="80" fill="none" stroke="#F4521E" stroke-width="12" />
    <circle cx="130" cy="130" r="56" fill="none" stroke="#D9441A" stroke-width="18" />
    <circle cx="130" cy="130" r="56" fill="none" stroke="#F4521E" stroke-width="12" />
    <path d="M60 52C40 30 20 26 2 34" fill="none" stroke="#D9441A" stroke-width="18" stroke-linecap="round" />
    <path d="M60 52C40 30 20 26 2 34" fill="none" stroke="#F4521E" stroke-width="12" stroke-linecap="round" />
    <path d="M44 100A90 90 0 0 1 100 40" fill="none" stroke="#FF8A5C" stroke-width="3" stroke-linecap="round" opacity=".7" />
    <g transform="rotate(-25 0 34)">
      <rect x="-26" y="24" width="28" height="20" rx="3" fill="#C9A54A" />
      <path d="M-20 24v20M-12 24v20M-4 24v20" stroke="#A88A35" stroke-width="2" />
    </g>
  </svg>

  <!-- Destornillador a la derecha -->
  <svg class="m-tool m-destornillador" viewBox="0 0 220 40" width="220" height="40">
    <rect x="4" y="8" width="82" height="24" rx="10" fill="#F4521E" />
    <rect x="4" y="8" width="82" height="9" rx="4.5" fill="#FF7A47" />
    <path d="M22 10v20M36 10v20M50 10v20M64 10v20" stroke="#D9441A" stroke-width="3" />
    <rect x="86" y="12" width="14" height="16" rx="3" fill="#23272D" />
    <path d="M100 17H196V23H100Z" fill="#A9ADB3" />
    <path d="M196 15L214 20L196 25Z" fill="#8F949B" />
  </svg>

  <!-- Llave Allen -->
  <svg class="m-tool m-allen" viewBox="0 0 70 140" width="70" height="140">
    <path d="M12 10V118H58" fill="none" stroke="#23272D" stroke-width="10" stroke-linejoin="round" />
    <path d="M9 10V118" fill="none" stroke="#4A4F57" stroke-width="2.5" />
  </svg>
</div>

<style>
  .marco {
    position: fixed;
    inset: 0;
    z-index: 50;
    pointer-events: none;
    overflow: hidden;
  }
  .marco svg {
    position: absolute;
    display: block;
    filter: drop-shadow(0 3px 2px rgba(20, 22, 24, .18));
  }

  /* Esquinas: arriba quedan bajo la cabecera fija (64 px). */
  .m-corner { width: 48px; height: 48px; }
  .m-tl { top: 72px; left: 8px; }
  .m-tr { top: 72px; right: 8px; transform: scaleX(-1); }
  .m-bl { bottom: 8px; left: 8px; transform: scaleY(-1); }
  .m-br { bottom: 8px; right: 8px; transform: scale(-1, -1); }

  /* Herramientas: asoman por los bordes, cortadas por la ventana. --g es el
     margen libre a cada lado del contenido (1300 px de ancho maximo): en
     pantallas grandes las piezas entran mas, en las justas se retiran. */
  .marco { --g: max(0px, (100vw - 1300px) / 2); }
  .m-cable { left: calc(var(--g) * .5 - 34px); top: 140px; height: min(520px, 62vh); width: auto; }
  .m-llave { left: calc(var(--g) * .8 - 190px); bottom: 64px; transform: rotate(-30deg); }
  .m-tornillos { left: calc(var(--g) * .7 - 70px); bottom: 170px; }
  .m-manguera { right: calc(var(--g) * .5 - 170px); bottom: -150px; }
  .m-destornillador { right: calc(var(--g) * .8 - 150px); top: 46%; transform: rotate(158deg); }
  .m-allen { right: calc(var(--g) * .6 - 22px); top: 26%; transform: rotate(12deg); }

  /* Con menos hueco a los lados, las herramientas pisarian el contenido. */
  @media (max-width: 1279px) {
    .m-tool { display: none; }
  }
  @media (max-width: 700px) {
    .marco { display: none; }
  }
  @media print {
    .marco { display: none; }
  }
</style>
