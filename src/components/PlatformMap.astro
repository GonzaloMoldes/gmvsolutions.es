  .pmap-conn {
    position: absolute;
    top: calc(var(--pm-node) / 2 - 2px);
    left: calc(50% + var(--pm-node) / 2 + 12px);
    width: calc(100% + var(--pm-gap) - var(--pm-node) - 34px);
    height: 4px; border-radius: 2px;
    background: linear-gradient(90deg, rgba(244, 82, 30, .28), rgba(244, 82, 30, .5));
