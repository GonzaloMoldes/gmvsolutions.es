---
// Mapa interactivo de la plataforma: el ciclo operativo en cuatro fases, con
// los 14 modulos de producto enlazados y recorrible por caso de uso real.
//
// Sustituye al carrusel de capturas de la home. Se hace con HTML y CSS, no con
// un SVG ni una imagen, por tres motivos: son 14 enlaces internos reales hacia
// paginas que en la auditoria salian con cero enlaces contextuales, es
// navegable con teclado y legible por lector de pantalla, y se adapta a movil
// sin necesitar una version aparte del grafico.
//
// Los colores salen de los tokens de global.css; aqui no se define paleta.

export interface Props {
  /** Etiqueta sobre el titulo. */
  eyebrow?: string;
  /** Titulo de la seccion. Va como h2: la pagina ya tiene su h1. */
  heading?: string;
}

const {
  eyebrow = 'La plataforma',
  heading = 'Cómo encaja todo junto',
} = Astro.props;

// Texto del visor segun el caso seleccionado. Se emite tambien como JSON para
// que el script no tenga que duplicarlo.
const READOUTS = {
  all: 'Las cuatro fases y los 14 módulos que las componen.',
  monitor: 'Ver quién está en qué máquina y cómo va el turno mientras pasa, no al día siguiente.',
  formacion: 'Formar a alguien nuevo o subir de nivel a quien ya está, y medir el aprendizaje con datos.',
  tiempos: 'Cuánto cuesta de verdad producir cada referencia y qué operarios rinden mejor en cada proceso.',
  errores: 'Guías paso a paso que no dejan saltarse lo crítico, para que el fallo no llegue al cliente.',
  obras: 'Planificar una obra con sus trabajos, procesos y tiempos, y después seguirla pieza a pieza.',
};
---

<div class="pmap" id="pmap" data-view="all">
  <div class="pmap-grid" aria-hidden="true"></div>

  <div class="pmap-head">
    <div class="eyebrow">{eyebrow}</div>
    <h2 class="section-title">{heading}</h2>
    <p class="pmap-lede">
      REELEVO no es una suite que se implanta entera el primer día. Es un ciclo de cuatro
      fases: defines el estándar, se ejecuta en el puesto, queda registro y decides con ese
      registro delante. Lo que aprendes en la cuarta vuelve a la primera.
    </p>
  </div>

  <nav class="pmap-panel" aria-label="Elige un caso de uso">
    <div class="pmap-panel-head">
      <span class="pmap-panel-label">Sigue un caso real</span>
      <span class="pmap-panel-ref">ESQ-01 · CICLO OPERATIVO</span>
    </div>
    <div class="pmap-switch">
      <button type="button" class="pmap-chip is-active" data-scenario="all" aria-pressed="true">Todo el mapa</button>
      <button type="button" class="pmap-chip" data-scenario="monitor" aria-pressed="false">Monitorizar la planta</button>
      <button type="button" class="pmap-chip" data-scenario="formacion" aria-pressed="false">Formar y medir</button>
      <button type="button" class="pmap-chip" data-scenario="tiempos" aria-pressed="false">Tiempos y habilidad</button>
      <button type="button" class="pmap-chip" data-scenario="errores" aria-pressed="false">Menos errores</button>
      <button type="button" class="pmap-chip" data-scenario="obras" aria-pressed="false">Obras y proyectos</button>
    </div>
    <p class="pmap-readout" id="pmapReadout" data-readouts={JSON.stringify(READOUTS)}>{READOUTS.all}</p>
  </nav>

  <div class="pmap-flow">
    <span class="pmap-tick tl" aria-hidden="true"></span>
    <span class="pmap-tick tr" aria-hidden="true"></span>
    <span class="pmap-tick bl" aria-hidden="true"></span>
    <span class="pmap-tick br" aria-hidden="true"></span>
    <div class="pmap-ruler" aria-hidden="true"></div>

    <ol class="pmap-stages">

      <li class="pmap-stage">
        <div class="pmap-node-row">
          <span class="pmap-conn" aria-hidden="true"></span>
          <div class="pmap-node">
            <svg class="pmap-ring" viewBox="0 0 100 100" aria-hidden="true">
              <circle cx="50" cy="50" r="47" fill="none" stroke="currentColor" stroke-width="1.5" stroke-dasharray="4 9" stroke-linecap="round" />
            </svg>
            <svg class="pmap-ico" viewBox="0 0 32 32" fill="none" aria-hidden="true">
              <path d="M8 4h11l5 5v19H8z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" />
              <path d="M19 4v5h5" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" />
              <path d="M12 14h8M12 18h8M12 22h5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
            </svg>
          </div>
          <span class="pmap-num">01</span>
        </div>
        <h3 class="pmap-stage-title">Defines el estándar</h3>
        <p class="pmap-stage-q">¿Qué hay que hacer, y quién puede hacerlo?</p>

        <div class="pmap-view" data-for="all">
          <div class="pmap-mods">
            <a class="pmap-mod" href="/documentacion-procesos/">
              <span class="pmap-mod-name">Documentación de procesos</span>
              <span class="pmap-mod-desc">SOPs con foto y vídeo. Una sola versión vigente.</span>
            </a>
            <a class="pmap-mod" href="/workflows/">
              <span class="pmap-mod-name">Workflows</span>
              <span class="pmap-mod-desc">Secuencia obligada y validaciones donde importan.</span>
            </a>
            <a class="pmap-mod" href="/gestion-competencias/">
              <span class="pmap-mod-name">Gestión de competencias</span>
              <span class="pmap-mod-desc">Quién está capacitado para qué máquina y a qué nivel.</span>
            </a>
          </div>
        </div>

        <div class="pmap-view" data-for="monitor">
          <p class="pmap-note">Defines qué procesos existen, en qué máquina va cada uno y quién está capacitado. Sin eso, un monitor en tiempo real solo enseña nombres sueltos.</p>
          <div class="pmap-mods">
            <a class="pmap-mod" href="/documentacion-procesos/"><span class="pmap-mod-name">Documentación de procesos</span></a>
            <a class="pmap-mod" href="/gestion-competencias/"><span class="pmap-mod-name">Gestión de competencias</span></a>
          </div>
        </div>

        <div class="pmap-view" data-for="formacion">
          <p class="pmap-note">La guía lleva foto, vídeo del gesto exacto y el «por qué» de cada paso. La matriz define los niveles: en formación, apto, experto.</p>
          <div class="pmap-mods">
            <a class="pmap-mod" href="/documentacion-procesos/"><span class="pmap-mod-name">Documentación de procesos</span></a>
            <a class="pmap-mod" href="/gestion-competencias/"><span class="pmap-mod-name">Gestión de competencias</span></a>
          </div>
        </div>

        <div class="pmap-view" data-for="tiempos">
          <p class="pmap-note">Cada proceso se define con sus pasos y su tiempo objetivo. Ese objetivo es contra lo que después comparas el tiempo real.</p>
          <div class="pmap-mods">
            <a class="pmap-mod" href="/documentacion-procesos/"><span class="pmap-mod-name">Documentación de procesos</span></a>
            <a class="pmap-mod" href="/workflows/"><span class="pmap-mod-name">Workflows</span></a>
          </div>
        </div>

        <div class="pmap-view" data-for="errores">
          <p class="pmap-note">La guía se monta paso a paso, con el defecto que evita cada uno, y los pasos críticos se marcan como validación obligatoria.</p>
          <div class="pmap-mods">
            <a class="pmap-mod" href="/documentacion-procesos/"><span class="pmap-mod-name">Documentación de procesos</span></a>
            <a class="pmap-mod" href="/workflows/"><span class="pmap-mod-name">Workflows</span></a>
          </div>
        </div>

        <div class="pmap-view" data-for="obras">
          <p class="pmap-note">Defines la obra con los trabajos que incluye, el proceso de cada uno y el tiempo previsto. La planificación deja de vivir en un Excel.</p>
          <div class="pmap-mods">
            <a class="pmap-mod" href="/documentacion-procesos/"><span class="pmap-mod-name">Documentación de procesos</span></a>
            <a class="pmap-mod" href="/workflows/"><span class="pmap-mod-name">Workflows</span></a>
          </div>
        </div>
      </li>

      <li class="pmap-stage">
        <div class="pmap-node-row">
          <span class="pmap-conn" aria-hidden="true"></span>
          <div class="pmap-node">
            <svg class="pmap-ring" viewBox="0 0 100 100" aria-hidden="true">
              <circle cx="50" cy="50" r="47" fill="none" stroke="currentColor" stroke-width="1.5" stroke-dasharray="4 9" stroke-linecap="round" />
            </svg>
            <svg class="pmap-ico" viewBox="0 0 32 32" fill="none" aria-hidden="true">
              <rect x="5" y="6" width="22" height="15" rx="1.5" stroke="currentColor" stroke-width="1.5" />
              <path d="M13 26h6M16 21v5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
              <path d="M10 11h4v4h-4zM18 11h4M18 15h4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </div>
          <span class="pmap-num">02</span>
        </div>
        <h3 class="pmap-stage-title">Se ejecuta en el puesto</h3>
        <p class="pmap-stage-q">¿Cómo llega al operario si falla la wifi?</p>

        <div class="pmap-view" data-for="all">
          <div class="pmap-mods">
            <a class="pmap-mod" href="/portal-operario/">
              <span class="pmap-mod-name">Portal del operario</span>
              <span class="pmap-mod-desc">Acceso por QR desde la máquina, sin cuenta que recordar.</span>
            </a>
            <a class="pmap-mod" href="/modo-offline/">
              <span class="pmap-mod-name">Modo offline y PWA</span>
              <span class="pmap-mod-desc">Sigue funcionando aunque la nave no tenga cobertura.</span>
            </a>
            <a class="pmap-mod" href="/firma-digital/">
              <span class="pmap-mod-name">Firma digital</span>
              <span class="pmap-mod-desc">Evidencia trazable en los pasos que la exigen.</span>
            </a>
          </div>
        </div>

        <div class="pmap-view" data-for="monitor">
          <p class="pmap-note">El operario abre el proceso con un QR y su ejecución empieza a contar en ese momento. El monitor se alimenta de trabajo real, no de partes rellenados luego.</p>
          <div class="pmap-mods">
            <a class="pmap-mod" href="/portal-operario/"><span class="pmap-mod-name">Portal del operario</span></a>
            <a class="pmap-mod" href="/modo-offline/"><span class="pmap-mod-name">Modo offline y PWA</span></a>
          </div>
        </div>

        <div class="pmap-view" data-for="formacion">
          <p class="pmap-note">Quien aprende ejecuta con la guía delante en lugar de memorizar antes. El tutor pasa de explicar cada paso a verificar el resultado.</p>
          <div class="pmap-mods">
            <a class="pmap-mod" href="/portal-operario/"><span class="pmap-mod-name">Portal del operario</span></a>
          </div>
        </div>

        <div class="pmap-view" data-for="tiempos">
          <p class="pmap-note">Cada ejecución se abre y se cierra en el puesto. El tiempo sale del propio trabajo, no de una estimación a final de mes.</p>
          <div class="pmap-mods">
            <a class="pmap-mod" href="/portal-operario/"><span class="pmap-mod-name">Portal del operario</span></a>
          </div>
        </div>

        <div class="pmap-view" data-for="errores">
          <p class="pmap-note">La guía avanza paso a paso en la pantalla del puesto y no deja saltarse lo crítico. Sin cobertura también, que es cuando más se improvisa.</p>
          <div class="pmap-mods">
            <a class="pmap-mod" href="/portal-operario/"><span class="pmap-mod-name">Portal del operario</span></a>
            <a class="pmap-mod" href="/modo-offline/"><span class="pmap-mod-name">Modo offline y PWA</span></a>
          </div>
        </div>

        <div class="pmap-view" data-for="obras">
          <p class="pmap-note">Cada operario abre el trabajo que le toca de esa obra y lo cierra al terminar, con firma si el cliente la exige.</p>
          <div class="pmap-mods">
            <a class="pmap-mod" href="/portal-operario/"><span class="pmap-mod-name">Portal del operario</span></a>
            <a class="pmap-mod" href="/firma-digital/"><span class="pmap-mod-name">Firma digital</span></a>
          </div>
        </div>
      </li>

      <li class="pmap-stage">
        <div class="pmap-node-row">
          <span class="pmap-conn" aria-hidden="true"></span>
          <div class="pmap-node">
            <svg class="pmap-ring" viewBox="0 0 100 100" aria-hidden="true">
              <circle cx="50" cy="50" r="47" fill="none" stroke="currentColor" stroke-width="1.5" stroke-dasharray="4 9" stroke-linecap="round" />
            </svg>
            <svg class="pmap-ico" viewBox="0 0 32 32" fill="none" aria-hidden="true">
              <path d="M5 26h22" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
              <rect x="8" y="16" width="4" height="8" stroke="currentColor" stroke-width="1.5" />
              <rect x="14" y="11" width="4" height="13" stroke="currentColor" stroke-width="1.5" />
              <rect x="20" y="19" width="4" height="5" stroke="currentColor" stroke-width="1.5" />
              <path d="M6 8l4-3 5 3 6-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </div>
          <span class="pmap-num">03</span>
        </div>
        <h3 class="pmap-stage-title">Queda registro</h3>
        <p class="pmap-stage-q">¿Qué ha pasado de verdad en el turno?</p>

        <div class="pmap-view" data-for="all">
          <div class="pmap-mods">
            <a class="pmap-mod" href="/control-produccion/">
              <span class="pmap-mod-name">Control de producción</span>
              <span class="pmap-mod-desc">Quién hizo qué, cuándo y cuánto tardó. Sin partes en papel.</span>
            </a>
            <a class="pmap-mod" href="/obras-trazabilidad/">
              <span class="pmap-mod-name">Obras y trazabilidad</span>
              <span class="pmap-mod-desc">Historial por pieza y por proyecto, con QR.</span>
            </a>
            <a class="pmap-mod" href="/calidad-y-conformidad/">
              <span class="pmap-mod-name">Calidad y conformidad</span>
              <span class="pmap-mod-desc">Base para la causa raíz, con sus límites declarados.</span>
            </a>
          </div>
        </div>

        <div class="pmap-view" data-for="monitor">
          <p class="pmap-note">Monitor de actividad: qué operario está en qué máquina, en qué proceso y cuánto lleva. El estado del turno mientras pasa, no en la reunión del día siguiente.</p>
          <div class="pmap-mods">
            <a class="pmap-mod" href="/control-produccion/"><span class="pmap-mod-name">Control de producción</span></a>
          </div>
        </div>

        <div class="pmap-view" data-for="formacion">
          <p class="pmap-note">Cuántas veces ha ejecutado cada proceso, con qué tiempos y cuántas consultas ha necesitado. Ahí es donde se mide el aprendizaje de verdad.</p>
          <div class="pmap-mods">
            <a class="pmap-mod" href="/control-produccion/"><span class="pmap-mod-name">Control de producción</span></a>
            <a class="pmap-mod" href="/gestion-competencias/"><span class="pmap-mod-name">Gestión de competencias</span></a>
          </div>
        </div>

        <div class="pmap-view" data-for="tiempos">
          <p class="pmap-note">Duración real por proceso, por producto y por operario. Ves cuánto cuesta cada referencia y quién rinde mejor en cada máquina.</p>
          <div class="pmap-mods">
            <a class="pmap-mod" href="/control-produccion/"><span class="pmap-mod-name">Control de producción</span></a>
          </div>
        </div>

        <div class="pmap-view" data-for="errores">
          <p class="pmap-note">Qué guía se siguió, en qué versión, quién la ejecutó y en qué paso se paró. La investigación deja de acabar en «fue un despiste».</p>
          <div class="pmap-mods">
            <a class="pmap-mod" href="/calidad-y-conformidad/"><span class="pmap-mod-name">Calidad y conformidad</span></a>
          </div>
        </div>

        <div class="pmap-view" data-for="obras">
          <p class="pmap-note">Historial por pieza y por proyecto: qué trabajos se han cerrado, cuáles faltan y cuánto ha llevado cada uno frente a lo previsto.</p>
          <div class="pmap-mods">
            <a class="pmap-mod" href="/obras-trazabilidad/"><span class="pmap-mod-name">Obras y trazabilidad</span></a>
            <a class="pmap-mod" href="/control-produccion/"><span class="pmap-mod-name">Control de producción</span></a>
          </div>
        </div>
      </li>

      <li class="pmap-stage">
        <div class="pmap-node-row">
          <div class="pmap-node">
            <svg class="pmap-ring" viewBox="0 0 100 100" aria-hidden="true">
              <circle cx="50" cy="50" r="47" fill="none" stroke="currentColor" stroke-width="1.5" stroke-dasharray="4 9" stroke-linecap="round" />
            </svg>
            <svg class="pmap-ico" viewBox="0 0 32 32" fill="none" aria-hidden="true">
              <path d="M16 6a10 10 0 1 1-9.5 6.9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
              <path d="M6 6v7h7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
              <path d="M12 16.5l3 3 5.5-6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </div>
          <span class="pmap-num">04</span>
        </div>
        <h3 class="pmap-stage-title">Decides y mejoras</h3>
        <p class="pmap-stage-q">¿Qué haces con lo que ahora sabes?</p>

        <div class="pmap-view" data-for="all">
          <div class="pmap-mods">
            <a class="pmap-mod" href="/cobertura-turnos/">
              <span class="pmap-mod-name">Cobertura de turnos</span>
              <span class="pmap-mod-desc">Alerta antes de que el turno se quede corto, no después.</span>
            </a>
            <a class="pmap-mod" href="/mantenimiento/">
              <span class="pmap-mod-name">Mantenimiento preventivo</span>
              <span class="pmap-mod-desc">Planes por máquina y órdenes en la agenda del operario.</span>
            </a>
            <a class="pmap-mod" href="/kaizen/">
              <span class="pmap-mod-name">Kaizen y mejora continua</span>
              <span class="pmap-mod-desc">Lo que se repite en planta acaba cambiando el estándar.</span>
            </a>
          </div>
        </div>

        <div class="pmap-view" data-for="monitor">
          <p class="pmap-note">Si la línea 3 se atasca te enteras cuando todavía puedes mover a alguien. Y la alerta de cobertura salta antes de que el turno se quede corto.</p>
          <div class="pmap-mods">
            <a class="pmap-mod" href="/cobertura-turnos/"><span class="pmap-mod-name">Cobertura de turnos</span></a>
            <a class="pmap-mod" href="/control-produccion/"><span class="pmap-mod-name">Control de producción</span></a>
          </div>
        </div>

        <div class="pmap-view" data-for="formacion">
          <p class="pmap-note">La matriz sube de nivel con la ejecución real, no con intuición. Ves quién puede cubrir qué y dónde falta refuerzo antes de que aparezca el error.</p>
          <div class="pmap-mods">
            <a class="pmap-mod" href="/gestion-competencias/"><span class="pmap-mod-name">Gestión de competencias</span></a>
          </div>
        </div>

        <div class="pmap-view" data-for="tiempos">
          <p class="pmap-note">Detectas quién hace ese proceso mejor y en menos tiempo, y conviertes su método en el estándar del resto. La habilidad deja de ser una anécdota.</p>
          <div class="pmap-mods">
            <a class="pmap-mod" href="/kaizen/"><span class="pmap-mod-name">Kaizen y mejora continua</span></a>
            <a class="pmap-mod" href="/gestion-competencias/"><span class="pmap-mod-name">Gestión de competencias</span></a>
          </div>
        </div>

        <div class="pmap-view" data-for="errores">
          <p class="pmap-note">El fallo que se repite no se archiva: reescribe la guía, y el cambio llega a todos los puestos a la vez sin reimprimir nada.</p>
          <div class="pmap-mods">
            <a class="pmap-mod" href="/kaizen/"><span class="pmap-mod-name">Kaizen y mejora continua</span></a>
          </div>
        </div>

        <div class="pmap-view" data-for="obras">
          <p class="pmap-note">Comparas lo planificado con lo real y replanificas con datos. La siguiente obra parte de lo que costó la anterior, no de una estimación.</p>
          <div class="pmap-mods">
            <a class="pmap-mod" href="/cobertura-turnos/"><span class="pmap-mod-name">Cobertura de turnos</span></a>
            <a class="pmap-mod" href="/kaizen/"><span class="pmap-mod-name">Kaizen y mejora continua</span></a>
          </div>
        </div>
      </li>
    </ol>

    <!-- Arco de retorno: lo aprendido en 04 reescribe el estandar de 01 -->
    <div class="pmap-loop" aria-hidden="true">
      <svg viewBox="0 0 1000 96" preserveAspectRatio="none">
        <defs>
          <linearGradient id="pmapLoopGrad" x1="1" y1="0" x2="0" y2="0">
            <stop offset="0%" stop-color="#F4521E" stop-opacity=".85" />
            <stop offset="50%" stop-color="#F4521E" stop-opacity=".45" />
            <stop offset="100%" stop-color="#F4521E" stop-opacity=".85" />
          </linearGradient>
        </defs>
        <path d="M 962 2 C 962 66, 900 80, 700 80 L 300 80 C 100 80, 38 66, 38 2" fill="none" stroke="url(#pmapLoopGrad)" stroke-width="2.4" stroke-linecap="round" />
        <path class="pmap-loop-flow" d="M 962 2 C 962 66, 900 80, 700 80 L 300 80 C 100 80, 38 66, 38 2" fill="none" stroke="#F4521E" stroke-width="3" stroke-linecap="round" />
        <path d="M 28 20 L 38 2 L 48 20" fill="none" stroke="#F4521E" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
      <span class="pmap-loop-label">El estándar se reescribe con lo aprendido</span>
    </div>
  </div>

  <section class="pmap-across">
    <p class="pmap-across-label">Atraviesa las cuatro fases</p>
    <div class="pmap-mods pmap-across-mods">
      <a class="pmap-mod" href="/api-integraciones/">
        <span class="pmap-mod-name">API e integraciones</span>
        <span class="pmap-mod-desc">El dato de planta llega a tu ERP, a Power BI o a un webhook.</span>
      </a>
      <a class="pmap-mod" href="/integracion-m365/">
        <span class="pmap-mod-name">Integración Microsoft 365</span>
        <span class="pmap-mod-desc">Power BI, Power Automate y Teams, si ya trabajas ahí.</span>
      </a>
    </div>
  </section>
</div>

<style>
  /* Todos los colores salen de los tokens de global.css. */
  .pmap {
    --pm-gap: 26px;
    --pm-node: 82px;
    position: relative;
