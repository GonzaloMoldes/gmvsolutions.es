  .pmap-mod:hover,
  .pmap-mod:focus-visible {
    border-color: var(--border-hover); background: var(--surface2); transform: translateY(-2px);
  }
  .pmap-mod:hover::before,
  .pmap-mod:focus-visible::before { transform: scaleY(1); }
  .pmap-mod:focus-visible { outline: 2px solid var(--orange); outline-offset: 3px; }

  .pmap-mod-name {
    display: block; font-family: 'Oswald', sans-serif;
    font-size: .87rem; font-weight: 500; text-transform: uppercase;
    letter-spacing: .04em; color: var(--white); line-height: 1.25;
  }
  .pmap-mod-desc { display: block; font-size: .76rem; color: var(--gray); line-height: 1.5; margin-top: 5px; }

  /* ── Vistas conmutables ── */
  .pmap-view { display: none; }
  .pmap[data-view='all'] .pmap-view[data-for='all'],
  .pmap[data-view='monitor'] .pmap-view[data-for='monitor'],
  .pmap[data-view='formacion'] .pmap-view[data-for='formacion'],
  .pmap[data-view='tiempos'] .pmap-view[data-for='tiempos'],
  .pmap[data-view='errores'] .pmap-view[data-for='errores'],
  .pmap[data-view='obras'] .pmap-view[data-for='obras'] { display: block; }

  /* ── Arco de retorno ── */
  .pmap-loop { position: relative; margin-top: 34px; }
  .pmap-loop svg { display: block; width: 100%; height: 84px; overflow: visible; }
  .pmap-loop-flow {
    stroke-dasharray: 90 1180;
    filter: drop-shadow(0 0 7px rgba(244, 82, 30, .9));
    animation: pmapLoopFlow 5.5s linear infinite;
  }
  @keyframes pmapLoopFlow { from { stroke-dashoffset: 1270; } to { stroke-dashoffset: 0; } }

  .pmap-loop-label {
    position: absolute; left: 50%; bottom: 2px; transform: translateX(-50%);
    background: var(--black); padding: 0 14px;
    font-family: 'DM Mono', monospace; font-size: .6rem;
    letter-spacing: .13em; text-transform: uppercase;
    color: var(--orange); white-space: nowrap;
  }

  /* ── Transversal ── */
  .pmap-across {
    margin-top: 30px; padding: 24px 26px;
    background: rgba(244, 82, 30, .045);
    border: 1px solid rgba(244, 82, 30, .18);
    border-radius: 4px;
  }
  .pmap-across-label {
    font-family: 'DM Mono', monospace; font-size: .6rem; letter-spacing: .14em;
    text-transform: uppercase; color: var(--orange); margin: 0 0 14px;
  }
  .pmap-across-mods { flex-direction: row; flex-wrap: wrap; }
  .pmap-across-mods .pmap-mod { flex: 1 1 250px; background: rgba(10, 10, 10, .5); }

  /* ── Responsive ── */
  @media (max-width: 1040px) {
    .pmap-stages { grid-template-columns: repeat(2, minmax(0, 1fr)); row-gap: 46px; }
    /* Con dos columnas el conector cruzaria de fila y mentiria sobre el flujo. */
    .pmap-stage:nth-child(2n) .pmap-conn { display: none; }
    .pmap-loop, .pmap-ruler { display: none; }
  }

  @media (max-width: 640px) {
    .pmap { --pm-node: 66px; }
    .pmap-stages { grid-template-columns: 1fr; row-gap: 40px; }
    .pmap-conn { display: none; }
    .pmap-ico { width: 27px; height: 27px; }
    .pmap-num { left: calc(var(--pm-node) - 14px); }
    .pmap-across-mods { flex-direction: column; }
  }

  @media (prefers-reduced-motion: reduce) {
    .pmap-conn::before { display: none; }
    .pmap-loop-flow, .pmap-ring { animation: none; }
    .pmap-mod, .pmap-chip, .pmap-node { transition: none; }
    .pmap-mod:hover { transform: none; }
  }
</style>

<script>
  (() => {
    const root = document.getElementById('pmap');
    const out = document.getElementById('pmapReadout');
    if (!root || !out) return;

    // El texto del visor viaja en un data-attribute para no duplicarlo aqui.
    let texts: Record<string, string> = {};
    try {
      texts = JSON.parse(out.dataset.readouts || '{}');
    } catch {
      texts = {};
    }

    const chips = root.querySelectorAll<HTMLButtonElement>('.pmap-chip');
    chips.forEach((chip) => {
      chip.addEventListener('click', () => {
        const key = chip.dataset.scenario || 'all';
        root.setAttribute('data-view', key);
        if (texts[key]) out.textContent = texts[key];
        chips.forEach((c) => {
          const on = c === chip;
          c.classList.toggle('is-active', on);
          c.setAttribute('aria-pressed', String(on));
        });
      });
    });
  })();
</script>
