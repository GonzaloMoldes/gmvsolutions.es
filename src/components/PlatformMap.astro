  .pmap-conn::before {
    content: '';
    position: absolute; top: -1px; left: 0;
    width: 42%; height: 6px; border-radius: 3px;
    background: linear-gradient(90deg, transparent, #F4521E 65%, #fff);
    box-shadow: 0 0 16px rgba(244, 82, 30, .9);
    animation: pmapComet 2.1s cubic-bezier(.45, 0, .55, 1) infinite;
  }
  @keyframes pmapComet {
    0% { left: -42%; opacity: 0; }
    12% { opacity: 1; }
    82% { opacity: 1; }
    100% { left: 100%; opacity: 0; }
  }
  .pmap-conn::after {
    content: '';
    position: absolute; right: -13px; top: 50%;
    transform: translateY(-50%);
    border-left: 14px solid var(--orange);
    border-top: 8px solid transparent; border-bottom: 8px solid transparent;
    filter: drop-shadow(0 0 8px rgba(244, 82, 30, .75));
  }

  .pmap-stage-title {
    font-family: 'Oswald', sans-serif;
    font-size: 1.1rem; font-weight: 600; text-transform: uppercase;
    letter-spacing: .035em; line-height: 1.15; margin: 0 0 7px;
    text-wrap: balance; color: var(--white);
  }
  .pmap-stage-q { font-size: .82rem; color: var(--gray2); margin: 0 0 18px; line-height: 1.5; }

  .pmap-note {
    font-size: .86rem; color: var(--gray); margin: 0 0 16px;
    border-left: 2px solid var(--orange); padding-left: 14px; line-height: 1.6;
  }

  /* ── Modulos ── */
  .pmap-mods { display: flex; flex-direction: column; gap: 10px; }

  .pmap-mod {
    display: block; position: relative;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 3px;
    padding: 15px 16px 15px 18px;
