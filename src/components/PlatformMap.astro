  .pmap-stage { min-width: 0; }

  .pmap-node-row { position: relative; height: var(--pm-node); margin-bottom: 20px; }

  .pmap-node {
    width: var(--pm-node); height: var(--pm-node);
    border-radius: 50%;
    display: grid; place-items: center;
    background:
      radial-gradient(circle at 50% 38%, rgba(244, 82, 30, .18), transparent 68%),
      var(--surface);
    box-shadow: inset 0 0 0 1px rgba(244, 82, 30, .28), 0 0 24px rgba(244, 82, 30, .07);
