---
// Ilustraciones de escena del rediseno claro (series 01 y 02 de la propuesta
// visual). Cada SVG vive en src/assets/ilustraciones/ y se incrusta en linea
// para que use las fuentes del sitio y no cueste una peticion aparte.
// Son una version provisional dibujada a mano: el reparto (operario de chaleco
// naranja, jefe de camisa blanca...) y las escenas sirven de guion para el
// ilustrador que haga la version final.
const svgs = import.meta.glob('../assets/ilustraciones/*.svg', {
  query: '?raw',
  import: 'default',
  eager: true,
}) as Record<string, string>;

export interface Props {
  escena: string;
  class?: string;
}

const { escena, class: className } = Astro.props;
const svg = svgs[`../assets/ilustraciones/${escena}.svg`];
if (!svg) throw new Error(`Ilustracion: no existe la escena "${escena}"`);
---

<!-- fade-up engancha la figura al IntersectionObserver de BaseLayout: al entrar
     en pantalla recibe .is-visible, que es lo que dispara los globos y los ticks. -->
<figure class:list={['ilus', 'fade-up', className]}>
  <Fragment set:html={svg} />
</figure>

<style>
  .ilus {
    margin: 0;
  }

  /* ── Animacion de las escenas ──
     Las clases las llevan los propios SVG (src/assets/ilustraciones):
       .ilus-bubble  cada bocadillo, con --i = su orden
       .ilus-breathe envoltorio de cada personaje, con --d = desfase
       .ilus-blink   pilotos verdes de maquinas y pantallas
       .ilus-draw    ticks verdes (pathLength=1)
     Todo va dentro de no-preference: con "reducir movimiento" la escena se ve
     completa y quieta. */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .ilus :global(.ilus-bubble) {
      opacity: 0;
      transform: translateY(10px) scale(.85);
      transform-box: fill-box;
      transform-origin: 30% 100%;
    }
    :global(.js) .ilus:global(.is-visible) :global(.ilus-bubble) {
      animation: ilusPop .55s cubic-bezier(.34, 1.56, .64, 1) forwards;
      animation-delay: calc(.35s + var(--i, 0) * .32s);
    }
    :global(.js) .ilus :global(.ilus-draw) {
      stroke-dasharray: 1;
      stroke-dashoffset: 1;
    }
    :global(.js) .ilus:global(.is-visible) :global(.ilus-draw) {
      animation: ilusDraw .5s ease-out 1.2s forwards;
    }
    .ilus :global(.ilus-breathe) {
      animation: ilusBreathe 4.2s ease-in-out infinite;
      animation-delay: var(--d, 0s);
    }
    .ilus :global(.ilus-blink) {
      animation: ilusBlink 2.4s ease-in-out infinite;
    }
  }

  @keyframes ilusPop {
    to { opacity: 1; transform: none; }
  }
  @keyframes ilusDraw {
    to { stroke-dashoffset: 0; }
  }
  @keyframes ilusBreathe {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-1.6px); }
  }
  @keyframes ilusBlink {
    0%, 100% { opacity: 1; }
    50% { opacity: .35; }
  }
  .ilus :global(svg) {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .page-hero .ilus {
    max-width: 640px;
    margin: 48px auto 0;
  }
</style>
