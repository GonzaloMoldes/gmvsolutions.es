---
// Ilustraciones de escena del rediseno claro (series 01 y 02 de la propuesta
// visual). Cada SVG vive en src/assets/ilustraciones/ y se incrusta en linea
// para que use las fuentes del sitio y no cueste una peticion aparte.
// Son una version provisional dibujada a mano: el reparto (operario de chaleco
// naranja, jefe de camisa blanca...) y las escenas sirven de guion para el
// ilustrador que haga la version final.
const svgs = import.meta.glob('../assets/ilustraciones/*.svg', {
  query: '?raw',
  import: 'default',
  eager: true,
}) as Record<string, string>;

export interface Props {
  escena: string;
  class?: string;
}

const { escena, class: className } = Astro.props;
const svg = svgs[`../assets/ilustraciones/${escena}.svg`];
if (!svg) throw new Error(`Ilustracion: no existe la escena "${escena}"`);
---

<figure class:list={['ilus', className]}>
  <Fragment set:html={svg} />
</figure>

<style>
  .ilus {
    margin: 0;
  }
  .ilus :global(svg) {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .page-hero .ilus {
    max-width: 640px;
    margin: 48px auto 0;
  }
</style>
