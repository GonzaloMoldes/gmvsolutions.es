# Modal de alta (newsletter + cuenta de empresa) — /api/suscribir
# Copia este archivo a .env (local) y configura las mismas variables en
# Vercel → Project → Settings → Environment Variables (Production + Preview).

# --- Mostrar el modal en la web ---
# Apagado por defecto. Ponlo a "on" SOLO cuando las demas variables esten listas.
PUBLIC_NEWSLETTER_MODAL=off

# --- E-goi (newsletter) ---
# Apikey de la API de E-goi (NO el ID de Connected Sites del pixel).
EGOI_API_KEY=
# ID numerico de la lista de newsletter en E-goi.
EGOI_LIST_ID=

# --- Alta de empresa en la app (servidor-a-servidor) ---
# Endpoint de la app que crea la empresa/tenant. Lo expone el proyecto de la app
# (Supabase), no esta web. Debe aceptar POST { email, nombre, empresa, source }
# autenticado con el secreto de abajo, ser idempotente por email y enviar su
# propio correo de activacion / magic link.
APP_REGISTRO_URL=
# Secreto compartido para autenticar la llamada anterior (Bearer).
APP_REGISTRO_SECRET=
